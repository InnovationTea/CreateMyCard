%%{init: {"flowchart": {"curve": "basis", "nodeSpacing": 30, "rankSpacing": 42}, "theme": "neutral"}}%%
flowchart TD
    A(["Uvicorn 单进程 / 单事件循环"])

    subgraph COMMON["公共 WebSocket 并发状态"]
        B["每个已通过 JSON 解析的消息创建一段处理任务<br/>running_tasks +1；完成后 -1"]
        C["active_connections：当前存活 WS 数<br/>total_connections：进程启动后的累计连接数"]
        D["每 10 秒打印一次三项指标<br/>等待线程令牌或模型令牌也属于 running_tasks"]
    end

    subgraph QUERY["第一、第二接口：同步查询链路"]
        E["事件循环完成收包、参数校验并发送 start"]
        F["run_in_threadpool 请求 AnyIO 默认线程令牌<br/>anyio_thread_pool_tokens 默认 80 / 每进程"]
        G{"当前有空闲 AnyIO 令牌？"}
        H["无令牌：请求协程异步等待<br/>不占工作线程、无单独排队超时<br/>WS 仍连接，running_tasks 仍计数"]
        I["取得 1 个令牌和 1 个工作线程<br/>令牌覆盖整个同步 Service 调用"]
        J["第一接口：版本、注册表、IDS mock/requests、过滤<br/>同步 IDS 网络等待期间仍占该线程令牌"]
        K["第二接口：版本、注册表和逐 ID JSON/Schema 查询<br/>文件读取期间仍占该线程令牌"]
        L["Service 返回或抛异常<br/>AnyIO 自动释放令牌"]
        M["事件循环发送 final<br/>第一、第二接口没有周期 heartbeat"]
    end

    subgraph GENERATION["第四接口：异步生成编排"]
        N["事件循环直接 await Service<br/>不把 120 秒生成全过程放入 AnyIO 工作线程"]
        O["独立 heartbeat 协程每 6 秒发送 partial<br/>模型排队、异步网络和退避期间仍可运行"]
        P["短同步岛才申请 AnyIO 令牌<br/>来源读取、Processor、Validator、本地保存/删除"]
        Q["同步岛结束立即释放 AnyIO 令牌<br/>模型异步等待期间不占 AnyIO 令牌"]
        R["每个首次生成或 quality repair<br/>进入统一模型调用入口"]
    end

    subgraph MODEL["所有真实模型调用共享的进程级限流"]
        S["Mock：直接读本地文件<br/>不进入真实模型 Semaphore"]
        T["真实物理调用请求共享 asyncio.Semaphore<br/>model_max_concurrency 默认 20 / 每进程"]
        U{"20 个模型令牌是否已有空闲？"}
        V["无令牌：请求协程排队<br/>不占线程，heartbeat 可继续发送"]
        W{"排队是否超过<br/>model_queue_timeout_seconds<br/>默认 120 秒？"}
        X["MODEL_QUEUE_TIMEOUT<br/>本次物理调用按模型异常处理"]
        Y["取得 1 个模型令牌<br/>首次、模型重试、fallback、repair 都共用同一上限"]
        Z{"物理 provider？"}
        AA["MEP：httpx 异步流<br/>网络等待不占工作线程"]
        AB["DeepSeek Platform：异步 WebSocket<br/>网络等待不占工作线程"]
        AC["llmclient：提交专用 ThreadPoolExecutor<br/>max_workers 默认同为 20<br/>不占 AnyIO 默认线程池"]
        AD{"执行是否超过<br/>model_request_timeout_seconds<br/>默认 120 秒？"}
        AE["MEP/DeepSeek：取消异步请求<br/>抛 MODEL_REQUEST_TIMEOUT"]
        AF["llmclient：线程不能强制终止<br/>继续持有模型令牌等待物理调用真正结束<br/>丢弃迟到结果后抛 MODEL_REQUEST_TIMEOUT"]
        AG["调用成功或异常结束<br/>finally 释放模型令牌"]
    end

    subgraph RETRY["重试、fallback 与 repair 对令牌的影响"]
        AH{"当前 provider 还有<br/>模型异常重试预算？"}
        AI["指数退避 + jitter 的 asyncio.sleep<br/>退避期间不占模型令牌、不占线程"]
        AJ["下一次尝试重新排队获取模型令牌<br/>不会连续独占令牌"]
        AK{"OpenAI master 已耗尽且<br/>模型重试、fallback 开关均开启？"}
        AL["切换 fallback<br/>fallback 每次调用仍重新获取同一模型令牌"]
        AM["模型阶段失败<br/>不进入 conversion/validation"]
        AN["模型返回源 Design Token<br/>先释放模型令牌，再做转换和校验"]
        AO{"conversion/validation<br/>存在 error 且 repair 可用？"}
        AP["下一轮 quality repair<br/>重新从 master 开始，也重新排队取令牌"]
        AQ["无 error / warning / repair 关闭或耗尽<br/>按质量策略继续保存或严格失败"]
    end

    subgraph BOUNDARY["并发边界"]
        AR["AnyIO 80 与模型 Semaphore 20 是两套独立资源<br/>80 控制同步代码工作线程；20 控制真实模型物理调用"]
        AS["模型 20 的统计范围：第三至第五接口、Create/Edit、<br/>首次生成、模型重试、master/fallback、所有 repair"]
        AT["限制按进程生效<br/>若启动 N 个 Uvicorn 进程，理论模型总上限为 N × 20"]
        AU["心跳发送失败只停止心跳<br/>不会取消生成、排队、repair 或 artifact 保存"]
    end

    A --> B --> C --> D
    B --> E --> F --> G
    G -- "否" --> H --> G
    G -- "是" --> I
    I --> J --> L
    I --> K --> L
    L --> M

    B --> N
    N -. "并行协程" .-> O
    N --> P --> Q --> R
    R -- "mock" --> S --> AN
    R -- "真实模型" --> T --> U
    U -- "否" --> V --> W
    W -- "否：继续等" --> U
    W -- "是" --> X --> AH
    U -- "是" --> Y --> Z
    Z -- "mep" --> AA --> AD
    Z -- "deepseek_platform" --> AB --> AD
    Z -- "llmclient" --> AC --> AD
    AD -- "否：完成" --> AG
    AD -- "是：异步 provider" --> AE --> AG
    AD -- "是：llmclient" --> AF --> AG
    AG -- "成功" --> AN
    AG -- "异常" --> AH
    AH -- "是" --> AI --> AJ --> T
    AH -- "否" --> AK
    AK -- "是" --> AL --> T
    AK -- "否" --> AM
    AN --> AO
    AO -- "是" --> AP --> R
    AO -- "否" --> AQ

    F -. "独立资源" .-> AR
    T -. "独立资源" .-> AR
    AR --> AS --> AT
    O -. "断开行为" .-> AU

    classDef terminal fill:#fde8e8,stroke:#b42318,color:#3b0a08;
    classDef success fill:#e8f7ee,stroke:#16803b,color:#072b16;
    classDef decision fill:#fff4d6,stroke:#b7791f,color:#3a2500;
    classDef limit fill:#e8f0fe,stroke:#3159a6,color:#101d3f;
    class X,AE,AF,AM terminal;
    class M,AN,AQ success;
    class G,U,W,Z,AD,AH,AK,AO decision;
    class F,T,Y,AR,AS,AT limit;
