    end

    subgraph PROFILE["2. 协议/Profile 与模式准备"]
        G["按 App 完整版本 + ROM 主次版本<br/>匹配 protocol registry_ranges.json"]
        H{"唯一命中协议区间？"}
        I["得到标准 A2UI Profile<br/>和 Design Compact Profile"]
        J{"enable_default_protocol_profile_fallback？"}
        K["加载默认协议和 Design Prompt"]
        L["UNSUPPORTED / APP_VERSION_UNSUPPORTED<br/>不调用模型、不保存"]
        M["建立固定策略<br/>processor=DESIGN_COMPACT<br/>strict validation=true<br/>stores_design_token=true"]
        N{"请求是否显式包含 sourceArtifactUrl？"}
    end

    subgraph MODE["3. Create / Edit 归一化"]
        O["Create：size 缺失→2x2<br/>三类候选缺失→空数组"]
        P{"enable_widget_edit？"}
        P1["UNSUPPORTED / WIDGET_EDIT_DISABLED"]
        Q["短时线程读取来源 artifact<br/>校验大小、Markdown 块和 schemaVersion"]
        R{"来源 artifact 和 designcompactdsl<br/>非空、未超限且结构有效？"}
        R1["SOURCE_ARTIFACT_* 失败<br/>不降级为 Create、不覆盖来源"]
        S["继承省略字段<br/>显式字段整体替换<br/>显式空数组清空候选"]
    end

    subgraph CAP["4. 能力与来源 Token 裁决"]
        T["按 App/ROM 区间选择能力目录"]
        U{"命中能力区间？"}
        V{"enable_default_capability_registry_fallback？"}
        W["加载默认能力目录"]
        U1["UNSUPPORTED / APP_VERSION_UNSUPPORTED"]
        X["加载最终 A2UI Profile"]
        Y{"Edit 来源 Design Token<br/>能按第四接口 Processor 转换？"}
        Y1["FAILED / SOURCE_ARTIFACT_INVALID"]
