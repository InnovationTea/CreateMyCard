        AC1["UNSUPPORTED / NO_EFFECTIVE_CAPABILITY<br/>不调用模型"]
    end

    subgraph PROMPT["5. 规格与提示词"]
        AD["构造 CardSpec<br/>只保留有效 dataBindings"]
        AE["构造 TaskSpec<br/>userQuery/size/event/assets<br/>outputSchema 投影为 dataModelSchema"]
        AF{"Create 还是 Edit？"}
        AG["Create Prompt<br/>system=Design Profile/PROMPT.md<br/>user=完整 TaskSpec JSON"]
        AH["Edit Prompt<br/>system=同一 PROMPT.md<br/>user=query + TaskSpec + 上轮原始 Design Token"]
    end

    subgraph MODEL["6. 每一次真实模型调用"]
        AI["调用前按配置发送 START 指令帧<br/>A2UIModelClient.generate"]
        AJ{"enable_a2ui_model_mock？"}
        AK["按 2x2/2x4 读取 Design mock"]
        AL{"路由后端？"}
        AM["MEP 物理客户端"]
        AN["OpenAI 复合后端<br/>从配置 master 开始"]
        AO{"enable_model_failure_retry？"}
        AP["master 只调用 1 次"]
        AQ["master 最多 1+M 次<br/>指数退避+抖动<br/>每次重新排队取共享令牌"]
        AR{"master 成功返回非空源 DSL？"}
        AS{"openai 且 enable_openai_fallback？"}
        AT["fallback 最多 1+F 次<br/>同一共享并发/排队/执行超时"]
        AU{"fallback 成功返回非空源 DSL？"}
        AV["FAILED / A2UI_GENERATION_FAILED<br/>不进入转换、校验和保存"]
        AW["得到完整 Design Compact DSL"]
    end

    subgraph LIMIT["6.1 共享并发、排队和执行超时（每次物理模型调用都适用）"]
        CA["ModelExecutionRuntime<br/>第三至第五接口、Create/Edit、<br/>首次生成、重试、fallback、repair 共用"]
        CB["请求共享 asyncio.Semaphore<br/>model_max_concurrency 默认 20 / 每进程"]
        CC{"有空闲模型令牌？"}
        CD["无令牌：协程排队，不占线程<br/>heartbeat 继续；默认最多等 120 秒"]
        CE["排队超时 → MODEL_QUEUE_TIMEOUT<br/>作为本次模型异常参与重试/fallback"]
        CF["取得 1 个令牌<br/>开始一次物理 provider 调用"]
        CG["MEP/DeepSeek：异步网络，不占工作线程<br/>llmclient：专用线程池，默认最多 20 worker"]
        CH{"执行超过独立请求超时<br/>默认 120 秒？"}
        CI["MEP/DeepSeek：取消请求并抛超时<br/>随后释放模型令牌"]
        CJ["llmclient：不能强杀线程<br/>继续占令牌直到真实调用结束<br/>丢弃迟到结果后再抛超时"]
        CK["成功或异常均在 finally 释放令牌<br/>退避 sleep 不占令牌；下一次重试重新排队"]
        CL["Mock 绕过 Semaphore<br/>AnyIO 线程令牌 80 与模型令牌 20 相互独立"]
    end

    subgraph QUALITY["7. Conversion / Validation / Repair 循环"]
        AX["DesignCompactProcessor<br/>上下文校验 + 解析 + 确定性转换"]
        AY{"出现已知 conversion error？"}
        AZ["形成 stage=conversion 的结构化错误<br/>不进入 Validator"]
        BA{"转换器未知运行时异常？"}
        BA1["服务异常交给 WS FAILED<br/>不让模型掩盖"]
        BB["得到标准三段 A2UI JSONL"]
        BC{"enable_artifact_validation？"}
        BD["跳过 Validator<br/>conversion 仍是强制步骤"]
        BE["构造临时 artifact 并执行 Validator<br/>Edit 额外检查已删除数据路径残留"]
        BF{"Validator 未知运行时异常？"}
        BF1["服务异常交给 WS FAILED<br/>不进入 repair"]
        BG{"存在 error 级问题？"}
        BH["warning 只记录<br/>不触发 repair"]
        BI{"enable_validation_failure_retry<br/>且 repair 次数未达 R？"}
        BJ["组装 repair Prompt<br/>继承原 system/user<br/>携带最新源 Design Token<br/>format + stage/code/message<br/>要求只输出完整 Design Token"]
        BK["再次调用统一模型入口<br/>每轮从 master 重新开始"]
        BL{"repair 模型调用成功？"}
        BM["本轮 repair 次数 +1<br/>允许 conversion→validation 阶段变化"]
        BN["严格失败 / VALIDATION_FAILED<br/>不构造、不保存 artifact"]
    end

    subgraph SAVE["8. Artifact 与响应"]
        BO["提取最终源 Design Token"]
        BP["构造 widget-artifact-v2<br/>genui=标准 A2UI<br/>designcompactdsl=最终源 Token<br/>保存 plan/meta/source digest"]
        BQ["ArtifactStore.save<br/>本地临时文件 → OBS/mock → 摘要 → 清理"]
        BR{"保存成功？"}
        BS["ResponsePlanner<br/>无移除→success<br/>部分能力移除→degraded"]
        BT["发送 SUCCESS/FAILURE 指令帧<br/>再发送插件 final<br/>streamContent=str(legacy_message)<br/>errorCode=0 / items=[]"]
        BU["OBS/IO 异常 → WS FAILED final"]
        BV(["本条请求结束<br/>取消 heartbeat，running_tasks -1"])
        BW["heartbeat 发送失败只停止心跳<br/>内部生成、repair、保存继续执行"]
    end

