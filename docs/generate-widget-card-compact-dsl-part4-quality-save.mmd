%%{init: {"flowchart": {"curve": "basis", "nodeSpacing": 30, "rankSpacing": 42}, "theme": "neutral"}}%%
flowchart TD
    A(["第4段：最新源 Design Compact DSL"])
    B["短时 AnyIO 工作线程执行 Processor<br/>上下文校验、解析、确定性转换"]
    C{"转换器发生未知运行时异常？"}
    C1["WS FAILED 服务异常<br/>不交给模型掩盖"]
    D{"存在已知 conversion error？"}
    E["形成 stage=conversion 的质量错误<br/>保留完整最新源 Design Token<br/>不进入 Validator"]
    F["得到标准三段 A2UI JSONL"]
    G{"enable_artifact_validation？"}
    H["跳过 Validator<br/>但 conversion 仍是必经步骤"]
    I["短时 AnyIO 工作线程执行 Validator<br/>Edit 额外检查已删除数据路径残留"]
    J{"Validator 发生未知运行时异常？"}
    J1["WS FAILED 服务异常<br/>不进入 repair"]
    K{"存在 error 级质量问题？"}
    L["warning 只记录<br/>不触发 repair"]
    M["形成 stage=validation 的结构化错误"]
    N{"enable_validation_failure_retry<br/>且 repair 次数未达到 R？"}
    O["组装 repair user 消息<br/>继承原 system/user<br/>携带最新源 Token、format、stage/code/message"]
    P["要求模型只输出修复后的完整 Design Token<br/>每轮 repair 重新从 master 开始"]
    Q["进入第3段统一模型入口<br/>模型异常可独立重试/fallback"]
    R["repair 成功返回新 Token<br/>repair 次数 +1，再执行完整转换和校验"]
    S["VALIDATION_FAILED<br/>第四接口严格失败，不保存 artifact"]
    T["提取最终源 Design Token"]
    U["构造 widget-artifact-v2<br/>genui=标准 A2UI<br/>designcompactdsl=最终源 Token"]
    V["短时线程写本地临时文件<br/>上传 OBS/mock → 摘要 → finally 删除"]
    W{"Artifact 保存成功？"}
    W1["WS FAILED<br/>不伪造 artifact URL"]
    X["ResponsePlanner<br/>无能力移除→success<br/>部分能力移除→degraded"]
    Y["发送指令帧和插件 final<br/>streamContent=str(legacy_message)<br/>errorCode=0 / items=[]"]
    Z(["请求结束：取消 heartbeat<br/>running_tasks -1"])

    A --> B --> C
    C -- "是" --> C1
    C -- "否" --> D
    D -- "是" --> E --> N
    D -- "否" --> F --> G
    G -- "否" --> H --> L --> T
    G -- "是" --> I --> J
    J -- "是" --> J1
    J -- "否" --> K
    K -- "否：无问题/仅 warning" --> L
    K -- "是" --> M --> N
    N -- "是" --> O --> P --> Q --> R --> B
    N -- "否：开关关闭/次数耗尽" --> S
    T --> U --> V --> W
    W -- "否" --> W1
    W -- "是" --> X --> Y --> Z

    classDef terminal fill:#fde8e8,stroke:#b42318,color:#3b0a08;
    classDef success fill:#e8f7ee,stroke:#16803b,color:#072b16;
    classDef decision fill:#fff4d6,stroke:#b7791f,color:#3a2500;
    class C1,J1,S,W1 terminal;
    class T,U,V,X,Y,Z success;
    class C,D,G,J,K,N,W decision;
