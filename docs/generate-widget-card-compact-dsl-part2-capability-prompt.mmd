%%{init: {"flowchart": {"curve": "basis", "nodeSpacing": 32, "rankSpacing": 44}, "theme": "neutral"}}%%
flowchart TD
    A(["第2段：已归一化的 Create/Edit 请求"])
    B["按 App/ROM 二维区间选择能力目录"]
    C{"唯一命中能力区间？"}
    D["加载命中的 registryVersion"]
    E{"默认能力目录回退开启<br/>且目录有效？"}
    E1["APP_VERSION_UNSUPPORTED<br/>不调用模型"]
    F["加载默认 capability_registry_version"]
    G["加载最终 A2UI Profile"]
    H["逐个裁决 candidateDataBindings<br/>注册状态 → arguments Schema → /data 路径 → 路径冲突"]
    I["逐个裁决 candidateEvents<br/>检查 capabilityId 是否注册"]
    J["逐个裁决 candidateAssetIds<br/>检查 assetId 是否注册"]
    K["无效候选写入 removedCapabilities<br/>第四接口不再次查询 IDS"]
    L{"原请求有数据绑定，且最终<br/>无有效数据绑定也无有效事件？"}
    L1["NO_EFFECTIVE_CAPABILITY<br/>不调用模型"]
    M["构造 CardSpec<br/>只保留最终有效 dataBindings"]
    N["构造 TaskSpec<br/>query/size/event/assets<br/>outputSchema 投影到 dataModelSchema"]
    O{"Create 还是 Edit？"}
    P["Create 两条消息<br/>system=PROMPT.md<br/>user=完整 TaskSpec JSON"]
    Q["Edit 两条消息<br/>system=同一 PROMPT.md<br/>user=query + TaskSpec + 上轮原始 Design Token"]
    R["previousDesignToken 被标记为不可信待编辑数据<br/>不能覆盖 system 约束"]
    S(["进入第3段：统一模型入口与并发限流"])

    A --> B --> C
    C -- "是" --> D --> G
    C -- "否" --> E
    E -- "否" --> E1
    E -- "是" --> F --> G
    G --> H --> I --> J --> K --> L
    L -- "是" --> L1
    L -- "否" --> M --> N --> O
    O -- "Create" --> P --> S
    O -- "Edit" --> Q --> R --> S

    classDef terminal fill:#fde8e8,stroke:#b42318,color:#3b0a08;
    classDef success fill:#e8f7ee,stroke:#16803b,color:#072b16;
    classDef decision fill:#fff4d6,stroke:#b7791f,color:#3a2500;
    class E1,L1 terminal;
    class S success;
    class C,E,L,O decision;
