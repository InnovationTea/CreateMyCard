{"version":"$version","createSurface":{"surfaceId":"$surfaceId","catalogId":"$catalogId","width":"$width","height":"$height"}}
{"version":"$version","updateComponents":{"surfaceId":"$surfaceId","root":"root","components":[{"id":"root","component":"Column","children":["header","main","footer"],"itemMargin":6,"styles":{"width":"$width","height":"$height","padding":12,"borderRadius":"$borderRadius","clip":true,"backgroundColor":"#ffffff19","justifyContent":"center"}},{"id":"header","component":"Row","children":["title","badge"],"itemMargin":6,"styles":{"justifyContent":"spaceBetween","alignItems":"center"}},{"id":"title","component":"Text","content":"$title","styles":{"fontSize":14,"fontWeight":700,"maxLines":1,"textOverflow":"none","layoutWeight":1}},{"id":"badge","component":"Text","content":"$badge","styles":{"fontSize":10,"fontWeight":500,"padding":{"left":6,"right":6,"top":2,"bottom":2},"borderRadius":8,"backgroundColor":"#ffffff19","maxLines":1}},{"id":"main","component":"Row","children":["accent","summary"],"itemMargin":8,"styles":{"alignItems":"center"}},{"id":"accent","component":"Column","children":[],"styles":{"width":4,"height":40,"borderRadius":2,"backgroundColor":"#ffffff19"}},{"id":"summary","component":"Text","content":"$description","styles":{"fontSize":16,"fontWeight":700,"maxLines":2,"textOverflow":"none","layoutWeight":1}},{"id":"footer","component":"Row","children":["statusDot","footerText"],"itemMargin":4,"styles":{"alignItems":"center"}},{"id":"statusDot","component":"Column","children":[],"styles":{"width":6,"height":6,"borderRadius":3,"backgroundColor":"#ffffff19"}},{"id":"footerText","component":"Text","content":"$footerText","styles":{"fontSize":10,"fontWeight":500,"maxLines":1,"textOverflow":"none"}}]}}
{"version":"$version","updateDataModel":{"surfaceId":"$surfaceId","path":"/","value":"$dataModel"}}
