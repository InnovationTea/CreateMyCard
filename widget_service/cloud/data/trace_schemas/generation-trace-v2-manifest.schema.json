{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generation-trace-v2-manifest.schema.json",
  "title": "Generation Trace v2 Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "instrumentationVersion",
    "traceId",
    "rootSpanId",
    "uid",
    "state",
    "startedAt",
    "recordCount",
    "artifactCount"
  ],
  "properties": {
    "schemaVersion": { "const": "generation-trace-v2" },
    "instrumentationVersion": { "const": 2 },
    "traceId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "rootSpanId": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
    "uid": { "type": "string", "minLength": 1 },
    "state": { "enum": ["recording", "complete", "partial"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "recordCount": { "type": "integer", "minimum": 0 },
    "artifactCount": { "type": "integer", "minimum": 0 },
    "summary": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "enum": ["complete", "partial"] } } },
      "then": { "required": ["completedAt", "summary"] }
    }
  ]
}
