[
  {
    "id": "ViewWeather",
    "type": "data",
    "description": "查询当前天气、空气质量和未来预报",
    "descriptionForLLM": "用户需要天气、温度、空气质量、未来预报时可选择。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "districtName": { "type": "string" },
        "forecastDays": { "type": "integer", "minimum": 1, "maximum": 7 }
      },
      "additionalProperties": true
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "location": { "type": "object" },
        "current": { "type": "object" },
        "daily": { "type": "array" },
        "updatedAt": { "type": "string" }
      }
    },
    "defaultWriteResultTo": "/data/weather",
    "dataModelSkeleton": {
      "data": {
        "weather": {
          "location": {},
          "current": {},
          "daily": [],
          "updatedAt": ""
        }
      }
    },
    "dependencies": {
      "minRomVersion": "7.0.0",
      "minAppVersion": "1.0.0",
      "requiredProviders": ["UG.weather.current", "UG.weather.forecast"]
    }
  },
  {
    "id": "calendar.events.search",
    "type": "data",
    "description": "查询用户手机本地日历事件",
    "descriptionForLLM": "用户需要今日会议、日程、提醒、待办时可选择。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "timeRange": { "type": "string", "enum": ["today", "tomorrow", "week"] },
        "limit": { "type": "integer", "minimum": 1, "maximum": 10 }
      },
      "additionalProperties": true
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "items": { "type": "array" },
        "updatedAt": { "type": "string" }
      }
    },
    "defaultWriteResultTo": "/data/calendar",
    "dataModelSkeleton": {
      "data": {
        "calendar": {
          "items": [],
          "updatedAt": ""
        }
      }
    },
    "dependencies": {
      "minRomVersion": "7.0.0",
      "minAppVersion": "1.0.0",
      "requiredProviders": ["UG.calendar.events.search"],
      "requiredPermissions": ["calendar.read"]
    }
  },
  {
    "id": "system.battery.status",
    "type": "data",
    "description": "查询设备电量、省电模式和充电状态",
    "descriptionForLLM": "用户需要低电量、省电、充电状态时可选择。",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": true
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "level": { "type": "integer" },
        "charging": { "type": "boolean" },
        "powerSaveMode": { "type": "boolean" }
      }
    },
    "defaultWriteResultTo": "/data/battery",
    "dataModelSkeleton": {
      "data": {
        "battery": {
          "level": 0,
          "charging": false,
          "powerSaveMode": false,
          "updatedAt": ""
        }
      }
    },
    "dependencies": {
      "minRomVersion": "7.0.0",
      "minAppVersion": "1.0.0",
      "requiredProviders": ["UG.system.battery.status"]
    }
  },
  {
    "id": "health.sleep.summary",
    "type": "data",
    "description": "查询睡眠摘要和睡眠时长",
    "descriptionForLLM": "用户需要睡眠监督、健康睡眠摘要时可选择。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "date": { "type": "string" }
      },
      "additionalProperties": true
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "durationMinutes": { "type": "integer" },
        "quality": { "type": "string" }
      }
    },
    "defaultWriteResultTo": "/data/sleep",
    "dataModelSkeleton": {
      "data": {
        "sleep": {
          "durationMinutes": 0,
          "quality": "",
          "updatedAt": ""
        }
      }
    },
    "dependencies": {
      "minRomVersion": "7.0.0",
      "minAppVersion": "1.0.0",
      "requiredPackages": [
        {
          "packageName": "com.huawei.hmos.health.core",
          "minVersion": "16.0.0"
        }
      ],
      "requiredProviders": ["UG.health.sleep.summary"],
      "requiredPermissions": ["health.read"]
    }
  }
]
