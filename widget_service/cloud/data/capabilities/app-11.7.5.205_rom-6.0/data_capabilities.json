        "appBundleName": {
          "type": "string",
          "description": "目标应用的包名，例如：com.ss.hm.ugc.aweme"
        }
      },
      "required": [
        "appBundleName"
      ]
    },
    "outputSchema": {
      "type": "object",
      "description": "适合桌面卡片展示的应用时长概要。",
      "properties": {
        "appUsage": {
          "type": "object",
          "description": "应用具体的使用时长详情",
          "properties": {
            "appName": {
              "type": "string",
              "description": "应用名称文本，例如：“抖音”",
              "sampleValue": "示例应用"
            },
            "durationText": {
              "type": "string",
              "description": "应用今日运行总时间文本（自带单位），例如：“25 秒”或“1 分钟 21 秒”。",
              "sampleValue": "25 分钟"
            }
          }
        },
        "updatedAt": {
          "type": "string",
          "description": "端侧完成数据查询和归一化的时间，格式如：2026-07-14 10:16。",
          "sampleValue": "2026-08-06 09:00"
        }
      }
    },
    "type": "data",
    "dataModelSkeleton": {}
  },
  {
    "id": "GetEarphoneInfo",
