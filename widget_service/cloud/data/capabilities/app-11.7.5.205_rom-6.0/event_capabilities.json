    "actionTemplate": {
      "call": "clickToApi",
      "args": {
        "intentName": "CallPhone",
        "params": {
          "phoneNumber": ""
        }
      }
    },
    "dynamicArguments": [
      {
        "path": "/params/phoneNumber",
        "description": "用户提供电话号码时填写；未提供时填写空字符串。",
