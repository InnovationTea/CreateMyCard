  {
    "id": "event.open.weather",
    "type": "event",
    "description": "打开手机天气应用某城市页，uri为固定值勿更改。cityCode来自于数据能力中ViewWeather出参cityCode字段，进行动态拼接，表示跳转到指定城市天气页。",
    "actionTemplate": {
      "call": "clickToDeeplink",
      "args": {
        "intentName": "Weather_CityCode",
        "bundleName": "",
        "abilityName": "",
        "uri": "{{ 'hww://www.huawei.com/totemweather?enterType=share&cityCode=' + ${/data/weather/location/cityCode} }}"
      }
    },
    "dynamicArguments": [
      {
        "path": "/uri",
        "description": "cityCode 取自 ViewWeather 的 /location/cityCode，保留完整 URI 模板。",
        "type": "string"
      }
    ],
    "targetScene": "Weather_CityCode",
    "parametersSchema": {
      "type": "object",
      "description": "点击事件的完整 args 对象。",
      "properties": {
        "intentName": {
          "type": "string",
          "description": "固定填写 Weather_CityCode，不得改写。",
          "const": "Weather_CityCode"
        },
        "bundleName": {
          "type": "string",
          "description": "该跳转不需要包名，固定填写空字符串。",
          "const": ""
        },
        "abilityName": {
          "type": "string",
          "description": "该跳转不需要 Ability，固定填写空字符串。",
          "const": ""
        },
        "uri": {
          "type": "string",
          "description": "cityCode 取自 ViewWeather 的 /location/cityCode，保留完整 URI 模板。"
        }
      },
      "required": [
        "intentName",
        "bundleName",
        "abilityName",
        "uri"
      ],
      "additionalProperties": false
    },
    "dependencies": {
      "requiredPackages": [
        {
          "packageName": "com.huawei.hmsapp.totemweather"
        }
      ]
    },
    "targetApp": "天气"
  },
