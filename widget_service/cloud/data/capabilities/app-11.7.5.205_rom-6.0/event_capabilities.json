  {
    "id": "event.call.phone",
    "type": "event",
    "description": "点击跳转至指定号码的拨号界面",
    "actionTemplate": {
      "call": "clickToApi",
      "args": {
        "intentName": "CallPhone",
        "params": {
          "phoneNumber": ""
        }
      }
    },
    "dynamicArguments": [
      {
        "path": "/params/phoneNumber",
        "description": "填写用户提供的电话号码；未提供时填写空字符串。",
        "type": "string"
      }
    ],
    "targetScene": "CallPhone",
    "parametersSchema": {
      "type": "object",
      "description": "拨号事件的完整 args 对象。",
      "properties": {
        "intentName": {
          "type": "string",
          "description": "固定填写 CallPhone，不得改写。",
          "const": "CallPhone"
        },
        "params": {
          "type": "object",
          "description": "拨号所需参数。",
          "properties": {
            "phoneNumber": {
              "type": "string",
              "description": "填写用户提供的电话号码；未提供时填写空字符串。"
            }
          },
          "required": [
            "phoneNumber"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "intentName",
        "params"
      ],
      "additionalProperties": false
    },
    "dependencies": {
      "requiredPackages": []
    }
  },
