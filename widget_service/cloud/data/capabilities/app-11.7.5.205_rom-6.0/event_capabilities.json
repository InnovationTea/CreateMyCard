    "actionTemplate": {
      "call": "clickToDeeplink",
      "args": {
        "intentName": "EnterMeeting",
        "bundleName": "",
        "abilityName": "",
        "uri": "{{ ${/data/calendar/events/i/oneClickServiceLink} }}"
      }
    },
    "dynamicArguments": [
