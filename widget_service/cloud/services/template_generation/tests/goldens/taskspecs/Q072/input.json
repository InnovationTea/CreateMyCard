{
  "content": {
    "bundleName": "com.omega_w_0823.hmservice",
    "userQuery": "帮我做个卡片，我准备10月1号国庆回重庆老家，看离出发还有几天和重庆未来三天每天的日期、星期、天气、温度范围、下雨概率，点击查看重庆天气详情。",
    "candidateDataBindings": [
      {
        "capabilityId": "GetCountdownDays",
        "arguments": {
          "targetDate": "2026-10-01"
        },
        "writeResultTo": "/data/countdown",
        "candidateOutputFields": [
          "/countdownDays"
        ]
      },
      {
        "capabilityId": "ViewWeather",
        "arguments": {
          "prefectureName": "重庆市",
          "forecastDays": 3
        },
        "writeResultTo": "/data/weather",
        "candidateOutputFields": [
          "/daily/0/date",
          "/daily/0/weekday",
          "/daily/0/condition",
          "/daily/0/temperatureRangeText",
          "/daily/0/rainProbabilityPercent",
          "/daily/1/date",
          "/daily/1/weekday",
          "/daily/1/condition",
          "/daily/1/temperatureRangeText",
          "/daily/1/rainProbabilityPercent",
          "/daily/2/date",
          "/daily/2/weekday",
          "/daily/2/condition",
          "/daily/2/temperatureRangeText",
          "/daily/2/rainProbabilityPercent",
          "/location/cityCode"
        ]
      }
    ],
    "title": "重庆返乡",
    "size": "2x4",
    "candidateEventCandidates": [
      {
        "capabilityId": "event.open.weather",
        "action": {
          "call": "clickToDeeplink",
          "args": {
            "intentName": "Weather_CityCode",
            "bundleName": "",
            "abilityName": "",
            "uri": "{{ 'hww://www.huawei.com/totemweather?enterType=share&cityCode=' + ${/data/weather/location/cityCode} }}"
          }
        }
      }
    ],
    "description": "返乡倒计时+三日天气",
    "candidateAssetIds": [
      "asset.calendar_fill",
      "asset.icon_weather_thermometer",
      "asset.drop_1"
    ]
  },
