          "/totalNapDurationText",
          "/dailySteps"
        ]
      },
      {
        "capabilityId": "ViewWeather",
        "arguments": {
          "prefectureName": "武汉市",
          "forecastDays": 1
        },
        "writeResultTo": "/data/weather",
        "candidateOutputFields": [
          "/current/feelsLikeC",
          "/current/alertLevel",
          "/location/cityCode"
        ]
      }
    ],
    "title": "午休后散步",
    "size": "2x4",
    "candidateEventCandidates": [
      {
