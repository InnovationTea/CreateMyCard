        "writeResultTo": "/data/calendar",
        "candidateOutputFields": [
          "/eventCount",
          "/events/0/title",
          "/events/0/dtStart",
          "/events/0/isAllDay",
          "/events/0/entityId"
        ]
      }
    ],
    "title": "近日安排",
    "size": "2x4",
