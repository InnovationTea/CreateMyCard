      "assetCandidates": [
        {
          "description": "样式：默认黑色的单色实心横向电池图标，电池内部为叶片留白；适用：电池相关场景，包括电量、省电模式、节能电池、绿色用电状态，也可作为电池健康或电池温度信息的辅助图标，相关数据可结合 GetPhoneBatteryInfo 展示。图标本身不表示具体电量、健康等级或温度高低。",
          "id": "asset.battery_leaf_fill",
          "src": "resources/base/media/battery_leaf_fill.svg"
        },
        {
          "description": "样式：默认黑色的单色左右分体式开放耳机，局部通过镂空表现高光与分隔，支持通过 fillColor 与卡片配色统一；适用：无线耳机本体、耳机连接、左右耳设备状态。",
          "id": "asset.icon_earphone",
          "src": "resources/base/media/icon_earphone.svg"
        },
        {
          "description": "样式：耳机收纳盒实心图标，默认黑色，图形为无线耳机充电盒造型；适用：蓝牙耳机设备连接、音频设备管理。",
          "id": "asset.earphone_case_16644",
          "src": "resources/base/media/earphone_case_16644.svg"
        },
        {
          "description": "样式：音乐音符实心图标，默认黑色，图形为双音符连接造型；适用：音乐播放卡片、音频功能入口、歌单展示。",
          "id": "asset.music_fill",
          "src": "resources/base/media/music_fill.svg"
        }
      ],
      "dataModelSchema": {
        "data": {
          "earphone": {
            "batteryLevel": {
              "description": "耳机盒（或整体）当前剩余电量的纯整数百分比，取值范围为 0 到 100，返回值不包含“%”。若直接用于文本展示，必须在数值后追加“%”。",
              "sampleValue": 80,
              "type": "integer"
            },
            "isConnected": {
              "description": "当前是否有蓝牙耳机处于连接活跃状态。",
              "sampleValue": true,
              "type": "boolean"
            },
            "leftBatteryLevel": {
              "description": "左耳机当前剩余电量的纯整数百分比，取值范围为 0 到 100，返回值不包含“%”；未连接时为 0。若直接用于文本展示，必须在数值后追加“%”。",
              "sampleValue": 76,
              "type": "integer"
            },
            "rightBatteryLevel": {
              "description": "右耳机当前剩余电量的纯整数百分比，取值范围为 0 到 100，返回值不包含“%”；未连接时为 0。若直接用于文本展示，必须在数值后追加“%”。",
              "sampleValue": 78,
              "type": "integer"
            }
          },
          "phoneBattery": {
            "batterySOCText": {
              "description": "可直接显示的当前手机设备剩余电量文本，已包含“%”单位；展示时不得再次追加“%”。",
              "sampleValue": "68%",
              "type": "string"
            }
          }
