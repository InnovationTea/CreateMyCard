{
  "content": {
    "bundleName": "com.omega_w_0823.hmservice",
    "userQuery": "帮我做个卡片，要去黑龙江漠河拍摄，看当前天气、体感、风力、天气预警和感冒风险，再看手机剩余电量、充电状态、电池温度和充电器类型，可以查看漠河天气详情，也可以打开电池设置。",
    "candidateDataBindings": [
      {
        "capabilityId": "ViewWeather",
        "arguments": {
          "prefectureName": "漠河市",
          "forecastDays": 1
        },
        "writeResultTo": "/data/weather",
        "candidateOutputFields": [
          "/current/condition",
          "/current/feelsLikeC",
          "/current/windLevel",
          "/current/alertLevel",
          "/current/coldLevel",
          "/location/cityCode"
        ]
      },
      {
        "capabilityId": "GetPhoneBatteryInfo",
        "arguments": {},
        "writeResultTo": "/data/phoneBattery",
        "candidateOutputFields": [
          "/batterySOC",
          "/chargingStatusDesc",
          "/batteryTemperatureText",
          "/pluggedTypeDesc"
        ]
      }
    ],
    "title": "漠河拍摄",
    "size": "2x4",
    "candidateEventCandidates": [
      {
        "capabilityId": "event.open.weather",
        "action": {
          "call": "clickToDeeplink",
          "args": {
            "intentName": "Weather_CityCode",
            "bundleName": "",
            "abilityName": "",
            "uri": "{{ 'hww://www.huawei.com/totemweather?enterType=share&cityCode=' + ${/data/weather/location/cityCode} }}"
          }
        }
      },
      {
        "capabilityId": "event.open.settings.battery",
        "action": {
          "call": "clickToDeeplink",
          "args": {
            "intentName": "Settings",
            "bundleName": "com.huawei.hmos.settings",
            "abilityName": "com.huawei.hmos.settings.MainAbility",
            "uri": "battery"
          }
        }
      }
    ],
    "description": "拍摄天气风险+手机续航+双入口",
    "candidateAssetIds": [
      "asset.icon_weather_thermometer",
      "asset.icon_weather_wind",
