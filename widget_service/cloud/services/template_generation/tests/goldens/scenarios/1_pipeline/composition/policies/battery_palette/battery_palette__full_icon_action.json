{
  "a2ui": [
    {
      "createSurface": {
        "catalogId": "ohos.a2ui.extended.catalog.form",
        "surfaceId": "surface_card"
      },
      "version": "v0.9"
    },
    {
      "updateComponents": {
        "components": [
          {
            "children": [
              "template_root"
            ],
            "component": "Stack",
            "id": "root",
            "styles": {
              "alignContent": "topStart",
              "backgroundColor": "#FFF0FFE6",
              "borderRadius": 20,
              "clip": true,
              "height": "matchParent",
              "padding": 0,
              "width": "matchParent"
            }
          },
          {
            "children": [
              "__genui_render_component__root_1"
            ],
            "component": "Stack",
            "id": "template_root",
            "styles": {
              "height": "matchParent",
              "padding": 12,
              "width": "matchParent"
            }
          },
          {
            "children": [
              "root_1_0",
              "root_1_1"
            ],
            "component": "Stack",
            "id": "__genui_render_component__root_1",
            "styles": {
              "alignContent": "bottomEnd",
              "height": "matchParent",
              "width": "matchParent"
            }
          },
          {
            "children": [
              "root_1_0_0",
              "root_1_0_1",
              "root_1_0_2"
            ],
            "component": "Column",
            "id": "root_1_0",
            "itemMargin": 4,
            "styles": {
              "alignItems": "start",
              "clip": true,
              "constraintSize": {
                "minHeight": 0,
                "minWidth": 0
              },
              "height": "matchParent",
              "justifyContent": "spaceBetween",
              "width": "matchParent"
            }
          },
          {
            "component": "Text",
            "content": "设备电量",
            "id": "root_1_0_0",
            "styles": {
              "constraintSize": {
                "minHeight": 0,
                "minWidth": 0
              },
              "fontColor": "#FF52991F",
              "fontSize": 16,
              "fontWeight": 700,
              "maxLines": 1,
              "textOverflow": "ellipsis",
              "width": "matchParent"
            }
          },
          {
            "component": "Text",
            "content": "{{ '电量 ' + ${/data/phoneBattery/batterySOCText} + '，' + ${/data/phoneBattery/batteryCapacityLevelDesc} + '，' + ${/data/phoneBattery/chargingStatusDesc} }}",
            "id": "root_1_0_1",
            "styles": {
              "constraintSize": {
                "minHeight": 0,
                "minWidth": 0
              },
              "fontColor": "#9952991F",
              "fontSize": 12,
              "fontWeight": 400,
              "maxLines": 3,
              "textOverflow": "ellipsis",
              "width": "matchParent"
            }
          },
          {
            "children": [
              "root_1_0_2_0"
            ],
            "component": "Stack",
            "id": "root_1_0_2",
            "styles": {
              "alignContent": "bottomStart",
              "constraintSize": {
                "minHeight": 0,
                "minWidth": 0
              },
              "layoutWeight": 1,
              "width": "matchParent"
            }
          },
          {
            "children": [
              "root_1_0_2_0_0"
            ],
            "component": "Stack",
            "id": "root_1_0_2_0",
            "styles": {
              "alignContent": "center",
              "flexShrink": 0,
              "height": 52,
              "width": 52
            }
          },
          {
            "component": "Progress",
            "id": "root_1_0_2_0_0",
            "styles": {
              "backgroundColor": "#3364BB5C",
              "color": "#FF52991F",
              "height": 52,
              "strokeWidth": 6,
              "type": "ring",
              "width": 52
            },
            "total": 100,
            "value": "{{ ${/data/phoneBattery/batterySOC} }}"
          },
          {
            "children": [
              "root_1_1_0"
            ],
            "component": "Stack",
            "id": "root_1_1",
            "onClick": [
              {
                "args": {
                  "intentName": "SetSettingSwitch",
                  "params": {
                    "appBundleName": "com.huawei.hmos.settings",
                    "itemName": "battery_saving_mode",
                    "switchFlag": 0
                  }
                },
                "call": "clickToIntent"
              }
            ],
            "styles": {
              "alignContent": "center",
              "backgroundColor": "#3364BB5C",
              "borderRadius": 15,
              "height": 30,
              "width": 30
            }
          },
          {
            "component": "Image",
            "id": "root_1_1_0",
            "src": "resources/base/media/battery_leaf_fill.svg",
            "styles": {
              "fillColor": "#FF52991F",
              "height": 16,
              "objectFit": "contain",
              "width": 16
            }
          }
        ],
        "root": "root",
        "surfaceId": "surface_card"
      },
      "version": "v0.9"
    },
    {
      "updateDataModel": {
        "path": "/",
        "surfaceId": "surface_card",
        "value": {
          "data": {
            "phoneBattery": {
              "batteryCapacityLevelDesc": "正常电量",
              "batterySOC": 68,
              "batterySOCText": "68%",
              "chargingStatusDesc": "未充电"
            }
          }
        }
      },
      "version": "v0.9"
    }
  ],
  "templateIds": [
    "BatteryOverviewFull@1",
    "IconAction@1",
    "FullIconActionLayout@1"
  ]
}
