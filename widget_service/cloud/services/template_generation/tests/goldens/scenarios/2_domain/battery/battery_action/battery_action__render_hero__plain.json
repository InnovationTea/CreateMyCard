{
  "a2ui": [
    {
      "createSurface": {
        "catalogId": "ohos.a2ui.extended.catalog.form",
        "surfaceId": "surface_card"
      },
      "version": "v0.9"
    },
    {
      "updateComponents": {
        "components": [
          {
            "children": [
              "template_root"
