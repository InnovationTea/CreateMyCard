            "component": "Column",
            "id": "root_1_0_0",
            "itemMargin": 4,
            "styles": {
              "alignItems": "start",
              "clip": true,
              "constraintSize": {
                "minHeight": 0,
                "minWidth": 0
              },
              "height": "matchParent",
              "justifyContent": "start",
              "padding": {
                "bottom": 0,
                "left": 0,
                "right": 0,
                "top": 0
              },
              "width": "matchParent"
            }
          },
          {
            "component": "Text",
            "content": "手机电量",
            "id": "root_1_0_0_0",
            "styles": {
              "constraintSize": {
                "minHeight": 0,
                "minWidth": 0
              },
              "fontColor": "#FF52991F",
              "fontSize": 12,
              "fontWeight": 400,
              "height": 16,
              "maxLines": 1,
              "minFontSize": 10,
              "textOverflow": "ellipsis",
              "width": "matchParent"
            }
          },
          {
            "children": [
              "root_1_0_0_1_0"
            ],
            "component": "Row",
            "id": "root_1_0_0_1",
            "itemMargin": 2,
            "styles": {
              "alignItems": "center",
              "clip": true,
              "constraintSize": {
                "minHeight": 0,
                "minWidth": 0
              },
              "justifyContent": "start",
              "margin": {
                "top": 6
              },
              "width": "matchParent"
            }
          },
          {
            "component": "Text",
            "content": "{{ ${/data/phoneBattery/batterySOCText} }}",
            "id": "root_1_0_0_1_0",
            "styles": {
              "constraintSize": {
                "minHeight": 0,
                "minWidth": 0
              },
              "fontColor": "#FF52991F",
              "fontSize": 30,
              "fontWeight": 700,
              "height": 40,
              "maxLines": 1,
              "textOverflow": "ellipsis"
            }
          },
          {
            "component": "Text",
            "content": "{{ '状态：' + ${/data/phoneBattery/chargingStatusDesc} }}",
            "id": "root_1_0_0_2",
            "styles": {
              "constraintSize": {
                "minHeight": 0,
                "minWidth": 0
              },
              "fontColor": "#9952991F",
              "fontSize": 12,
              "fontWeight": 400,
              "height": 16,
              "maxLines": 1,
              "textOverflow": "ellipsis",
              "width": "matchParent"
            }
          },
          {
            "children": [
              "root_1_1_0"
            ],
            "component": "Column",
            "id": "root_1_1",
            "styles": {
              "height": 36,
              "width": "matchParent"
            }
          },
          {
            "component": "Button",
            "id": "root_1_1_0",
            "label": "电池设置",
            "onClick": [
              {
                "args": {
                  "abilityName": "com.huawei.hmos.settings.MainAbility",
                  "bundleName": "com.huawei.hmos.settings",
                  "intentName": "Settings",
                  "uri": "battery"
                },
                "call": "clickToDeeplink"
              }
            ],
            "styles": {
              "backgroundColor": "#3364BB5C",
              "borderRadius": 18,
              "fontColor": "#FF52991F",
              "fontSize": 14,
              "fontWeight": 500,
              "height": 36,
              "width": "matchParent"
            }
          }
