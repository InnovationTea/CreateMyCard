      "version": "v0.9"
    },
    {
      "updateDataModel": {
        "path": "/",
        "surfaceId": "surface_card",
        "value": {
          "data": {
            "phoneBattery": {
              "batterySOCText": "68%",
              "chargingStatusDesc": "未充电"
            }
          }
        }
      },
      "version": "v0.9"
    }
  ],
  "projectedEvents": [
    {
      "args": {
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "bundleName": "com.huawei.hmos.settings",
        "intentName": "Settings",
        "uri": "battery"
      },
      "call": "clickToDeeplink",
      "id": "event.open.settings.battery"
    }
  ],
  "templateIds": [
    "BatteryOverviewChargingProgressHero@1",
    "PillAction@1",
    "HeroActionLayout@1"
  ]
