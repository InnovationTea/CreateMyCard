              "alignContent": "topStart",
              "backgroundColor": "#FFF0FFE6",
              "borderRadius": 20,
              "clip": true,
              "height": "matchParent",
              "padding": 0,
              "width": "matchParent"
            }
          },
          {
            "children": [
              "__genui_render_component__root_1"
            ],
            "component": "Stack",
            "id": "template_root",
            "styles": {
              "height": "matchParent",
              "padding": 12,
              "width": "matchParent"
            }
          },
          {
            "children": [
              "root_1_0",
              "root_1_1"
            ],
            "component": "Column",
            "id": "__genui_render_component__root_1",
            "itemMargin": 8,
            "styles": {
              "alignItems": "center",
              "height": "matchParent",
              "justifyContent": "start",
              "width": "matchParent"
            }
          },
          {
            "children": [
              "root_1_0_0"
            ],
            "component": "Column",
            "id": "root_1_0",
            "styles": {
              "layoutWeight": 1,
              "width": "matchParent"
            }
          },
          {
            "children": [
              "root_1_0_0_0",
              "root_1_0_0_1",
              "root_1_0_0_2"
