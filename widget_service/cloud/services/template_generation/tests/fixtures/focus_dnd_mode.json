{
  "userQuery": "看看今天的日程安排，生成一个专注模式卡片，帮我把免打扰打开。\n\n本轮卡片静态内容（用作展示的外部事实）：\n今天有日程：早睡提醒，22:00-23:00",
  "size": "2x2",
  "appVersion": "11.7.8.342",
  "eventCandidates": [
    {
      "id": "event.open.settings.dndMode",
      "description": "打开系统设置中的情景模式并显示免打扰模式",
      "call": "clickToDeeplink",
      "args": {
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "bundleName": "com.huawei.hmos.settings",
        "intentName": "Settings",
        "parameters": {"specifiedModeId": "1"},
        "uri": "intelligent_scene_entry"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "calendar": {
        "eventCount": {
          "type": "integer",
          "description": "查询到的日程记录总数量。",
          "sampleValue": 1
        },
        "events": [
          {
            "title": {
              "type": "string",
              "description": "日程标题，例如“咪咕视频《西班牙 VS 奥地利》”或航“项目进展会”。",
              "sampleValue": "项目例会"
            },
            "dtStart": {
              "type": "string",
              "description": "格式化后的日程开始时间短文本，如 '03:00'，若为全天日程可能为特殊标记。",
              "sampleValue": "14:00"
            },
            "dtEnd": {
              "type": "string",
              "description": "格式化后的日程结束时间短文本，如 '05:00'。",
              "sampleValue": "15:00"
            },
            "startDate": {
              "type": "string",
              "description": "日程开始日期格式化文本，例如 '07-03'。",
              "sampleValue": "08-06"
            },
            "countdownDays": {
              "type": "integer",
              "description": "距离日程开始的自然日天数纯整数，返回值不包含“天”。0 表示今天发生或已经发生，正整数表示距离开始还有多少天；若直接用于文本展示，必须在数值后追加“天”。",
              "sampleValue": 0
            }
          }
        ]
      }
    }
  },
  "assetCandidates": [
    {
      "id": "asset.icon_focus",
      "src": "resources/base/media/icon_focus.svg",
      "description": "样式：默认黑色的单色实心月牙图标，无圆形底和睡眠字样；适用：专注模式、勿扰模式、夜间状态。"
    }
  ]
}
