{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "location",
    "current",
    "daily"
  ],
  "properties": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "districtName"
      ],
      "properties": {
        "districtName": {
          "type": "string"
        }
      }
    },
    "current": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temperatureText",
        "condition",
        "airQuality"
      ],
      "properties": {
        "temperatureText": {
          "type": "string"
        },
        "condition": {
          "type": "string"
        },
        "airQuality": {
          "type": "string"
        }
      }
    },
    "daily": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "temperatureRangeText"
        ],
        "properties": {
          "temperatureRangeText": {
            "type": "string"
          }
        }
      }
    }
  }
}
