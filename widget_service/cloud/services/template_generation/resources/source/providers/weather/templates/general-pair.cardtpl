#Template WeatherOverviewGeneralPairFull@1(data: { location: string, firstLabel: string, firstValue: string, secondLabel: string, secondValue: string, ...supportValues: string[] }, props: { conditionIcon?: asset })
Column({"_advancedComponent": "WeatherOverview", "width": "matchParent", "height": "matchParent", "itemMargin": 4, "justifyContent": "spaceBetween", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
Row({"width": "matchParent", "itemMargin": 4, "alignItems": "center", "constraintSize": {"minWidth": 0, "minHeight": 0}},
Column({"itemMargin": 0, "justifyContent": "center", "alignItems": "start", "clip": true, "layoutWeight": 1, "constraintSize": {"minWidth": 0, "minHeight": 0}},
Text(data.location, {"width": "matchParent", "height": 20, "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "textAlign": "start", "constraintSize": {"minWidth": 0, "minHeight": 0}})
),
#if props.conditionIcon
Image(props.conditionIcon, {"width": 20, "height": 20, "objectFit": "contain", "flexShrink": 0, "fillColor": $theme('supportContentColor')})
#endif
),
Row({"layoutWeight": 1, "itemMargin": 8, "alignItems": "center", "constraintSize": {"minWidth": 0, "minHeight": 0}},
Column({"itemMargin": 0, "justifyContent": "center", "alignItems": "start", "clip": true, "layoutWeight": 1, "constraintSize": {"minWidth": 0, "minHeight": 0}},
Text(data.firstLabel, {"width": "matchParent", "height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "textAlign": "start", "constraintSize": {"minWidth": 0, "minHeight": 0}}),
Text(data.firstValue, {"width": "matchParent", "height": 32, "fontSize": 24, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "textAlign": "start", "constraintSize": {"minWidth": 0, "minHeight": 0}})
),
Column({"itemMargin": 0, "justifyContent": "center", "alignItems": "start", "clip": true, "layoutWeight": 1, "constraintSize": {"minWidth": 0, "minHeight": 0}},
Text(data.secondLabel, {"width": "matchParent", "height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "textAlign": "start", "constraintSize": {"minWidth": 0, "minHeight": 0}}),
Text(data.secondValue, {"width": "matchParent", "height": 32, "fontSize": 24, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "textAlign": "start", "constraintSize": {"minWidth": 0, "minHeight": 0}})
)),
#if data.supportValues.size == 1
Text(data.supportValues[0], {"width": "matchParent", "height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "textAlign": "start", "constraintSize": {"minWidth": 0, "minHeight": 0}})
#elseif data.supportValues.size == 2
Text(`${data.supportValues[0]} | ${data.supportValues[1]}`, {"width": "matchParent", "height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "textAlign": "start", "constraintSize": {"minWidth": 0, "minHeight": 0}})
#endif
)
#End

