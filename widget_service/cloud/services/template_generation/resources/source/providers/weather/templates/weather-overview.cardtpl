        "width": "matchParent",
        "height": 12,
        "itemMargin": 0,
        "justifyContent": "spaceBetween",
        "alignItems": "center"
      },
      Text(
        data.thirdDate,
        { "width": 64, "height": 12, "fontSize": 10, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "flexShrink": 0 }
      ),
      Text(
        data.thirdWeekday,
        { "width": 40, "height": 12, "fontSize": 10, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "textAlign": "end", "maxLines": 1, "textOverflow": "ellipsis", "flexShrink": 0 }
      )
    ),
    Row(
      {
        "width": "matchParent",
        "height": 12,
        "itemMargin": 0,
        "justifyContent": "spaceBetween",
        "alignItems": "center"
      },
      Text(
        data.thirdCondition,
        { "width": 32, "height": 12, "fontSize": 10, "fontWeight": 500, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "flexShrink": 0 }
      ),
      Text(
        data.thirdRainProbability,
        { "width": 24, "height": 12, "fontSize": 10, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "flexShrink": 0 }
      ),
      Text(
        data.thirdTemperatureRange,
        { "width": 54, "height": 12, "fontSize": 10, "fontWeight": 500, "fontColor": $theme('primaryColor'), "textAlign": "end", "maxLines": 1, "textOverflow": "ellipsis", "flexShrink": 0 }
      )
    )
  )
)
#End

#Template WeatherOverviewDestinationDayFull@1(props: { location?: string, targetDate?: string })
data = {
    temperatureRange: $path("/daily/3/temperatureRangeText"),
    rainProbability: $path("/daily/3/rainProbabilityPercent"),
    airQuality: $path("/daily/3/airQuality")
}

Column(
  {
    "_advancedComponent": "WeatherOverview",
    "width": "matchParent",
    "height": "matchParent",
    "itemMargin": 11,
    "justifyContent": "start",
    "alignItems": "start",
    "clip": true,
    "constraintSize": { "minWidth": 0, "minHeight": 0 }
  },
  Column(
    {
      "width": "matchParent",
      "height": 37,
      "itemMargin": 2,
      "justifyContent": "start",
      "alignItems": "start",
      "clip": true,
      "constraintSize": { "minWidth": 0, "minHeight": 0 }
    },
    #if props.location
      Row(
        {
          "width": "matchParent",
          "height": 19,
          "itemMargin": 0,
          "justifyContent": "start",
          "alignItems": "center",
          "clip": true,
          "constraintSize": { "minWidth": 0, "minHeight": 0 }
        },
        Text(props.location, { "fontSize": 14, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1, "flexShrink": 0 }),
        Text("天气", { "width": "matchParent", "fontSize": 14, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": { "minWidth": 0, "minHeight": 0 } })
      )
    #else
      Text(
        "目的地天气",
        { "width": "matchParent", "height": 19, "fontSize": 14, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": { "minWidth": 0, "minHeight": 0 } }
      )
    #endif
    #if props.targetDate
      Text(
        props.targetDate,
        { "width": "matchParent", "height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": { "minWidth": 0, "minHeight": 0 } }
      )
    #else
      Text(
        "出发当天",
        { "width": "matchParent", "height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": { "minWidth": 0, "minHeight": 0 } }
      )
    #endif
  ),
  Column(
    {
      "width": "matchParent",
      "layoutWeight": 1,
      "justifyContent": "spaceBetween",
      "alignItems": "start",
      "clip": true,
      "constraintSize": { "minWidth": 0, "minHeight": 0 }
    },
    Row(
      { "width": "matchParent", "height": 16, "justifyContent": "spaceBetween", "alignItems": "center" },
      Text("温度", { "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1 }),
      Text(data.temperatureRange, { "width": "matchParent", "layoutWeight": 1, "fontSize": 12, "minFontSize": 10, "fontWeight": 500, "fontColor": $theme('primaryColor'), "textAlign": "right", "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": { "minWidth": 0, "minHeight": 0 } })
    ),
    Row(
      { "width": "matchParent", "height": 16, "justifyContent": "spaceBetween", "alignItems": "center" },
      Text("降雨", { "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1 }),
      Text(data.rainProbability, { "fontSize": 12, "fontWeight": 500, "fontColor": $theme('primaryColor'), "maxLines": 1 })
    ),
    Row(
      { "width": "matchParent", "height": 16, "justifyContent": "spaceBetween", "alignItems": "center" },
      Text("空气质量", { "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1 }),
      Text(data.airQuality, { "fontSize": 12, "fontWeight": 500, "fontColor": $theme('primaryColor'), "maxLines": 1 })
    )
  )
)
#End
