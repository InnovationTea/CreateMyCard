#Template WeatherOverviewCompact@1(props: {})
data = {
    city: $path("/location/districtName"),
    temperature: $path("/current/temperatureText"),
    condition: $path("/current/condition"),
    coldLevel: $path("/current/coldLevel")
}

Column(
  "compact",
  {
    "_advancedComponent": "WeatherOverview",
    "width": "matchParent",
    "height": "matchParent",
    "itemMargin": 4,
    "justifyContent": "center",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
  Row(
      "between",
      {
        "width": "matchParent",
        "itemMargin": 4,
        "justifyContent": "start",
        "alignItems": "bottom",
        "clip": true,
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      },
      Text(
            data.city,
            "compact-title",
            {
              "fontSize": 14,
              "fontWeight": 700,
              "maxLines": 1,
              "textOverflow": "ellipsis",
              "constraintSize": {"minWidth": 0, "minHeight": 0}
            }
          ),
      Text(
            data.temperature,
            "title",
            {"fontSize": 20, "fontWeight": 800, "maxLines": 1, "flexShrink": 0}
          )
    ),
  Text(
      `${data.condition}｜感冒风险${data.coldLevel}`,
      "subtitle",
      {
        "width": "matchParent",
        "fontSize": 12,
        "fontWeight": 400,
        "maxLines": 1,
        "textOverflow": "ellipsis",
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      }
    )
)
#End

#Template WeatherOverviewIconCompact@1(props: { conditionIcon: asset })
data = {
    city: $path("/location/districtName"),
    temperature: $path("/current/temperatureText"),
    condition: $path("/current/condition"),
    coldLevel: $path("/current/coldLevel")
}

Column(
  "compact",
  {
    "_advancedComponent": "WeatherOverview",
    "width": "matchParent",
    "height": "matchParent",
    "itemMargin": 4,
    "justifyContent": "center",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
  Row(
      "between",
      {
        "width": "matchParent",
        "height": 20,
        "itemMargin": 4,
        "justifyContent": "spaceBetween",
        "alignItems": "center",
        "clip": true,
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      },
      Text(
            data.city,
            "compact-title",
            {
              "fontSize": 14,
              "fontWeight": 700,
              "maxLines": 1,
              "textOverflow": "ellipsis",
              "constraintSize": {"minWidth": 0, "minHeight": 0}
            }
          ),
      Image(
            props.conditionIcon,
            "icon",
            {
              "width": 20,
              "height": 20,
              "objectFit": "contain",
              "flexShrink": 0,
              "_preserveOriginalColor": true
            }
          )
    ),
  Row(
      "between",
      {
        "width": "matchParent",
        "itemMargin": 4,
        "justifyContent": "spaceBetween",
        "alignItems": "bottom",
        "clip": true,
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      },
      Text(
            data.temperature,
            "title",
            {"fontSize": 20, "fontWeight": 800, "maxLines": 1, "flexShrink": 0}
          ),
      Text(
            `${data.condition}｜${data.coldLevel}`,
            "subtitle",
            {
              "fontSize": 12,
              "fontWeight": 400,
              "maxLines": 1,
              "textOverflow": "ellipsis",
              "constraintSize": {"minWidth": 0, "minHeight": 0}
            }
          )
    )
)
#End

