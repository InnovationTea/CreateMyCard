#Template WeatherOverviewCompact@1(props: { conditionIcon?: asset })
data = {
    city: $path("/location/districtName"),
    temperature: $path("/current/temperatureText"),
    condition: $path("/current/condition"),
    coldLevel: $path("/current/coldLevel")
}

Column(
  {
    "_advancedComponent": "WeatherOverview",
    "width": "matchParent",
    "height": "matchParent",
    "itemMargin": 4,
    "justifyContent": "start",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
  Row({
      "width": "matchParent",
      "height": 24,
      "itemMargin": 0,
      "alignItems": "center",
      "justifyContent": "spaceBetween",
  },
    Row(
      {
        "height": 24,
        "itemMargin": 4,
        "justifyContent": "start",
        "alignItems": "center",
        "clip": true,
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      },
      Text(
            data.city,
            {
              "fontSize": 16,
              "fontWeight": 700, "fontColor": $theme('primaryColor'),
              "maxLines": 1,
              "textOverflow": "ellipsis",
              "constraintSize": {"minWidth": 0, "minHeight": 0}
            }
          ),
      Text(
            data.temperature,
            {"fontSize": 16, "fontWeight": 800, "fontColor": $theme('primaryColor'), "maxLines": 1, "flexShrink": 0}
          )
    ),
    IfPresent(
      props.conditionIcon,
      Image(
        props.conditionIcon,
        {
          "width": 20,
          "height": 20,
          "objectFit": "contain",
          "flexShrink": 0,
          "_preserveOriginalColor": true
        }
      )
    )
  ),
  Text(
      `${data.condition}｜感冒风险${data.coldLevel}`,
      {
        "width": "matchParent",
        "height": 16,
        "fontSize": 12,
        "fontWeight": 400, "fontColor": $theme('supportContentColor'),
        "maxLines": 1,
        "textOverflow": "ellipsis",
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      }
    )
)
#End

#Template WeatherOverviewTemperatureIconCompact@1(props: { conditionIcon: asset })
data = {
    condition: $path("/current/condition"),
    districtName: $optionalPath("/location/districtName"),
    temperature: $path("/current/temperatureText")
}

Row(
  {
    "_advancedComponent": "WeatherOverview",
    "width": "matchParent",
    "height": 64,
    "backgroundColor": $theme('actionStyle.backgroundColor'),
    "borderRadius": 16,
    "padding": {"left": 12, "top": 0, "right": 22, "bottom": 0},
    "justifyContent": "spaceBetween",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
  Column(
      {
        "width": 84,
        "margin": {"left": 0, "top": 12, "right": 0, "bottom": 0},
        "itemMargin": 2,
        "justifyContent": "start",
        "alignItems": "start",
        "clip": true,
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      },
      Text(
            data.temperature,
            {"fontSize": 14, "fontWeight": 800, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
          ),
      Row(
          {
            "width": "matchParent",
            "itemMargin": 0,
            "justifyContent": "start",
            "alignItems": "center",
            "clip": true,
            "constraintSize": {"minWidth": 0, "minHeight": 0}
          },
          Text(
                data.condition,
                {"fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
              ),
          IfPresent(
                data.districtName,
                Text(
                      ` | ${data.districtName}`,
                      {"fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
                    )
              )
          )
    ),
  Image(
      props.conditionIcon,
      {
        "width": 20,
        "height": 20,
        "margin": {"left": 0, "top": 22, "right": 0, "bottom": 22},
        "objectFit": "contain",
        "fillColor": $theme('primaryColor'),
        "flexShrink": 0,
        "_preserveOriginalColor": true
      }
    )
)
#End

#Template WeatherOverviewTemperatureUvCompact@1(props: {})
data = {
    condition: $path("/current/condition"),
    districtName: $optionalPath("/location/districtName"),
    cityCode: $optionalPath("/location/cityCode"),
    temperature: $path("/current/temperatureText"),
    uvIndex: $path("/current/uvIndex")
}

Column(
  {
    "_advancedComponent": "WeatherOverview",
    "width": "matchParent",
    "height": 64,
    "backgroundColor": $theme('actionStyle.backgroundColor'),
    "borderRadius": 16,
    "padding": {"left": 12, "top": 0, "right": 12, "bottom": 0},
    "justifyContent": "center",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
  Text(
        data.temperature,
        {"fontSize": 19, "fontWeight": 800, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
      ),
  Row(
      {
        "width": "matchParent",
        "itemMargin": 0,
        "justifyContent": "start",
        "alignItems": "center",
        "clip": true,
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      },
      Text(
            data.condition,
            {"fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
          ),
      IfPresent(
            data.districtName,
            Text(
                  ` | ${data.districtName}`,
                  {"fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
                )
          ),
      IfPresent(
            data.cityCode,
            Text(
                  data.cityCode,
                  {"width": 0, "height": 0, "fontSize": 1, "fontColor": "#00FFFFFF", "maxLines": 1, "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}}
                )
          ),
      Text(
            data.uvIndex,
            {"width": 0, "height": 0, "fontSize": 1, "fontColor": "#00FFFFFF", "maxLines": 1, "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}}
          )
      )
)
#End

