      "width": "matchParent",
      "height": "matchParent",
      "layoutWeight": 2,
      "itemMargin": 4,
      "justifyContent": "center",
      "alignItems": "start",
      "constraintSize": {"minWidth": 0, "minHeight": 0}
    },
    Text(
      #Expr(data.city ? data.city : (data.district ? data.district : (props.location ? props.location : "当前城市"))),
      {"fontSize": 14, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis"}
