#Template WeatherOverviewDailyDateFull@1(props: { conditionIcon?: asset })
data = {
    district: $optionalPath("/location/districtName"),
    date: $path("/daily/1/date"),
    weekday: $path("/daily/1/weekday"),
    condition: $path("/daily/1/condition")
}

Column(
  {
    "_advancedComponent": "WeatherOverview",
    "width": "matchParent",
    "height": "matchParent",
    "itemMargin": 8,
    "justifyContent": "spaceBetween",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
  Row(
    {"width": "matchParent", "height": 20, "justifyContent": "spaceBetween", "alignItems": "top"},
    Text(#Expr(data.district ? data.district : "明日天气"), {"width": "matchParent", "fontSize": 14, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}),
    #if props.conditionIcon
      Image(props.conditionIcon, {"width": 20, "height": 20, "objectFit": "contain", "fillColor": $theme('supportContentColor'), "flexShrink": 0})
    #endif
  ),
  Column(
    {"width": "matchParent", "height": 48, "itemMargin": 3, "justifyContent": "end", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
    Text(data.condition, {"width": "matchParent", "fontSize": 20, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis"}),
    Text(`${data.weekday} ${data.date}`, {"width": "matchParent", "fontSize": 14, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis"})
  )
)
#End

#Template WeatherOverviewDailyRainFull@1(props: { rainIcon?: asset })
data = {
    rainProbability: $path("/daily/1/rainProbabilityPercent"),
    temperatureRange: $path("/daily/1/temperatureRangeText")
}

Column(
  {
    "_advancedComponent": "WeatherOverview",
    "width": "matchParent",
    "height": "matchParent",
    "itemMargin": 6,
    "justifyContent": "start",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
  Row(
    {"width": "matchParent", "height": 20, "justifyContent": "spaceBetween", "alignItems": "top"},
    Text(
      "明日降雨",
      {"width": "matchParent", "fontSize": 14, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    ),
    #if props.rainIcon
      Image(props.rainIcon, {"width": 20, "height": 20, "objectFit": "contain", "fillColor": $theme('supportContentColor'), "flexShrink": 0})
    #endif
  ),
  Column(
    {"width": "matchParent", "height": 60, "layoutWeight": 1, "itemMargin": 3, "justifyContent": "start", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
    Text(data.rainProbability, {"width": "matchParent", "fontSize": 28, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis"}),
    Text("空气湿度", {"width": "matchParent", "fontSize": 14, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1})
  ),
  Column(
    {"width": "matchParent", "height": 40, "layoutWeight": 1, "itemMargin": 3, "justifyContent": "end", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
    Text(
    "温度范围", {"fontSize": 14, "minFontSize": 10, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "textAlign": "left", "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}),
    Text(data.temperatureRange, {"fontSize": 14, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1})
  ),

)
#End

#Template WeatherOverviewDailyCompareFull@1(props: { })
data = {
    todayCondition: $path("/daily/0/condition"),
    todayAirQuality: $path("/daily/0/airQuality"),
    tomorrowCondition: $path("/daily/1/condition"),
    tomorrowAirQuality: $path("/daily/1/airQuality")
}

Column(
  {
    "_advancedComponent": "WeatherOverview",
    "width": "matchParent",
    "height": "matchParent",
    "itemMargin": 6,
    "justifyContent": "spaceBetween",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
  Row(
    {"width": "matchParent", "height": 14, "justifyContent": "spaceBetween", "alignItems": "top"},
    Text("两日天气", {"width": "matchParent", "fontSize": 14, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "textAlign": "left", "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}})
  ),
  Stack(
    {"width": "matchParent", "height": 50, "padding": {"left": 10, "right": 10, "top": 6, "bottom": 6}, "borderRadius": 12, "backgroundColor": $theme('supportContentStyle.backgroundColor'), "alignContent": "center", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
    Column(
      {"width": "matchParent", "height": "matchParent", "itemMargin": 3, "justifyContent": "center", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
      Row(
        {"width": "matchParent", "justifyContent": "spaceBetween", "alignItems": "start"},
        Text(data.todayCondition, {"width": "matchParent", "layoutWeight": 1, "fontSize": 14, "fontWeight": 700, "fontColor": $theme('primaryColor'), "textAlign": "left", "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}),
        Text("今天", {"fontSize": 10, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1, "flexShrink": 0})
      ),
      Text(`空气质量 ${data.todayAirQuality}`, {"width": "matchParent", "fontSize": 10, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "textAlign": "left", "maxLines": 1, "textOverflow": "ellipsis"})
    )
  ),
  Stack(
    {"width": "matchParent", "height": 50, "padding": {"left": 10, "right": 10, "top": 6, "bottom": 6}, "borderRadius": 12, "backgroundColor": $theme('supportContentStyle.backgroundColor'), "alignContent": "center", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
    Column(
      {"width": "matchParent", "height": "matchParent", "itemMargin": 3, "justifyContent": "center", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
      Row(
        {"width": "matchParent", "itemMargin": 1, "justifyContent": "spaceBetween", "alignItems": "start"},
        Text(data.tomorrowCondition, {"width": "matchParent", "layoutWeight": 1, "fontSize": 14, "fontWeight": 700, "fontColor": $theme('primaryColor'), "textAlign": "left", "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}),
        Text("明天", {"fontSize": 10, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1, "flexShrink": 0})
      ),
      Text(`空气质量 ${data.tomorrowAirQuality}`, {"width": "matchParent", "fontSize": 10, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "textAlign": "left", "maxLines": 1, "textOverflow": "ellipsis"})
    )
  )
)
#End

