  )
)

#End

#Template WeatherOverviewAirQualityHero@1(props: { location?: string })
data = {
    condition: $path("/current/condition"),
    airQuality: $path("/current/airQuality"),
    city: $optionalPath("/location/prefectureName"),
    district: $optionalPath("/location/districtName"),
    coldLevel: $optionalPath("/current/coldLevel")
}

Column(
  {
    "_advancedComponent": "WeatherOverview",
    "width": "matchParent",
    "height": "matchParent",
    "itemMargin": 2,
    "justifyContent": "start",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
  Row(
    {
      "width": "matchParent",
      "height": 20,
      "itemMargin": 0,
      "justifyContent": "start",
      "alignItems": "top",
    },
    Text(
      #Expr(data.city ? data.city : (data.district ? data.district : (props.location ? props.location : "当前城市"))),
      {
        "fontSize": 12,
        "fontWeight": 400, "fontColor": $theme('supportContentColor'),
        "maxLines": 1,
        "textOverflow": "ellipsis",
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      }
    ),
    Text(
      "空气质量",
      {
        "fontSize": 12,
        "fontWeight": 400, "fontColor": $theme('supportContentColor'),
        "maxLines": 1,
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      }
    ),
  ),
  Column(
    {
      "width": "matchParent",
      "itemMargin": 2,
      "justifyContent": "start",
      "alignItems": "start",
      "clip": true,
      "constraintSize": {"minWidth": 0, "minHeight": 0}
    },
    Text(
      data.airQuality,
      {
        "width": "matchParent",
        "fontSize": 30,
        "fontWeight": 700, "fontColor": $theme('primaryColor'),
        "maxLines": 1
      }
    ),
    #if data.coldLevel
      Text(
        `${data.condition}｜感冒风险${data.coldLevel}`,
        {
          "width": "matchParent",
          "fontSize": 12,
          "fontWeight": 400, "fontColor": $theme('supportContentColor'),
          "maxLines": 1,
          "textOverflow": "ellipsis",
          "constraintSize": { "minWidth": 0, "minHeight": 0 }
        }
      )
    #else
      Text(
        `${data.condition}`,
        {
          "width": "matchParent",
          "fontSize": 12,
          "fontWeight": 400, "fontColor": $theme('supportContentColor'),
          "maxLines": 1,
          "textOverflow": "ellipsis",
          "constraintSize": { "minWidth": 0, "minHeight": 0 }
        }
      )
    #endif
  ),
)

#End
