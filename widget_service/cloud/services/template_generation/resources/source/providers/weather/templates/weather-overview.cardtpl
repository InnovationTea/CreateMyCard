#Template WeatherOverviewCompact@1(props: { conditionIcon?: asset })
data = {
    city: $path("/location/districtName"),
    temperature: $path("/current/temperatureText"),
    condition: $path("/current/condition"),
    coldLevel: $path("/current/coldLevel")
}

Column(
  {
    "_advancedComponent": "WeatherOverview",
    "width": "matchParent",
    "height": "matchParent",
    "itemMargin": 4,
    "justifyContent": "start",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
  Row({
      "width": "matchParent",
      "height": 24,
      "itemMargin": 0,
      "alignItems": "center",
      "justifyContent": "spaceBetween",
  },
    Row(
      {
        "height": 24,
        "itemMargin": 4,
        "justifyContent": "start",
        "alignItems": "center",
        "clip": true,
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      },
      Text(
            data.city,
            {
              "fontSize": 16,
              "fontWeight": 700, "fontColor": $theme('primaryColor'),
              "maxLines": 1,
              "textOverflow": "ellipsis",
              "constraintSize": {"minWidth": 0, "minHeight": 0}
            }
          ),
      Text(
            data.temperature,
            {"fontSize": 16, "fontWeight": 800, "fontColor": $theme('primaryColor'), "maxLines": 1, "flexShrink": 0}
          )
    ),
    IfPresent(
      props.conditionIcon,
      Image(
        props.conditionIcon,
        {
          "width": 20,
          "height": 20,
          "objectFit": "contain",
          "flexShrink": 0,
          "_preserveOriginalColor": true
        }
      )
    )
  ),
  Text(
      `${data.condition}｜感冒风险${data.coldLevel}`,
      {
        "width": "matchParent",
        "height": 16,
        "fontSize": 12,
        "fontWeight": 400, "fontColor": $theme('supportContentColor'),
        "maxLines": 1,
        "textOverflow": "ellipsis",
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      }
    )
)
#End

