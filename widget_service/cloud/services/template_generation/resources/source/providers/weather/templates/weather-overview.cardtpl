#Template WeatherOverviewTemperatureSupport@1(props: { location?: string, conditionIcon?: asset, actionId?: string })
data = {
    condition: $path("/current/condition"),
    city: $optionalPath("/location/prefectureName"),
    district: $optionalPath("/location/districtName"),
    temperatureText: $optionalPath("/current/temperatureText"),
    temperatureC: $optionalPath("/current/temperatureC"),
    feelsLikeC: $optionalPath("/current/feelsLikeC"),
}

Row(
  {
    "_advancedComponent": "WeatherOverviewTemperatureSupport",
    "width": "matchParent",
    "padding": { "left": 8, "top": 0, "right": 8, "bottom": 0 },
    "justifyContent": "spaceBetween",
    "alignItems": "center",
    "clip": true,
    "constraintSize": { "minWidth": 0, "minHeight": 0 },
    "onClick": EventAction(props?.actionId)
  },
  Column(
    {
      "itemMargin": 2,
