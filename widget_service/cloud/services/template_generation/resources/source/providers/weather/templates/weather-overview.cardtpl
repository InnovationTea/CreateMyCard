    #if data.feelsLike
      Row(
        {"width": "matchParent", "itemMargin": 2, "justifyContent": "end", "alignItems": "center"},
        Text(
          "体感",
          {"fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1}
        ),
        Text(
          data.feelsLike,
          {"fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1}
        ),
        Text(
          "℃",
          {"fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1}
        )
      )
    #endif
    #if data.rainProbability
      Text(
        `降雨 ${data.rainProbability}`,
        {"fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "textAlign": "end"}
      )
    #endif
  )
)
#End

