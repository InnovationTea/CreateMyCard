#Template WeatherOverviewConditionFull@1(props: { conditionIcon?: asset })
data = {
    city: $path("/location/districtName"),
    temperature: $path("/current/temperatureText"),
    condition: $path("/current/condition"),
    airQuality: $path("/current/airQuality"),
    coldLevel: $path("/current/coldLevel")
}

Column(
  "compact",
  {
    "_advancedComponent": "WeatherOverview",
    "width": "matchParent",
    "height": "matchParent",
    "itemMargin": 4,
    "justifyContent": "center",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
  Row(
      "between",
      {
        "width": "matchParent",
        "height": 20,
        "itemMargin": 4,
        "justifyContent": "spaceBetween",
        "alignItems": "center",
        "clip": true,
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      },
      Text(
            data.city,
            "compact-title",
            {
              "fontSize": 12,
              "fontWeight": 400,
              "maxLines": 1,
              "textOverflow": "ellipsis",
              "constraintSize": {"minWidth": 0, "minHeight": 0}
            }
          ),
      IfPresent(
            props.conditionIcon,
            Image(
                    props.conditionIcon,
                    "icon",
                    {
                      "width": 20,
                      "height": 20,
                      "objectFit": "contain",
                      "flexShrink": 0,
                      "_preserveOriginalColor": true
                    }
                  )
          )
    ),
  Text(
      data.condition,
      "title",
      {
        "width": "matchParent",
        "fontSize": 32,
        "minFontSize": 20,
        "fontWeight": 800,
        "maxLines": 1
      }
    ),
  Text(
      `${data.temperature}｜空气${data.airQuality}`,
      "body",
      {
        "width": "matchParent",
        "fontSize": 12,
        "fontWeight": 500,
        "maxLines": 1,
        "textOverflow": "ellipsis",
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      }
    ),
  Text(
      `感冒风险 ${data.coldLevel}`,
      "subtitle",
      {"width": "matchParent", "fontSize": 12, "fontWeight": 400, "maxLines": 1}
    )
)
#End

#Template WeatherOverviewHumidityFull@1(props: {})
data = {
    city: $path("/location/districtName"),
    temperature: $path("/current/temperatureText"),
    condition: $path("/current/condition"),
    humidity: $path("/current/humidityPercent"),
    airQuality: $path("/current/airQuality"),
    coldLevel: $path("/current/coldLevel")
}

Column(
  "compact",
  {
    "_advancedComponent": "WeatherOverview",
    "width": "matchParent",
    "height": "matchParent",
    "itemMargin": 4,
    "justifyContent": "center",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
  Text(
      `${data.city}湿度`,
      "compact-title",
      {
        "width": "matchParent",
        "fontSize": 12,
        "fontWeight": 400,
        "maxLines": 1,
        "textOverflow": "ellipsis",
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      }
    ),
  Text(
      Expr(`'' + ${data.humidity} + '%'`),
      "title",
      {"fontSize": 40, "fontWeight": 800, "maxLines": 1}
    ),
  Text(
      `${data.condition}｜${data.temperature}`,
      "body",
      {
        "width": "matchParent",
        "fontSize": 12,
        "fontWeight": 500,
        "maxLines": 1,
        "textOverflow": "ellipsis",
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      }
    ),
  Text(
      `空气${data.airQuality}｜感冒风险${data.coldLevel}`,
      "subtitle",
      {
        "width": "matchParent",
        "fontSize": 10,
        "fontWeight": 400,
        "maxLines": 1,
        "textOverflow": "ellipsis",
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      }
    )
)
#End

