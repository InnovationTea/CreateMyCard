#Template WeatherOverviewHeroTitle@1(props: { location?: string })
data = {
    city: $optionalPath("/location/prefectureName"),
    district: $optionalPath("/location/districtName"),
    temperature: $optionalPath("/current/temperatureText"),
    condition: $optionalPath("/current/condition"),
}

Row(
  {
    "_advancedComponent": "WeatherOverview",
    "width": "matchParent",
    "height": 18,
    "itemMargin": 4,
    "justifyContent": "start",
    "alignItems": "top",
    "clip": true,
    "constraintSize": { "minWidth": 0, "minHeight": 0 }
  },
  Text(
    #Expr(data.city ? data.city : (data.district ? data.district : (props.location ? props.location : "当前城市"))),
    {
      "fontSize": 12,
      "fontWeight": 700, "fontColor": $theme('supportContentColor'),
      "maxLines": 1,
      "textOverflow": "ellipsis",
      "constraintSize": { "minWidth": 0, "minHeight": 0 }
    }
  ),
  #if data.condition && data.temperature
    Text(
      `${data.condition} | ${data.temperature}`,
      { "fontSize": 12, "fontWeight": 700, "fontColor": $theme('supportContentColor'), "maxLines": 1, "flexShrink": 0 }
    )
  #elseif data.condition
    Text(
      data.condition,
      { "fontSize": 12, "fontWeight": 700, "fontColor": $theme('supportContentColor'), "maxLines": 1, "flexShrink": 0 }
    )
  #elseif data.temperature
    Text(
      data.temperature,
      { "fontSize": 12, "fontWeight": 700, "fontColor": $theme('supportContentColor'), "maxLines": 1, "flexShrink": 0 }
    )
  #endif
)
#End

#Template WeatherOverviewDaily2TravelSupport@1(props: { conditionIcon?: asset, actionId?: string })
data = {
    condition: $path("/daily/2/condition"),
    temperatureRange: $path("/daily/2/temperatureRangeText")
}

Column(
  {
    "_advancedComponent": "WeatherOverview",
    "width": "matchParent",
    "padding": { "left": 8, "right": 8 },
    "justifyContent": "start",
    "alignItems": "center",
    "clip": true,
    "borderRadius": 12,
    "constraintSize": { "minWidth": 0, "minHeight": 0 },
    "onClick": EventAction(props?.actionId)
  },
  Row(
    {
      "width": "matchParent",
      "justifyContent": "spaceBetween",
      "alignItems": "center",
      "clip": true,
      "constraintSize": { "minWidth": 0, "minHeight": 0 }
    },
    Column(
      {
        "itemMargin": 4,
        "justifyContent": "center",
        "alignItems": "start",
        "clip": true,
        "constraintSize": { "minWidth": 0, "minHeight": 0 }
      },
      Text(
        data.condition,
        {
          "fontSize": 14,
          "fontWeight": 700,
          "fontColor": $theme('primaryColor'),
          "maxLines": 1,
          "textOverflow": "ellipsis"
        }
      ),
      Text(
        data.temperatureRange,
        {
          "fontSize": 10,
          "fontWeight": 400,
          "fontColor": $theme('supportContentColor'),
          "maxLines": 1,
          "textOverflow": "ellipsis"
        }
      )
    ),
    #if props.conditionIcon
      Image(
        props.conditionIcon,
        {
          "width": 24,
          "height": 24,
          "objectFit": "contain",
          "flexShrink": 0,
          "fillColor": $theme('supportContentColor')
        }
      )
    #endif
  )
)
#End

#Template WeatherOverviewTravelSupport@1(props: { conditionIcon?: asset, actionId?: string })
data = {
    daily4Condition: $optionalPath("/daily/4/condition"),
    daily4TemperatureRange: $optionalPath("/daily/4/temperatureRangeText"),
    daily4RainProbability: $optionalPath("/daily/4/rainProbabilityPercent"),
    currentTemperature: $optionalPath("/current/temperatureC"),
    currentCondition: $optionalPath("/current/condition")
}

Column(
  {
    "_advancedComponent": "WeatherOverview",
    "width": "matchParent",
    "height": "matchParent",
    "padding": { "left": 8, "right": 8 },
    "itemMargin": 3,
    "justifyContent": "center",
    "alignItems": "start",
    "clip": true,
    "constraintSize": { "minWidth": 0, "minHeight": 0 },
    "onClick": EventAction(props?.actionId)
  },
  Row(
    {
      "width": "matchParent",
      "justifyContent": "spaceBetween",
      "alignItems": "center",
      "clip": true,
      "constraintSize": { "minWidth": 0, "minHeight": 0 }
    },
    #if data.daily4TemperatureRange
      Column(
        {
          "itemMargin": 3,
          "justifyContent": "center",
          "alignItems": "start",
          "clip": true,
          "constraintSize": { "minWidth": 0, "minHeight": 0 }
        },
        Text(
          data.daily4TemperatureRange,
          {
            "fontSize": 14,
            "fontWeight": 700,
            "fontColor": $theme('primaryColor'),
            "maxLines": 1,
            "textOverflow": "ellipsis"
          }
        ),
        Row(
          {
            "itemMargin": 0,
            "justifyContent": "start",
            "alignItems": "center",
            "clip": true,
            "constraintSize": { "minWidth": 0, "minHeight": 0 }
          },
          #if data.daily4Condition
            Text(
              data.daily4Condition,
              {
                "fontSize": 10,
                "fontWeight": 400,
                "fontColor": $theme('supportContentColor'),
                "maxLines": 1,
                "textOverflow": "ellipsis",
                "constraintSize": { "minWidth": 0, "minHeight": 0 }
              }
            ),
          #endif
          #if data.daily4RainProbability && data.daily4Condition
            Text(
              ' | ',
              {
                "fontSize": 10,
                "fontWeight": 400,
                "fontColor": $theme('supportContentColor'),
                "maxLines": 1,
                "textOverflow": "ellipsis",
                "constraintSize": { "minWidth": 0, "minHeight": 0 }
              }
            ),
            #endif
            #if data.daily4RainProbability
            Text(
              Expr("降雨概率 " + data.daily4RainProbability),
              {
                "fontSize": 10,
                "fontWeight": 400,
                "fontColor": $theme('supportContentColor'),
                "maxLines": 1,
                "textOverflow": "ellipsis",
                "constraintSize": { "minWidth": 0, "minHeight": 0 }
              }
            )
          #endif
        )
      )
    #elseif data.currentTemperature && data.currentCondition
      Column(
        {
          "itemMargin": 3,
          "justifyContent": "center",
          "alignItems": "start",
          "clip": true,
          "constraintSize": { "minWidth": 0, "minHeight": 0 }
        },
        Text(
          data.currentCondition,
          {
            "fontSize": 14,
            "fontWeight": 700,
            "fontColor": $theme('primaryColor'),
            "maxLines": 1,
            "textOverflow": "ellipsis"
          }
        ),
        Row(
          {
            "itemMargin": 1,
            "justifyContent": "start",
            "alignItems": "end",
            "clip": true,
            "constraintSize": { "minWidth": 0, "minHeight": 0 }
          },
          Text(
            data.currentTemperature,
            {
              "fontSize": 10,
              "fontWeight": 400,
              "fontColor": $theme('supportContentColor'),
              "maxLines": 1
            }
          ),
          Text(
            "℃",
            {
              "fontSize": 10,
              "fontWeight": 400,
              "fontColor": $theme('supportContentColor'),
              "maxLines": 1
            }
          )
        )
      )
    #else
      Text(
        "目的地天气",
        {
          "fontSize": 14,
          "fontWeight": 500,
          "fontColor": $theme('supportContentColor'),
          "maxLines": 1
        }
      )
    #endif
    #if props.conditionIcon
      Image(
        props.conditionIcon,
        {
          "width": 24,
          "height": 24,
          "objectFit": "contain",
          "flexShrink": 0,
          "fillColor": $theme('supportContentColor')
        }
      )
    #endif
  )
)
#End

#Template WeatherOverviewCompact@1(props: { location?: string, conditionIcon?: asset })
data = {
    city: $optionalPath("/location/prefectureName"),
    district: $optionalPath("/location/districtName"),
    temperature: $path("/current/temperatureText"),
    condition: $path("/current/condition"),
    coldLevel: $optionalPath("/current/coldLevel")
}

Column(
  {
    "_advancedComponent": "WeatherOverview",
    "width": "matchParent",
    "height": "matchParent",
    "itemMargin": 4,
    "justifyContent": "start",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
  Row({
      "width": "matchParent",
      "height": 24,
      "itemMargin": 0,
      "alignItems": "center",
      "justifyContent": "spaceBetween",
  },
    Row(
      {
        "height": 24,
        "itemMargin": 4,
        "justifyContent": "start",
        "alignItems": "center",
        "clip": true,
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      },
      Text(
            #Expr(data.city ? data.city : (data.district ? data.district : (props.location ? props.location : "当前城市"))),
            {
              "fontSize": 16,
              "fontWeight": 700, "fontColor": $theme('primaryColor'),
              "maxLines": 1,
              "textOverflow": "ellipsis",
              "constraintSize": {"minWidth": 0, "minHeight": 0}
            }
          ),
      Text(
            data.temperature,
            {"fontSize": 16, "fontWeight": 800, "fontColor": $theme('primaryColor'), "maxLines": 1, "flexShrink": 0}
          )
    ),
    #if props.conditionIcon
      Image(
        props.conditionIcon,
        {
          "width": 20,
          "height": 20,
          "objectFit": "contain",
          "flexShrink": 0,
          "fillColor": $theme('supportContentColor'),
        }
      )
    #endif
  ),
  #if data.coldLevel
    Text(
      `${data.condition}｜感冒风险${data.coldLevel}`,
      {
        "width": "matchParent",
        "height": 16,
        "fontSize": 12,
        "fontWeight": 400, "fontColor": $theme('supportContentColor'),
        "maxLines": 1,
        "textOverflow": "ellipsis",
        "constraintSize": { "minWidth": 0, "minHeight": 0 }
      }
    )
  #else
    Text(
      `${data.condition}`,
      {
        "width": "matchParent",
        "height": 16,
        "fontSize": 12,
        "fontWeight": 400, "fontColor": $theme('supportContentColor'),
        "maxLines": 1,
        "textOverflow": "ellipsis",
        "constraintSize": { "minWidth": 0, "minHeight": 0 }
      }
    )
  #endif
)
#End

#Template WeatherOverviewWideFull@1(props: { location?: string, conditionIcon?: asset })
data = {
    city: $optionalPath("/location/prefectureName"),
    district: $optionalPath("/location/districtName"),
    temperature: $path("/current/temperatureText"),
    condition: $path("/current/condition"),
    feelsLike: $optionalPath("/current/feelsLikeC"),
    humidity: $optionalPath("/current/humidityPercent"),
    airQuality: $optionalPath("/current/airQuality"),
    windDirection: $optionalPath("/current/windDirection"),
    windLevel: $optionalPath("/current/windLevel"),
    temperatureRange: $optionalPath("/daily/0/temperatureRangeText"),
    rainProbability: $optionalPath("/daily/0/rainProbabilityPercent")
}

Row(
  {
    "_advancedComponent": "WeatherOverview",
    "width": "matchParent",
    "height": "matchParent",
    "itemMargin": 12,
    "justifyContent": "spaceBetween",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
  Column(
    {
      "width": "matchParent",
      "height": "matchParent",
      "layoutWeight": 1,
      "itemMargin": 4,
      "justifyContent": "spaceBetween",
      "alignItems": "start",
      "clip": true,
      "constraintSize": {"minWidth": 0, "minHeight": 0}
    },
    Column(
      {"width": "matchParent", "itemMargin": 2, "alignItems": "start"},
      Row(
        {"width": "matchParent", "height": 20, "itemMargin": 4, "alignItems": "center"},
        Text(
          #Expr(data.city ? data.city : (data.district ? data.district : (props.location ? props.location : "当前城市"))),
          {"fontSize": 14, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "layoutWeight": 1}
        ),
        #if props.conditionIcon
          Image(
            props.conditionIcon,
            {"width": 20, "height": 20, "objectFit": "contain", "flexShrink": 0, "fillColor": $theme('supportContentColor')}
          )
        #endif
      ),
      Text(
        data.temperature,
        {"fontSize": 38, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1}
      ),
      Text(
        data.condition,
        {"fontSize": 14, "fontWeight": 500, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis"}
      )
    ),
    #if data.temperatureRange
      Text(
        `今日 ${data.temperatureRange}`,
        {"fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis"}
      )
    #endif
  ),
  Column(
    {
      "width": "matchParent",
      "height": "matchParent",
      "layoutWeight": 1,
      "itemMargin": 6,
      "justifyContent": "center",
      "alignItems": "start",
      "clip": true,
      "constraintSize": {"minWidth": 0, "minHeight": 0}
    },
    #if data.feelsLike
      Row(
        {"width": "matchParent", "itemMargin": 2, "alignItems": "center"},
        Text(
          "体感",
          {"fontSize": 12, "fontWeight": 500, "fontColor": $theme('primaryColor'), "maxLines": 1}
        ),
        Text(
          data.feelsLike,
          {"fontSize": 12, "fontWeight": 500, "fontColor": $theme('primaryColor'), "maxLines": 1}
        ),
        Text(
          "℃",
          {"fontSize": 12, "fontWeight": 500, "fontColor": $theme('primaryColor'), "maxLines": 1}
        )
      )
    #endif
    #if data.humidity
      Row(
        {"width": "matchParent", "itemMargin": 2, "alignItems": "center"},
        Text(
          "湿度",
          {"fontSize": 12, "fontWeight": 500, "fontColor": $theme('primaryColor'), "maxLines": 1}
        ),
        Text(
          data.humidity,
          {"fontSize": 12, "fontWeight": 500, "fontColor": $theme('primaryColor'), "maxLines": 1}
        ),
        Text(
          "%",
          {"fontSize": 12, "fontWeight": 500, "fontColor": $theme('primaryColor'), "maxLines": 1}
        )
      )
    #endif
    #if data.airQuality
      Text(
        `空气 ${data.airQuality}`,
        {"fontSize": 12, "fontWeight": 500, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis"}
      )
    #endif
    #if data.windDirection
      #if data.windLevel
        Row(
          {"width": "matchParent", "itemMargin": 2, "alignItems": "center"},
          Text(
            data.windDirection,
            {"fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis"}
          ),
          Text(
            data.windLevel,
            {"fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1}
          ),
          Text(
            "级",
            {"fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1}
          )
        )
      #endif
    #endif
    #if data.windDirection
      #if data.windLevel
      #else
        Text(
          data.windDirection,
          {"fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis"}
        )
      #endif
    #endif
    #if data.rainProbability
      Text(
        `降雨 ${data.rainProbability}`,
        {"fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis"}
      )
    #endif
  )
)
#End

#Template WeatherOverviewWideHero@1(props: { location?: string, conditionIcon?: asset })
data = {
    city: $optionalPath("/location/prefectureName"),
    district: $optionalPath("/location/districtName"),
    temperature: $path("/current/temperatureText"),
    condition: $path("/current/condition"),
    feelsLike: $optionalPath("/current/feelsLikeC"),
