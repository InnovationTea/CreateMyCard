)
#End

#Template WeatherOverviewHumidityFull@1(props: { location?: string })
data = {
    temperature: $path("/current/temperatureText"),
    condition: $path("/current/condition"),
    humidity: $path("/current/humidityPercent"),
    city: $optionalPath("/location/prefectureName"),
    district: $optionalPath("/location/districtName"),
    airQuality: $optionalPath("/current/airQuality"),
    coldLevel: $optionalPath("/current/coldLevel")
}

Column(
  {
    "_advancedComponent": "WeatherOverview",
    "width": "matchParent",
    "height": "matchParent",
    "itemMargin": 4,
    "justifyContent": "spaceBetween",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
  Column(
    {
      "width": "matchParent",
      "itemMargin": 2,
      "justifyContent": "start",
      "alignItems": "start",
      "clip": true,
      "constraintSize": {"minWidth": 0, "minHeight": 0}
    },
    Row(
      {
        "width": "matchParent",
        "height": 20,
        "itemMargin": 0,
        "justifyContent": "start",
        "alignItems": "top",
        "clip": true,
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      },
      Text(
        #Expr(data.city ? data.city : (data.district ? data.district : (props.location ? props.location : "当前城市"))),
        {
          "fontSize": 12,
          "fontWeight": 400, "fontColor": $theme('supportContentColor'),
          "maxLines": 1,
          "textOverflow": "ellipsis",
          "constraintSize": {"minWidth": 0, "minHeight": 0}
        }
      ),
      Text(
        "湿度",
        {
          "fontSize": 12,
          "fontWeight": 400, "fontColor": $theme('supportContentColor'),
          "maxLines": 1,
          "constraintSize": {"minWidth": 0, "minHeight": 0}
        }
      )
    ),
    Row(
      {
        "width": "matchParent",
        "height": 44,
        "itemMargin": 8,
        "justifyContent": "start",
        "alignItems": "center",
        "clip": true,
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      },
      Text(
        Expr('' + data.humidity + '%'),
        {"fontSize": 38, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1}
      )
    )
  ),
  Column(
    {
      "width": "matchParent",
      "itemMargin": 0,
      "justifyContent": "start",
      "alignItems": "start",
      "clip": true,
      "constraintSize": { "minWidth": 0, "minHeight": 0 }
    },
    Text(
      `${data.condition}｜${data.temperature}`,
      {
        "width": "matchParent",
        "fontSize": 12,
        "fontWeight": 500, "fontColor": $theme('supportContentColor'),
        "maxLines": 1,
        "textOverflow": "ellipsis",
        "constraintSize": { "minWidth": 0, "minHeight": 0 }
      }
    ),
    #if data.airQuality && data.coldLevel
      Text(
        `空气${data.airQuality}｜感冒风险${data.coldLevel}`,
        { "width": "matchParent", "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1 }
      )
    #else
      #if data.airQuality
        Text(
          `空气${data.airQuality}`,
          { "width": "matchParent", "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1 }
        )
      #else
        #if data.coldLevel
          Text(
            `感冒风险${data.coldLevel}`,
            { "width": "matchParent", "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1 }
          )
        #endif
      #endif
    #endif
  )
)

#End

