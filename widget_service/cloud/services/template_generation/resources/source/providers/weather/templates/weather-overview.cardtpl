#Template WeatherOverviewConditionFull@1(props: { conditionIcon?: asset })
data = {
    city: $path("/location/districtName"),
    temperature: $path("/current/temperatureText"),
    condition: $path("/current/condition"),
    airQuality: $path("/current/airQuality"),
    coldLevel: $path("/current/coldLevel")
}

Column(
  {
    "_advancedComponent": "WeatherOverview",
    "width": "matchParent",
    "height": "matchParent",
    "itemMargin": 4,
    "justifyContent": "center",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
  Row(
      {
        "width": "matchParent",
        "height": 20,
        "itemMargin": 4,
        "justifyContent": "spaceBetween",
        "alignItems": "center",
        "clip": true,
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      },
      Text(
            data.city,
            {
              "fontSize": 12,
              "fontWeight": 400, "fontColor": $theme('supportContentColor'),
              "maxLines": 1,
              "textOverflow": "ellipsis",
              "constraintSize": {"minWidth": 0, "minHeight": 0}
            }
          ),
      IfPresent(
            props.conditionIcon,
            Image(
                    props.conditionIcon,
                    {
                      "width": 20,
                      "height": 20,
                      "objectFit": "contain",
                      "flexShrink": 0,
                      "_preserveOriginalColor": true
                    }
                  )
          )
    ),
  Text(
      data.condition,
      {
        "width": "matchParent",
        "fontSize": 32,
        "minFontSize": 20,
        "fontWeight": 800, "fontColor": $theme('primaryColor'),
        "maxLines": 1
      }
    ),
  Text(
      `${data.temperature}｜空气${data.airQuality}`,
      {
        "width": "matchParent",
        "fontSize": 12,
        "fontWeight": 500, "fontColor": $theme('supportContentColor'),
        "maxLines": 1,
        "textOverflow": "ellipsis",
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      }
    ),
  Text(
      `感冒风险 ${data.coldLevel}`,
      {"width": "matchParent", "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1}
    )
)
#End

#Template WeatherOverviewHumidityFull@1(props: {})
data = {
    city: $path("/location/districtName"),
    temperature: $path("/current/temperatureText"),
    condition: $path("/current/condition"),
    humidity: $path("/current/humidityPercent"),
    airQuality: $path("/current/airQuality"),
    coldLevel: $path("/current/coldLevel")
}

Column(
  {
    "_advancedComponent": "WeatherOverview",
    "width": "matchParent",
    "height": "matchParent",
    "itemMargin": 4,
    "justifyContent": "center",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
  Text(
      `${data.city}湿度`,
      {
        "width": "matchParent",
        "fontSize": 12,
        "fontWeight": 400, "fontColor": $theme('supportContentColor'),
        "maxLines": 1,
        "textOverflow": "ellipsis",
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      }
    ),
  Text(
      Expr(`'' + ${data.humidity} + '%'`),
      {"fontSize": 40, "fontWeight": 800, "fontColor": $theme('primaryColor'), "maxLines": 1}
    ),
  Text(
      `${data.condition}｜${data.temperature}`,
      {
        "width": "matchParent",
        "fontSize": 12,
        "fontWeight": 500, "fontColor": $theme('supportContentColor'),
        "maxLines": 1,
        "textOverflow": "ellipsis",
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      }
    ),
  Text(
      `空气${data.airQuality}｜感冒风险${data.coldLevel}`,
      {
        "width": "matchParent",
        "fontSize": 10,
        "fontWeight": 400, "fontColor": $theme('supportContentColor'),
        "maxLines": 1,
        "textOverflow": "ellipsis",
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      }
    )
)
#End

