#Template WeatherOverviewHumidityFull@1(props: { conditionIcon?: asset })
data = {
    city: $path("/location/districtName"),
    temperature: $path("/current/temperatureText"),
    condition: $path("/current/condition"),
    humidity: $path("/current/humidityPercent"),
    airQuality: $path("/current/airQuality"),
    coldLevel: $path("/current/coldLevel")
}

Column(
  "compact",
  {
    "_advancedComponent": "WeatherOverview",
    "width": "matchParent",
    "height": "matchParent",
    "itemMargin": 2,
    "justifyContent": "spaceBetween",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
  Column(
      "compact",
      {
        "width": "matchParent",
        "itemMargin": 2,
        "justifyContent": "start",
        "alignItems": "start",
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      },
      Row(
            "between",
            {
              "width": "matchParent",
              "height": 20,
              "itemMargin": 2,
              "justifyContent": "spaceBetween",
              "alignItems": "top",
              "clip": true,
              "constraintSize": {"minWidth": 0, "minHeight": 0}
            },
            Text(
                    `${data.city}湿度`,
                    "compact-title",
                    {
                      "fontSize": 12,
                      "fontWeight": 400,
                      "maxLines": 1,
                      "textOverflow": "ellipsis",
                      "constraintSize": {"minWidth": 0, "minHeight": 0}
                    }
                  ),
            IfPresent(
                    props.conditionIcon,
                    Image(
                              props.conditionIcon,
                              "icon",
                              {
                                "width": 20,
                                "height": 20,
                                "objectFit": "contain",
                                "flexShrink": 0,
                                "_preserveOriginalColor": true
                              }
                            )
                  )
          ),
      Text(
            Expr(`'' + ${data.humidity} + '%'`),
            "title",
            {"fontSize": 38, "fontWeight": 700, "maxLines": 1}
          )
    ),
  Column(
      "compact",
      {
        "width": "matchParent",
        "itemMargin": 2,
        "justifyContent": "start",
        "alignItems": "start",
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      },
      Text(
            `${data.condition}｜${data.temperature}`,
            "body",
            {
              "width": "matchParent",
              "fontSize": 12,
              "fontWeight": 400,
              "maxLines": 1,
              "textOverflow": "ellipsis",
              "constraintSize": {"minWidth": 0, "minHeight": 0}
            }
          ),
      Text(
            `空气${data.airQuality}｜感冒风险${data.coldLevel}`,
            "body",
            {
              "width": "matchParent",
              "fontSize": 12,
              "fontWeight": 400,
              "maxLines": 1,
              "textOverflow": "ellipsis",
              "constraintSize": {"minWidth": 0, "minHeight": 0}
            }
          )
    )
)
#End

