#Template WeatherOverviewHumidityFull@1(props: {})
data = {
    city: $path("/location/districtName"),
    temperature: $path("/current/temperatureText"),
    condition: $path("/current/condition"),
    humidity: $path("/current/humidityPercent"),
    airQuality: $path("/current/airQuality"),
    coldLevel: $path("/current/coldLevel")
}

Column(
  {
    "_advancedComponent": "WeatherOverview",
    "width": "matchParent",
    "height": "matchParent",
    "itemMargin": 4,
    "justifyContent": "spaceBetween",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
  Column(
    {
      "width": "matchParent",
      "itemMargin": 2,
      "justifyContent": "start",
      "alignItems": "start",
      "clip": true,
      "constraintSize": {"minWidth": 0, "minHeight": 0}
    },
    Row(
      {
        "width": "matchParent",
        "height": 20,
        "itemMargin": 4,
        "justifyContent": "spaceBetween",
        "alignItems": "top",
        "clip": true,
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      },
      Text(
            `${data.city}湿度`,
            {
              "fontSize": 12,
              "fontWeight": 400, "fontColor": $theme('supportContentColor'),
              "maxLines": 1,
              "textOverflow": "ellipsis",
              "constraintSize": {"minWidth": 0, "minHeight": 0}
            }
          )
    ),
    Row(
      {
        "width": "matchParent",
        "height": 44,
        "itemMargin": 8,
        "justifyContent": "start",
        "alignItems": "center",
        "clip": true,
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      },
      Text(
        Expr(`'' + ${data.humidity} + '%'`),
        {"fontSize": 38, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1}
      )
    )
  ),
  Column(
    {
      "width": "matchParent",
      "itemMargin": 0,
      "justifyContent": "start",
      "alignItems": "start",
      "clip": true,
      "constraintSize": {"minWidth": 0, "minHeight": 0}
    },
    Text(
      `${data.condition}｜${data.temperature}`,
      {
        "width": "matchParent",
        "fontSize": 12,
        "fontWeight": 500, "fontColor": $theme('supportContentColor'),
        "maxLines": 1,
        "textOverflow": "ellipsis",
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      }
    ),
    Text(
      `空气${data.airQuality}｜感冒风险${data.coldLevel}`,
      {"width": "matchParent", "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1}
    )
  )
)

#End

