#Template WeatherOverviewTemperatureSupport@1(props: { conditionIcon?: asset, actionId?: string })
data = {
    condition: $path("/current/condition"),
    city: $path("/location/districtName"),
    temperature: $path("/current/temperatureText"),
    coldLevel: $path("/current/coldLevel")
}

Row(
  {
    "_advancedComponent": "WeatherOverviewTemperatureSupport",
    "width": "matchParent",
    "padding": { "left": 12, "top": 0, "right": 16, "bottom": 0 },
    "justifyContent": "spaceBetween",
    "alignItems": "center",
    "clip": true,
    "constraintSize": { "minWidth": 0, "minHeight": 0 },
    "onClick": EventAction(props?.actionId)
  },
  Column(
    {
      "itemMargin": 4,
      "justifyContent": "start",
      "alignItems": "start",
      "clip": true,
      "constraintSize": { "minWidth": 0, "minHeight": 0 }
    },
    Row(
      {
        "height": 20,
        "itemMargin": 2,
        "justifyContent": "start",
        "alignItems": "center",
        "clip": true,
        "constraintSize": { "minWidth": 0, "minHeight": 0 }
      },
      Text(
        data.city,
        {
          "fontSize": 14,
          "fontWeight": 700, "fontColor": $theme('primaryColor'),
          "maxLines": 1,
          "textOverflow": "ellipsis",
          "constraintSize": { "minWidth": 0, "minHeight": 0 }
        }
      ),
      Text(
        data.temperature,
        { "fontSize": 14, "fontWeight": 800, "fontColor": $theme('primaryColor'), "maxLines": 1, "flexShrink": 0 }
      )
    ),
    Text(
      `${data.condition}｜感冒风险${data.coldLevel}`,
      {
        "width": "matchParent",
        "height": 16,
        "fontSize": 12,
        "fontWeight": 400, "fontColor": $theme('supportContentColor'),
        "maxLines": 1,
        "textOverflow": "ellipsis",
        "constraintSize": { "minWidth": 0, "minHeight": 0 }
      }
    )
  ),
  #if props.conditionIcon
    Image(
      props.conditionIcon,
      {
        "width": 32,
        "height": 32,
        "objectFit": "contain",
        "flexShrink": 0,
        "fillColor": $theme('supportContentColor'),
      }
    )
  #endif
)
#End

