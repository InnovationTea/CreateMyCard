#Template ActivityOverviewCompact@1(props: { stepsIcon?: asset })
data = {
    steps: $path("/dailySteps")
}

Column(
  "compact",
  {"_advancedComponent": "ActivityOverview", "width": "matchParent", "height": "matchParent", "itemMargin": 4, "justifyContent": "spaceBetween", "alignItems": "start", "constraintSize": {"minWidth": 0, "minHeight": 0}},
    Row(
        "between",
        {"width": "matchParent", "justifyContent": "start", "alignItems": "center"},
        Column(
            "compact",
            {"itemMargin": 2, "justifyContent": "start", "alignItems": "start", "layoutWeight": 1},
            Row(
                "between",
                {"width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "bottom"},
                Text(
                    data.steps,
                    "title",
                    {"fontSize": 20, "fontWeight": 700, "maxLines": 1}
                ),
                Text(
                    "步",
                    "subtitle",
                    {"fontSize": 10, "maxLines": 1}
                )
            ),
            Text(
                "每日步数",
                {"fontSize": 12, "fontWeight": 500, "maxLines": 1}
            )
        ),
        IfPresent(
            props.stepsIcon,
            Image(
                props.stepsIcon,
                "icon",
                {"width": 24, "height": 24, "objectFit": "contain", "flexShrink": 0}
            )
        )
    )
)
#End

#Template ActivityOverviewHero@1(props: { stepsIcon?: asset })
data = {
    steps: $path("/dailySteps")
}

Column(
  "compact",
  {"_advancedComponent": "ActivityOverview", "width": "matchParent", "height": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "start", "constraintSize": {"minWidth": 0, "minHeight": 0}},
  Row(
    "between",
    {"width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center"},
    IfPresent(
      props.stepsIcon,
      Image(
        props.stepsIcon,
        "icon",
        {"width": 20, "height": 20, "objectFit": "contain", "flexShrink": 0}
      )
    ),
    Text(
      "今日活动",
      "compact-title",
      {"fontSize": 12, "fontWeight": 500, "maxLines": 1}
    )
  ),
  Row(
    "between",
    {"width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "bottom"},
    Text(
      data.steps,
      "title",
      {"fontSize": 38, "fontWeight": 800, "maxLines": 1}
    ),
    Text(
      "步",
      "subtitle",
      {"fontSize": 12, "fontWeight": 500, "maxLines": 1}
    )
  ),
  Progress(
    {"value": data.steps, "total": 10000, "strokeWidth": 8, "color": "#FFFFFFFF", "backgroundColor": "#1AFFFFFF", "height": 12, "width": "matchParent"}
  )
)
#End

#Template ActivityOverviewWideHero@1(props: { stepsIcon?: asset, caloriesIcon?: asset, distanceIcon?: asset })
data = {
    steps: $path("/dailySteps"),
    calories: $path("/dailyTotalCaloriesText"),
    distance: $path("/dailyDistanceText"),
    targetDate: $path("/targetDateText")
}

Row(
    "between",
    {"_advancedComponent": "ActivityOverview", "width": "100%", "height": "100%", "itemMargin": 8, "alignItems": "center"},
    Column(
        "compact",
        {"layoutWeight": 1, "height": "matchParent", "itemMargin": 8, "justifyContent": "spaceBetween", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
        Column(
            "compact",
            {"width": "matchParent", "constraintSize": {"minWidth": 0, "minHeight": 0}},
            Column(
                "compact",
                {"width": "matchParent", "height": 20},
                Text(
                    "今日活动",
                    "compact-title",
                    {"fontSize": 12, "fontWeight": 500, "maxLines": 1}
                )
            ),
            Column(
                "compact",
                {"width": "matchParent", "justifyContent": "start", "alignItems": "start", "clip": true},
                Text(
                    data.steps,
                    "title",
                    {"fontSize": 30, "fontWeight": 700, "maxLines": 1}
                ),
                Text(
                    "总步数",
                    "subtitle",
                    {"fontSize": 12, "fontWeight": 500, "maxLines": 1}
                )
            )
        ),
        Text(
            data.targetDate,
            {"fontSize": 10, "fontWeight": 400, "maxLines": 1}
        )
    ),
    Column(
        "compact",
        {"layoutWeight": 1, "itemMargin": 8, "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
        IfPresent(
            props.stepsIcon,
            Column(
                "compact",
                {"width": "matchParent", "alignItems": "end", "height": 20},
                Image(
                    props.stepsIcon,
                    "icon",
                    {"width": 20, "height": 20, "objectFit": "contain", "flexShrink": 0}
                )
            )
        ),
        IfPresent(
            data.calories,
            Row(
                "between",
                {"padding": {"top": 11, "bottom": 11, "left": 12, "right": 12}, "width": "matchParent", "justifyContent": "spaceBetween", "alignItems": "center", "constraintSize": {"minWidth": 0, "minHeight": 0}, "backgroundColor": "#33FFFFFF", "borderRadius": 16},
                Column(
                    "compact",
                    {"layoutWeight": 1, "width": "matchParent", "justifyContent": "center", "alignItems": "start", "clip": true},
                    Row(
                        "between",
                        {"itemMargin": 4, "justifyContent": "start", "alignItems": "bottom"},
                        Text(
                            data.calories,
                            "title",
                            {"fontSize": 18, "fontWeight": 700, "maxLines": 1}
                        ),
                        Text(
                            "千卡",
                            "subtitle",
                            {"fontSize": 10, "maxLines": 1}
                        )
                    ),
                    Text(
                        "消耗热量",
                        {"fontSize": 12, "fontWeight": 500, "maxLines": 1}
                    )
                ),
                IfPresent(
                    props.caloriesIcon,
                    Image(
                        props.caloriesIcon,
                        "icon",
                        {"width": 24, "height": 24, "objectFit": "contain", "flexShrink": 0}
                    )
                )
            )
        ),
        IfPresent(
            data.distance,
            Row(
                "between",
                {"padding": {"top": 11, "bottom": 11, "left": 12, "right": 12}, "width": "matchParent", "justifyContent": "spaceBetween", "alignItems": "center", "constraintSize": {"minWidth": 0, "minHeight": 0}, "backgroundColor": "#33FFFFFF", "borderRadius": 16},
                Column(
                    "compact",
                    {"layoutWeight": 1, "width": "matchParent", "justifyContent": "center", "alignItems": "start", "clip": true},
                    Row(
                        "between",
                        {"itemMargin": 4, "justifyContent": "start", "alignItems": "bottom"},
                        Text(
                            data.distance,
                            "title",
                            {"fontSize": 18, "fontWeight": 700, "maxLines": 1}
                        ),
                        Text(
                            "千里",
                            "subtitle",
                            {"fontSize": 10, "maxLines": 1}
                        )
                    ),
                    Text(
                        "运动距离",
                        {"fontSize": 12, "fontWeight": 500, "maxLines": 1}
                    )
                ),
                IfPresent(
                    props.distanceIcon,
                    Image(
                        props.distanceIcon,
                        "icon",
                        {"width": 24, "height": 24, "objectFit": "contain", "flexShrink": 0}
                    )
                )
            )
        )
    )
)
#End

#Template ActivityOverviewFull@1(props: { stepsIcon?: asset, caloriesIcon?: asset, distanceIcon?: asset })
data = {
    steps: $path("/dailySteps"),
    calories: $path("/dailyTotalCaloriesText"),
    distance: $path("/dailyDistanceText")
}

Column(
  "compact",
  {"_advancedComponent": "ActivityOverview", "width": "matchParent", "height": "matchParent", "itemMargin": 4, "justifyContent": "spaceBetween", "alignItems": "start", "constraintSize": {"minWidth": 0, "minHeight": 0}},
  Column(
    "compact",
    {"itemMargin": 4, "justifyContent": "start", "width": "matchParent"},
    Row(
      "between",
      {"width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center"},
      IfPresent(
        props.stepsIcon,
        Image(
          props.stepsIcon,
          "icon",
          {"width": 20, "height": 20, "objectFit": "contain", "flexShrink": 0}
        )
      ),
      Text(
        "今日活动",
        "compact-title",
        {"fontSize": 12, "fontWeight": 500, "maxLines": 1}
      )
    ),
    Row(
      "between",
      {"width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "bottom"},
      Text(
        data.steps,
        "title",
        {"fontSize": 38, "fontWeight": 800, "maxLines": 1}
      ),
      Text(
        "步",
        "subtitle",
        {"fontSize": 12, "fontWeight": 500, "maxLines": 1}
      )
    ),
    Progress(
      {"value": data.steps, "total": 10000, "strokeWidth": 8, "color": "#FFFFFFFF", "backgroundColor": "#1AFFFFFF", "height": 12, "width": "matchParent"}
    )
  ),
  Column(
    "compact",
    {"itemMargin": 4, "justifyContent": "start", "width": "matchParent"},
    Row(
      "between",
      {"width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center"},
      IfPresent(
        props.caloriesIcon,
        Image(
          props.caloriesIcon,
          "icon",
          {"width": 16, "height": 16, "objectFit": "contain", "flexShrink": 0}
        )
      ),
      Text(
        data.calories,
        "body",
        {"fontSize": 12, "minFontSize": 10, "fontWeight": 500, "maxLines": 1}
      )
    ),
    Row(
      "between",
      {"width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center"},
      IfPresent(
        props.distanceIcon,
        Image(
          props.distanceIcon,
          "icon",
          {"width": 16, "height": 16, "objectFit": "contain", "flexShrink": 0}
        )
      ),
      Text(
        data.distance,
        "body",
        {"fontSize": 12, "minFontSize": 10, "fontWeight": 500, "maxLines": 1}
      )
    )
  )
)
#End

