#Template("HeartRateOverview@1", {
  capability: "GetHealthAndSportSummary",
  description: "运动健康数据提供方交付的平均心率概览",
  domainTags: ["heart-rate", "health", "exercise"],
  compatibleThemeProfileIds: [
    "meeting-paper-neutral",
    "digital-wellbeing-neutral-dark",
    "race-night-violet"
  ],
  allowedParentComponents: ["Column", "Row", "List", "Stack"],
  bindings: {
    average: { path: "/exerciseHeartRateAvg", type: "integer" },
    updatedAt: { path: "/updatedAt", type: "string" }
  },
  params: {
    sourceIcon: {
      kind: "asset",
      semanticTags: ["heart"],
      required: false
    }
  },
  limits: { maxNodes: 8, maxDepth: 3 }
})

#Variant("hero", {
  sizes: ["2x2", "2x4"],
  roles: ["hero"],
  requires: ["average"]
})
Column("compact", {
  _advancedComponent: "HeartRateOverview",
  width: "matchParent",
  height: "matchParent",
  itemMargin: 4,
  justifyContent: "spaceBetween",
  alignItems: "start",
  constraintSize: { minWidth: 0, minHeight: 0 }
},
  Row("between", {
    width: "matchParent",
    itemMargin: 4,
    justifyContent: "start",
    alignItems: "top",
    constraintSize: { minWidth: 0, minHeight: 0 }
  },
    Text("运动平均心率", "subtitle", {
      fontSize: 12,
      fontWeight: 500,
      fontColor: "#E6000000",
      maxLines: 1,
      textOverflow: "ellipsis",
      constraintSize: { minWidth: 0, minHeight: 0 },
      width: "matchParent"
    })
  ),
  Row("between", {
    width: "matchParent",
    itemMargin: 4,
    justifyContent: "start",
    alignItems: "bottom",
    constraintSize: { minWidth: 0, minHeight: 0 }
  },
    Text(Bind("average"), "title", {
      fontSize: 38,
      fontWeight: 800,
      fontColor: "#FFE84057",
      maxLines: 1,
      textOverflow: "ellipsis",
      constraintSize: { minWidth: 0, minHeight: 0 }
    }),
    Text("bpm", "subtitle", {
      fontSize: 12,
      fontWeight: 500,
      fontColor: "#E6000000",
      maxLines: 1,
      textOverflow: "ellipsis",
      constraintSize: { minWidth: 0, minHeight: 0 }
    })
  )
)
#EndVariant

