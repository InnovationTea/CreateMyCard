#Template HeartRateOverviewFull@1(props: {})
data = {
    average: $path("/exerciseHeartRateAvg")
}

Column(
    { "_advancedComponent": "HeartRateOverview", "itemMargin": 0, "width": "matchParent", "height": "matchParent", "justifyContent": "center", "alignItems": "center", "constraintSize": { "minWidth": 0, "minHeight": 0 } },
    Text(
        "运动平均心率",
        { "width": "matchParent", "fontSize": 16, "minFontSize": 12, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textAlign": "center", "textOverflow": "ellipsis", "constraintSize": { "minWidth": 0, "minHeight": 0 } }
    ),
    Text(
        data.average,
        { "width": "matchParent", "margin": { "top": 4 }, "textAlign": "center", "fontSize": 56, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": { "minWidth": 0, "minHeight": 0 } }
    ),
    Text(
        "次/分钟",
        { "fontSize": 12, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": { "minWidth": 0, "minHeight": 0 } }
    )
)
#End

#Template HeartRateOverviewMinMaxFull@1(props: {})
data = {
    max: $path("/exerciseHeartRateMax"),
    min: $path("/exerciseHeartRateMin"),
    updatedAt: $optionalPath("/updatedAt")
}

Column(
    {
        "_advancedComponent": "HeartRateOverview",
        "width": "matchParent",
        "height": "matchParent",
        "itemMargin": 4,
        "justifyContent": "spaceBetween",
        "alignItems": "start",
        "clip": true,
        "constraintSize": { "minWidth": 0, "minHeight": 0 }
    },
    Column(
        { "itemMargin": 8, "justifyContent": "start", "width": "matchParent" },
        Row(
            { "width": "matchParent", "itemMargin": 4, "justifyContent": "spaceBetween", "alignItems": "top" },
            Text(
                "心率监测",
                {
                    "fontSize": 12,
                    "fontWeight": 400,
                    "fontColor": $theme('supportContentColor'),
                    "maxLines": 1
                }
            )
        ),
        Row(
            { "width": "matchParent", "justifyContent": "start", "alignItems": "bottom" },
            Text(
                Expr(`'' + ${data.min} + '/' + ${data.max}`),
                { "fontSize": 34, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": { "minWidth": 0, "minHeight": 0 } }
            )
        ),
        Text(
            "每分钟心率区间",
            { "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": { "minWidth": 0, "minHeight": 0 } }
        )
    ),
    Column(
        { "itemMargin": 4, "justifyContent": "start", "width": "matchParent" },
        #if data.updatedAt
            Row(
                { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center" },
                Text(
                    data.updatedAt,
                    { "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1 }
                ),
                Text(
                    "更新",
                    { "fontWeight": 400, "fontColor": $theme('supportContentColor'), "fontSize": 12, "maxLines": 1 }
                )
            )
        #endif
    )
)
#End

#Template HeartRateOverviewSupport@1(props: { heartIcon?: asset, actionId?: string })
data = {
    average: $path("/exerciseHeartRateAvg")
}

Row(
  {
    "_advancedComponent": "HeartRateOverview",
    "width": "matchParent",
    "height": "matchParent",
    "justifyContent": "spaceBetween",
    "alignItems": "center",
    "padding": { "left": 12, "right": 12 },
    "onClick": EventAction(props?.actionId)
  },
  Column(
    { "itemMargin": 4, "justifyContent": "start", "alignItems": "start", "constraintSize": { "minWidth": 0, "minHeight": 0 } },
    Row(
      { "itemMargin": 2, "justifyContent": "start", "alignItems": "bottom", "constraintSize": { "minWidth": 0, "minHeight": 0 } },
      Text(
        data.average,
        { "fontSize": 16, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": { "minWidth": 0, "minHeight": 0 } }
      ),
      Text(
        "次/分钟",
        { "fontSize": 10, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "padding": { "bottom": 6 } }
      )
    ),
    Text(
      "运动平均心率",
      { "fontSize": 12, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": { "minWidth": 0, "minHeight": 0 }, "width": "matchParent" }
    )
  ),
  #if props.heartIcon
  Image(
    props.heartIcon,
    {
      "width": 24,
      "height": 24,
      "fillColor": $theme("supportContentColor")
    }
  )
  #endif
)
#End

