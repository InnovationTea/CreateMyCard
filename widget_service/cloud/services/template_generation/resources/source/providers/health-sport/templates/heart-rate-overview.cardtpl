#Variant("heroIcon", {
  sizes: ["2x2", "2x4"],
  roles: ["hero"],
  requires: ["average"],
  requiresParams: ["sourceIcon"]
})
Column("compact", {
  _advancedComponent: "HeartRateOverview",
  width: "matchParent",
  height: "matchParent",
  itemMargin: 4,
  justifyContent: "spaceBetween",
  alignItems: "start",
  constraintSize: { minWidth: 0, minHeight: 0 }
},
  Row("between", {
    width: "matchParent",
    itemMargin: 4,
    justifyContent: "start",
    alignItems: "top",
    constraintSize: { minWidth: 0, minHeight: 0 }
  },
    Image(Asset("sourceIcon"), "icon", {
      width: 20,
      height: 20,
      objectFit: "contain",
