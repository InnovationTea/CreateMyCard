#Template WorkoutOverviewFull@1(props: { sourceIcon?: asset })
data = {
    workoutType: $optionalPath("/exerciseTypeName"),
    workoutCalories: $path("/exerciseCalorieText"),
    duration: $path("/exerciseDurationText"),
    endTime: $path("/exerciseEndTimeText")
}

Column(
    {
        "_advancedComponent": "WorkoutOverview",
        "width": "matchParent",
        "height": "matchParent",
        "itemMargin": 4,
        "justifyContent": "spaceBetween",
        "alignItems": "start",
        "constraintSize": {"minWidth": 0, "minHeight": 0}
    },
    Column(
        {
            "itemMargin": 4,
            "justifyContent": "start",
            "width": "matchParent",
            "constraintSize": {"minWidth": 0, "minHeight": 0}
        },
        Row(
            {
                "width": "matchParent",
                "itemMargin": 4,
                "justifyContent": "start",
                "alignItems": "start",
                "constraintSize": {"minWidth": 0, "minHeight": 0}
            },
            #if props.sourceIcon
                Image(
                    props.sourceIcon,
                    {"width": 20, "height": 20, "objectFit": "contain", "flexShrink": 0}
                ),
            #endif
            #if data.workoutType
                Text(
                    data.workoutType,
                    {
                        "width": "matchParent",
                        "fontSize": 12,
                        "fontWeight": 500,
                        "fontColor": $theme('supportContentColor'),
                        "maxLines": 1,
                        "textOverflow": "ellipsis",
                        "constraintSize": {"minWidth": 0, "minHeight": 0}
                    }
                ),
            #else
                Text(
                    "运动记录",
                    {
                        "width": "matchParent",
                        "fontSize": 12,
                        "fontWeight": 500,
                        "fontColor": $theme('supportContentColor'),
                        "maxLines": 1,
                        "textOverflow": "ellipsis",
                        "constraintSize": {"minWidth": 0, "minHeight": 0}
                    }
                )
            #endif
        )
    ),
    Column(
        {
            "itemMargin": 4,
            "justifyContent": "start",
            "width": "matchParent",
            "constraintSize": {"minWidth": 0, "minHeight": 0}
        },
        Text(
            data.workoutCalories,
            {
                "fontSize": 20,
                "fontWeight": 800,
                "fontColor": $theme('primaryColor'),
                "maxLines": 1,
                "textOverflow": "ellipsis",
                "constraintSize": {"minWidth": 0, "minHeight": 0}
            }
        ),
        Row(
            {
              "width": "matchParent",
              "itemMargin": 4,
              "justifyContent": "start",
              "alignItems": "center",
              "constraintSize": {"minWidth": 0, "minHeight": 0}
            },
            Text(
                `${data.duration} | ${data.endTime}`,
                {
                    "fontWeight": 400,
                    "fontColor": $theme('supportContentColor'),
                    "fontSize": 12,
                    "maxLines": 1,
                    "textOverflow": "ellipsis",
                    "constraintSize": {"minWidth": 0, "minHeight": 0}
                }
            )
        )
    )
)
#End

#Template WorkoutOverviewCompact@1(props: { sourceIcon?: asset })
data = {
    workoutType: $optionalPath("/exerciseTypeName"),
    workoutCalories: $path("/exerciseCalorieText"),
    duration: $path("/exerciseDurationText")
}

Column(
    {
        "_advancedComponent": "WorkoutOverview",
        "width": "matchParent",
        "height": "matchParent",
        "itemMargin": 4,
        "justifyContent": "spaceBetween",
        "alignItems": "start",
        "constraintSize": {"minWidth": 0, "minHeight": 0}
    },
    Row(
        {
            "itemMargin": 4,
            "width": "matchParent",
            "justifyContent": "spaceBetween",
            "alignItems": "top"
        },
        Column(
            {
                "itemMargin": 2,
                "justifyContent": "start",
                "alignItems": "start"
            },
            Text(
                data.workoutCalories,
                {"fontSize": 20, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1}
            ),
            #if data.workoutType
                Text(
                    `${data.workoutType} | ${data.duration}`,
                    {
                        "fontWeight": 400,
                        "fontColor": $theme('supportContentColor'),
                        "fontSize": 12,
                        "maxLines": 1,
                        "textOverflow": "ellipsis",
                        "constraintSize": {"minWidth": 0, "minHeight": 0},
                        "margin": {"top": 2}
                    }
                )
            #else
                Text(
                    data.duration,
                    {
                        "fontWeight": 400,
                        "fontColor": $theme('supportContentColor'),
                        "fontSize": 12,
                        "maxLines": 1,
                        "textOverflow": "ellipsis",
                        "constraintSize": {"minWidth": 0, "minHeight": 0},
                        "margin": {"top": 2}
                    }
                )
            #endif
        ),
        #if props.sourceIcon
          Image(
              props.sourceIcon,
              {"width": 20, "height": 20, "objectFit": "contain", "flexShrink": 0}
          )
        #endif
    )
)
#End

#Template WorkoutOverviewHero@1(props: { sourceIcon?: asset })
data = {
    workoutType: $optionalPath("/exerciseTypeName"),
    workoutCalories: $optionalPath("/exerciseCalorieText"),
    duration: $path("/exerciseDurationText")
}

Column(
    {
        "_advancedComponent": "WorkoutOverview",
        "width": "matchParent",
        "height": "matchParent",
        "itemMargin": 8,
        "justifyContent": "start",
        "alignItems": "start",
        "clip": true,
        "constraintSize": {"minWidth": 0, "minHeight": 0}
    },
    Row(
        {"width": "matchParent", "itemMargin": 4, "justifyContent": "spaceBetween", "alignItems": "top"},
        #if data.workoutType
            Text(
                data.workoutType,
                {"fontSize": 12, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1}
            ),
        #else
            Text(
                "运动记录",
                {"fontSize": 12, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1}
            )
        #endif
        #if props.sourceIcon
          Image(
              props.sourceIcon,
              {"width": 20, "height": 20, "objectFit": "contain", "flexShrink": 0}
          )
        #endif
    ),
    #if data.workoutCalories
        Text(
            data.workoutCalories,
            {"fontSize": 24, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1}
        ),
    #else
        Text(
            data.duration,
            {"fontSize": 24, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1}
        ),
    #endif
    Row(
        {
            "itemMargin": 4,
            "width": "matchParent",
            "justifyContent": "start"
        },
        Text(
            "运动时长",
            {"fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1}
        ),
        #if data.workoutCalories
            Text(
                data.duration,
                {"fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1}
            )
        #endif
    )
)
#End

#Template WorkoutOverviewSupport@1(props: { sourceIcon?: asset, actionId?: string })
data = {
    workoutType: $optionalPath("/exerciseTypeName"),
    workoutCalories: $path("/exerciseCalorieText"),
    duration: $path("/exerciseDurationText")
}

Row(
    {
        "_advancedComponent": "WorkoutOverview",
        "width": "matchParent",
        "height": "matchParent",
        "itemMargin": 4,
        "justifyContent": "spaceBetween",
        "alignItems": "center",
        "padding": { "left": 12, "right": 12 },
        "onClick": EventAction(props?.actionId)
    },
    Column(
        {
            "itemMargin": 2,
            "justifyContent": "start",
            "alignItems": "start"
        },
        Text(
            data.workoutCalories,
            { "fontSize": 14, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1 }
        ),
        #if data.workoutType
            Text(
            `${data.workoutType}${data.duration}`,
            {
                "fontWeight": 400,
                "fontColor": $theme('supportContentColor'),
                "fontSize": 12,
                "maxLines": 1,
                "textOverflow": "ellipsis",
                "constraintSize": { "minWidth": 0, "minHeight": 0 },
                "margin": { "top": 2 }
            }
        )
            #else
            Text(
            data.duration,
            {
                "fontWeight": 400,
                "fontColor": $theme('supportContentColor'),
                "fontSize": 12,
                "maxLines": 1,
                "textOverflow": "ellipsis",
                "constraintSize": { "minWidth": 0, "minHeight": 0 },
                "margin": { "top": 2 }
            }
        )
            #endif
    ),
    #if props.sourceIcon
    Image(
        props.sourceIcon,
        { "width": 24, "height": 24, "objectFit": "contain", "flexShrink": 0, "fillColor": $theme('supportContentColor') }
    )
    #endif
)

#End
