#Template WorkoutOverviewFull@1(props: { sourceIcon?: asset })
data = {
    workoutType: $optionalPath("/exerciseTypeName"),
    workoutCalories: $path("/exerciseCalorieText"),
    duration: $path("/exerciseDurationText"),
    endTime: $optionalPath("/exerciseEndTimeText")
}

Column(
    {
        "_advancedComponent": "WorkoutOverview",
        "width": "matchParent",
        "height": "matchParent",
        "itemMargin": 4,
        "justifyContent": "spaceBetween",
        "alignItems": "start",
        "constraintSize": {"minWidth": 0, "minHeight": 0}
    },
    Column(
        {
            "itemMargin": 4,
            "justifyContent": "start",
            "width": "matchParent",
            "constraintSize": {"minWidth": 0, "minHeight": 0}
        },
        Row(
            {
                "width": "matchParent",
                "itemMargin": 4,
                "justifyContent": "start",
                "alignItems": "start",
                "constraintSize": {"minWidth": 0, "minHeight": 0}
            },
            #if props.sourceIcon
                Image(
                    props.sourceIcon,
                    {"width": 20, "height": 20, "objectFit": "contain", "flexShrink": 0}
                ),
            #endif
            #if data.workoutType
                Text(
                    data.workoutType,
                    {
                        "width": "matchParent",
                        "fontSize": 12,
                        "fontWeight": 500,
                        "fontColor": $theme('supportContentColor'),
                        "maxLines": 1,
                        "textOverflow": "ellipsis",
                        "constraintSize": {"minWidth": 0, "minHeight": 0}
                    }
                ),
            #else
                Text(
                    "运动记录",
                    {
                        "width": "matchParent",
                        "fontSize": 12,
                        "fontWeight": 500,
                        "fontColor": $theme('supportContentColor'),
                        "maxLines": 1,
                        "textOverflow": "ellipsis",
                        "constraintSize": {"minWidth": 0, "minHeight": 0}
                    }
                )
            #endif
        )
    ),
    Column(
        {
            "itemMargin": 4,
            "justifyContent": "start",
            "width": "matchParent",
            "constraintSize": {"minWidth": 0, "minHeight": 0}
        },
        Text(
            data.workoutCalories,
            { "height": 24,
                "fontSize": 18,
                "fontWeight": 800,
                "fontColor": $theme('primaryColor'),
                "maxLines": 1,
                "textOverflow": "ellipsis",
                "constraintSize": {"minWidth": 0, "minHeight": 0}
            }
        ),
        Row(
            {
              "width": "matchParent",
              "itemMargin": 4,
              "justifyContent": "start",
              "alignItems": "center",
              "constraintSize": {"minWidth": 0, "minHeight": 0}
            },
            #if data.endTime
            Text(
                `${data.duration} | ${data.endTime}`,
                {
                    "fontWeight": 400,
                    "fontColor": $theme('supportContentColor'),
                    "fontSize": 12,
                    "maxLines": 1,
                    "textOverflow": "ellipsis",
                    "constraintSize": {"minWidth": 0, "minHeight": 0}
                }
            ),
            #else
            Text(
                data.duration,
                {
                    "fontWeight": 400,
                    "fontColor": $theme('supportContentColor'),
                    "fontSize": 12,
                    "maxLines": 1,
                    "textOverflow": "ellipsis",
                    "constraintSize": {"minWidth": 0, "minHeight": 0}
                }
            )
            #endif
        )
    )
)
#End

#Template WorkoutOverviewCompact@1(props: { sourceIcon?: asset })
data = {
    workoutType: $optionalPath("/exerciseTypeName"),
    workoutCalories: $path("/exerciseCalorieText"),
    duration: $path("/exerciseDurationText")
}

Column(
    {
        "_advancedComponent": "WorkoutOverview",
        "width": "matchParent",
        "height": "matchParent",
        "itemMargin": 4,
        "justifyContent": "spaceBetween",
        "alignItems": "start",
        "constraintSize": {"minWidth": 0, "minHeight": 0}
    },
    Row(
        {
            "itemMargin": 4,
            "width": "matchParent",
            "justifyContent": "spaceBetween",
            "alignItems": "top"
        },
        Column(
            {
                "itemMargin": 2,
                "justifyContent": "start",
                "alignItems": "start"
            },
            Text(
                data.workoutCalories,
                { "height": 24,"fontSize": 18, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1}
            ),
            #if data.workoutType
                Text(
                    `${data.workoutType} | ${data.duration}`,
                    {
                        "fontWeight": 400,
                        "fontColor": $theme('supportContentColor'),
                        "fontSize": 12,
                        "maxLines": 1,
                        "textOverflow": "ellipsis",
                        "constraintSize": {"minWidth": 0, "minHeight": 0},
                        "margin": {"top": 2}
                    }
                )
            #else
                Text(
                    data.duration,
                    {
                        "fontWeight": 400,
                        "fontColor": $theme('supportContentColor'),
                        "fontSize": 12,
                        "maxLines": 1,
                        "textOverflow": "ellipsis",
                        "constraintSize": {"minWidth": 0, "minHeight": 0},
                        "margin": {"top": 2}
                    }
                )
            #endif
        ),
        #if props.sourceIcon
          Image(
              props.sourceIcon,
              {"width": 20, "height": 20, "objectFit": "contain", "flexShrink": 0}
          )
        #endif
    )
)
#End

#Template WorkoutOverviewHero@1(props: { sourceIcon?: asset })
data = {
    workoutType: $optionalPath("/exerciseTypeName"),
    workoutCalories: $optionalPath("/exerciseCalorieText"),
    duration: $path("/exerciseDurationText")
}

Column(
    {
        "_advancedComponent": "WorkoutOverview",
        "width": "matchParent",
        "height": "matchParent",
        "itemMargin": 8,
        "justifyContent": "start",
        "alignItems": "start",
        "clip": true,
        "constraintSize": {"minWidth": 0, "minHeight": 0}
    },
    Row(
        {"width": "matchParent", "itemMargin": 4, "justifyContent": "spaceBetween", "alignItems": "top"},
        #if data.workoutType
            Text(
                data.workoutType,
                {"fontSize": 12, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1}
            ),
        #else
            Text(
                "运动记录",
                {"fontSize": 12, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1}
            )
        #endif
        #if props.sourceIcon
          Image(
              props.sourceIcon,
              {"width": 20, "height": 20, "objectFit": "contain", "flexShrink": 0}
          )
        #endif
    ),
    #if data.workoutCalories
        Text(
            data.workoutCalories,
            { "height": 24,"fontSize": 18, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1}
        ),
    #else
        Text(
            data.duration,
            { "width": "matchParent", "height": 34,"fontSize": 24, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1}
        ),
    #endif
    Row(
        {
            "itemMargin": 4,
            "width": "matchParent",
            "justifyContent": "start"
        },
        Text(
            "运动时长",
            {"fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1}
        ),
        #if data.workoutCalories
            Text(
                data.duration,
                {"fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1}
            )
        #endif
    )
)
#End

#Template WorkoutOverviewSupport@1(props: { sourceIcon?: asset, actionId?: string })
data = {
    workoutType: $optionalPath("/exerciseTypeName"),
    workoutCalories: $path("/exerciseCalorieText"),
    duration: $path("/exerciseDurationText")
}

Row(
    {
        "_advancedComponent": "WorkoutOverview",
        "width": "matchParent",
        "height": "matchParent",
        "itemMargin": 4,
        "justifyContent": "spaceBetween",
        "alignItems": "center",
        "padding": { "left": 8, "right": 8 },
        "onClick": EventAction(props?.actionId)
    },
    Column(
        {
            "itemMargin": 2,
            "justifyContent": "start",
            "alignItems": "start"
        },
        Text(
            data.workoutCalories,
            { "fontSize": 14, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1 }
        ),
        #if data.workoutType
            Text(
            `${data.workoutType}${data.duration}`,
            {
                "fontWeight": 400,
                "fontColor": $theme('supportContentColor'),
                "fontSize": 12,
                "maxLines": 1,
                "textOverflow": "ellipsis",
                "constraintSize": { "minWidth": 0, "minHeight": 0 },
                "margin": { "top": 2 }
            }
        )
            #else
            Text(
            data.duration,
            {
                "fontWeight": 400,
                "fontColor": $theme('supportContentColor'),
                "fontSize": 12,
                "maxLines": 1,
                "textOverflow": "ellipsis",
                "constraintSize": { "minWidth": 0, "minHeight": 0 },
                "margin": { "top": 2 }
            }
        )
            #endif
    ),
    #if props.sourceIcon
    Image(
        props.sourceIcon,
        { "width": 24, "height": 24, "objectFit": "contain", "flexShrink": 0, "fillColor": $theme('supportContentColor') }
    )
    #endif
)

#End

#Template WorkoutOverviewTrainingRecordWideFull@1(props: { timeIcon?: asset, actionIcon?: asset, actionId?: string })
data = {
    workoutType: $path("/exerciseTypeName"),
    workoutDate: $path("/targetDateText"),
    duration: $path("/exerciseDurationText"),
    startTime: $path("/exerciseStartTimeText"),
    endTime: $path("/exerciseEndTimeText"),
    heartRateAvg: $path("/exerciseHeartRateAvg"),
    heartRateMax: $path("/exerciseHeartRateMax"),
}

Column(
    {
        "_advancedComponent": "WorkoutOverview",
        "width": "matchParent",
        "height": "matchParent",
        "itemMargin": 8,
        "justifyContent": "start",
        "alignItems": "start",
        "clip": true,
        "constraintSize": { "minWidth": 0, "minHeight": 0 }
    },
    Row(
        {
            "width": "matchParent",
            "height": "matchParent",
            "layoutWeight": 1,
            "itemMargin": 8,
            "clip": true,
            "constraintSize": { "minWidth": 0, "minHeight": 0 }
        },
        Column(
            {
                "layoutWeight": 1,
                "height": "matchParent",
                "itemMargin": 4,
                "justifyContent": "spaceBetween",
                "alignItems": "start",
                "clip": true,
                "constraintSize": { "minWidth": 0, "minHeight": 0 }
            },
            Row(
                { "width": "matchParent", "itemMargin": 4, "justifyContent": "spaceBetween", "alignItems": "top" },
                #if data.workoutType
                    Text(
                        data.workoutType,
                        { "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1 }
                    ),
                #else
                    Text(
                        "训练记录",
                        { "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1 }
                    )
                #endif
            ),
            Column(
                {
                    "height": 60,
                    "itemMargin": 2,
                    "justifyContent": "start",
                    "alignItems": "start",
                    "constraintSize": { "minWidth": 0, "minHeight": 0 }
                },
                Row(
                    { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "bottom" },
                    Text(
                        data.duration,
                        { "fontSize": 28, "fontWeight": 800, "fontColor": $theme('primaryColor'), "maxLines": 1 }
                    )
                ),
                Text(
                    data.workoutDate,
                    {
                        "width": "matchParent",
                        "fontSize": 12,
                        "fontWeight": 400,
                        "fontColor": $theme('supportContentColor'),
                        "maxLines": 1,
                        "textOverflow": "ellipsis",
                        "constraintSize": { "minWidth": 0, "minHeight": 0 }
                    }
                )
            ),
            Column(
                {
                    "width": "matchParent",
                    "itemMargin": 4,
                    "justifyContent": "end",
                    "alignItems": "start",
                    "constraintSize": { "minWidth": 0, "minHeight": 0 }
                },
                Row(
                    { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center" },
                    Text(
                        "平均心率",
                        { "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1 }
                    ),
                    Text(
                        Expr(data.heartRateAvg + "次/分钟"),
                        { "fontSize": 12, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1 }
                    )
                ),
                Row(
                    { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center" },
                    Text(
                        "最高心率",
                        { "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1 }
                    ),
                    Text(
                        Expr(data.heartRateMax + "次/分钟"),
                        { "fontSize": 12, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1 }
                    )
                )
            )
        ),
        Column(
            {
                "layoutWeight": 1,
                "height": "matchParent",
                "itemMargin": 8,
                "justifyContent": "spaceBetween",
                "alignItems": "start",
                "clip": true,
                "constraintSize": { "minWidth": 0, "minHeight": 0 }
            },
            Row(
                {
                    "width": "matchParent",
                    "layoutWeight": 1,
                    "itemMargin": 4,
                    "alignItems": "center",
                    "padding": { "left": 12, "top": 8, "right": 12, "bottom": 8 },
                    "backgroundColor": $theme('progressBackgroundColor'),
                    "borderRadius": 16,
                    "clip": true,
                    "constraintSize": { "minWidth": 0, "minHeight": 0 }
                },
                Column(
                    {
                        "layoutWeight": 1,
                        "itemMargin": 2,
                        "justifyContent": "center",
                        "alignItems": "start",
                        "clip": true,
                        "constraintSize": { "minWidth": 0, "minHeight": 0 }
                    },
                    Text(
                        `${data.startTime}-${data.endTime}`,
                        {
                            "width": "matchParent",
                            "fontSize": 14,
                            "fontWeight": 700,
                            "fontColor": $theme('primaryColor'),
                            "maxLines": 1,
                            "textOverflow": "ellipsis",
                            "constraintSize": { "minWidth": 0, "minHeight": 0 }
                        }
                    ),
                    Text(
                        "运动时间",
                        { "fontSize": 12, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1 }
                    )
                ),
                #if props.timeIcon
                    Image(
                        props.timeIcon,
                        { "width": 24, "height": 24, "objectFit": "contain", "flexShrink": 0, "fillColor": $theme('supportContentColor') }
                    )
                #endif
            ),
            #if props.actionId
                Row(
                    {
                        "width": "matchParent",
                        "layoutWeight": 1,
                        "itemMargin": 4,
                        "alignItems": "center",
                        "padding": { "left": 12, "top": 8, "right": 12, "bottom": 8 },
                        "backgroundColor": $theme('actionStyle.backgroundColor'),
                        "borderRadius": 16,
                        "onClick": EventAction(props.actionId),
                        "clip": true,
                        "constraintSize": { "minWidth": 0, "minHeight": 0 }
                    },
                    Column(
                        {
                            "layoutWeight": 1,
                            "itemMargin": 2,
                            "justifyContent": "center",
                            "alignItems": "start",
                            "clip": true,
                            "constraintSize": { "minWidth": 0, "minHeight": 0 }
                        },
                        Text(
                            "打开锻炼",
                            {
                                "width": "matchParent",
                                "fontSize": 14,
                                "fontWeight": 500,
                                "fontColor": $theme('actionStyle.contentColor'),
                                "maxLines": 1,
                                "textOverflow": "ellipsis",
                                "constraintSize": { "minWidth": 0, "minHeight": 0 }
                            }
                        )
                    ),
                    #if props.actionIcon
                        Image(
                            props.actionIcon,
                            { "width": 24, "height": 24, "objectFit": "contain", "flexShrink": 0, "fillColor": $theme('supportContentColor') }
                        )
                    #endif
                )
            #endif
        )
    )
)
#End
