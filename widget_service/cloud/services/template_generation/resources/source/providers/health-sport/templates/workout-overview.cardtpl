#Template WorkoutOverviewFull@1(props: { sourceIcon?: asset })
data = {
    workoutType: $path("/exerciseTypeName"),
    workoutCalories: $path("/exerciseCalorieText"),
    duration: $path("/exerciseDurationText"),
    endTime: $path("/exerciseEndTimeText")
}

Column(
  {
    "_advancedComponent": "WorkoutOverview",
    "width": "matchParent",
    "height": "matchParent",
    "itemMargin": 4,
    "justifyContent": "spaceBetween",
    "alignItems": "start",
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
  Column(
      {
        "itemMargin": 4,
        "justifyContent": "start",
        "width": "matchParent",
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      },
      Row(
            {
              "width": "matchParent",
              "itemMargin": 4,
              "justifyContent": "start",
              "alignItems": "center",
              "constraintSize": {"minWidth": 0, "minHeight": 0}
            },
            IfPresent(
                    props.sourceIcon,
                    Image(
                              props.sourceIcon,
                              {"width": 20, "height": 20, "objectFit": "contain", "flexShrink": 0, "_preserveOriginalColor": true}
                            )
                  ),
            Text(
                    data.workoutType,
                    {
                      "width": "matchParent",
                      "fontSize": 12,
                      "fontWeight": 500,
                      "fontColor": $theme('supportContentColor'),
                      "maxLines": 1,
                      "textOverflow": "ellipsis",
                      "constraintSize": {"minWidth": 0, "minHeight": 0}
                    }
                  )
          ),
      Row(
            {
              "width": "matchParent",
              "itemMargin": 4,
              "justifyContent": "start",
              "alignItems": "bottom",
              "constraintSize": {"minWidth": 0, "minHeight": 0}
            },
            Text(
                    data.workoutCalories,
                    {
                      "fontSize": 30,
                      "fontWeight": 800,
                      "fontColor": $theme('primaryColor'),
                      "maxLines": 1,
                      "textOverflow": "ellipsis",
                      "constraintSize": {"minWidth": 0, "minHeight": 0}
                    }
                  )
          ),
      Progress(
            {
              "value": 20,
              "total": 100,
              "color": $theme('supportContentColor'),
              "backgroundColor": "#1AFFFFFF",
              "strokeWidth": 8,
              "height": 12,
              "width": "matchParent"
            }
          )
    ),
  Column(
      {
        "itemMargin": 4,
        "justifyContent": "start",
        "width": "matchParent",
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      },
      Row(
            {
              "width": "matchParent",
              "itemMargin": 4,
              "justifyContent": "start",
              "alignItems": "center",
              "constraintSize": {"minWidth": 0, "minHeight": 0}
            },
            Text(
                    data.duration,
                    {
                      "fontWeight": 400,
                      "fontColor": $theme('supportContentColor'),
                      "fontSize": 12,
                      "maxLines": 1,
                      "textOverflow": "ellipsis",
                      "constraintSize": {"minWidth": 0, "minHeight": 0}
                    }
                  )
          ),
      Row(
            {
              "width": "matchParent",
              "itemMargin": 4,
              "justifyContent": "start",
              "alignItems": "center",
              "constraintSize": {"minWidth": 0, "minHeight": 0}
            },
            Text(
                    data.endTime,
                    {
                      "fontWeight": 400,
                      "fontColor": $theme('supportContentColor'),
                      "fontSize": 12,
                      "maxLines": 1,
                      "textOverflow": "ellipsis",
                      "constraintSize": {"minWidth": 0, "minHeight": 0}
                    }
                  )
          )
    )
)
#End
