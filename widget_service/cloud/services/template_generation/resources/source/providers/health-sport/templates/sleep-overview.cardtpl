#Template SleepOverviewScoreFull@1(props: { sourceIcon?: asset })
data = {
    score: $path("/sleepScore"),
    duration: $path("/nightSleepDurationText"),
    status: $optionalPath("/sleepStatus"),
    deepDuration: $optionalPath("/deepSleepDurationText"),
}

Column(
    {
        "_advancedComponent": "SleepOverview",
        "width": "matchParent",
        "height": "matchParent",
        "itemMargin": 4,
        "justifyContent": "spaceBetween",
        "alignItems": "start",
        "clip": true,
        "constraintSize": { "minWidth": 0, "minHeight": 0 }
    },
    Column(
        { "width": "matchParent", "itemMargin": 8, "justifyContent": "start", "alignItems": "start", "constraintSize": { "minWidth": 0, "minHeight": 0 } },
        Row(
            { "width": "matchParent", "itemMargin": 4, "justifyContent": "spaceBetween", "alignItems": "top" },
            #if data.status
                Text(
                    Expr('睡眠健康：' + data.status),
                    { "fontWeight": 400, "fontColor": $theme('supportContentColor'), "fontSize": 12, "maxLines": 1 }
                ),
            #else
                Text(
                    "睡眠监测",
                    { "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1 }
                ),
            #endif
        ),
        Row(
            { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "bottom" },
            Text(
                data.score,
                { "fontSize": 34, "fontWeight": 800, "fontColor": $theme('primaryColor'), "maxLines": 1 }
            ),
            Text(
                "分",
                { "fontSize": 14, "fontWeight": 500, "fontColor": $theme('primaryColor'), "maxLines": 1 }
            )
        )
    ),
    Column(
        { "width": "matchParent", "itemMargin": 8, "justifyContent": "start", "alignItems": "start", "constraintSize": { "minWidth": 0, "minHeight": 0 } },
        Row(
            { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center" },
            Text(
                "总睡眠",
                { "fontWeight": 400, "fontColor": $theme('supportContentColor'), "fontSize": 12, "maxLines": 1 }
            ),
            Text(
                data.duration,
                { "fontSize": 12, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1 }
            )
        ),
        #if data.deepDuration
            Row(
                { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center" },
                Text(
                    "深睡眠",
                    { "fontWeight": 400, "fontColor": $theme('supportContentColor'), "fontSize": 12, "maxLines": 1 }
                ),
                Text(
                    data.deepDuration,
                    { "fontSize": 12, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1 }
                )
            )
        #endif
    )
)
#End
