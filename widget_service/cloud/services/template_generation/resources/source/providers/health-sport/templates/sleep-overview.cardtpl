    Column(
        {
            "itemMargin": 4,
            "justifyContent": "start",
            "alignItems": "start",
        },
        Text(
            data.duration,
            { "fontSize": 14, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1 }
        ),
