  alignItems: "center"
},
  Column("compact", { layoutWeight: 56, itemMargin: 0, clip: true, constraintSize: { minWidth: 0, minHeight: 0 } },
    Column("compact", { width: "matchParent", height: "matchParent", itemMargin: 4, justifyContent: "spaceBetween", alignItems: "start", clip: true, constraintSize: { minWidth: 0, minHeight: 0 } },
