#Template SleepOverviewFull@1(props: { sourceIcon?: asset })
data = {
    duration: $path("/nightSleepDurationText"),
    status: $path("/sleepStatus"),
    score: $optionalPath("/sleepScore"),
    startTime: $optionalPath("/fallAsleepTimeText"),
    endTime: $optionalPath("/wakeupTimeText"),
}

Column(
    {
        "_advancedComponent": "SleepOverview",
        "width": "matchParent",
        "height": "matchParent",
        "itemMargin": 4,
        "justifyContent": "spaceBetween",
        "alignItems": "start",
        "clip": true,
        "constraintSize": { "minWidth": 0, "minHeight": 0 }
    },
    Column(
        { "itemMargin": 8, "justifyContent": "start", "width": "matchParent" },
        Row(
            { "width": "matchParent", "itemMargin": 4, "justifyContent": "spaceBetween", "alignItems": "top" },
            Text(
                "睡眠情况",
                {
                    "fontSize": 12,
                    "fontWeight": 500,
                    "fontColor": $theme('supportContentColor'),
                    "maxLines": 1
                }
            ),
            IfPresent(
                props.sourceIcon,
                Image(
                    props.sourceIcon,
                    { "width": 20, "height": 20, "objectFit": "contain", "flexShrink": 0 }
                )
            ),
        ),
        Row(
            { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "bottom", "margin": {"top": 4} },
            Text(
                data.duration,
                { "fontSize": 24, "fontWeight": 800, "fontColor": $theme('primaryColor'), "maxLines": 1 }
            )
        ),
        IfPresent(
            data.score,
            Progress(
                {
                    "value": data.score,
                    "total": 100,
                    "strokeWidth": 8,
                    "color": $theme('supportContentColor'),
                    "backgroundColor": "#33564AF7",
                    "height": 12,
                    "width": "matchParent"
                }
            )
        )
    ),
    Column(
        { "itemMargin": 4, "justifyContent": "start", "width": "matchParent" },
        IfPresent(
            data.score,
            Row(
                { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center" },
                Text(
                    "睡眠情况评分",
                    { "fontWeight": 400, "fontColor": $theme('supportContentColor'), "fontSize": 12, "maxLines": 1 }
                ),
                Text(
                    data.score,
                    { "fontSize": 12, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1 }
                ),
                Text(
                    "分",
                    { "fontWeight": 400, "fontColor": $theme('supportContentColor'), "fontSize": 12, "maxLines": 1 }
                )
            ),
        ),
        IfAbsent(
            data.score,
            IfPresent(
                data.startTime & data.endTime,
                Row(
                    { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center" },
                    Text(
                        "时段 ",
                        { "fontWeight": 400, "fontColor": $theme('supportContentColor'), "fontSize": 12, "maxLines": 1 }
                    ),
                    Text(
                        `${data.startTime}-${data.endTime}`,
                        { "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1 }
                    ),
                ),
            )
        ),
        Row(
            { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center" },
            Text(
                `状况${data.status}`,
                {
                    "fontSize": 12,
                    "fontColor": $theme('supportContentColor'),
                    "maxLines": 1,
                    "fontWeight": 400,
                }
            )
        )
    )
)
#End

#Template SleepOverviewHero@1(props: { sourceIcon?: asset })
data = {
    duration: $path("/nightSleepDurationText"),
    status: $optionalPath("/sleepStatus"),
    score: $optionalPath("/sleepScore"),
    startTime: $optionalPath("/fallAsleepTimeText"),
    endTime: $optionalPath("/wakeupTimeText"),
}

Column(
    {
        "_advancedComponent": "SleepOverview",
        "width": "matchParent",
        "height": "matchParent",
        "itemMargin": 8,
        "justifyContent": "start",
        "alignItems": "start",
        "clip": true,
        "constraintSize": { "minWidth": 0, "minHeight": 0 }
    },
    Row(
        { "width": "matchParent", "itemMargin": 4, "justifyContent": "spaceBetween", "alignItems": "top" },
        Text(
            "睡眠情况",
            { "fontSize": 12, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1 }
        ),
        IfPresent(
            props.sourceIcon,
            Image(
                props.sourceIcon,
                { "width": 20, "height": 20, "objectFit": "contain", "flexShrink": 0 }
            )
        ),
    ),
    Row(
        { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center", "margin": {"top": 4} },
        Text(
            data.duration,
            { "fontSize": 24, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1 }
        )
    ),
    IfPresent(
        data.score,
        Progress(
            {
                "value": data.score,
                "total": 100,
                "strokeWidth": 8,
                "color": $theme('supportContentColor'),
                "backgroundColor": "#33564AF7",
                "height": 12,
                "width": "matchParent"
            }
        )
    ),
    IfAbsent(
        data.score,
        IfPresent(
            data.status,
            Text(
                `状况${data.status}`,
                {
                    "fontSize": 12,
                    "fontColor": $theme('supportContentColor'),
                    "maxLines": 1,
                    "fontWeight": 400,
                }
            )
        )
    ),
    IfAbsent(
        data.score,
        IfAbsent(
            data.status,
            IfPresent(
                data.startTime & data.endTime,
                Row(
                    { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center" },
                    Text(
                        "时段 ",
                        { "fontWeight": 400, "fontColor": $theme('supportContentColor'), "fontSize": 12, "maxLines": 1 }
                    ),
                    Text(
                        `${data.startTime}-${data.endTime}`,
                        { "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1 }
                    ),
                ),
            )
        )
    )
)
#End

#Template SleepOverviewCompact@1(props: { sourceIcon?: asset })
data = {
    duration: $path("/nightSleepDurationText"),
    score: $path("/sleepScore")
}

Column(
    {
        "_advancedComponent": "SleepOverview",
        "width": "matchParent",
        "height": "matchParent",
        "itemMargin": 4,
        "justifyContent": "start",
        "alignItems": "start",
        "clip": true,
        "constraintSize": { "minWidth": 0, "minHeight": 0 }
    },
    Row(
        { "itemMargin": 4, "width": "matchParent", "justifyContent": "start", "alignItems": "top" },
        Column(
            {
                "width": "matchParent",
                "itemMargin": 2,
                "justifyContent": "start",
                "alignItems": "start",
                "layoutWeight": 1
            },
            Text(
                data.duration,
                { "fontSize": 16, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1 }
            ),
            Text(
                "睡眠情况时长",
                { "fontSize": 12, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1 }
            ),
        ),
        Stack(
            { "width": 44, "height": 44, "alignContent": "center", "flexShrink": 0 },
            Progress(
                {
                    "value": data.score,
                    "total": 100,
                    "type": "ring",
                    "color": $theme('supportContentColor'),
                    "backgroundColor": "#33564AF7",
                    "width": 44,
                    "height": 44,
                    "strokeWidth": 6
                }
            ),
            IfPresent(
                props.sourceIcon,
                Image(
                    props.sourceIcon,
                    { "width": 20, "height": 20, "objectFit": "contain" }
                )
            )
        )
    )
)
#End

#Template SleepOverviewSupport@1(props: { sourceIcon?: asset, actionId?: string })
data = {
    duration: $path("/nightSleepDurationText"),
    score: $path("/sleepScore")
}

Stack({
  "width": "matchParent",
  "height": "matchParent",
  "alignContent": "topStart"
},
  Column(
      {
          "_advancedComponent": "SleepOverview",
          "width": "matchParent",
          "height": "matchParent",
          "itemMargin": 4,
          "justifyContent": "start",
          "alignItems": "start",
          "clip": true,
          "constraintSize": { "minWidth": 0, "minHeight": 0 }
      },
      Row(
          { "itemMargin": 4, "width": "matchParent", "justifyContent": "start", "alignItems": "top" },
          Column(
              {
                  "width": "matchParent",
                  "itemMargin": 2,
                  "justifyContent": "start",
                  "alignItems": "start",
                  "layoutWeight": 1
              },
              Text(
                  data.duration,
                  { "fontSize": 16, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1 }
              ),
              Text(
                  "睡眠情况时长",
                  { "fontSize": 12, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1 }
              ),
          ),
          Stack(
              { "width": 44, "height": 44, "alignContent": "center", "flexShrink": 0 },
              Progress(
                  {
                      "value": data.score,
                      "total": 100,
                      "type": "ring",
                      "color": $theme('supportContentColor'),
                      "backgroundColor": "#33564AF7",
                      "width": 44,
                      "height": 44,
                      "strokeWidth": 6
                  }
              ),
              IfPresent(
                  props.sourceIcon,
                  Image(
                      props.sourceIcon,
                      { "width": 20, "height": 20, "objectFit": "contain" }
                  )
              )
          )
      )
  ),
  IfPresent(props.actionId,
    Stack({
      "width": "matchParent",
      "height": "matchParent",
      "alignContent": "center",
      "onClick": EventAction(props.actionId)
    },
      Text("", {
        "width": "matchParent",
        "height": "matchParent"
      })
    )
  )
)
#End
