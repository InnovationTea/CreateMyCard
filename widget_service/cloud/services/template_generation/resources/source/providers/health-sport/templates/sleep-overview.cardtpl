        ),
    ),
    #if props.sourceIcon
    Image(
        props.sourceIcon,
        {
            "width": 24,
            "height": 24, "flexShrink": 0,
            "fillColor": $theme("supportContentColor")
        }
    )
    #endif
)
#End

#Template SleepOverviewScoreDetailWideFull@1(props: { sourceIcon?: asset })
data = {
    score: $path("/sleepScore"),
    duration: $path("/nightSleepDurationText"),
    status: $optionalPath("/sleepStatus"),
    napDuration: $optionalPath("/totalNapDurationText"),
    deepDuration: $optionalPath("/deepSleepDurationText"),
}

Row(
    {
        "_advancedComponent": "SleepOverview",
        "width": "matchParent",
        "height": "matchParent",
        "itemMargin": 8,
        "clip": true,
        "constraintSize": { "minWidth": 0, "minHeight": 0 }
    },
    Column(
        {
            "layoutWeight": 1,
            "height": "matchParent",
            "itemMargin": 4,
            "justifyContent": "spaceBetween",
            "alignItems": "start",
            "clip": true,
            "constraintSize": { "minWidth": 0, "minHeight": 0 }
        },
        Text(
            "睡眠监测",
            { "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1 }
        ),
        Column(
            {
                "height": 70,
                "itemMargin": 2,
                "justifyContent": "start",
                "alignItems": "start",
                "constraintSize": { "minWidth": 0, "minHeight": 0 }
            },
            Row(
                { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "bottom" },
                Text(
                    data.score,
                    { "fontSize": 34, "fontWeight": 800, "fontColor": $theme('primaryColor'), "maxLines": 1 }
                ),
                Text(
                    "分",
                    { "fontSize": 14, "fontWeight": 500, "fontColor": $theme('primaryColor'), "maxLines": 1 }
                )
            ),
            Text(
                "睡眠得分",
                { "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1 }
            )
        ),
        #if data.status
            Row(
                { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center" },
                Text(
                    "睡眠状况",
                    { "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1 }
                ),
                Text(
                    data.status,
                    { "fontSize": 12, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1 }
                )
            )
        #endif
    ),
    Column(
        {
            "layoutWeight": 1,
            "height": "matchParent",
            "itemMargin": 8,
            "justifyContent": "spaceBetween",
            "alignItems": "start",
            "clip": true,
            "constraintSize": { "minWidth": 0, "minHeight": 0 }
        },
        Row(
            {
                "width": "matchParent",
                "layoutWeight": 1,
                "itemMargin": 4,
                "alignItems": "center",
                "padding": { "left": 12, "top": 8, "right": 12, "bottom": 8 },
                "backgroundColor": $theme('progressBackgroundColor'),
                "borderRadius": 16,
                "clip": true,
                "constraintSize": { "minWidth": 0, "minHeight": 0 }
            },
            Column(
                {
                    "layoutWeight": 1,
                    "itemMargin": 2,
                    "justifyContent": "center",
                    "alignItems": "start",
                    "clip": true,
                    "constraintSize": { "minWidth": 0, "minHeight": 0 }
                },
                Text(
                    data.duration,
                    { "fontSize": 16, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1 }
                ),
                Text(
                    "睡眠总时长",
                    { "fontSize": 12, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1 }
                )
            ),
            #if props.sourceIcon
                Image(
                    props.sourceIcon,
                    { "width": 24, "height": 24, "objectFit": "contain", "flexShrink": 0, "fillColor": $theme('supportContentColor') }
                )
            #endif
        ),
        #if data.napDuration || data.deepDuration
            Row(
                {
                    "width": "matchParent",
                    "layoutWeight": 1,
                    "itemMargin": 4,
                    "alignItems": "center",
                    "padding": { "left": 12, "top": 8, "right": 12, "bottom": 8 },
                    "backgroundColor": $theme('progressBackgroundColor'),
                    "borderRadius": 16,
                    "clip": true,
                    "constraintSize": { "minWidth": 0, "minHeight": 0 }
                },
                Column(
                    {
                        "layoutWeight": 1,
                        "itemMargin": 2,
                        "justifyContent": "center",
                        "alignItems": "start",
                        "clip": true,
                        "constraintSize": { "minWidth": 0, "minHeight": 0 }
                    },
                    #if data.deepDuration
                        Row(
                            { "width": "matchParent", "itemMargin": 4, "justifyContent": "spaceBetween", "alignItems": "center" },
                            Text(
                                "深睡",
                                { "fontSize": 12, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1 }
                            ),
                            Text(
                                data.deepDuration,
                                { "fontSize": 12, "fontWeight": 500, "fontColor": $theme('primaryColor'), "maxLines": 1 }
                            )
                        ),
                    #endif
                    #if data.napDuration
                        Row(
                            { "width": "matchParent", "itemMargin": 4, "justifyContent": "spaceBetween", "alignItems": "center" },
                            Text(
                                "小睡",
                                { "fontSize": 12, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1 }
                            ),
                            Text(
                                data.napDuration,
                                { "fontSize": 12, "fontWeight": 500, "fontColor": $theme('primaryColor'), "maxLines": 1 }
                            )
                        ),
                    #endif
                )
            )
        #endif
    )
)
#End

#Template SleepOverviewNapFull@1(props: { sourceIcon?: asset })
data = {
    duration: $path("/totalNapDurationText"),
    startTime: $optionalPath("/fallAsleepTimeText"),
    endTime: $optionalPath("/wakeupTimeText"),
}

Column(
    {
        "_advancedComponent": "SleepOverview",
        "width": "matchParent",
        "height": "matchParent",
        "itemMargin": 4,
        "justifyContent": "spaceBetween",
        "alignItems": "start",
        "clip": true,
        "constraintSize": { "minWidth": 0, "minHeight": 0 }
    },
    #if data.startTime && data.endTime
    Column(
        { "itemMargin": 8, "justifyContent": "start", "width": "matchParent" },
        Row(
            { "width": "matchParent", "itemMargin": 4, "justifyContent": "spaceBetween", "alignItems": "top" },
            Text(
                "作息提醒",
                {
                    "fontSize": 12,
                    "fontWeight": 500,
                    "fontColor": $theme('supportContentColor'),
                    "maxLines": 1
                }
            ),
            #if props.sourceIcon
                Image(
                    props.sourceIcon,
                    { "width": 20, "height": 20, "fillColor": $theme('supportContentColor'), "objectFit": "contain", "flexShrink": 0 }
                )
            #endif
        ),
        Row(
            { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "bottom", "margin": {"top": 4} },
            Text(
                data.duration,
                { "width": "matchParent", "height": 28, "fontSize": 20, "fontWeight": 800, "fontColor": $theme('primaryColor'), "maxLines": 1 }
            )
        )
    ),
    Column(
        { "itemMargin": 4, "justifyContent": "start", "width": "matchParent" },
        Row(
            { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center" },
            Text(
                "时段 ",
                { "fontWeight": 400, "fontColor": $theme('supportContentColor'), "fontSize": 12, "maxLines": 1 }
            ),
            Text(
                `${data.startTime}-${data.endTime}`,
                { "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1 }
            )
        )
    )
    #else
    Text(
        "睡眠监测",
        {"width": "matchParent", "margin": {"top": 8}, "fontSize": 16, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textAlign": "center", "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    ),
    Text(
        data.duration,
        {"width": "matchParent", "fontSize": 38, "minFontSize": 24, "fontWeight": 800, "fontColor": $theme('primaryColor'), "maxLines": 1, "textAlign": "center", "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    ),
    Text(
        "小睡时长",
        {"width": "matchParent", "fontSize": 12, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textAlign": "center", "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    )
    #endif
)
#End

