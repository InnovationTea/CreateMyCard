#Template SleepOverviewFull@1(props: { sourceIcon?: asset })
data = {
    duration: $path("/nightSleepDurationText"),
    napDuration: $optionalPath("/totalNapDurationText"),
    deepDuration: $optionalPath("/deepSleepDurationText"),
    type: $optionalPath("/sleepTypeDesc"),
    status: $optionalPath("/sleepStatus"),
    score: $optionalPath("/sleepScore"),
    startTime: $optionalPath("/fallAsleepTimeText"),
    endTime: $optionalPath("/wakeupTimeText"),
}

Column(
    {
        "_advancedComponent": "SleepOverview",
        "width": "matchParent",
        "height": "matchParent",
        "itemMargin": 4,
        "justifyContent": "spaceBetween",
        "alignItems": "start",
        "clip": true,
        "constraintSize": { "minWidth": 0, "minHeight": 0 }
    },
    Column(
        { "itemMargin": 8, "justifyContent": "start", "width": "matchParent", "layoutWeight": 1 },
        Row(
            { "width": "matchParent", "itemMargin": 4, "justifyContent": "spaceBetween", "alignItems": "top" },
            #if data.type
                #if data.status && data.duration
                    #if data.deepDuration
                    Text(
                        Expr(data.type + ' ' + data.status),
                        { "fontWeight": 400, "fontColor": $theme('supportContentColor'), "fontSize": 12, "maxLines": 1 }
                    ),
                    #elseif data.napDuration
                    Text(
                        Expr(data.type + ' ' + data.status),
                        { "fontWeight": 400, "fontColor": $theme('supportContentColor'), "fontSize": 12, "maxLines": 1 }
                    ),
                    #else
                    Text(
                        data.type,
                        {
                            "fontSize": 12,
                            "fontWeight": 400,
                            "fontColor": $theme('supportContentColor'),
                            "maxLines": 1
                        }
                    ),
                    #endif
                #else
                Text(
                    data.type,
                    {
                        "fontSize": 12,
                        "fontWeight": 400,
                        "fontColor": $theme('supportContentColor'),
                        "maxLines": 1
                    }
                ),
                #endif
            #else
                #if data.status && data.duration
                    #if data.deepDuration
                    Text(
                        Expr('睡眠健康：' + data.status),
                        { "fontWeight": 400, "fontColor": $theme('supportContentColor'), "fontSize": 12, "maxLines": 1 }
                    ),
                    #elseif data.napDuration
                    Text(
                        Expr('睡眠健康：' + data.status),
                        { "fontWeight": 400, "fontColor": $theme('supportContentColor'), "fontSize": 12, "maxLines": 1 }
                    ),
                    #else
                    Text(
                        "睡眠监测",
                        {
                            "fontSize": 12,
                            "fontWeight": 400,
                            "fontColor": $theme('supportContentColor'),
                            "maxLines": 1
                        }
                    ),
                    #endif
                #else
                Text(
                    "睡眠监测",
                    {
                        "fontSize": 12,
                        "fontWeight": 400,
                        "fontColor": $theme('supportContentColor'),
                        "maxLines": 1
                    }
                ),
                #endif
            #endif
            #if props.sourceIcon
                Image(
                    props.sourceIcon,
                    { "width": 20, "height": 20, "fillColor": $theme('supportContentColor'), "objectFit": "contain", "flexShrink": 0 }
                )
            #endif
        ),
        Row(
            { "width": "matchParent", "justifyContent": "start", "alignItems": "bottom" },
            Text(
                data.duration,
                { "width": "matchParent", "height": 28, "fontSize": 20, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1 }
            )
        ),
    #if data.score
      Progress(
          {
              "value": data.score,
              "total": 100,
              "strokeWidth": 8,
              "color": $theme('progressColor'),
              "backgroundColor": $theme('progressBackgroundColor'),
              "height": 12,
              "width": "matchParent"
          }
      )
    #endif
),
    #if data.score
        Row(
            { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center" },
            Text(
                "睡眠监测评分",
                { "fontWeight": 400, "fontColor": $theme('supportContentColor'), "fontSize": 12, "maxLines": 1 }
            ),
            Text(
                data.score,
                { "fontSize": 12, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1 }
            ),
            Text(
                "分",
                { "fontWeight": 400, "fontColor": $theme('supportContentColor'), "fontSize": 12, "maxLines": 1 }
            )
        ),
    #else
        #if data.startTime && data.endTime
            Row(
                { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center" },
                Text(
                    "时段",
                    { "fontWeight": 400, "fontColor": $theme('supportContentColor'), "fontSize": 12, "maxLines": 1 }
                ),
                Text(
                    `${data.startTime}-${data.endTime}`,
                    { "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1 }
                ),
            ),
        #endif
    #endif
    #if data.status
        #if data.deepDuration
        #else
            #if data.napDuration
            #else
        Row(
            { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center" },
            Text(
                "睡眠状况",
                { "fontWeight": 400, "fontColor": $theme('supportContentColor'), "fontSize": 12, "maxLines": 1 }
            ),
            Text(
                data.status,
                { "fontSize": 12, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1 }
            )
        ),
            #endif
        #endif
    #endif
    #if data.deepDuration
        Row(
            { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center" },
            Text(
                "深度睡眠",
                { "fontWeight": 400, "fontColor": $theme('supportContentColor'), "fontSize": 12, "maxLines": 1 }
            ),
            Text(
                data.deepDuration,
                { "fontSize": 12, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1 }
            )
        )
    #elseif data.napDuration
        Row(
            { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center" },
            Text(
                "小睡时长",
                { "fontWeight": 400, "fontColor": $theme('supportContentColor'), "fontSize": 12, "maxLines": 1 }
            ),
            Text(
                data.napDuration,
                { "fontSize": 12, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1 }
            )
        )
    #endif
)
#End

#Template SleepOverviewHero@1(props: { sourceIcon?: asset })
data = {
    duration: $path("/nightSleepDurationText"),
    status: $optionalPath("/sleepStatus"),
    score: $optionalPath("/sleepScore"),
    startTime: $optionalPath("/fallAsleepTimeText"),
    endTime: $optionalPath("/wakeupTimeText"),
}

Column(
    {
        "_advancedComponent": "SleepOverview",
        "width": "matchParent",
        "height": "matchParent",
        "itemMargin": 8,
        "justifyContent": "start",
        "alignItems": "start",
        "clip": true,
        "constraintSize": { "minWidth": 0, "minHeight": 0 }
    },
    Row(
        { "width": "matchParent", "itemMargin": 4, "justifyContent": "spaceBetween", "alignItems": "top" },
        Text(
            "睡眠监测",
            { "fontSize": 12, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1 }
        ),
        #if props.sourceIcon
          Image(
              props.sourceIcon,
              { "width": 20, "height": 20, "fillColor": $theme('supportContentColor'), "objectFit": "contain", "flexShrink": 0 }
          )
        #endif
    ),
    Row(
        { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center" },
        Text(
            data.duration,
            { "width": "matchParent", "height": 28, "fontSize": 20, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1 }
        )
    ),
    #if data.score
      Progress(
          {
              "value": data.score,
              "total": 100,
              "strokeWidth": 8,
              "color": $theme('progressColor'),
              "backgroundColor": $theme('progressBackgroundColor'),
              "height": 12,
              "width": "matchParent"
          }
      )
    #else
      #if data.status
        Text(
            `睡眠状况${data.status}`,
            {
                "fontSize": 12,
                "fontColor": $theme('supportContentColor'),
                "maxLines": 1,
                "fontWeight": 400,
            }
        )
      #endif
    #endif
    #if data.score
    #else
      #if data.status
      #else
        #if data.startTime && data.endTime
          Row(
              { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center" },
              Text(
                  "时段 ",
                  { "fontWeight": 400, "fontColor": $theme('supportContentColor'), "fontSize": 12, "maxLines": 1 }
              ),
              Text(
                  `${data.startTime}-${data.endTime}`,
                  { "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1 }
              ),
          ),
        #endif
      #endif
    #endif
)
#End

