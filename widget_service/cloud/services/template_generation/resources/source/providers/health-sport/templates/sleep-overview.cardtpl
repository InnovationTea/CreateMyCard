#Template SleepOverviewCompact@1(props: { sourceIcon?: asset })
data = {
    duration: $path("/nightSleepDurationText"),
    score: $path("/sleepScore")
}

Column(
    "compact",
    {"_advancedComponent": "SleepOverview", "width": "matchParent", "height": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
    Row(
        "between",
        {"width": "matchParent", "justifyContent": "start", "alignItems": "center"},
        Column(
            "compact",
            {"itemMargin": 2, "justifyContent": "start", "alignItems": "start", "layoutWeight": 1},
            Text(
                data.duration,
                "title",
                {"fontSize": 16, "fontWeight": 700, "maxLines": 1}
            ),
            Text(
                "睡眠时长",
                {"fontSize": 12, "fontWeight": 500, "maxLines": 1}
            ),
        ),
        Stack(
            "overlay",
            {"width": 44, "height": 44, "alignContent": "center", "flexShrink": 0},
            Progress(
                {"value": data.score, "total": 100, "type": "ring", "color": "#FFFFFFFF", "backgroundColor": "#1AFFFFFF", "width": 44, "height": 44, "strokeWidth": 6}
            ),
            IfPresent(
                props.sourceIcon,
                Image(
                    props.sourceIcon,
                    "icon",
                    {"width": 20, "height": 20, "objectFit": "contain", "fillColor": "#99FFFFFF"}
                )
            )
        )
    )
)
#End
