#Template("SleepOverview@1", {
  capability: "GetHealthAndSportSummary",
  description: "运动健康数据提供方交付的睡眠概览",
  domainTags: ["sleep", "health", "bedtime"],
  compatibleThemeProfileIds: ["sleep-night-violet", "race-sunrise-action", "race-night-violet"],
  allowedParentComponents: ["Column", "Row", "List", "Stack"],
  bindings: {
    status: { path: "/sleepStatus", type: "string" },
    asleep: { path: "/fallAsleepTimeText", type: "string" },
    wakeup: { path: "/wakeupTimeText", type: "string" }
  },
  params: {
    sleepDurationPrimaryValueText: {
      type: "string", required: true, sourcePaths: ["/nightSleepDurationText"]
    },
    sleepDurationPrimaryUnitText: {
      type: "string", required: true, sourcePaths: ["/nightSleepDurationText"]
    },
    sleepDurationSecondaryValueText: { type: "string", sourcePaths: ["/nightSleepDurationText"] },
    sleepDurationSecondaryUnitText: { type: "string", sourcePaths: ["/nightSleepDurationText"] },
    sourceIcon: { type: "string", kind: "asset", semanticTags: ["sleep"] }
  },
  limits: { maxNodes: 28, maxDepth: 7 }
})

#Variant("duration", { sizes: ["2x2", "2x4"], roles: ["hero"], requires: [], requiresParams: ["sleepDurationPrimaryValueText", "sleepDurationPrimaryUnitText"] })
Column("compact", {
  _advancedComponent: "SleepOverview", width: "matchParent", height: "matchParent",
  itemMargin: 4, justifyContent: "spaceBetween", alignItems: "start", clip: true,
  constraintSize: { minWidth: 0, minHeight: 0 }
},
  Row("between", {
    width: "matchParent", height: 20, itemMargin: 4, justifyContent: "spaceBetween",
    alignItems: "middle", clip: true, constraintSize: { minWidth: 0, minHeight: 0 }
  },
    Text("睡眠", "compact-title", {
      fontSize: 12, minFontSize: 12, fontWeight: 400, fontColor: "#FFFFFFFF",
      maxLines: 1, textOverflow: "ellipsis", layoutWeight: 1,
      constraintSize: { minWidth: 0, minHeight: 0 }
    }),
    IfParam("sourceIcon",
      Image(Asset("sourceIcon"), "icon", { width: 20, height: 20, objectFit: "contain", flexShrink: 0 })
    )
  ),
  Row("between", {
    width: "matchParent", itemMargin: 2, justifyContent: "start", alignItems: "bottom",
    clip: true, constraintSize: { minWidth: 0, minHeight: 0 }
  },
    Row("between", { itemMargin: 0, justifyContent: "start", alignItems: "bottom", constraintSize: { minWidth: 0, minHeight: 0 } },
      Text(Param("sleepDurationPrimaryValueText"), "title", { fontSize: 30, minFontSize: 30, fontWeight: 700, fontColor: "#FFFFFFFF", maxLines: 1, textOverflow: "ellipsis", constraintSize: { minWidth: 0, minHeight: 0 } }),
      Text(Param("sleepDurationPrimaryUnitText"), "subtitle", { fontSize: 12, minFontSize: 12, fontWeight: 400, fontColor: "#99FFFFFF", maxLines: 1, textOverflow: "ellipsis", constraintSize: { minWidth: 0, minHeight: 0 } })
    )
  )
)
#EndVariant

