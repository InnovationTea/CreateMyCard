#Template SleepOverviewFull@1(props: { sourceIcon?: asset })
data = {
    duration: $path("/nightSleepDurationText"),
    napDuration: $optionalPath("/totalNapDurationText"),
    deepDuration: $optionalPath("/deepSleepDurationText"),
    type: $optionalPath("/sleepTypeDesc"),
    status: $optionalPath("/sleepStatus"),
    score: $optionalPath("/sleepScore"),
    startTime: $optionalPath("/fallAsleepTimeText"),
    endTime: $optionalPath("/wakeupTimeText"),
}

Column(
    {
        "_advancedComponent": "SleepOverview",
        "width": "matchParent",
        "height": "matchParent",
        "itemMargin": 4,
        "justifyContent": "spaceBetween",
        "alignItems": "start",
        "clip": true,
        "constraintSize": { "minWidth": 0, "minHeight": 0 }
    },
    Column(
        { "itemMargin": 8, "justifyContent": "start", "width": "matchParent" },
        Row(
            { "width": "matchParent", "itemMargin": 4, "justifyContent": "spaceBetween", "alignItems": "top" },
            #if data.type
                Text(
                    data.type,
                    {
                        "fontSize": 12,
                        "fontWeight": 400,
                        "fontColor": $theme('supportContentColor'),
                        "maxLines": 1
                    }
                ),
            #else
                Text(
                    "睡眠监测",
                    {
                        "fontSize": 12,
                        "fontWeight": 400,
                        "fontColor": $theme('supportContentColor'),
                        "maxLines": 1
                    }
                ),
            #endif
            #if props.sourceIcon
                Image(
                    props.sourceIcon,
                    { "width": 20, "height": 20, "fillColor": $theme('supportContentColor'), "objectFit": "contain", "flexShrink": 0 }
                )
            #endif
        ),
        Row(
            { "width": "matchParent", "justifyContent": "start", "alignItems": "bottom" },
            Text(
                data.duration,
                { "fontSize": 20, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1 }
            )
        ),
        #if data.score
          Progress(
              {
                  "value": data.score,
                  "total": 100,
                  "strokeWidth": 8,
                  "color": $theme('progressColor'),
                  "backgroundColor": $theme('progressBackgroundColor'),
                  "height": 12,
                  "width": "matchParent"
              }
          )
        #endif
    ),
    Column(
        { "itemMargin": 4, "justifyContent": "start", "width": "matchParent" },
        #if data.score
            Row(
                { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center" },
                Text(
                    "睡眠监测评分",
                    { "fontWeight": 400, "fontColor": $theme('supportContentColor'), "fontSize": 12, "maxLines": 1 }
                ),
                Text(
                    data.score,
                    { "fontSize": 12, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1 }
                ),
                Text(
                    "分",
                    { "fontWeight": 400, "fontColor": $theme('supportContentColor'), "fontSize": 12, "maxLines": 1 }
                )
            ),
        #else
            #if data.startTime && data.endTime
                Row(
                    { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center" },
                    Text(
                        "时段",
                        { "fontWeight": 400, "fontColor": $theme('supportContentColor'), "fontSize": 12, "maxLines": 1 }
                    ),
                    Text(
                        `${data.startTime}-${data.endTime}`,
                        { "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1 }
                    ),
                ),
            #endif
        #endif
        #if data.status
            Row(
                { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center" },
                Text(
                    "睡眠状况",
                    { "fontWeight": 400, "fontColor": $theme('supportContentColor'), "fontSize": 12, "maxLines": 1 }
                ),
                Text(
                    data.status,
                    { "fontSize": 12, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1 }
                )
            ),
        #endif
        #if data.deepDuration
            Row(
                { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center" },
                Text(
                    "深度睡眠",
                    { "fontWeight": 400, "fontColor": $theme('supportContentColor'), "fontSize": 12, "maxLines": 1 }
                ),
                Text(
                    data.deepDuration,
                    { "fontSize": 12, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1 }
                )
            )
        #elseif data.napDuration
            Row(
                { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center" },
                Text(
                    "小睡时长",
                    { "fontWeight": 400, "fontColor": $theme('supportContentColor'), "fontSize": 12, "maxLines": 1 }
                ),
                Text(
                    data.napDuration,
                    { "fontSize": 12, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1 }
                )
            )
        #endif
    )
)
#End

#Template SleepOverviewHero@1(props: { sourceIcon?: asset })
data = {
    duration: $path("/nightSleepDurationText"),
    status: $optionalPath("/sleepStatus"),
    score: $optionalPath("/sleepScore"),
    startTime: $optionalPath("/fallAsleepTimeText"),
    endTime: $optionalPath("/wakeupTimeText"),
}

Column(
    {
        "_advancedComponent": "SleepOverview",
        "width": "matchParent",
        "height": "matchParent",
        "itemMargin": 8,
        "justifyContent": "start",
        "alignItems": "start",
        "clip": true,
        "constraintSize": { "minWidth": 0, "minHeight": 0 }
    },
    Row(
        { "width": "matchParent", "itemMargin": 4, "justifyContent": "spaceBetween", "alignItems": "top" },
        Text(
            "睡眠监测",
            { "fontSize": 12, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1 }
        ),
        #if props.sourceIcon
          Image(
              props.sourceIcon,
              { "width": 20, "height": 20, "fillColor": $theme('supportContentColor'), "objectFit": "contain", "flexShrink": 0 }
          )
        #endif
    ),
    Row(
        { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center" },
        Text(
            data.duration,
            { "fontSize": 20, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1 }
        )
    ),
    #if data.score
      Progress(
          {
              "value": data.score,
              "total": 100,
              "strokeWidth": 8,
              "color": $theme('progressColor'),
              "backgroundColor": $theme('progressBackgroundColor'),
              "height": 12,
              "width": "matchParent"
          }
      )
    #else
      #if data.status
        Text(
            `睡眠状况${data.status}`,
            {
                "fontSize": 12,
                "fontColor": $theme('supportContentColor'),
                "maxLines": 1,
                "fontWeight": 400,
            }
        )
      #endif
    #endif
    #if data.score
    #else
      #if data.status
      #else
        #if data.startTime && data.endTime
          Row(
              { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center" },
              Text(
                  "时段 ",
                  { "fontWeight": 400, "fontColor": $theme('supportContentColor'), "fontSize": 12, "maxLines": 1 }
              ),
              Text(
                  `${data.startTime}-${data.endTime}`,
                  { "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1 }
              ),
          ),
        #endif
      #endif
    #endif
)
#End

#Template SleepOverviewCompact@1(props: { sourceIcon?: asset })
data = {
    duration: $path("/nightSleepDurationText")
}

Column(
    {
        "_advancedComponent": "SleepOverview",
        "width": "matchParent",
        "height": "matchParent",
        "itemMargin": 4,
        "justifyContent": "start",
        "alignItems": "start",
        "clip": true,
        "constraintSize": { "minWidth": 0, "minHeight": 0 }
    },
    Row(
        { "itemMargin": 4, "width": "matchParent", "justifyContent": "start", "alignItems": "top" },
        Column(
            {
                "width": "matchParent",
                "itemMargin": 2,
                "justifyContent": "start",
                "alignItems": "start",
                "layoutWeight": 1
            },
            Text(
                data.duration,
                { "fontSize": 20, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1 }
            ),
            Text(
                "睡眠监测时长",
                { "fontSize": 10, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1 }
            )
        ),
        #if props.sourceIcon
          Image(
              props.sourceIcon,
              { "width": 20, "height": 20, "fillColor": $theme('supportContentColor'), "objectFit": "contain", "flexShrink": 0 }
          )
        #endif
    )
)
#End

#Template SleepOverviewSupport@1(props: { sourceIcon?: asset, actionId?: string })
data = {
    duration: $path("/nightSleepDurationText")
}

Row(
    {
        "_advancedComponent": "SleepOverview",
        "itemMargin": 4, "width": "matchParent", "justifyContent": "spaceBetween",
        "alignItems": "center", "padding": { "left": 12, "right": 12 },
        "onClick": EventAction(props?.actionId)
    },
    Column(
        {
            "itemMargin": 4,
            "justifyContent": "start",
            "alignItems": "start",
        },
        Text(
            data.duration,
            { "fontSize": 14, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1 }
        ),
        Text(
            "睡眠监测时长",
            { "fontSize": 12, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1 }
        ),
    ),
    #if props.sourceIcon
    Image(
        props.sourceIcon,
        {
            "width": 24,
            "height": 24,
            "fillColor": $theme("supportContentColor")
        }
    )
    #endif
)
#End

#Template SleepOverviewNapFull@1(props: { sourceIcon?: asset })
data = {
    duration: $path("/totalNapDurationText"),
    startTime: $optionalPath("/fallAsleepTimeText"),
    endTime: $optionalPath("/wakeupTimeText"),
}

Column(
    {
        "_advancedComponent": "SleepOverview",
        "width": "matchParent",
        "height": "matchParent",
        "itemMargin": 4,
        "justifyContent": "spaceBetween",
        "alignItems": "start",
        "clip": true,
        "constraintSize": { "minWidth": 0, "minHeight": 0 }
    },
    Column(
        { "itemMargin": 8, "justifyContent": "start", "width": "matchParent" },
        Row(
            { "width": "matchParent", "itemMargin": 4, "justifyContent": "spaceBetween", "alignItems": "top" },
            Text(
                "作息提醒",
                {
                    "fontSize": 12,
                    "fontWeight": 500,
                    "fontColor": $theme('supportContentColor'),
                    "maxLines": 1
                }
            ),
            #if props.sourceIcon
                Image(
                    props.sourceIcon,
                    { "width": 20, "height": 20, "fillColor": $theme('supportContentColor'), "objectFit": "contain", "flexShrink": 0 }
                )
            #endif
        ),
        Row(
            { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "bottom", "margin": {"top": 4} },
            Text(
                data.duration,
                { "fontSize": 20, "fontWeight": 800, "fontColor": $theme('primaryColor'), "maxLines": 1 }
            )
        )
    ),
    Column(
        { "itemMargin": 4, "justifyContent": "start", "width": "matchParent" },
        #if data.startTime && data.endTime
            Row(
                { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center" },
                Text(
                    "时段 ",
                    { "fontWeight": 400, "fontColor": $theme('supportContentColor'), "fontSize": 12, "maxLines": 1 }
                ),
                Text(
                    `${data.startTime}-${data.endTime}`,
                    { "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1 }
                )
            )
        #endif
    )
)
#End

