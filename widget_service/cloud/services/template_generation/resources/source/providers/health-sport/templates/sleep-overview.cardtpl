#Template SleepOverviewSupport@1(props: { sourceIcon?: asset, actionId?: string })
data = {
    duration: $path("/nightSleepDurationText")
}

Row(
    {
        "_advancedComponent": "SleepOverview",
        "itemMargin": 4, "width": "matchParent", "justifyContent": "spaceBetween",
        "alignItems": "center", "padding": { "left": 8, "right": 8 },
        "onClick": EventAction(props?.actionId)
