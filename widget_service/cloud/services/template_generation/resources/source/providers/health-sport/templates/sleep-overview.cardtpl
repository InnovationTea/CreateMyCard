    Column("compact", {
      width: "matchParent", height: "matchParent", padding: 8, borderRadius: 8,
      backgroundColor: "#24FFFFFF", itemMargin: 8, justifyContent: "center",
      alignItems: "start", clip: true, constraintSize: { minWidth: 0, minHeight: 0 }
    },
      Column("compact", { width: "matchParent", itemMargin: 4, alignItems: "start" },
        Text("入睡", "subtitle", { fontSize: 10, minFontSize: 10, fontWeight: 400, fontColor: "#99FFFFFF", maxLines: 1, textOverflow: "ellipsis", constraintSize: { minWidth: 0, minHeight: 0 } }),
        Text(Bind("asleep"), "body", { fontSize: 14, minFontSize: 14, fontWeight: 500, fontColor: "#FFFFFFFF", maxLines: 1, textOverflow: "ellipsis", constraintSize: { minWidth: 0, minHeight: 0 } })
      ),
      Column("compact", { width: "matchParent", itemMargin: 4, alignItems: "start" },
        Text("醒来", "subtitle", { fontSize: 10, minFontSize: 10, fontWeight: 400, fontColor: "#99FFFFFF", maxLines: 1, textOverflow: "ellipsis", constraintSize: { minWidth: 0, minHeight: 0 } }),
