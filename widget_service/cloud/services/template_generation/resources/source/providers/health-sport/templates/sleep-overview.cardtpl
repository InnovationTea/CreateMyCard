#Template SleepOverviewFull@1(props: { sourceIcon?: asset })
data = {
    duration: $path("/nightSleepDurationText"),
    status: $path("/sleepStatus"),
    score: $path("/sleepScore")
}

Column(
    {
        "_advancedComponent": "SleepOverview",
        "width": "matchParent",
        "height": "matchParent",
        "itemMargin": 4,
        "justifyContent": "start",
        "alignItems": "start",
        "clip": true,
        "constraintSize": {"minWidth": 0, "minHeight": 0}
    },
    Column(
        {
            "width": "matchParent",
            "height": "matchParent",
            "itemMargin": 4,
            "justifyContent": "start",
            "alignItems": "start",
            "clip": true
        },
        Column(
            {
                "width": "matchParent",
                "height": "matchParent",
                "itemMargin": 4,
                "justifyContent": "start",
                "alignItems": "start",
                "clip": true
            },
            Column(
                {"itemMargin": 4, "justifyContent": "spaceBetween", "width": "matchParent", "height": "matchParent"},
                Column(
                    {"itemMargin": 4, "justifyContent": "start", "width": "matchParent"},
                    Row(
                        {"width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center"},
                        IfPresent(
                            props.sourceIcon,
                            Image(
                                props.sourceIcon,
                                {"width": 20, "height": 20, "objectFit": "contain", "flexShrink": 0, "_preserveOriginalColor": true}
                            )
                        ),
                        Text(
                            "睡眠",
                            {
                                "fontSize": 12,
                                "fontWeight": 500,
                                "fontColor": $theme('supportContentColor'),
                                "maxLines": 1
                            }
                        )
                    ),
                    Row(
                        {"width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "bottom"},
                        Text(
                            data.duration,
                            {"fontSize": 30, "fontWeight": 800, "fontColor": $theme('primaryColor'), "maxLines": 1}
                        )
                    ),
                    Progress(
                        {
                            "value": data.score,
                            "total": 100,
                            "strokeWidth": 8,
                            "color": $theme('supportContentColor'),
                            "backgroundColor": "#FF564AF7",
                            "height": 12,
                            "width": "matchParent"
                        }
                    )
                ),
                Column(
                    {"itemMargin": 4, "justifyContent": "start", "width": "matchParent"},
                    Row(
                        {"width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center"},
                        Text(
                            "睡眠评分",
                            {"fontWeight":500,"fontColor": $theme('supportContentColor'),"fontSize": 12, "maxLines": 1}
                        ),
                        Text(
                            data.score,
                            {"fontSize": 12, "fontWeight": 800, "fontColor": $theme('primaryColor'), "maxLines": 1}
                        ),
                        Text(
                            "分",
                            {"fontWeight":500,"fontColor": $theme('supportContentColor'),"fontSize": 12, "maxLines": 1}
                        )
                    ),
                    Row(
                        {"width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center"},
                        Text(
                            data.status,
                            {
                                "fontSize": 12,
                                "fontColor": $theme('supportContentColor'),
                                "maxLines": 1
                            }
                        )
                    )
                )
            )
        )
    )
)
#End

#Template SleepOverviewHero@1(props: { sourceIcon?: asset })
data = {
    duration: $path("/nightSleepDurationText"),
    score: $path("/sleepScore")
}

Column(
    {
        "_advancedComponent": "SleepOverview",
        "width": "matchParent",
        "height": "matchParent",
        "itemMargin": 4,
        "justifyContent": "spaceBetween",
        "alignItems": "start",
        "clip": true,
        "constraintSize": {"minWidth": 0, "minHeight": 0}
    },
    Column(
        {
            "width": "matchParent",
            "height": "matchParent",
            "itemMargin": 4,
            "justifyContent": "start",
            "alignItems": "start",
            "clip": true
        },
        Column(
            {
                "width": "matchParent",
                "height": "matchParent",
                "itemMargin": 4,
                "justifyContent": "start",
                "alignItems": "start",
                "clip": true
            },
            Column(
                {"itemMargin": 4, "justifyContent": "start", "width": "matchParent"},
                Row(
                    {"width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "center"},
                    IfPresent(
                        props.sourceIcon,
                        Image(
                            props.sourceIcon,
                            {"width": 20, "height": 20, "objectFit": "contain", "flexShrink": 0, "_preserveOriginalColor": true}
                        )
                    ),
                    Text(
                        "睡眠",
                        {"fontSize": 12, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1}
                    )
                ),
                Row(
                    {"width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "bottom"},
                    Text(
                        data.duration,
                        {"fontSize": 30, "fontWeight": 800, "fontColor": $theme('primaryColor'), "maxLines": 1}
                    )
                ),
                Progress(
                    {
                        "value": data.score,
                        "total": 100,
                        "strokeWidth": 8,
                        "color": $theme('supportContentColor'),
                        "backgroundColor": "#FF564AF7",
                        "height": 12,
                        "width": "matchParent"
                    }
                )
            )
        )
    )
)
#End

#Template SleepOverviewCompact@1(props: { sourceIcon?: asset })
data = {
    duration: $path("/nightSleepDurationText"),
    score: $path("/sleepScore")
}

Column(
    {
        "_advancedComponent": "SleepOverview",
        "width": "matchParent",
        "height": "matchParent",
        "itemMargin": 4,
        "justifyContent": "start",
        "alignItems": "start",
        "clip": true,
        "constraintSize": {"minWidth": 0, "minHeight": 0}
    },
    Row(
        {"itemMargin":4,"width": "matchParent", "justifyContent": "start", "alignItems": "center"},
        Column(
            {
                "width": "matchParent",
                "itemMargin": 2,
                "justifyContent": "start",
                "alignItems": "start",
                "layoutWeight": 1
            },
            Text(
                data.duration,
                {"fontSize": 16, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1}
            ),
            Text(
                "睡眠时长",
                {"fontSize": 12, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1}
            ),
        ),
        Stack(
            {"width": 44, "height": 44, "alignContent": "center", "flexShrink": 0},
            Progress(
                {
                    "value": data.score,
                    "total": 100,
                    "type": "ring",
                    "color": $theme('supportContentColor'),
                    "backgroundColor": "#FF564AF7",
                    "width": 44,
                    "height": 44,
                    "strokeWidth": 6
                }
            ),
            IfPresent(
                props.sourceIcon,
                Image(
                    props.sourceIcon,
                    {"width": 20, "height": 20, "objectFit": "contain", "_preserveOriginalColor": true}
                )
            )
        )
    )
)
#End
