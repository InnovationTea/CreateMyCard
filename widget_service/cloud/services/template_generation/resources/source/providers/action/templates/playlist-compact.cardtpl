#Template PlaylistCompactAction@1(props: { actionId: string, label: string, icon: asset })
data = {}
Stack({"width": "matchParent", "height": "matchParent",
  "onClick": EventAction(props.actionId)},
  Row({"width": "matchParent", "height": "matchParent",
    "itemMargin": 8, "alignItems": "center"},
    Column({"layoutWeight": 1, "itemMargin": 2},
      Text("30 首", {"width": "matchParent", "height": 22, "fontSize": 16,
        "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1}),
      Text(props.label, {"width": "matchParent", "height": 14, "fontSize": 10,
        "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1})
    ),
    Image(props.icon, {"width": 24, "height": 24, "objectFit": "contain",
      "flexShrink": 0, "fillColor": $theme('primaryColor')})
  )
)
#End
