#Template PillAction@1(props: { actionId: string, label: string, icon?: asset })
data = {
}

Stack({
  "width": "matchParent",
  "height": 36,
  "borderRadius": 18,
  "backgroundColor": $theme('actionStyle.backgroundColor'),
  "alignContent": "center",
  "onClick": EventAction(props.actionId)
},
  Row({
    "justifyContent": "center",
    "alignItems": "center"
  },
    #if props.icon
      Image(props.icon, {
        "width": 20,
        "height": 20,
        "objectFit": "contain",
        "fillColor": $theme('actionStyle.contentColor')
      })
    #endif
    Text(props.label, {
      "fontSize": 14,
      "fontWeight": 500,
      "fontColor": $theme('actionStyle.contentColor'),
      "maxLines": 1,
      "textOverflow": "ellipsis"
    })
  )
)
#End

#Template CompactAction@1(props: { actionId: string, label: string, icon: asset, subtitle?: string, prominent?: boolean })
data = {
}

Stack({
  "width": "matchParent",
  "height": "matchParent",
  "borderRadius": $theme('supportContentStyle.borderRadius'),
  "backgroundColor": $theme('supportContentStyle.backgroundColor'),
  "alignContent": "center",
  "onClick": EventAction(props.actionId)
},
#if props.prominent
  Row({
    "width": "matchParent",
    "height": "matchParent",
    "padding": {"left": 12, "top": 0, "right": 12, "bottom": 0},
    "justifyContent": "spaceBetween",
    "alignItems": "center"
  },
    Column({
      "layoutWeight": 1,
      "justifyContent": "center",
      "alignItems": "start",
      "itemMargin": 1
    },
      Text(props.label, {
        "width": "matchParent",
        "height": 21,
        "fontSize": 16,
        "fontWeight": 700,
        "fontColor": $theme('primaryColor'),
        "maxLines": 1,
        "textOverflow": "ellipsis",
        "textAlign": "start"
      }),
      #if props.subtitle
        Text(props.subtitle, {
          "width": "matchParent",
          "height": 14,
          "fontSize": 10,
          "fontWeight": 500,
          "fontColor": $theme('supportContentColor'),
          "maxLines": 1,
          "textOverflow": "ellipsis",
          "textAlign": "start",
          "_preserveOriginalColor": true
        })
      #endif
    ),
    Image(props.icon, {
      "width": 24,
      "height": 24,
      "objectFit": "contain",
      "flexShrink": 0,
      "fillColor": $theme("supportContentColor")
    })
  )
#else
  Row({
    "width": "matchParent",
    "height": "matchParent",
    "padding": {"left": 12, "top": 0, "right": 16, "bottom": 0},
    "justifyContent": "spaceBetween",
    "alignItems": "center"
  },
    Column({
      "layoutWeight": 1,
      "justifyContent": "center",
      "alignItems": "start",
      "itemMargin": 1
    },
      Text(props.label, {
        "width": "matchParent",
        "height": 19,
        "fontSize": 14,
        "fontWeight": 700,
        "fontColor": $theme('primaryColor'),
        "maxLines": 1,
        "textOverflow": "ellipsis",
        "textAlign": "start"
      }),
      #if props.subtitle
        Text(props.subtitle, {
          "width": "matchParent",
          "height": 14,
          "fontSize": 10,
          "fontWeight": 500,
          "fontColor": $theme('supportContentColor'),
          "maxLines": 1,
          "textOverflow": "ellipsis",
          "textAlign": "start",
          "_preserveOriginalColor": true
        })
      #endif
    ),
    Image(props.icon, {
      "width": 24,
      "height": 24,
      "objectFit": "contain",
      "flexShrink": 0,
      "fillColor": $theme("supportContentColor")
    })
  )
#endif
)
#End

