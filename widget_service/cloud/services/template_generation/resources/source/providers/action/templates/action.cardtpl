#Template PillAction@1(props: { actionId: string, label: string })
data = {
}

Button(props.label, {
  "width": "matchParent",
  "height": 36,
  "borderRadius": 18,
  "backgroundColor": $theme('actionStyle.backgroundColor'),
  "fontSize": 14,
  "fontWeight": 500,
  "fontColor": $theme('actionStyle.contentColor'),
  "onClick": EventAction(props.actionId)
})
#End

#Template IconAction@1(props: { actionId: string, icon: asset })
data = {
}

Stack({
  "width": 30,
  "height": 30,
  "borderRadius": 15,
  "backgroundColor": $theme('actionStyle.backgroundColor'),
  "alignContent": "center",
  "onClick": EventAction(props.actionId)
},
  Image(props.icon, {
    "width": 16,
    "height": 16,
    "objectFit": "contain",
    "fillColor": $theme('actionStyle.contentColor')
  })
)
#End
