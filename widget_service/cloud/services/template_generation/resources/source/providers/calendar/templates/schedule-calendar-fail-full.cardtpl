#Template ScheduleOverviewLocationDescriptionEndWideFull@1(props: {})
data = {
    description: $path("/events/0/description"),
    end: $path("/events/0/dtEnd"),
    location: $path("/events/0/eventLocation")
}

Column(
  {"_advancedComponent": "ScheduleOverview", "width": "matchParent", "height": "matchParent", "itemMargin": 2, "justifyContent": "spaceBetween", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
  Column(
    {"width": "matchParent", "itemMargin": 8, "alignItems": "start"},
    Text("日程详情", {"width": "matchParent", "height": 20, "fontSize": 12, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis"}),
    Text(data.description, {"width": "matchParent", "height": 28, "fontSize": 18, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}})
  ),
  Column(
    {"width": "matchParent", "itemMargin": 4, "alignItems": "start"},
    Text(data.end, {"width": "matchParent", "height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis"}),
    Text(data.location, {"width": "matchParent", "height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis"})
  )
)
#End

#Template ScheduleOverviewAllDayLocationWideFull@1(props: {})
data = {
    allDay: $path("/events/0/isAllDay"),
    location: $path("/events/0/eventLocation"),
    title: $optionalPath("/events/0/title"),
    timeZone: $optionalPath("/events/0/timeZone")
}

Column(
  {"_advancedComponent": "ScheduleOverview", "width": "matchParent", "height": "matchParent", "itemMargin": 2, "justifyContent": "spaceBetween", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
  Column(
    {"width": "matchParent", "itemMargin": 4, "alignItems": "start"},
    Row(
      {"width": "matchParent", "height": 24, "alignItems": "top"},
      Text("日程详情", {"width": "matchParent", "height": 16, "fontSize": 12, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis"})
    ),
    #if data.title
    Text(data.title, {"width": "matchParent", "height": 28, "fontSize": 18, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}})
    #endif
  ),
  Column(
    {"width": "matchParent", "itemMargin": 4, "alignItems": "start"},
    #if data.timeZone
    Text(data.timeZone, {"width": "matchParent", "height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis"}),
    #endif
    Text(Expr(data.allDay ? "全天" : "非全天"), {"width": "matchParent", "height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis"}),
    Text(data.location, {"width": "matchParent", "height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis"})
  )
)
#End

#Template ScheduleOverviewEventCountThreeDetailsWideFull@1(props: {})
data = {
    eventCount: $path("/eventCount"),
    firstTitle: $path("/events/0/title"),
    firstStart: $path("/events/0/dtStart"),
    firstDescription: $path("/events/0/description"),
    secondTitle: $path("/events/1/title"),
    secondStart: $path("/events/1/dtStart"),
    secondDescription: $path("/events/1/description"),
    thirdTitle: $path("/events/2/title"),
    thirdStart: $path("/events/2/dtStart"),
    thirdDescription: $path("/events/2/description")
}

Column(
  {"_advancedComponent": "ScheduleOverview", "width": "matchParent", "height": "matchParent", "itemMargin": 8, "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
  Row(
    {"width": "matchParent", "height": 16, "itemMargin": 2, "alignItems": "center"},
    Text("日程安排", {"width": 48, "height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}),
    Text(data.eventCount, {"width": 16, "height": 16, "fontSize": 10, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}, "backgroundColor": $theme('actionStyle.backgroundColor'), "borderRadius": 8, "textAlign": "center", "flexShrink": 0}),
  ),
  Column(
    {"width": "matchParent", "layoutWeight": 1, "itemMargin": 6, "alignItems": "start", "constraintSize": {"minWidth": 0, "minHeight": 0}},
    Row(
      {"width": "matchParent", "height": 30, "padding": {"left": 8, "right": 8}, "itemMargin": 8, "alignItems": "center", "borderRadius": 8, "backgroundColor": $theme('supportContentStyle.backgroundColor'), "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
      Text(Expr(data.firstTitle + (data.firstDescription ? "·" + data.firstDescription : "")), {"height": 16, "fontSize": 12, "fontWeight": 500, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}, "layoutWeight": 1}),
      Text(data.firstStart, {"width": 40, "height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}, "textAlign": "end", "flexShrink": 0}),
    ),
    Row(
      {"width": "matchParent", "height": 30, "padding": {"left": 8, "right": 8}, "itemMargin": 8, "alignItems": "center", "borderRadius": 8, "backgroundColor": $theme('supportContentStyle.backgroundColor'), "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
      Text(Expr(data.secondTitle + (data.secondDescription ? "·" + data.secondDescription : "")), {"height": 16, "fontSize": 12, "fontWeight": 500, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}, "layoutWeight": 1}),
      Text(data.secondStart, {"width": 40, "height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}, "textAlign": "end", "flexShrink": 0}),
    ),
    Row(
      {"width": "matchParent", "height": 30, "padding": {"left": 8, "right": 8}, "itemMargin": 8, "alignItems": "center", "borderRadius": 8, "backgroundColor": $theme('supportContentStyle.backgroundColor'), "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
      Text(Expr(data.thirdTitle + (data.thirdDescription ? "·" + data.thirdDescription : "")), {"height": 16, "fontSize": 12, "fontWeight": 500, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}, "layoutWeight": 1}),
      Text(data.thirdStart, {"width": 40, "height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}, "textAlign": "end", "flexShrink": 0}),
    ),
  ),
)
#End

#Template ScheduleOverviewTitleLocationHero@1(props: {})
data = {
    title: $path("/events/0/title"),
    location: $path("/events/0/eventLocation")
}

Column(
  {"_advancedComponent": "ScheduleOverview", "width": "matchParent", "height": "matchParent", "itemMargin": 6, "justifyContent": "spaceBetween", "alignItems": "center", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
  Text("日程", {"width": "matchParent", "height": 16, "fontSize": 12, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}, "textAlign": "center"}),
  Text(data.title, {"width": "matchParent", "height": 58, "fontSize": 24, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}, "textAlign": "center"}),
  Text(data.location, {"width": "matchParent", "height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}, "textAlign": "center"}),
)
