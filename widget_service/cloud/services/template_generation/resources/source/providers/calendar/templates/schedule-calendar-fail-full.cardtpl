#Template ScheduleOverviewDateAllDayWideFull@1(props: {})
data = {
    date: $path("/events/0/startDate"),
    title: $path("/events/0/title"),
    allDay: $path("/events/0/isAllDay")
}

Column(
  {"_advancedComponent": "ScheduleOverview", "width": "matchParent", "height": "matchParent", "itemMargin": 2, "justifyContent": "spaceBetween", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
  Column(
    {"width": "matchParent", "itemMargin": 4, "alignItems": "start"},
    Row(
      {"width": "matchParent", "height": 24, "alignItems": "top"},
      Text("日程详情", {"height": 16, "fontSize": 12, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "width": "matchParent"})
    ),
    Text(data.title, {"width": "matchParent", "height": 28, "fontSize": 18, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}})
  ),
  Column(
    {"width": "matchParent", "itemMargin": 4, "alignItems": "start"},
    Text(data.date, {"width": "matchParent", "height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis"}),
    Text(Expr(data.allDay ? "全天" : "非全天"), {"width": "matchParent", "height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis"})
  )
)
#End

#Template ScheduleOverviewTwoEventsWideFull@1(props: {})
data = {
    firstStart: $path("/events/0/dtStart"),
    secondStart: $path("/events/1/dtStart"),
    firstTitle: $optionalPath("/events/0/title"),
    secondTitle: $optionalPath("/events/1/title"),
    firstEnd: $optionalPath("/events/0/dtEnd"),
    secondEnd: $optionalPath("/events/1/dtEnd"),
    firstLocation: $optionalPath("/events/0/eventLocation"),
    secondLocation: $optionalPath("/events/1/eventLocation")
}

Column(
  {"_advancedComponent": "ScheduleOverview", "width": "matchParent", "height": "matchParent", "itemMargin": 6, "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
  Text("日程安排", {"width": "matchParent", "height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}),
  Row(
    {"width": "matchParent", "layoutWeight": 1, "itemMargin": 12, "alignItems": "top", "constraintSize": {"minWidth": 0, "minHeight": 0}},
  #if data.firstEnd
  #if data.firstLocation
  Column(
    {"layoutWeight": 1, "height": "matchParent", "padding": {"left": 12, "right": 8, "top": 8, "bottom": 8}, "justifyContent": "center", "alignItems": "start", "borderRadius": 12, "backgroundColor": $theme('supportContentStyle.backgroundColor'), "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
    Row(
      {"width": "matchParent", "itemMargin": 8, "alignItems": "top", "constraintSize": {"minWidth": 0, "minHeight": 0}},
    #if data.firstTitle
    Column(
      {"width": 8, "padding": {"top": 6}, "itemMargin": 4, "alignItems": "center", "flexShrink": 0},
      Stack(
        {"width": 8, "height": 8, "borderRadius": 4, "borderWidth": 1.5, "borderColor": $theme('primaryColor')},
        Divider({"width": 0, "height": 0, "strokeWidth": 0, "color": $theme('primaryColor')}),
      ),
      Divider({"width": 1, "height": 50, "strokeWidth": 1, "vertical": true, "color": $theme('actionStyle.backgroundColor')}),
    ),
    #else
    Column(
      {"width": 8, "padding": {"top": 3}, "itemMargin": 4, "alignItems": "center", "flexShrink": 0},
      Stack(
        {"width": 8, "height": 8, "borderRadius": 4, "borderWidth": 1.5, "borderColor": $theme('primaryColor')},
        Divider({"width": 0, "height": 0, "strokeWidth": 0, "color": $theme('primaryColor')}),
      ),
      Divider({"width": 1, "height": 30, "strokeWidth": 1, "vertical": true, "color": $theme('actionStyle.backgroundColor')}),
    ),
    #endif
    Column(
      {"layoutWeight": 1, "itemMargin": 4, "alignItems": "start", "constraintSize": {"minWidth": 0, "minHeight": 0}},
      #if data.firstTitle
      Text(data.firstTitle, {"width": "matchParent", "height": 20, "fontSize": 14, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}),
      #endif
      Column(
      {"width": "matchParent", "itemMargin": 2, "alignItems": "start", "constraintSize": {"minWidth": 0, "minHeight": 0}},
      Text(data.firstStart, {"width": "matchParent", "height": 14, "fontSize": 10, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}),
      Text(Expr(data.firstEnd ? "结束 " + data.firstEnd : ""), {"width": "matchParent", "height": 14, "fontSize": 10, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}),
      Text(data.firstLocation, {"width": "matchParent", "height": 14, "fontSize": 10, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}),
    )
    )
    ),
  ),
  #else
  Column(
    {"layoutWeight": 1, "height": "matchParent", "padding": {"left": 12, "right": 8, "top": 8, "bottom": 8}, "justifyContent": "center", "alignItems": "start", "borderRadius": 12, "backgroundColor": $theme('supportContentStyle.backgroundColor'), "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
    Row(
      {"width": "matchParent", "itemMargin": 8, "alignItems": "top", "constraintSize": {"minWidth": 0, "minHeight": 0}},
    #if data.firstTitle
    Column(
      {"width": 8, "padding": {"top": 6}, "itemMargin": 4, "alignItems": "center", "flexShrink": 0},
      Stack(
        {"width": 8, "height": 8, "borderRadius": 4, "borderWidth": 1.5, "borderColor": $theme('primaryColor')},
        Divider({"width": 0, "height": 0, "strokeWidth": 0, "color": $theme('primaryColor')}),
      ),
      Divider({"width": 1, "height": 34, "strokeWidth": 1, "vertical": true, "color": $theme('actionStyle.backgroundColor')}),
    ),
    #else
    Column(
      {"width": 8, "padding": {"top": 3}, "itemMargin": 4, "alignItems": "center", "flexShrink": 0},
