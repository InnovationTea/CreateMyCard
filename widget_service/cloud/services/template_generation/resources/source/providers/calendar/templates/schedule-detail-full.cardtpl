#Template ScheduleOverviewReminderDetailsFull@1(props: { calendarIcon?: asset, headerLabel?: string })
data = {
    sender: $path("/events/0/senderName"),
    importance: $path("/events/0/importantEventType"),
    reminder: $path("/events/0/remindTime/0"),
    updated: $path("/updatedAt")
}

Column(
  {"_advancedComponent": "ScheduleOverview", "width": "matchParent", "height": "matchParent", "itemMargin": 0, "justifyContent": "spaceBetween", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
  Row(
    {"width": "matchParent", "height": 20, "itemMargin": 4, "justifyContent": "spaceBetween", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
    #if props.headerLabel
      Text(
        props.headerLabel,
        {"layoutWeight": 1, "height": 12, "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
      )
    #else
