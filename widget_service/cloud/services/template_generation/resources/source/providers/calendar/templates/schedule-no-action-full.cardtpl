#Template ScheduleOverviewSourceReminderFull@1(props: {})
data = {
    sender: $path("/events/0/senderName"),
    reminder: $path("/events/0/remindTime/0"),
    title: $optionalPath("/events/0/title")
}

Column(
  {"_advancedComponent": "ScheduleOverview", "width": "matchParent", "height": "matchParent", "itemMargin": 8, "justifyContent": "start", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
  Row(
    {"width": "matchParent", "height": 20, "itemMargin": 4, "justifyContent": "spaceBetween", "alignItems": "top", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
    #if data.title
      Text(
        data.title,
        {"layoutWeight": 1, "height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
      )
    #else
      Text(
        "日程来源",
        {"layoutWeight": 1, "height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
      )
    #endif

  ),
  Column(
    {"width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
    Text(
      `来自 ${data.sender}`,
      {"width": "matchParent", "fontSize": 16, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 2, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    ),
    Text(
      `提前${data.reminder}分钟提醒`,
      {"width": "matchParent", "height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    )
  )
)
#End

#Template ScheduleOverviewTimezoneWideFull@1(props: {})
data = {
    title: $optionalPath("/events/0/title"),
    timeZone: $path("/events/0/timeZone"),
    location: $path("/events/0/eventLocation"),
    start: $path("/events/0/dtStart"),
    end: $optionalPath("/events/0/dtEnd")
}

Column(
  {
    "_advancedComponent": "ScheduleOverview",
    "width": "matchParent",
    "height": "matchParent",
    "itemMargin": 8,
    "justifyContent": "start",
    "alignItems": "start",
    "clip": true,
    "constraintSize": { "minWidth": 0, "minHeight": 0 }
  },
  Row(
    {
      "width": "matchParent",
      "height": 16,
      "justifyContent": "spaceBetween",
      "alignItems": "top",
      "clip": true,
      "constraintSize": { "minWidth": 0, "minHeight": 0 }
    },
      Text(
        "日程提醒",
        {
          "width": "matchParent",
          "height": 16,
          "fontSize": 12,
          "fontWeight": 400,
          "fontColor": $theme('supportContentColor'),
          "maxLines": 1,
          "textOverflow": "ellipsis",
          "constraintSize": { "minWidth": 0, "minHeight": 0 }
        }
      )

  ),
  Text(
    data.timeZone,
    {
      "width": "matchParent",
      "height": 40,
      "fontSize": 16,
      "minFontSize": 16,
      "fontWeight": 700,
      "fontColor": $theme('primaryColor'),
      "maxLines": 1,
      "textOverflow": "ellipsis",
      "constraintSize": { "minWidth": 0, "minHeight": 0 }
    }
  ),
  Row(
    {
      "width": "matchParent",
      "itemMargin": 8,
      "height": 54,
      "justifyContent": "start",
      "alignItems": "top",
      "clip": true,
      "constraintSize": { "minWidth": 0, "minHeight": 0 }
    },
    Column(
      {
        "width": 8,
        "height": "matchParent",
        "padding": { "left": 0, "top": 4, "right": 0, "bottom": 2 },
        "itemMargin": 4,
        "justifyContent": "start",
        "alignItems": "center",
        "flexShrink": 0,
        "clip": true
      },
      Stack(
        {
          "width": 8,
          "height": 8,
          "borderRadius": 4,
          "borderWidth": 1.5,
          "borderColor": $theme('primaryColor'),
          "backgroundColor": "#00FFFFFF",
          "alignContent": "center",
          "flexShrink": 0
        },
        Divider({ "width": 0, "height": 0, "strokeWidth": 0, "color": "#00FFFFFF" })
      ),
      Divider(
        {
          "width": 1,
          "layoutWeight": 1,
          "strokeWidth": 1,
          "vertical": true,
          "color": $theme('supportContentColor')
        }
      )
    ),
    Column(
      {
        "height": "matchParent",
        "layoutWeight": 1,
        "itemMargin": 2,
        "justifyContent": "start",
        "alignItems": "start",
        "clip": true,
        "constraintSize": { "minWidth": 0, "minHeight": 0 }
      },
      #if data.title
      Text(
        data.title,
        {
          "width": "matchParent",
          "height": 20,
          "fontSize": 14,
          "fontWeight": 700,
          "fontColor": $theme('primaryColor'),
          "maxLines": 1,
          "textOverflow": "ellipsis",
          "margin": { "bottom": 2 },
        }
      )
      #endif
      #if data.end
      Text(
        `${data.start} - ${data.end}`,
        { "height": 14, "fontSize": 10, "minFontSize": 10, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": { "minWidth": 0, "minHeight": 0 } }
      )
      #else
      Text(
        data.start,
        { "height": 14, "fontSize": 10, "minFontSize": 10, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": { "minWidth": 0, "minHeight": 0 } }
      )
      #endif
      Text(
        Expr(data.location == "" ? "" : data.location),
        { "height": 14, "fontSize": 10, "minFontSize": 10, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": { "minWidth": 0, "minHeight": 0 } }
      )
    )
  )
)
#End

#Template ScheduleOverviewEventCountDetailsWideFull@1(props: {})
data = {
    eventCount: $path("/eventCount"),
    title: $optionalPath("/events/0/title"),
    start: $optionalPath("/events/0/dtStart"),
    description: $path("/events/0/description")
}

Column(
  {
    "_advancedComponent": "ScheduleOverview",
    "width": "matchParent",
    "height": "matchParent",
    "itemMargin": 2,
    "justifyContent": "spaceBetween",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
  Column(
    {
      "width": "matchParent",
      "itemMargin": 4,
      "justifyContent": "start",
      "alignItems": "start",
      "clip": true,
      "constraintSize": {"minWidth": 0, "minHeight": 0}
    },
    Row(
      {"width": "matchParent", "height": 24, "itemMargin": 4, "justifyContent": "start", "alignItems": "top", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
      Text(
        "近期日程安排",
        {"height": 16, "fontSize": 12, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
      ),
      Stack(
        {"width": 14, "height": 14, "borderRadius": 7, "alignContent": "center", "flexShrink": 0, "clip": true},
        Stack(
          {"width": 14, "height": 14, "borderRadius": 7, "backgroundColor": $theme('actionStyle.backgroundColor'), "alignContent": "center"},
          Divider({"width": 0, "height": 0, "strokeWidth": 0, "color": $theme('actionStyle.backgroundColor')})
        ),
        Text(
          data.eventCount,
          {"width": 14, "height": 14, "fontSize": 10, "fontWeight": 500, "fontColor": $theme('actionStyle.contentColor'), "textAlign": "center", "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
        )
      )
    ),
    #if data.title
      Text(
        `首项：${data.title}`,
        {"width": "matchParent", "height": 28, "fontSize": 18, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
      )
    #endif
  ),
  Column(
    {"width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
    #if data.start
      Text(
        data.start,
        {"width": "matchParent", "height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
      )
    #endif
    #if data.description
      Text(
        `首项备注：${data.description}`,
        {"width": "matchParent", "height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
      )
    #endif
  )
)
#End

#Template ScheduleOverviewReminderWideFull@1(props: {})
data = {
    title: $optionalPath("/events/0/title"),
    start: $path("/events/0/dtStart"),
    reminder: $path("/events/0/remindTime/0")
}

Column(
  {"_advancedComponent": "ScheduleOverview", "width": "matchParent", "height": "matchParent", "itemMargin": 2, "justifyContent": "spaceBetween", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
  Column(
    {"width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
    Row(
      {"width": "matchParent", "height": 24, "itemMargin": 4, "justifyContent": "start", "alignItems": "top", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
      Text(
        "日程提醒",
        {"height": 16, "fontSize": 12, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
      )
    ),
    #if data.title
      Text(
        data.title,
        {"height": 28, "fontSize": 18, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "width": "matchParent", "constraintSize": {"minWidth": 0, "minHeight": 0}}
      )
    #endif
  ),
  Column(
    {"width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
    Text(
      data.start,
      {"height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "width": "matchParent", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    ),
    Text(
      Expr(data.start == "" ? "" : `提前${data.reminder}分钟提醒`),
      {"height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "width": "matchParent", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    )
  )
)
#End
