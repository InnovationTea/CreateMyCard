#Template DateOverviewCompact@1(props: {  })
data = {
    startDate: $path("/events/0/startDate")
}

Column(
  "compact",
  {"_advancedComponent": "DateOverview", "width": "100%", "height": "100%", "itemMargin": 4, "justifyContent": "start", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
  Text(
      "日程日期",
      "subtitle",
      {"width": "100%", "height": 12, "fontSize": 12, "minFontSize": 12, "fontWeight": 500, "fontColor": "#99000000", "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    ),
  Text(
      data.startDate,
      "title",
      {"width": "100%", "height": 44, "fontSize": 38, "minFontSize": 30, "fontWeight": 800, "fontColor": "#FFFF3B30", "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    )
)
#End

#Template DateOverviewFull@1(props: {  })
data = {
    startDate: $path("/events/0/startDate"),
    updatedAt: $path("/updatedAt")
}

Column(
  "compact",
  {"_advancedComponent": "DateOverview", "width": "100%", "height": "100%", "itemMargin": 0, "justifyContent": "spaceBetween", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
  Column(
      "compact",
      {"width": "100%", "height": 64, "itemMargin": 4, "justifyContent": "start", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
      Text(
            "日程日期",
            "subtitle",
            {"width": "100%", "height": 12, "fontSize": 12, "minFontSize": 12, "fontWeight": 500, "fontColor": "#99000000", "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
          ),
      Text(
            data.startDate,
            "title",
            {"width": "100%", "height": 44, "fontSize": 38, "minFontSize": 30, "fontWeight": 800, "fontColor": "#FFFF3B30", "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
          )
    ),
  Column(
      "compact",
      {"width": "100%", "height": 40, "itemMargin": 0, "justifyContent": "start", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
      Text(
            data.updatedAt,
            "body",
            {"width": "100%", "height": 20, "fontSize": 12, "minFontSize": 12, "fontWeight": 400, "fontColor": "#E6000000", "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
          ),
      Text(
            "日历数据更新时间",
            "body",
            {"width": "100%", "height": 20, "fontSize": 12, "minFontSize": 12, "fontWeight": 400, "fontColor": "#99000000", "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
          )
    )
)
#End
