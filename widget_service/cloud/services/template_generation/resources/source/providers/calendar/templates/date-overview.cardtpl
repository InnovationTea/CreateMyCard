#Template DateOverviewCompactDate@1(props: {  })
data = {
    startDate: $path("/events/0/startDate")
}

Row(
  "between",
  {"_advancedComponent": "DateOverview", "width": "100%", "height": 20, "itemMargin": 6, "justifyContent": "start", "alignItems": "center", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
  Text(
      data.startDate,
      "compact-title",
      {"fontSize": 14, "fontWeight": 700, "fontColor": "#FFFF3B30", "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    ),
  Text(
      "日程日期",
      "subtitle",
      {"fontSize": 12, "fontWeight": 500, "fontColor": "#99000000", "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    )
)
#End

#Template DateOverviewDateHero@1(props: {  })
data = {
    startDate: $path("/events/0/startDate")
}

Column(
  "compact",
  {"_advancedComponent": "DateOverview", "width": "100%", "height": "100%", "itemMargin": 4, "justifyContent": "center", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
  Text(
      data.startDate,
      "title",
      {"fontSize": 30, "minFontSize": 30, "fontWeight": 800, "fontColor": "#FFFF3B30", "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    ),
  Text(
      "日程日期",
      "body",
      {"fontSize": 14, "fontWeight": 500, "fontColor": "#99000000", "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    )
)
#End
