#Template DateOverviewCompact@1(props: {  })
data = {
    startDate: $path("/events/0/startDate")
}

Column(
  {"_advancedComponent": "DateOverview", "width": "100%", "height": "100%", "itemMargin": 4, "justifyContent": "start", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
  Text(
      "日程日期",
      {"width": "100%", "height": 12, "fontSize": 12, "minFontSize": 12, "fontWeight": 500, "fontColor": "#991F4799", "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    ),
  Text(
      data.startDate,
      {"width": "100%", "height": 44, "fontSize": 38, "minFontSize": 30, "fontWeight": 800, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    )
)
#End

#Template DateOverviewFull@1(props: {  })
data = {
    startDate: $path("/events/0/startDate"),
    updatedAt: $path("/updatedAt")
}

Column(
  {"_advancedComponent": "DateOverview", "width": "100%", "height": "100%", "itemMargin": 0, "justifyContent": "spaceBetween", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
  Column(
      {"width": "100%", "height": 64, "itemMargin": 4, "justifyContent": "start", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
      Text(
            "日程日期",
            {"width": "100%", "height": 12, "fontSize": 12, "minFontSize": 12, "fontWeight": 500, "fontColor": "#991F4799", "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
          ),
      Text(
            data.startDate,
            {"width": "100%", "height": 44, "fontSize": 38, "minFontSize": 30, "fontWeight": 800, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
          )
    ),
  Column(
      {"width": "100%", "height": 40, "itemMargin": 0, "justifyContent": "start", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
      Text(
            data.updatedAt,
            {"width": "100%", "height": 20, "fontSize": 12, "minFontSize": 12, "fontWeight": 400, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
          ),
      Text(
            "日历数据更新时间",
            {"width": "100%", "height": 20, "fontSize": 12, "minFontSize": 12, "fontWeight": 400, "fontColor": "#991F4799", "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
          )
    )
)
#End
