#Template ScheduleOverviewNextEventHero@1(props: { calendarIcon?: asset, headerLabel?: string })
data = {
    title: $path("/events/0/title"),
    start: $path("/events/0/dtStart"),
    end: $path("/events/0/dtEnd"),
    location: $path("/events/0/eventLocation")
}

Column(
  {
    "_advancedComponent": "ScheduleOverview",
    "_layoutActionBackgroundOpacity": 0.2,
    "width": "matchParent",
    "height": "matchParent",
    "itemMargin": 2,
    "justifyContent": "start",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
  Row(
    {
      "width": "matchParent",
      "height": 20,
      "justifyContent": "spaceBetween",
      "alignItems": "top",
      "clip": true,
      "constraintSize": {"minWidth": 0, "minHeight": 0}
    },
    #if props.headerLabel
      Text(
        props.headerLabel,
        {
          "height": 16,
          "fontSize": 12,
          "fontWeight": 400,
          "fontColor": $theme('supportContentColor'),
          "maxLines": 1,
          "textOverflow": "ellipsis",
          "constraintSize": {"minWidth": 0, "minHeight": 0}
        }
      )
    #else
      Text(
        "下一个日程",
        {
          "height": 16,
          "fontSize": 12,
          "fontWeight": 400,
          "fontColor": $theme('supportContentColor'),
          "maxLines": 1,
          "textOverflow": "ellipsis",
          "constraintSize": {"minWidth": 0, "minHeight": 0}
        }
      )
    #endif
    #if props.calendarIcon
      Image(
        props.calendarIcon,
        {
          "width": 20,
          "height": 20,
          "objectFit": "contain",
          "fillColor": $theme('supportContentColor'),
          "flexShrink": 0
        }
      )
    #endif
  ),
  Row(
    {
      "width": "matchParent",
      "itemMargin": 8,
      "height": Expr(data.start == "" ? 24 : 54),
      "justifyContent": "start",
      "alignItems": "top",
      "clip": true,
      "constraintSize": { "minWidth": 0, "minHeight": 0 }
    },
    Column(
      {
        "width": 8,
        "height": "matchParent",
        "padding": { "left": 0, "top": 4, "right": 0, "bottom": 2 },
        "itemMargin": 4,
        "justifyContent": "start",
        "alignItems": "center",
        "flexShrink": 0,
        "clip": true
      },
      Stack(
        {
          "width": 8,
          "height": 8,
          "borderRadius": 4,
          "borderWidth": 1.5,
          "borderColor": $theme('primaryColor'),
          "backgroundColor": "#00FFFFFF",
          "alignContent": "center",
          "flexShrink": 0
        },
        Divider({ "width": 0, "height": 0, "strokeWidth": 0, "color": "#00FFFFFF" })
      ),
      Divider(
        {
          "width": 1,
          "layoutWeight": 1,
          "strokeWidth": 1,
          "vertical": true,
          "color": $theme('supportContentColor')
        }
      )
    ),
    Column(
      {
        "height": "matchParent",
        "layoutWeight": 1,
        "itemMargin": 2,
        "justifyContent": "start",
        "alignItems": "start",
        "clip": true,
        "constraintSize": { "minWidth": 0, "minHeight": 0 }
      },
      Text(
        data.title,
        {
          "width": "matchParent",
          "height": 20,
          "fontSize": 14,
          "fontWeight": 700,
          "fontColor": $theme('primaryColor'),
          "maxLines": 1,
          "textOverflow": "ellipsis",
          "margin": { "bottom": 2 },
        }
      ),
      Text(
        Expr(data.start == "" ? "" : `${data.start} - ${data.end}`),
        { "height": 14, "fontSize": 10, "minFontSize": 10, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": { "minWidth": 0, "minHeight": 0 } }
      ),
      Text(
        Expr(data.location == "" ? "" : data.location),
        { "height": 14, "fontSize": 10, "minFontSize": 10, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": { "minWidth": 0, "minHeight": 0 } }
      )
    )
  )
)
#End

