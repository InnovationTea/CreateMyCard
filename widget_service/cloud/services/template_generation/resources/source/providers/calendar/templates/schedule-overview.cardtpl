                              {"width": "100%", "itemMargin": 4, "justifyContent": "start", "alignItems": "top", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
                              Image(
                                          props.locationIcon,
                                          {"width": 12, "height": 12, "objectFit": "contain"}
                                        ),
                              Text(
                                          data.location,
                                          {"width": "100%", "fontSize": 10, "minFontSize": 10, "fontWeight": 400, "fontColor": "#661F4799", "maxLines": 1, "textOverflow": "ellipsis", "layoutWeight": 1, "constraintSize": {"minWidth": 0, "minHeight": 0}}
                                        )
                            )
                  )
          )
    )
)
#End

