    ),
    Column(
      {
        "width": "matchParent",
        "height": 54,
        "layoutWeight": 1,
        "itemMargin": 2,
        "justifyContent": "start",
        "alignItems": "start",
        "clip": true,
        "constraintSize": { "minWidth": 0, "minHeight": 0 }
      },
      Text(
        data.title,
        {
          "width": "matchParent",
          "height": 20,
          "fontSize": 14,
          "fontWeight": 700,
          "fontColor": $theme('primaryColor'),
          "maxLines": 1,
          "textOverflow": "ellipsis",
          "margin": { "bottom": 2 },
        }
      ),
      Text(
        `${data.start} - ${data.end}`,
        { "width": "100%", "height": 14, "fontSize": 10, "minFontSize": 10, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": { "minWidth": 0, "minHeight": 0 } }
      ),
      Text(
        data.location,
        { "width": "100%", "height": 14, "fontSize": 10, "minFontSize": 10, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": { "minWidth": 0, "minHeight": 0 } }
      )
    )
  )
)
#End

