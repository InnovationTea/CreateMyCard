        {
          "width": 112,
          "height": 12,
          "fontSize": 12,
          "fontWeight": 400,
          "fontColor": "#991F4799",
          "maxLines": 1,
          "textOverflow": "ellipsis",
          "constraintSize": {"minWidth": 0, "minHeight": 0}
        }
      )
    ),
    IfPresent(
      props.calendarIcon,
      Image(
        props.calendarIcon,
        {
          "width": 20,
          "height": 20,
          "objectFit": "contain",
          "fillColor": $theme('primaryColor'),
          "flexShrink": 0
        }
      )
    )
  ),
  Column(
    {
      "width": "matchParent",
      "height": 64,
      "itemMargin": 2,
      "justifyContent": "start",
      "alignItems": "start",
      "clip": true,
      "constraintSize": {"minWidth": 0, "minHeight": 0}
    },
    Text(
      data.title,
      {
        "width": "matchParent",
        "height": 28,
        "fontSize": 20,
        "fontWeight": 700,
        "fontColor": $theme('primaryColor'),
        "maxLines": 1,
        "textOverflow": "ellipsis",
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      }
    ),
    IfPresent(
      data.start,
      IfPresent(
        data.end,
        Text(
          `${data.start}-${data.end}`,
          {"width": "matchParent", "height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": "#991F4799", "maxLines": 1, "textOverflow": "ellipsis"}
        )
      )
    ),
    IfPresent(
      data.start,
      IfAbsent(
        data.end,
        Text(
          data.start,
          {"width": "matchParent", "height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": "#991F4799", "maxLines": 1, "textOverflow": "ellipsis"}
        )
      )
    ),
    IfAbsent(
      data.start,
      IfPresent(
        data.reminder,
        Text(
          `提前${data.reminder}分钟提醒`,
          {"width": "matchParent", "height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": "#991F4799", "maxLines": 1, "textOverflow": "ellipsis"}
        )
      )
    ),
    IfAbsent(
      data.start,
      IfAbsent(
        data.reminder,
        IfPresent(
          data.timeZone,
          IfPresent(
            data.isAllDay,
            Text(
              Expr(`${data.isAllDay} ? '全天 · ' + ${data.timeZone} : '非全天 · ' + ${data.timeZone}`),
              {"width": "matchParent", "height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": "#991F4799", "maxLines": 1, "textOverflow": "ellipsis"}
            )
          )
        )
      )
    ),
    IfAbsent(
      data.start,
      IfAbsent(
        data.reminder,
        IfPresent(
          data.timeZone,
          IfAbsent(
            data.isAllDay,
            Text(
              data.timeZone,
              {"width": "matchParent", "height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": "#991F4799", "maxLines": 1, "textOverflow": "ellipsis"}
            )
          )
        )
      )
    ),
    IfAbsent(
      data.start,
      IfAbsent(
        data.reminder,
        IfAbsent(
          data.timeZone,
          IfPresent(
            data.isAllDay,
            Text(
              Expr(`${data.isAllDay} ? '全天日程' : '非全天日程'`),
              {"width": "matchParent", "height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": "#991F4799", "maxLines": 1, "textOverflow": "ellipsis"}
            )
          )
        )
      )
    ),
    IfPresent(
      data.location,
      Text(
        data.location,
        {"width": "matchParent", "height": 16, "fontSize": 10, "fontWeight": 400, "fontColor": "#661F4799", "maxLines": 1, "textOverflow": "ellipsis"}
      )
    )
  )
)
#End

