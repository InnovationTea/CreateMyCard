          Text(Bind("location"), "subtitle", { width: "100%", fontSize: 10, minFontSize: 10, fontWeight: 400, fontColor: "#66000000", maxLines: 1, textOverflow: "ellipsis", layoutWeight: 1, constraintSize: { minWidth: 0, minHeight: 0 } })
        )
      )
    )
  )
)
#EndVariant

