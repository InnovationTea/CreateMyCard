#Template ScheduleOverviewNextEventHero@1(props: { calendarIcon?: asset, headerLabel?: string })
data = {
    title: $path("/events/0/title"),
    start: $path("/events/0/dtStart"),
    end: $path("/events/0/dtEnd"),
    location: $path("/events/0/eventLocation")
}

Column(
  {
    "_advancedComponent": "ScheduleOverview",
    "_layoutActionBackgroundOpacity": 0.2,
    "width": "matchParent",
    "height": "matchParent",
    "itemMargin": 0,
    "justifyContent": "start",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
  Row(
    {
      "width": "matchParent",
      "height": 20,
      "justifyContent": "spaceBetween",
      "alignItems": "start",
      "clip": true,
      "constraintSize": {"minWidth": 0, "minHeight": 0}
    },
    IfPresent(
      props.headerLabel,
      Text(
        props.headerLabel,
        {
          "width": 112,
          "height": 12,
          "fontSize": 12,
          "fontWeight": 700,
          "fontColor": $theme('supportContentColor'),
          "maxLines": 1,
          "textOverflow": "ellipsis",
          "constraintSize": {"minWidth": 0, "minHeight": 0}
        }
      )
    ),
    IfAbsent(
      props.headerLabel,
      Text(
        "下一个日程",
        {
          "width": 112,
          "height": 12,
          "fontSize": 12,
          "fontWeight": 700,
          "fontColor": $theme('supportContentColor'),
          "maxLines": 1,
          "textOverflow": "ellipsis",
          "constraintSize": {"minWidth": 0, "minHeight": 0}
        }
      )
    ),
    IfPresent(
      props.calendarIcon,
      Image(
        props.calendarIcon,
        {
          "width": 20,
          "height": 20,
          "objectFit": "contain",
          "fillColor": $theme('supportContentColor'),
          "flexShrink": 0
        }
      )
    )
  ),
  Row(
    {
      "width": "matchParent",
      "height": 56,
      "itemMargin": 8,
      "justifyContent": "start",
      "alignItems": "start",
      "clip": true,
      "constraintSize": { "minWidth": 0, "minHeight": 0 }
    },
    Column(
      {
        "width": 8,
        "height": 54,
        "padding": { "left": 0, "top": 4, "right": 0, "bottom": 0 },
        "itemMargin": 4,
        "justifyContent": "start",
        "alignItems": "center",
        "flexShrink": 0,
        "clip": true
      },
      Stack(
        {
          "width": 8,
          "height": 8,
          "borderRadius": 4,
          "borderWidth": 1.5,
          "borderColor": $theme('primaryColor'),
          "alignContent": "center",
          "flexShrink": 0
        },
        Divider({ "width": 0, "height": 0, "strokeWidth": 0, "color": "#00FFFFFF" })
      ),
      Divider(
        {
          "width": 1,
          "height": 36,
          "strokeWidth": 1,
          "vertical": true,
          "color": $theme('supportContentColor')
        }
      )
    ),
    Column(
      {
        "width": "matchParent",
        "height": 64,
        "itemMargin": 4,
        "justifyContent": "start",
        "alignItems": "start",
        "clip": true,
        "constraintSize": { "minWidth": 0, "minHeight": 0 }
      },
      Text(
        data.title,
        {
          "width": "matchParent",
          "height": 19,
          "fontSize": 14,
          "fontWeight": 700,
          "fontColor": $theme('primaryColor'),
          "maxLines": 1,
          "textOverflow": "ellipsis",
          "constraintSize": { "minWidth": 0, "minHeight": 0 }
        }
      ),
      Column(
        { "width": 120, "itemMargin": 2, "justifyContent": "start", "alignItems": "start", "clip": true, "constraintSize": { "minWidth": 0, "minHeight": 0 } },
        Text(
          `${data.start}-${data.end}`,
          { "width": 120, "height": 14, "fontSize": 10, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": { "minWidth": 0, "minHeight": 0 } }
        ),
        Text(
          data.location,
          { "width": 120, "height": 14, "fontSize": 10, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": { "minWidth": 0, "minHeight": 0 } }
        )
      )
    )
  )
)
#End

