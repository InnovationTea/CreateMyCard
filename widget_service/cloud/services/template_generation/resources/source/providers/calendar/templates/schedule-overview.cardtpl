#Template("ScheduleOverview@1", {
  capability: "GetCalendarEvents",
  description: "日程数据提供方交付的首项日程概览",
  domainTags: ["schedule", "calendar", "meeting"],
  compatibleThemeProfileIds: ["meeting-paper-neutral", "focus-warm-amber", "family-weather-care-blue", "rainy-commute-gray-blue"],
  allowedParentComponents: ["Column", "Row", "List", "Stack"],
  bindings: {
    title: { path: "/events/0/title", type: "string" },
    location: { path: "/events/0/eventLocation", type: "string" }
  },
  params: {
    timeText: {
      type: "string", required: true, sourcePaths: ["/events/0/dtStart", "/events/0/dtEnd"]
    },
    sourceIcon: { type: "string", kind: "asset", semanticTags: ["calendar", "schedule"] },
    timeIcon: { type: "string", kind: "asset", semanticTags: ["time"] },
    locationIcon: { type: "string", kind: "asset", semanticTags: ["location"] }
  },
  limits: { maxNodes: 24, maxDepth: 7 }
})

#Variant("nextEvent", { sizes: ["2x2", "2x4"], roles: ["hero"], requires: ["title"], requiresParams: ["timeText"] })
Column("compact", {
  _advancedComponent: "ScheduleOverview", width: "100%", height: "100%", itemMargin: 4,
  justifyContent: "start", alignItems: "start", clip: true,
  constraintSize: { minWidth: 0, minHeight: 0 }
},
  Row("between", {
    width: "100%", height: 12, itemMargin: 4, justifyContent: "spaceBetween",
    alignItems: "top", clip: true
  },
    Text("下一个日程", "subtitle", {
      width: "100%", fontSize: 12, minFontSize: 12, fontWeight: 400,
      fontColor: "#99000000", maxLines: 1, textOverflow: "ellipsis", layoutWeight: 1,
      constraintSize: { minWidth: 0, minHeight: 0 }
    }),
    IfParam("sourceIcon",
      Image(Asset("sourceIcon"), "icon", {
        width: 12, height: 12, objectFit: "contain", fillColor: "#FFFF3B30"
      })
    )
  ),
  Row("between", {
    width: "100%", height: "100%", layoutWeight: 1, itemMargin: 8,
    justifyContent: "start", alignItems: "center", clip: true,
    constraintSize: { minWidth: 0, minHeight: 0 }
  },
    Column("compact", {
      width: 8, height: "100%", itemMargin: 2, justifyContent: "start",
      alignItems: "center", flexShrink: 0, clip: true
    },
      Stack("overlay", {
        width: 8, height: 8, borderRadius: 4, borderWidth: 2,
        borderColor: "#FFFF3B30", backgroundColor: "#00FFFFFF",
        alignContent: "center", flexShrink: 0
      },
        Divider({ width: 0, height: 0, strokeWidth: 0, color: "#00FFFFFF" })
      ),
      Divider({ width: 1, height: 28, strokeWidth: 1, vertical: true, color: "#1F000000" })
    ),
    Column("compact", {
      width: "100%", height: "100%", layoutWeight: 1, itemMargin: 4,
      justifyContent: "start", alignItems: "start", clip: true,
      constraintSize: { minWidth: 0, minHeight: 0 }
    },
      Text(Bind("title"), "title", {
        width: "100%", fontSize: 20, minFontSize: 20, fontWeight: 700,
        fontColor: "#E6000000", maxLines: 1, textOverflow: "ellipsis",
        constraintSize: { minWidth: 0, minHeight: 0 }
      }),
      IfMissingParam("timeIcon",
        Text(Param("timeText"), "subtitle", {
          width: "100%", fontSize: 14, minFontSize: 14, fontWeight: 400,
          fontColor: "#99000000", maxLines: 1, textOverflow: "ellipsis",
          constraintSize: { minWidth: 0, minHeight: 0 }
        })
      ),
      IfParam("timeIcon",
        Row("between", {
          width: "100%", itemMargin: 4, justifyContent: "start", alignItems: "top",
          clip: true, constraintSize: { minWidth: 0, minHeight: 0 }
        },
          Image(Asset("timeIcon"), "icon", { width: 12, height: 12, objectFit: "contain" }),
          Text(Param("timeText"), "subtitle", {
            width: "100%", fontSize: 14, minFontSize: 14, fontWeight: 400,
            fontColor: "#99000000", maxLines: 1, textOverflow: "ellipsis", layoutWeight: 1,
            constraintSize: { minWidth: 0, minHeight: 0 }
          })
        )
      )
    )
  )
)
#EndVariant

