#Template ScheduleOverviewNextEventFull@1(props: { sourceIcon?: asset, headerLabel?: string })
data = {
    title: $path("/events/0/title"),
    start: $optionalPath("/events/0/dtStart"),
    end: $optionalPath("/events/0/dtEnd"),
    reminder: $optionalPath("/events/0/remindTime/0"),
    location: $optionalPath("/events/0/eventLocation")
}

Column(
  {"_advancedComponent": "ScheduleOverview", "width": "100%", "height": "100%", "itemMargin": 4, "justifyContent": "start", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
  Row(
      {"width": "100%", "height": 20, "itemMargin": 4, "justifyContent": "spaceBetween", "alignItems": "top", "clip": true},
      IfPresent(
            props.headerLabel,
            Text(
                    props.headerLabel,
                    {"width": "100%", "fontSize": 12, "minFontSize": 12, "fontWeight": 400, "fontColor": "#991F4799", "maxLines": 1, "textOverflow": "ellipsis", "layoutWeight": 1, "constraintSize": {"minWidth": 0, "minHeight": 0}}
                  )
          ),
      IfAbsent(
            props.headerLabel,
            Text(
                    "日程",
                    {"width": "100%", "fontSize": 12, "minFontSize": 12, "fontWeight": 400, "fontColor": "#991F4799", "maxLines": 1, "textOverflow": "ellipsis", "layoutWeight": 1, "constraintSize": {"minWidth": 0, "minHeight": 0}}
                  )
          ),
      IfPresent(
            props.sourceIcon,
            Image(
                    props.sourceIcon,
                    {"width": 12, "height": 12, "objectFit": "contain", "fillColor": $theme('primaryColor')}
                  )
          )
    ),
  Row(
      {"width": "100%", "height": "100%", "layoutWeight": 1, "itemMargin": 8, "justifyContent": "start", "alignItems": "center", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
      Column(
            {"width": 8, "height": "100%", "itemMargin": 2, "justifyContent": "start", "alignItems": "center", "flexShrink": 0, "clip": true},
            Stack(
                    {"width": 8, "height": 8, "borderRadius": 4, "borderWidth": 2, "borderColor": $theme('primaryColor'), "backgroundColor": "#00FFFFFF", "alignContent": "center", "flexShrink": 0},
                    Divider(
                              {"width": 0, "height": 0, "strokeWidth": 0, "color": "#00FFFFFF"}
                            )
                  ),
            Divider(
                    {"width": 1, "height": 28, "strokeWidth": 1, "vertical": true, "color": $theme('actionStyle.backgroundColor')}
                  )
          ),
      Column(
            {"width": "100%", "height": "100%", "layoutWeight": 1, "itemMargin": 4, "justifyContent": "start", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
            Text(
                    data.title,
                    {"width": "100%", "height": 28, "fontSize": 20, "minFontSize": 20, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
                  ),
            IfPresent(
                    data.start,
                    IfPresent(
                              data.end,
                              Text(
                                          `${data.start}-${data.end}`,
                                          {"width": "100%", "height": 14, "fontSize": 12, "minFontSize": 12, "fontWeight": 400, "fontColor": "#991F4799", "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
                                        )
                            )
                  ),
            IfPresent(
                    data.start,
                    IfAbsent(
                              data.end,
                              Text(
                                          data.start,
                                          {"width": "100%", "height": 14, "fontSize": 12, "minFontSize": 12, "fontWeight": 400, "fontColor": "#991F4799", "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
                                        )
                            )
                  ),
            IfAbsent(
                    data.start,
                    IfPresent(
                              data.reminder,
                              Text(
                                          `提前${data.reminder}分钟提醒`,
                                          {"width": "100%", "height": 14, "fontSize": 12, "minFontSize": 12, "fontWeight": 400, "fontColor": "#991F4799", "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
                                        )
                            )
                  ),
            IfPresent(
                    data.location,
                    Text(
                              data.location,
                              {"width": "100%", "height": 14, "fontSize": 10, "minFontSize": 10, "fontWeight": 400, "fontColor": "#661F4799", "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
                            )
                  )
          )
    )
)
#End

#Template ScheduleOverviewNextEventHero@1(props: { calendarIcon?: asset, headerLabel?: string })
data = {
    title: $path("/events/0/title"),
    start: $optionalPath("/events/0/dtStart"),
    end: $optionalPath("/events/0/dtEnd"),
    reminder: $optionalPath("/events/0/remindTime/0"),
    timeZone: $optionalPath("/events/0/timeZone"),
    isAllDay: $optionalPath("/events/0/isAllDay"),
    location: $optionalPath("/events/0/eventLocation")
}

Column(
  {
    "_advancedComponent": "ScheduleOverview",
