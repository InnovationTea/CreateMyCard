#Template ScheduleOverviewEventCountThreeNotesWideFull@1(props: {})
data = {
    eventCount: $path("/eventCount"),
    firstDescription: $path("/events/0/description"),
    secondDescription: $path("/events/1/description"),
    thirdDescription: $path("/events/2/description")
}

Column(
  {"_advancedComponent": "ScheduleOverview", "width": "matchParent", "height": "matchParent", "itemMargin": 10, "justifyContent": "start", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
  Row(
    {"width": "matchParent", "height": 20, "itemMargin": 4, "justifyContent": "start", "alignItems": "center", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
    Text(
      "日程安排",
      {"height": 20, "fontSize": 14, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    ),
    Stack(
      {"width": 14, "height": 14, "borderRadius": 7, "alignContent": "center", "flexShrink": 0, "clip": true},
      Stack(
        {"width": 14, "height": 14, "borderRadius": 7, "backgroundColor": $theme('actionStyle.backgroundColor'), "alignContent": "center"},
        Divider({"width": 0, "height": 0, "strokeWidth": 0, "color": $theme('actionStyle.backgroundColor')})
      ),
      Text(
        data.eventCount,
        {"height": 14, "fontSize": 10, "fontWeight": 500, "fontColor": $theme('actionStyle.contentColor'), "maxLines": 1, "textOverflow": "ellipsis", "width": 14, "textAlign": "center", "constraintSize": {"minWidth": 0, "minHeight": 0}}
      )
    )
  ),
  Column(
    {"width": "matchParent", "height": 96, "itemMargin": 0, "justifyContent": "start", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
    Text(
      data.firstDescription,
      {"height": 20, "fontSize": 12, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "width": "matchParent", "margin": {"bottom": 9}, "constraintSize": {"minWidth": 0, "minHeight": 0}}
    ),
    Divider({"width": "matchParent", "height": 1, "strokeWidth": 1, "margin": {"bottom": 8}, "color": $theme('actionStyle.backgroundColor')}),
    Text(
      data.secondDescription,
      {"height": 20, "fontSize": 12, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "width": "matchParent", "margin": {"bottom": 9}, "constraintSize": {"minWidth": 0, "minHeight": 0}}
    ),
    Divider({"width": "matchParent", "height": 1, "strokeWidth": 1, "margin": {"bottom": 8}, "color": $theme('actionStyle.backgroundColor')}),
    Text(
      data.thirdDescription,
      {"height": 20, "fontSize": 12, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "width": "matchParent", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    )
  )
)
#End
