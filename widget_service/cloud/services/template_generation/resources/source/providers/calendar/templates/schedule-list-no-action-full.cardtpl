#Template ScheduleOverviewTimezoneThreeEventsWideFull@1(props: {})
data = {
    firstTitle: $path("/events/0/title"),
    firstStart: $path("/events/0/dtStart"),
    firstEnd: $path("/events/0/dtEnd"),
    firstTimeZone: $path("/events/0/timeZone"),
    firstLocation: $path("/events/0/eventLocation"),
    secondTitle: $path("/events/1/title"),
    secondStart: $path("/events/1/dtStart"),
    secondEnd: $path("/events/1/dtEnd"),
    secondTimeZone: $path("/events/1/timeZone"),
    secondLocation: $path("/events/1/eventLocation"),
    thirdTitle: $path("/events/2/title"),
    thirdStart: $path("/events/2/dtStart"),
    thirdEnd: $path("/events/2/dtEnd"),
    thirdTimeZone: $path("/events/2/timeZone"),
    thirdLocation: $path("/events/2/eventLocation")
}

Column(
  {"_advancedComponent": "ScheduleOverview", "width": "matchParent", "height": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
  Text(
    "跨时区日程",
    {"height": 20, "fontSize": 14, "fontWeight": 500, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "width": "matchParent", "constraintSize": {"minWidth": 0, "minHeight": 0}}
  ),
  Column(
    {"width": "matchParent", "height": 102, "itemMargin": 1, "justifyContent": "start", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
    Row(
      {"width": "matchParent", "height": 32, "itemMargin": 8, "justifyContent": "start", "alignItems": "top", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
      Column(
        {"width": 160, "height": 32, "itemMargin": 0, "justifyContent": "start", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
        Text(
          data.firstTitle,
          {"height": 16, "fontSize": 12, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "width": "matchParent", "constraintSize": {"minWidth": 0, "minHeight": 0}}
        ),
        Text(
          `${data.firstStart}-${data.firstEnd}`,
          {"height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "width": "matchParent", "constraintSize": {"minWidth": 0, "minHeight": 0}}
        )
      ),
      Column(
        {"width": 108, "height": 32, "itemMargin": 0, "justifyContent": "start", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
        Text(
          data.firstTimeZone,
          {"height": 16, "fontSize": 12, "fontWeight": 500, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "width": "matchParent", "textAlign": "end", "constraintSize": {"minWidth": 0, "minHeight": 0}}
        ),
        Text(
          data.firstLocation,
          {"height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "width": "matchParent", "textAlign": "end", "constraintSize": {"minWidth": 0, "minHeight": 0}}
        )
      )
    ),
    Divider({"width": "matchParent", "height": 1, "strokeWidth": 1, "color": $theme('actionStyle.backgroundColor')}),
    Row(
      {"width": "matchParent", "height": 32, "itemMargin": 8, "justifyContent": "start", "alignItems": "top", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
      Column(
        {"width": 160, "height": 32, "itemMargin": 0, "justifyContent": "start", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
        Text(
          data.secondTitle,
          {"height": 16, "fontSize": 12, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "width": "matchParent", "constraintSize": {"minWidth": 0, "minHeight": 0}}
        ),
        Text(
          `${data.secondStart}-${data.secondEnd}`,
          {"height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "width": "matchParent", "constraintSize": {"minWidth": 0, "minHeight": 0}}
        )
      ),
      Column(
        {"width": 108, "height": 32, "itemMargin": 0, "justifyContent": "start", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
        Text(
          data.secondTimeZone,
          {"height": 16, "fontSize": 12, "fontWeight": 500, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "width": "matchParent", "textAlign": "end", "constraintSize": {"minWidth": 0, "minHeight": 0}}
        ),
        Text(
          data.secondLocation,
          {"height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "width": "matchParent", "textAlign": "end", "constraintSize": {"minWidth": 0, "minHeight": 0}}
        )
      )
    ),
    Divider({"width": "matchParent", "height": 1, "strokeWidth": 1, "color": $theme('actionStyle.backgroundColor')}),
    Row(
      {"width": "matchParent", "height": 32, "itemMargin": 8, "justifyContent": "start", "alignItems": "top", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
      Column(
        {"width": 160, "height": 32, "itemMargin": 0, "justifyContent": "start", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
        Text(
          data.thirdTitle,
          {"height": 16, "fontSize": 12, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "width": "matchParent", "constraintSize": {"minWidth": 0, "minHeight": 0}}
        ),
        Text(
          `${data.thirdStart}-${data.thirdEnd}`,
          {"height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "width": "matchParent", "constraintSize": {"minWidth": 0, "minHeight": 0}}
        )
      ),
      Column(
        {"width": 108, "height": 32, "itemMargin": 0, "justifyContent": "start", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
        Text(
          data.thirdTimeZone,
          {"height": 16, "fontSize": 12, "fontWeight": 500, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "width": "matchParent", "textAlign": "end", "constraintSize": {"minWidth": 0, "minHeight": 0}}
        ),
        Text(
          data.thirdLocation,
          {"height": 16, "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "width": "matchParent", "textAlign": "end", "constraintSize": {"minWidth": 0, "minHeight": 0}}
        )
      )
    )
  )
)
#End

