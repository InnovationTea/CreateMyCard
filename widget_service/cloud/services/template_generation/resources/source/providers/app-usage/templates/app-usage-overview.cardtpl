#Template AppUsageOverviewSingleApp@1(props: { durationPrimaryValueText: string, durationPrimaryUnitText: string, appIcon?: asset })
data = {
    appName: $path("/appUsage/appName"),
    updatedAt: $optionalPath("/updatedAt")
}

Column(
  "compact",
  {"_advancedComponent": "AppUsageOverview", "width": "matchParent", "height": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
  Row(
      "between",
      {"width": "matchParent", "height": 20, "itemMargin": 4, "justifyContent": "spaceBetween", "alignItems": "top", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
      Text(
            data.appName,
            "compact-title",
            {"fontSize": 12, "minFontSize": 12, "fontWeight": 600, "fontColor": "#E6000000", "maxLines": 1, "textOverflow": "ellipsis", "layoutWeight": 1, "constraintSize": {"minWidth": 0, "minHeight": 0}}
          ),
      IfPresent(
            props.appIcon,
            Image(
                    props.appIcon,
                    "icon",
                    {"width": 20, "height": 20, "borderRadius": 4, "objectFit": "contain", "flexShrink": 0}
                  )
          )
    ),
  Column(
      "compact",
      {"layoutWeight": 1, "justifyContent": "end", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
      Row(
            "between",
            {"width": "matchParent", "itemMargin": 2, "justifyContent": "start", "alignItems": "bottom", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
            Text(
                    props.durationPrimaryValueText,
                    "title",
                    {"fontSize": 30, "minFontSize": 30, "fontWeight": 700, "fontColor": "#E6000000", "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
                  ),
            Text(
                    props.durationPrimaryUnitText,
                    "subtitle",
                    {"fontSize": 12, "minFontSize": 12, "fontWeight": 400, "fontColor": "#99000000", "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
                  )
          )
    ),
  IfPresent(
      data.updatedAt,
      Text(
            data.updatedAt,
            "subtitle",
            {"fontSize": 10, "minFontSize": 10, "fontWeight": 400, "fontColor": "#99000000", "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
          )
    )
)
#End

