#Template AppUsageOverviewFull@1(props: { appIcon?: asset })
data = {
    appName: $path("/appUsage/appName"),
    duration: $path("/appUsage/durationText"),
    updatedAt: $optionalPath("/updatedAt")
}

Column(
    {"_advancedComponent": "AppUsageOverview", "width": "matchParent", "height": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
    Column(
        {
            "width": "matchParent",
            "itemMargin": 8,
            "justifyContent": "start",
            "alignItems": "start",
        },
        Row(
            {"width": "matchParent", "height": 20, "itemMargin": 4, "justifyContent": "spaceBetween", "alignItems": "center", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
            Text(
                data.appName,
                {"fontSize": 12, "minFontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "layoutWeight": 1, "constraintSize": {"minWidth": 0, "minHeight": 0}}
            ),
            #if props.appIcon
              Image(
                  props.appIcon,
                  {"width": 20, "height": 20, "borderRadius": 4, "objectFit": "contain", "flexShrink": 0, "_preserveOriginalColor": true}
              )
            #endif
        ),
        Row(
            {"height": 32, "width": "matchParent", "itemMargin": 2, "justifyContent": "start", "alignItems": "bottom", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
            Text(
                data.duration,
                {"fontSize": 24, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
            )
        ),
    ),
    #if data.updatedAt
      Column(
          {"width":"matchParent","itemMargin":4,"layoutWeight": 1, "justifyContent": "end", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
          Text(
              `更新于 ${data.updatedAt}`,
              {"fontSize": 10, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
          )
      )
    #endif
)
#End

