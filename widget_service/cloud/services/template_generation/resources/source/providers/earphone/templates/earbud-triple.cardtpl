#Template BluetoothDeviceOverviewEarbudTripleHero@1(props: { caseIcon?: asset, leftEarIcon?: asset, rightEarIcon?: asset })
data = {
    name: $path("/earphoneName"),
    left: $path("/leftBatteryLevel"),
    right: $path("/rightBatteryLevel"),
    case: $path("/batteryLevel"),
    leftCharge: $optionalPath("/leftChargingStatusDesc"),
    rightCharge: $optionalPath("/rightChargingStatusDesc"),
    caseCharge: $optionalPath("/chargingStatusDesc")
}

Column(
    {
        "_advancedComponent": "BluetoothDeviceOverview",
        "_layoutActionBackgroundOpacity": 0.1,
        "width": "matchParent", "height": "matchParent", "itemMargin": 4,
        "justifyContent": "start", "alignItems": "start", "clip": true,
        "constraintSize": { "minWidth": 0, "minHeight": 0 }
    },
    Text(data.name, {
        "width": "matchParent", "fontSize": 18, "fontWeight": 700,
        "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis",
        "constraintSize": { "minWidth": 0, "minHeight": 0 },
        "margin": { "top": 0, "bottom": 4, "left": 0, "right": 0 }
    }),
    Row({ "width": #Expr(data.leftCharge ? (data.rightCharge ? (data.caseCharge ? 126 : "matchParent") : "matchParent") : "matchParent"), "height": #Expr(data.leftCharge ? (data.rightCharge ? (data.caseCharge ? 50 : 34) : 34) : 34), "itemMargin": 9,
        "justifyContent": "start", "alignItems": "start" },
        Column({ "width": #Expr(data.leftCharge ? (data.rightCharge ? (data.caseCharge ? 36 : "matchParent") : "matchParent") : "matchParent"), "layoutWeight": #Expr(data.leftCharge ? (data.rightCharge ? (data.caseCharge ? 0 : 1) : 1) : 1), "height": #Expr(data.leftCharge ? (data.rightCharge ? (data.caseCharge ? 50 : 34) : 34) : 34), "itemMargin": 2,
            "justifyContent": "start", "alignItems": #Expr(data.leftCharge ? (data.rightCharge ? (data.caseCharge ? "start" : "center") : "center") : "center") },
            Stack({ "width": 16, "height": 16, "alignContent": "center" },
                #if props.leftEarIcon
                #if props.rightEarIcon
                #if props.caseIcon
                    Image(props.leftEarIcon, { "width": 12, "height": 12, "fillColor": "#99FFFFFF" }),
                #else
                Stack({"width": 16, "height": 16, "borderRadius": 8,
                  "alignContent": "center", "flexShrink": 0,
                  "backgroundColor": $theme('supportContentColor')},
                  Text("L", {"width": 16, "height": 16, "fontSize": 10,
                    "fontWeight": 500, "fontColor": "#FFFFFFFF", "textAlign": "center",
                    "maxLines": 1})
                ),
                #endif
                #else
                Stack({"width": 16, "height": 16, "borderRadius": 8,
                  "alignContent": "center", "flexShrink": 0,
                  "backgroundColor": $theme('supportContentColor')},
                  Text("L", {"width": 16, "height": 16, "fontSize": 10,
                    "fontWeight": 500, "fontColor": "#FFFFFFFF", "textAlign": "center",
                    "maxLines": 1})
                ),
                #endif
                #else
                Stack({"width": 16, "height": 16, "borderRadius": 8,
                  "alignContent": "center", "flexShrink": 0,
                  "backgroundColor": $theme('supportContentColor')},
                  Text("L", {"width": 16, "height": 16, "fontSize": 10,
                    "fontWeight": 500, "fontColor": "#FFFFFFFF", "textAlign": "center",
                    "maxLines": 1})
                ),
                #endif
            ),
            Text(Expr('' + data.left + '%'), {
                "width": #Expr(data.leftCharge ? (data.rightCharge ? (data.caseCharge ? 36 : "matchParent") : "matchParent") : "matchParent"), "height": 16, "fontSize": 12, "fontWeight": 500,
                "textAlign": #Expr(data.leftCharge ? (data.rightCharge ? (data.caseCharge ? "start" : "center") : "center") : "center"), "fontColor": "#FFFFFFFF", "maxLines": 1,
                "textOverflow": "ellipsis"
            }),
            #if data.leftCharge && data.rightCharge
                #if data.caseCharge
            Text(data.leftCharge, {
                "width": #Expr(data.leftCharge ? (data.rightCharge ? (data.caseCharge ? 36 : "matchParent") : "matchParent") : "matchParent"), "height": 14, "fontSize": 10, "fontWeight": 400,
                "textAlign": #Expr(data.leftCharge ? (data.rightCharge ? (data.caseCharge ? "start" : "center") : "center") : "center"), "fontColor": "#99FFFFFF", "maxLines": 1,
                "textOverflow": "ellipsis"
            })
                #endif
            #endif
        ),
        Column({ "width": #Expr(data.leftCharge ? (data.rightCharge ? (data.caseCharge ? 36 : "matchParent") : "matchParent") : "matchParent"), "layoutWeight": #Expr(data.leftCharge ? (data.rightCharge ? (data.caseCharge ? 0 : 1) : 1) : 1), "height": #Expr(data.leftCharge ? (data.rightCharge ? (data.caseCharge ? 50 : 34) : 34) : 34), "itemMargin": 2,
            "justifyContent": "start", "alignItems": #Expr(data.leftCharge ? (data.rightCharge ? (data.caseCharge ? "start" : "center") : "center") : "center") },
            Stack({ "width": 16, "height": 16, "alignContent": "center" },
                #if props.leftEarIcon
                #if props.rightEarIcon
                #if props.caseIcon
                    Image(props.rightEarIcon, { "width": 12, "height": 12, "fillColor": "#99FFFFFF" }),
                #else
                Stack({"width": 16, "height": 16, "borderRadius": 8,
                  "alignContent": "center", "flexShrink": 0,
                  "backgroundColor": $theme('supportContentColor')},
                  Text("R", {"width": 16, "height": 16, "fontSize": 10,
                    "fontWeight": 500, "fontColor": "#FFFFFFFF", "textAlign": "center",
                    "maxLines": 1})
                ),
                #endif
                #else
                Stack({"width": 16, "height": 16, "borderRadius": 8,
                  "alignContent": "center", "flexShrink": 0,
                  "backgroundColor": $theme('supportContentColor')},
                  Text("R", {"width": 16, "height": 16, "fontSize": 10,
                    "fontWeight": 500, "fontColor": "#FFFFFFFF", "textAlign": "center",
                    "maxLines": 1})
                ),
                #endif
                #else
                Stack({"width": 16, "height": 16, "borderRadius": 8,
                  "alignContent": "center", "flexShrink": 0,
                  "backgroundColor": $theme('supportContentColor')},
                  Text("R", {"width": 16, "height": 16, "fontSize": 10,
                    "fontWeight": 500, "fontColor": "#FFFFFFFF", "textAlign": "center",
                    "maxLines": 1})
                ),
                #endif
            ),
            Text(Expr('' + data.right + '%'), {
                "width": #Expr(data.leftCharge ? (data.rightCharge ? (data.caseCharge ? 36 : "matchParent") : "matchParent") : "matchParent"), "height": 16, "fontSize": 12, "fontWeight": 500,
                "textAlign": #Expr(data.leftCharge ? (data.rightCharge ? (data.caseCharge ? "start" : "center") : "center") : "center"), "fontColor": "#FFFFFFFF", "maxLines": 1,
                "textOverflow": "ellipsis"
            }),
            #if data.leftCharge && data.rightCharge
                #if data.caseCharge
            Text(data.rightCharge, {
                "width": #Expr(data.leftCharge ? (data.rightCharge ? (data.caseCharge ? 36 : "matchParent") : "matchParent") : "matchParent"), "height": 14, "fontSize": 10, "fontWeight": 400,
                "textAlign": #Expr(data.leftCharge ? (data.rightCharge ? (data.caseCharge ? "start" : "center") : "center") : "center"), "fontColor": "#99FFFFFF", "maxLines": 1,
                "textOverflow": "ellipsis"
            })
                #endif
            #endif
        ),
        Column({ "width": #Expr(data.leftCharge ? (data.rightCharge ? (data.caseCharge ? 36 : "matchParent") : "matchParent") : "matchParent"), "layoutWeight": #Expr(data.leftCharge ? (data.rightCharge ? (data.caseCharge ? 0 : 1) : 1) : 1), "height": #Expr(data.leftCharge ? (data.rightCharge ? (data.caseCharge ? 50 : 34) : 34) : 34), "itemMargin": 2,
            "justifyContent": "start", "alignItems": #Expr(data.leftCharge ? (data.rightCharge ? (data.caseCharge ? "start" : "center") : "center") : "center") },
            Stack({ "width": 16, "height": 16, "alignContent": "center" },
                #if props.leftEarIcon
                #if props.rightEarIcon
                #if props.caseIcon
                    Image(props.caseIcon, { "width": 13.73, "height": 10, "fillColor": "#99FFFFFF" }),
                #else
                Stack({"width": 16, "height": 16, "borderRadius": 8,
                  "alignContent": "center", "flexShrink": 0,
                  "backgroundColor": $theme('supportContentColor')},
                  Text("E", {"width": 16, "height": 16, "fontSize": 10,
                    "fontWeight": 500, "fontColor": "#FFFFFFFF", "textAlign": "center",
                    "maxLines": 1})
                ),
                #endif
                #else
                Stack({"width": 16, "height": 16, "borderRadius": 8,
                  "alignContent": "center", "flexShrink": 0,
                  "backgroundColor": $theme('supportContentColor')},
                  Text("E", {"width": 16, "height": 16, "fontSize": 10,
                    "fontWeight": 500, "fontColor": "#FFFFFFFF", "textAlign": "center",
                    "maxLines": 1})
                ),
                #endif
                #else
                Stack({"width": 16, "height": 16, "borderRadius": 8,
                  "alignContent": "center", "flexShrink": 0,
                  "backgroundColor": $theme('supportContentColor')},
                  Text("E", {"width": 16, "height": 16, "fontSize": 10,
                    "fontWeight": 500, "fontColor": "#FFFFFFFF", "textAlign": "center",
                    "maxLines": 1})
                ),
                #endif
            ),
            Text(Expr('' + data.case + '%'), {
                "width": #Expr(data.leftCharge ? (data.rightCharge ? (data.caseCharge ? 36 : "matchParent") : "matchParent") : "matchParent"), "height": 16, "fontSize": 12, "fontWeight": 500,
                "textAlign": #Expr(data.leftCharge ? (data.rightCharge ? (data.caseCharge ? "start" : "center") : "center") : "center"), "fontColor": "#FFFFFFFF", "maxLines": 1,
                "textOverflow": "ellipsis"
            }),
            #if data.leftCharge && data.rightCharge
                #if data.caseCharge
            Text(data.caseCharge, {
                "width": #Expr(data.leftCharge ? (data.rightCharge ? (data.caseCharge ? 36 : "matchParent") : "matchParent") : "matchParent"), "height": 14, "fontSize": 10, "fontWeight": 400,
                "textAlign": #Expr(data.leftCharge ? (data.rightCharge ? (data.caseCharge ? "start" : "center") : "center") : "center"), "fontColor": "#99FFFFFF", "maxLines": 1,
                "textOverflow": "ellipsis"
            })
                #endif
            #endif
        )
    )
)
#End
