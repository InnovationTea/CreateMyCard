#Template BluetoothDeviceOverviewCaseConnectionHero@1(props: { title?: string, deviceIcon: asset })
data = { battery: $path("/batteryLevel"), connected: $path("/isConnected") }
Column({"_advancedComponent": "BluetoothDeviceOverview", "width": "matchParent", "height": "matchParent",
  "justifyContent": "start", "alignItems": "start", "itemMargin": 8},
  Text(#Expr(props.title ? props.title : "耳机仓"), {"height": 16, "fontSize": 12, "fontWeight": 400,
    "fontColor": $theme('supportContentColor'), "maxLines": 1}),
  Row({"width": "matchParent", "itemMargin": 8, "alignItems": "center"},
    Stack({"width": 44, "height": 44, "alignContent": "center", "flexShrink": 0},
      Progress({"value": data.battery, "total": 100, "type": "ring",
        "width": 44, "height": 44, "strokeWidth": 6,
        "color": $theme('progressColor'), "backgroundColor": $theme('progressBackgroundColor')}),
      Image(props.deviceIcon, {"width": 20, "height": 20, "objectFit": "contain",
        "fillColor": $theme('supportContentColor')})
    ),
    Column({"layoutWeight": 1, "itemMargin": 2},
      Text(Expr(data.battery + '%'), {"height": 19, "fontSize": 14, "fontWeight": 700,
        "fontColor": $theme('primaryColor'), "maxLines": 1}),
      Text(Expr(data.connected ? '已连接' : '未连接'), {"height": 14, "fontSize": 10,
        "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1})
    )
  )
)
#End

#Template BluetoothDeviceOverviewConnectionBatterySupport@1(props: { caseIcon?: asset })
data = { battery: $path("/batteryLevel"), connected: $path("/isConnected") }
Column(
    {
        "_advancedComponent": "BluetoothDeviceOverview",
        "width": "matchParent",
        "height": "matchParent",
        "itemMargin": 4,
        "justifyContent": "center",
        "alignItems": "start",
        "clip": true,
        "constraintSize": {
            "minWidth": 0,
            "minHeight": 0
        }
    },
    Row(
        {
            "width": "matchParent",
            "height": "matchParent",
            "itemMargin": 4,
            "justifyContent": "spaceBetween",
            "alignItems": "center"
        },
        Column(
            {
                "layoutWeight": 1,
                "constraintSize": {"minWidth": 0},
                "height": "matchParent",
                "itemMargin": 4,
                "justifyContent": "center",
            },
            Text(
                Expr("电量 " + data.battery + '%'),
                { "fontColor": $theme('primaryColor'), "fontSize": 16, "fontWeight": 700, "maxLines": 1 }
            ),
            Text(
                Expr(data.connected ? '已连接' : '未连接'),
                { "width": "matchParent", "fontSize": 12, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1 }
            ),
        ),
        #if props.caseIcon
            Image(
                props.caseIcon,
                { "width": 24, "height": 24, "fillColor": $theme('supportContentColor') }
            ),
        #else
        Stack({"width": 17.5, "height": 17.5, "borderRadius": 8.75,
          "alignContent": "center", "flexShrink": 0,
          "backgroundColor": $theme('supportContentColor')},
          Text("E", {"width": 17.5, "height": 17.5, "fontSize": 12,
            "fontWeight": 500, "fontColor": "#FFFFFFFF", "textAlign": "center",
            "maxLines": 1})
        ),
        #endif
    )
)
#End
