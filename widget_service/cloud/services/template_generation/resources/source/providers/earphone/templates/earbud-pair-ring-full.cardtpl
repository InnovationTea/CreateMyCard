#Template BluetoothDeviceOverviewEarbudPairRingFull@1(props: {})
data = {
    name: $path("/earphoneName"),
    left: $path("/leftBatteryLevel"),
    right: $path("/rightBatteryLevel"),
    leftCharge: $optionalPath("/leftChargingStatusDesc"),
    rightCharge: $optionalPath("/rightChargingStatusDesc")
}

Column(
  {"_advancedComponent": "BluetoothDeviceOverview", "width": "matchParent", "height": "matchParent",
   "itemMargin": 8, "justifyContent": "start", "alignItems": "start", "clip": true,
   "constraintSize": {"minWidth": 0, "minHeight": 0}},
  Text(data.name, {"width": "matchParent", "height": 22, "fontSize": 16, "fontWeight": 500,
    "fontColor": $theme('primaryColor'), "textAlign": "left", "maxLines": 1,
    "textOverflow": "ellipsis", "flexShrink": 0, "constraintSize": {"minWidth": 0}}),
  Row(
    {"width": "matchParent", "itemMargin": 12, "justifyContent": "start", "alignItems": "start"},
    Column(
      {"layoutWeight": 1, "itemMargin": 4, "justifyContent": "start", "alignItems": "center",
       "constraintSize": {"minWidth": 0}},
      Stack(
        {"width": 48, "height": 48, "alignContent": "center", "flexShrink": 0},
        Progress({"value": data.left, "total": 100, "type": "ring", "width": 48, "height": 48,
          "strokeWidth": 6, "color": $theme('progressColor'),
          "backgroundColor": $theme('progressBackgroundColor')}),
        Stack({"width": 17.5, "height": 17.5, "borderRadius": 8.75,
          "alignContent": "center", "backgroundColor": $theme('supportContentColor')},
          Text("L", {"width": 17.5, "height": 17.5, "fontSize": 12, "fontWeight": 500,
            "fontColor": "#FFFFFFFF", "textAlign": "center", "maxLines": 1})
        )
      ),
      Text(Expr('' + data.left + '%'), {"width": "matchParent", "height": 18,
        "fontSize": 12, "fontWeight": 500, "fontColor": $theme('primaryColor'),
        "textAlign": "center", "maxLines": 1, "flexShrink": 0}),
      #if data.leftCharge
      Text(data.leftCharge, {"width": "matchParent", "height": 16, "fontSize": 12,
        "minFontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'),
        "textAlign": "center", "maxLines": 1, "textOverflow": "ellipsis", "flexShrink": 0}),
      #endif
    ),
    Column(
      {"layoutWeight": 1, "itemMargin": 4, "justifyContent": "start", "alignItems": "center",
       "constraintSize": {"minWidth": 0}},
      Stack(
        {"width": 48, "height": 48, "alignContent": "center", "flexShrink": 0},
        Progress({"value": data.right, "total": 100, "type": "ring", "width": 48, "height": 48,
          "strokeWidth": 6, "color": $theme('progressColor'),
          "backgroundColor": $theme('progressBackgroundColor')}),
        Stack({"width": 17.5, "height": 17.5, "borderRadius": 8.75,
          "alignContent": "center", "backgroundColor": $theme('supportContentColor')},
          Text("R", {"width": 17.5, "height": 17.5, "fontSize": 12, "fontWeight": 500,
            "fontColor": "#FFFFFFFF", "textAlign": "center", "maxLines": 1})
        )
      ),
      Text(Expr('' + data.right + '%'), {"width": "matchParent", "height": 18,
        "fontSize": 12, "fontWeight": 500, "fontColor": $theme('primaryColor'),
        "textAlign": "center", "maxLines": 1, "flexShrink": 0}),
      #if data.rightCharge
      Text(data.rightCharge, {"width": "matchParent", "height": 16, "fontSize": 12,
        "minFontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'),
        "textAlign": "center", "maxLines": 1, "textOverflow": "ellipsis", "flexShrink": 0}),
      #endif
    )
  )
)
#End
