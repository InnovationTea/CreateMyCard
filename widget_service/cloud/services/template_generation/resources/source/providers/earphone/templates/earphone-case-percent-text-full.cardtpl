#Template BluetoothDeviceOverviewEarphoneCasePercentTextFull@1(props: {})
data = {
    name: $optionalPath("/earphoneName"),
    battery: $path("/batteryLevel"),
    charging: $path("/chargingStatusDesc")
}

Column(
  {"_advancedComponent": "BluetoothDeviceOverview", "width": "matchParent", "height": "matchParent",
   "padding": {"top": 4}, "itemMargin": 8, "justifyContent": "start", "alignItems": "center",
   "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
  Text(
    #Expr(data.name ? data.name : "耳机电量"),
    {"width": 112, "height": 24, "fontSize": 16, "fontWeight": 400,
     "fontColor": $theme('supportContentColor'), "textAlign": "center", "maxLines": 1,
     "textOverflow": "ellipsis", "flexShrink": 0}
  ),
  Text(
    Expr('' + data.battery + '%'),
    {"width": 102, "height": 60, "fontSize": 38, "fontWeight": 700,
     "fontColor": $theme('primaryColor'), "textAlign": "center", "maxLines": 1, "flexShrink": 0}
  ),
  Text(
    data.charging,
    {"width": 106, "height": 16, "fontSize": 12, "fontWeight": 400,
     "fontColor": $theme('supportContentColor'), "textAlign": "center", "maxLines": 1, "flexShrink": 0}
  )
)
#End
