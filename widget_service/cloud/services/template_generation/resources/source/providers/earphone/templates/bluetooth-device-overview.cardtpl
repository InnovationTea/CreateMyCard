                        ),
                Text(
                          Expr('' + data.left + '%'),
                          {"width": "matchParent", "fontSize": 12, "fontWeight": 500, "fontColor": $theme('primaryColor'), "maxLines": 1, "textAlign": "center", "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
                        )
              )
      #endif
      #if data.right
        Column(
                {"width":"matchParent","layoutWeight": 1, "itemMargin": 1, "justifyContent": "center", "alignItems": "center", "constraintSize": {"minWidth": 0, "minHeight": 0}},
                Stack(
                          {"width": 40, "height": 40, "alignContent": "center", "flexShrink": 0},
                          Progress(
                                      {"value": data.right,
                                        "total": 100,
                                        "type": "ring",
                                        "color": $theme('supportContentColor'),
                                        "backgroundColor": "#1A000000",
                                        "width": 40,
                                        "height": 40,
                                        "strokeWidth": 6}
                                    ),
                          #if props.rightEarIcon
                            Image(
                                          props.rightEarIcon,
                                          {"width": 18, "height": 18, "objectFit": "contain", "_preserveOriginalColor": true}
                                        )
                          #endif
                        ),
                Text(
                          Expr('' + data.right + '%'),
                          {"width": "matchParent", "fontSize": 12, "fontWeight": 500, "fontColor": $theme('primaryColor'), "maxLines": 1, "textAlign": "center", "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
                        )
              )
      #endif
      #if data.left
      #else
        #if data.right
        #else
          #if data.battery
            Column(
                        {"width":"matchParent","layoutWeight": 1, "itemMargin": 1, "justifyContent": "center", "alignItems": "center", "constraintSize": {"minWidth": 0, "minHeight": 0}},
                        Stack(
                                      {"width": 40, "height": 40, "alignContent": "center", "flexShrink": 0},
                                      Progress(
                                                      {"value": data.battery,
                                                        "total": 100,
                                                        "type": "ring",
                                                        "color": $theme('supportContentColor'),
                                                        "backgroundColor": "#1A000000",
                                                        "width": 40,
                                                        "height": 40,
                                                        "strokeWidth": 6}
                                                    ),
                                      #if props.sourceIcon
