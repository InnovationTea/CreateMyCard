  ),
  Column({"layoutWeight": 1, "height": "matchParent", "itemMargin": 12},
    Row({"width": "matchParent", "layoutWeight": 1, "padding": {"left": 8, "right": 8, "top": 6, "bottom": 7},
      "itemMargin": 8, "alignItems": "center", "borderRadius": 16,
      "backgroundColor": $theme('supportContentStyle.backgroundColor')},
      Column({"layoutWeight": 1, "height": 37, "itemMargin": 2},
        Text(Expr(`'' + ${data.left} + '%'`), {"width": "matchParent", "height": 21, "fontSize": 16,
          "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1}),
        Text(data.leftChargingStatus, {"width": "matchParent", "height": 14, "fontSize": 10,
          "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1})
      ),
      Stack({"width": 44, "height": 44, "alignContent": "center", "flexShrink": 0},
        Progress({"value": data.left, "total": 100, "type": "ring", "width": 44, "height": 44,
          "strokeWidth": 6, "color": $theme('progressColor'),
          "backgroundColor": $theme('progressBackgroundColor')}),
        #if props.leftEarIcon
          Image(props.leftEarIcon, {"width": 20, "height": 20, "objectFit": "contain",
            "fillColor": $theme('supportContentColor')})
        #endif
      )
    ),
    Row({"width": "matchParent", "layoutWeight": 1, "padding": {"left": 8, "right": 8, "top": 6, "bottom": 7},
      "itemMargin": 8, "alignItems": "center", "borderRadius": 16,
      "backgroundColor": $theme('supportContentStyle.backgroundColor')},
      Column({"layoutWeight": 1, "height": 37, "itemMargin": 2},
        Text(Expr(`'' + ${data.right} + '%'`), {"width": "matchParent", "height": 21, "fontSize": 16,
          "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1}),
        Text(data.rightChargingStatus, {"width": "matchParent", "height": 14, "fontSize": 10,
          "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1})
      ),
      Stack({"width": 44, "height": 44, "alignContent": "center", "flexShrink": 0},
        Progress({"value": data.right, "total": 100, "type": "ring", "width": 44, "height": 44,
          "strokeWidth": 6, "color": $theme('progressColor'),
          "backgroundColor": $theme('progressBackgroundColor')}),
        #if props.rightEarIcon
          Image(props.rightEarIcon, {"width": 20, "height": 20, "objectFit": "contain",
            "fillColor": $theme('supportContentColor')})
        #endif
      )
    )
  )
)
#End

#Template BluetoothDeviceOverviewMusicFull@1(props: { caseIcon?: asset })
data = {
  name: $path("/earphoneName"),
  connected: $path("/isConnected"),
  battery: $path("/batteryLevel"),
  updated: $path("/updatedAt")
}
Column({"_advancedComponent": "BluetoothDeviceOverview", "width": "matchParent", "height": "matchParent", "justifyContent": "spaceBetween"},
  Column({"width": "matchParent", "itemMargin": 14},
    Text(data.name, {"height": 16, "fontSize": 12, "fontWeight": 400,
      "fontColor": $theme('supportContentColor'), "maxLines": 1}),
    Row({"width": "matchParent", "height": 44, "itemMargin": 8, "alignItems": "center"},
      Stack({"width": 44, "height": 44, "alignContent": "center", "flexShrink": 0},
        Progress({"value": data.battery, "total": 100, "type": "ring", "width": 44, "height": 44,
          "strokeWidth": 6, "color": $theme('progressColor'),
          "backgroundColor": $theme('progressBackgroundColor')}),
        #if props.caseIcon
          Image(props.caseIcon, {"width": 20, "height": 20, "objectFit": "contain",
            "fillColor": $theme('supportContentColor')})
        #endif
      ),
      Column({"layoutWeight": 1, "height": 35, "itemMargin": 2},
        Text(Expr(data.battery + '%'), {"height": 19, "fontSize": 14, "fontWeight": 700,
          "fontColor": $theme('primaryColor'), "maxLines": 1}),
        Text(Expr(data.connected ? '已连接' : '未连接'), {"height": 14, "fontSize": 10,
          "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1})
      )
    )
  ),
  Text(Expr('更新时间 ' + data.updated), {"height": 16, "fontSize": 12, "fontWeight": 400,
    "fontColor": $theme('supportContentColor'), "maxLines": 1})
)
#End

#Template BluetoothDeviceOverviewStatusHero@1(props: { deviceIcon?: asset })
data = {
    status: $path("/chargingStatusDesc")
}

Column(
  {
    "_advancedComponent": "BluetoothDeviceOverview",
    "width": "matchParent",
    "height": "matchParent",
    "itemMargin": 6,
    "justifyContent": "start",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
  Row(
    {
      "width": "matchParent",
      "height": 20,
      "justifyContent": "spaceBetween",
      "alignItems": "top"
    },
    Text(
      "耳机仓",
      {
        "width": "matchParent",
        "fontSize": 14,
        "fontWeight": 400,
        "fontColor": $theme('supportContentColor'),
        "maxLines": 1,
        "textOverflow": "ellipsis",
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      }
    ),
    #if props.deviceIcon
      Image(
        props.deviceIcon,
        {
          "width": 20,
          "height": 20,
          "objectFit": "contain",
          "flexShrink": 0,
          "fillColor": $theme('supportContentColor')
        }
      )
    #endif
  ),
  Column(
    {
      "width": "matchParent",
      "height": 48,
      "layoutWeight": 1,
      "itemMargin": 3,
      "justifyContent": "start",
      "alignItems": "start",
      "clip": true,
      "constraintSize": {"minWidth": 0, "minHeight": 0}
    },
    Text(
      data.status,
      {
        "width": "matchParent",
        "fontSize": 20,
        "fontWeight": 700,
        "fontColor": $theme('primaryColor'),
        "maxLines": 1,
        "textOverflow": "ellipsis"
      }
    ),
    Text(
      "充电状态",
      {
        "width": "matchParent",
        "fontSize": 14,
        "fontWeight": 400,
        "fontColor": $theme('supportContentColor'),
        "maxLines": 1
      }
    )
  )
)
#End
