#Template BluetoothDeviceOverviewEarbudsSupport@1(props: { deviceIcon: asset, actionId?: string })
data = {
    left: $path("/leftBatteryLevel"),
    right: $path("/rightBatteryLevel")
}

Row(
  {
      "_advancedComponent": "BluetoothDeviceOverview",
      "width": "matchParent",
      "height": "matchParent",
      "padding": { "left": 8, "right": 8 },
      "alignItems": "center",
      "justifyContent": "spaceBetween",
      "onClick": EventAction(props?.actionId)
  },
  Column(
    {
      "itemMargin": 2,
      "alignItems": "start",
      "justifyContent": "start",
    },
    Text(
      '耳机电量',
      { "fontSize": 14, "fontWeight": 700, "height": 19, "fontColor": $theme('primaryColor') }
    ),
    Text(
      Expr('L ' + data.left + '% R ' + data.right + '%'),
      { "fontSize": 12, "fontWeight": 400, "height": 16, "fontColor": $theme('primaryColor') }
    )
  ),
  Image(
    props.deviceIcon,
    { "width": 24, "height": 24, "flexShrink": 0, "fillColor": $theme('supportContentColor') }
  )
)

#End

#Template BluetoothDeviceOverviewConnectionSupport@1(props: { deviceIcon: asset, actionId?: string })
data = {
    percent: $optionalPath("/batteryLevel"),
    connected: $path("/isConnected")
}

Row(
  {
    "_advancedComponent": "BluetoothDeviceOverview",
    "width": "matchParent",
    "height": "matchParent",
    "padding": { "left": 8, "right": 8 },
    "justifyContent": "start",
    "alignItems": "center",
    "clip": true,
    "constraintSize": { "minWidth": 0, "minHeight": 0 },
    "onClick": EventAction(props?.actionId)
  },
  Row(
    {
      "width": "matchParent",
      "itemMargin": 8,
      "justifyContent": "spaceBetween",
      "alignItems": "center",
      "constraintSize": {"minWidth": 0, "minHeight": 0}
    },
    Column(
      {
        "itemMargin": 4,
        "justifyContent": "start",
        "alignItems": "start",
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      },
      Text(
        Expr(`${data.connected}? '已链接' : '未链接'`),
        {
          "fontSize": 14,
          "fontWeight": 700,
          "fontColor": $theme('primaryColor'),
          "maxLines": 1,
          "textOverflow": "ellipsis",
          "constraintSize": {"minWidth": 0, "minHeight": 0}
        }
      ),
      #if data.percent
      Text(
        Expr("电量 " + data.percent + "%"),
        {
          "fontSize": 12,
          "fontWeight": 500,
          "fontColor": $theme('supportContentColor'),
          "maxLines": 1,
          "textOverflow": "ellipsis",
          "constraintSize": {"minWidth": 0, "minHeight": 0}
        }
      )
      #endif
    ),
    #if data.percent
    Stack(
      {"width": 40, "height": 40, "alignContent": "center", "flexShrink": 0},
      Progress(
        {
          "value": data.percent,
          "total": 100,
          "type": "ring",
          "color": $theme('progressColor'),
          "backgroundColor": $theme('progressBackgroundColor'),
          "width": 40,
          "height": 40,
          "strokeWidth": 6
        }
      ),
      #if props.deviceIcon
      Image(
        props.deviceIcon,
        {
          "width": 16,
          "height": 16,
          "objectFit": "contain",
          "fillColor": $theme('supportContentColor')
        }
      )
      #endif
    )
    #else
      #if props.deviceIcon
      Image(
        props.deviceIcon,
        { "width": 24, "height": 24, "flexShrink": 0, "fillColor": $theme('supportContentColor') }
      )
      #endif
    #endif
  )
)
#End

