      Text(
        Expr('' + data.right + '%'),
        { "fontColor": $theme('supportContentColor'), "fontSize": 10, "fontWeight": 400 }
      )
    )
  )
)
#End

#Template BluetoothDeviceOverviewCompletePhoneWideFull@1(props: { leftEarIcon?: asset, rightEarIcon?: asset })
data = {
    connected: $path("/isConnected"),
    name: $path("/earphoneName"),
    battery: $path("/batteryLevel"),
    left: $path("/leftBatteryLevel"),
    right: $path("/rightBatteryLevel")
}

Column(
  {"_advancedComponent": "BluetoothDeviceOverview",
    "width": "matchParent",
    "height": "matchParent",
    "padding": {"left": 8,
    "top": 6,
    "right": 8,
    "bottom": 6},
    "borderRadius": 8,
    "backgroundColor": "#1A64BB5C",
    "itemMargin": 4,
    "justifyContent": "start",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {"minWidth": 0,
    "minHeight": 0}},
  Text(
      Expr(data.connected ? data.name + ' · 已连接 · 充电盒 ' + data.battery + '%' : data.name + ' · 未连接 · 充电盒 ' + data.battery + '%'),
      {"width": "matchParent", "fontSize": 11, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textAlign": "start", "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    ),
  Row(
      {"width": "matchParent", "height": 56, "itemMargin": 8, "justifyContent": "center", "alignItems": "center", "constraintSize": {"minWidth": 0, "minHeight": 0}},
      Column(
            {"width":"matchParent","layoutWeight": 1, "itemMargin": 1, "justifyContent": "center", "alignItems": "center", "constraintSize": {"minWidth": 0, "minHeight": 0}},
            Stack(
                    {"width": 40, "height": 40, "alignContent": "center", "flexShrink": 0},
                    Progress(
                              {"value": data.left,
                                "total": 100,
                                "type": "ring",
                                "color": $theme('supportContentColor'),
                                "backgroundColor": "#1A000000",
                                "width": 40,
                                "height": 40,
                                "strokeWidth": 6}
                            ),
                    #if props.leftEarIcon
                      Image(
                                  props.leftEarIcon,
                                  {"width": 18, "height": 18, "objectFit": "contain", "_preserveOriginalColor": true}
                                )
                    #endif
                  ),
            Text(
                    Expr('' + data.left + '%'),
                    {"width": "matchParent", "fontSize": 12, "fontWeight": 500, "fontColor": $theme('primaryColor'), "maxLines": 1, "textAlign": "center", "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
                  )
          ),
      Column(
            {"width":"matchParent","layoutWeight": 1, "itemMargin": 1, "justifyContent": "center", "alignItems": "center", "constraintSize": {"minWidth": 0, "minHeight": 0}},
            Stack(
                    {"width": 40, "height": 40, "alignContent": "center", "flexShrink": 0},
                    Progress(
                              {"value": data.right,
                                "total": 100,
                                "type": "ring",
                                "color": $theme('supportContentColor'),
                                "backgroundColor": "#1A000000",
                                "width": 40,
                                "height": 40,
                                "strokeWidth": 6}
                            ),
                    #if props.rightEarIcon
                      Image(
                                  props.rightEarIcon,
                                  {"width": 18, "height": 18, "objectFit": "contain", "_preserveOriginalColor": true}
                                )
                    #endif
                  ),
            Text(
                    Expr('' + data.right + '%'),
                    {"width": "matchParent", "fontSize": 12, "fontWeight": 500, "fontColor": $theme('primaryColor'), "maxLines": 1, "textAlign": "center", "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
                  )
          )
    )
)
#End
