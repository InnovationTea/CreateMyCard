#Template BluetoothDeviceOverviewEarbudsPhone@1(props: { sourceIcon?: asset, leftEarIcon?: asset, rightEarIcon?: asset })
data = {
    connected: $path("/isConnected"),
    battery: $optionalPath("/batteryLevel"),
    left: $optionalPath("/leftBatteryLevel"),
    right: $optionalPath("/rightBatteryLevel")
}

Column(
  "compact",
  {"_advancedComponent": "BluetoothDeviceOverview", "_layoutActionBackgroundOpacity": 0.1, "width": "matchParent", "height": "matchParent", "padding": 0, "borderRadius": 0, "backgroundColor": "#00000000", "itemMargin": 2, "justifyContent": "center", "alignItems": "center", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
  Column(
      "compact",
      {"width": "matchParent", "height": "matchParent", "itemMargin": 2, "justifyContent": "center", "alignItems": "center", "constraintSize": {"minWidth": 0, "minHeight": 0}},
      IfPresent(
            data.left,
            Column(
                    "compact",
                    {"layoutWeight": 1, "itemMargin": 1, "justifyContent": "center", "alignItems": "center", "constraintSize": {"minWidth": 0, "minHeight": 0}},
                    Stack(
                              "overlay",
                              {"width": 32, "height": 32, "alignContent": "center", "flexShrink": 0},
                              Progress(
                                          {"value": data.left, "total": 100, "type": "ring", "color": Expr(`${data.left} <= 20 ? '#FFF9A01E' : '#FF64BB5C'`), "backgroundColor": "#1A000000", "width": 32, "height": 32, "strokeWidth": 6}
                                        ),
                              IfPresent(
                                          props.leftEarIcon,
                                          Image(
                                                        props.leftEarIcon,
                                                        "icon",
                                                        {"width": 14, "height": 14, "objectFit": "contain", "fillColor": "#99000000"}
                                                      )
                                        )
                            ),
                    Text(
                              Expr(`'' + ${data.left} + '%'`),
                              "subtitle",
                              {"width": "matchParent", "fontSize": 12, "fontWeight": 500, "fontColor": "#E6000000", "maxLines": 1, "textAlign": "center", "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
                            )
                  )
          ),
      IfPresent(
            data.right,
            Column(
                    "compact",
                    {"layoutWeight": 1, "itemMargin": 1, "justifyContent": "center", "alignItems": "center", "constraintSize": {"minWidth": 0, "minHeight": 0}},
                    Stack(
                              "overlay",
                              {"width": 32, "height": 32, "alignContent": "center", "flexShrink": 0},
                              Progress(
                                          {"value": data.right, "total": 100, "type": "ring", "color": Expr(`${data.right} <= 20 ? '#FFF9A01E' : '#FF64BB5C'`), "backgroundColor": "#1A000000", "width": 32, "height": 32, "strokeWidth": 6}
                                        ),
                              IfPresent(
                                          props.rightEarIcon,
                                          Image(
                                                        props.rightEarIcon,
                                                        "icon",
                                                        {"width": 14, "height": 14, "objectFit": "contain", "fillColor": "#99000000"}
                                                      )
                                        )
                            ),
                    Text(
                              Expr(`'' + ${data.right} + '%'`),
                              "subtitle",
                              {"width": "matchParent", "fontSize": 12, "fontWeight": 500, "fontColor": "#E6000000", "maxLines": 1, "textAlign": "center", "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
                            )
                  )
          ),
      IfAbsent(
            data.left,
            IfAbsent(
                    data.right,
                    IfPresent(
                              data.battery,
                              Column(
                                          "compact",
                                          {"layoutWeight": 1, "itemMargin": 1, "justifyContent": "center", "alignItems": "center", "constraintSize": {"minWidth": 0, "minHeight": 0}},
                                          Stack(
                                                        "overlay",
                                                        {"width": 32, "height": 32, "alignContent": "center", "flexShrink": 0},
                                                        Progress(
                                                                        {"value": data.battery, "total": 100, "type": "ring", "color": Expr(`${data.battery} <= 20 ? '#FFF9A01E' : '#FF64BB5C'`), "backgroundColor": "#1A000000", "width": 32, "height": 32, "strokeWidth": 6}
                                                                      ),
                                                        IfPresent(
                                                                        props.sourceIcon,
                                                                        Image(
                                                                                          props.sourceIcon,
                                                                                          "icon",
                                                                                          {"width": 14, "height": 14, "objectFit": "contain", "fillColor": "#99000000"}
                                                                                        )
                                                                      )
                                                      ),
                                          Text(
                                                        Expr(`'' + ${data.battery} + '%'`),
                                                        "subtitle",
                                                        {"width": "matchParent", "fontSize": 12, "fontWeight": 500, "fontColor": "#E6000000", "maxLines": 1, "textAlign": "center", "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
                                                      )
                                        )
                            )
                  )
          )
    ),
  Text(
      Expr(`${data.connected} ? '已连接' : '未连接'`),
      "subtitle",
      {"width": "matchParent", "fontSize": 10, "fontWeight": 400, "fontColor": "#99000000", "maxLines": 1, "textAlign": "center", "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    )
)
#End

