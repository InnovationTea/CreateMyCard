#Template BluetoothDeviceOverviewEarbudsSupport@1(props: { deviceIcon: asset, actionId?: string })
data = {
    left: $path("/leftBatteryLevel"),
    right: $path("/rightBatteryLevel")
}

Row(
  {
      "_advancedComponent": "BluetoothDeviceOverview",
      "width": "matchParent",
      "height": "matchParent",
      "padding": { "left": 12, "right": 16 },
      "alignItems": "center",
      "justifyContent": "spaceBetween",
      "onClick": EventAction(props?.actionId)
  },
  Column(
    {
      "itemMargin": 2,
      "alignItems": "start",
      "justifyContent": "start",
    },
    Text(
      '耳机电量',
      { "fontSize": 14, "fontWeight": 700, "height": 19, "fontColor": $theme('primaryColor') }
    ),
    Text(
      Expr('L ' + data.left + '% R ' + data.right + '%'),
      { "fontSize": 12, "fontWeight": 500, "height": 16, "fontColor": $theme('primaryColor') }
    )
  ),
  Image(
    props.deviceIcon,
    { "width": 24, "height": 24, "fillColor": $theme('supportContentColor') }
  )
)

#End

#Template BluetoothDeviceOverviewEarbudsFull@1(props: { leftEarIcon?: asset, rightEarIcon?: asset })
data = {
    left: $path("/leftBatteryLevel"),
    right: $path("/rightBatteryLevel"),
    leftDesc: $optionalPath("/leftChargingStatusDesc"),
    rightDesc: $optionalPath("/rightChargingStatusDesc")
}

Column(
  {
    "_advancedComponent": "BluetoothDeviceOverview",
    "_layoutActionBackgroundOpacity": 0.1,
    "width": "matchParent",
    "height": "matchParent",
    "itemMargin": 4,
    "justifyContent": "start",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
    Row(
        {
            "layoutWeight": 1,
            "justifyContent": "center",
            "alignItems": "center",
            "itemMargin": 12
        },
        Stack(
            {"width": 52, "height": 52, "alignContent": "center", "flexShrink": 0},
            Progress(
                {
                    "value": data.left,
                    "total": 100,
                    "type": "ring",
                    "color": $theme('progressColor'),
                    "backgroundColor": $theme('progressBackgroundColor'),
                    "width": 52,
                    "height": 52,
                    "strokeWidth": 6
                }
            ),
            Row(
                {
                    "alignItems": "end",
                    "justifyContent": "center",
                    "itemMargin": 1
                },
                Text(
                    data.left,
                    { "fontColor": $theme('primaryColor'), "fontSize": 13.71, "fontWeight": 700, "flexShrink": 0 }
                ),
                Text(
                    "%",
                    { "fontColor": $theme('supportContentColor'), "fontSize": 9.14, "fontWeight": 500, "flexShrink": 1, "margin": { "bottom": 2 } }
                )
            )
        ),
        Column(
            {
                "alignItems": "start",
                "itemMargin": 2
            },
            Row(
                { "itemMargin": 4, "alignItems": "center" },
                #if props.leftEarIcon
                    Image(
                        props.leftEarIcon,
                        { "width": 16, "height": 16, "fillColor": $theme('supportContentColor') }
                    ),
                #endif
                Text(
                    "左耳机",
                    { "fontColor": $theme('primaryColor'), "fontSize": 14, "fontWeight": 700 }
                )
            ),
            #if data.leftDesc
                Text(
                    data.leftDesc,
                    { "fontColor": $theme('supportContentColor'), "fontSize": 12, "fontWeight": 500 }
                )
            #endif
        )
    ),
    Row(
        {
            "layoutWeight": 1,
            "justifyContent": "center",
            "alignItems": "center",
            "itemMargin": 12
        },
        Stack(
            {"width": 52, "height": 52, "alignContent": "center", "flexShrink": 0},
            Progress(
                {
                    "value": data.right,
                    "total": 100,
                    "type": "ring",
                    "color": $theme('progressColor'),
                    "backgroundColor": $theme('progressBackgroundColor'),
                    "width": 52,
                    "height": 52,
                    "strokeWidth": 6
                }
            ),
            Row(
                {
                    "alignItems": "end",
                    "justifyContent": "center",
                    "itemMargin": 1
                },
                Text(
                    data.right,
                    { "fontColor": $theme('primaryColor'), "fontSize": 13.71, "fontWeight": 700, "flexShrink": 0 }
                ),
                Text(
                    "%",
                    { "fontColor": $theme('supportContentColor'), "fontSize": 9.14, "fontWeight": 500, "flexShrink": 1, "margin": { "bottom": 2 } }
                )
            )
        ),
        Column(
            {
                "alignItems": "start",
                "itemMargin": 2
            },
            Row(
                { "itemMargin": 4, "alignItems": "center" },
                #if props.rightEarIcon
                    Image(
                        props.rightEarIcon,
                        { "width": 16, "height": 16, "fillColor": $theme('supportContentColor') }
                    ),
                #endif
                Text(
                    "右耳机",
                    { "fontColor": $theme('primaryColor'), "fontSize": 14, "fontWeight": 700 }
                )
            ),
            #if data.rightDesc
                Text(
                    data.rightDesc,
                    { "fontColor": $theme('supportContentColor'), "fontSize": 12, "fontWeight": 500 }
                )
            #endif
        )
    )
)
#End

#Template BluetoothDeviceOverviewEarbudPairFull@1(props: { caseIcon?: asset, leftEarIcon?: asset, rightEarIcon?: asset })
data = {
    connected: $path("/isConnected"),
    name: $path("/earphoneName"),
    case: $path("/batteryLevel"),
    left: $path("/leftBatteryLevel"),
    right: $path("/rightBatteryLevel")
}

Column(
  {
    "_advancedComponent": "BluetoothDeviceOverview",
    "width": "matchParent",
    "height": "matchParent",
    "itemMargin": 4,
    "justifyContent": "spaceBetween",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {
      "minWidth": 0,
      "minHeight": 0
    }
  },
  Column(
    { "width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "start", "constraintSize": { "minWidth": 0, "minHeight": 0 } },
    Text(
      data.name,
      { "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "height": 18, "constraintSize": { "minWidth": 0, "minHeight": 0 } }
    ),
    Text(
      Expr(data.connected ? '已连接' : '未连接'),
      { "fontSize": 20, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "height": 26, "constraintSize": { "minWidth": 0, "minHeight": 0 } }
    )
  ),
  Row(
    { "width": "matchParent", "height": 40, "itemMargin": 8, "justifyContent": "spaceBetween", "alignItems": "center", "constraintSize": { "minWidth": 0, "minHeight": 0 } },
    Column(
      {
          "height": 40,
          "itemMargin": 2,
          "justifyContent": "start",
          "alignItems": "center",
      },
      #if props.leftEarIcon
        Image(
          props.leftEarIcon,
          { "width": 20, "height": 20, "fillColor": $theme('supportContentColor') }
        )
      #else
        Text('左',
          { "fontSize": 14, "height": 20, "fontWeight": 400, "fontColor":$theme('supportContentColor') }
        )
      #endif
      Text(Expr('' + data.left + '%'),
          { "fontSize": 14, "height": 18, "fontWeight": 500, "fontColor":$theme('supportContentColor') }
        )
    ),
    Column(
      {
          "height": 40,
          "itemMargin": 2,
          "justifyContent": "start",
          "alignItems": "center",
      },
      #if props.rightEarIcon
        Image(
          props.rightEarIcon,
          { "width": 20, "height": 20, "fillColor": $theme('supportContentColor') }
        )
      #else
        Text('右',
          { "fontSize": 14, "height": 20, "fontWeight": 400, "fontColor":$theme('supportContentColor') }
        )
      #endif
      Text(Expr('' + data.right + '%'),
          { "fontSize": 14, "height": 18, "fontWeight": 500, "fontColor":$theme('supportContentColor') }
        )
    ),
    Column(
      {
          "height": 40,
          "itemMargin": 2,
          "justifyContent": "start",
          "alignItems": "center",
      },
      #if props.caseIcon
        Image(
