    Column("compact", { layoutWeight: 1, itemMargin: 1, justifyContent: "center", alignItems: "center", constraintSize: { minWidth: 0, minHeight: 0 } },
      Stack("overlay", { width: 40, height: 40, alignContent: "center", flexShrink: 0 },
        Progress({
