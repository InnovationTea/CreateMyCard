#Template BluetoothDeviceOverviewHero@1(props: { leftEarIcon?: asset, rightEarIcon?: asset })
data = {
    connected: $path("/isConnected"),
    name: $path("/earphoneName"),
    left: $path("/leftBatteryLevel"),
    right: $path("/rightBatteryLevel")
}

Column(
  {
    "_advancedComponent": "BluetoothDeviceOverview",
    "_layoutActionBackgroundOpacity": 0.1,
    "width": "matchParent",
    "height": "matchParent",
    "itemMargin": 4,
    "justifyContent": "start",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
  Text(
    data.name,
    {
      "width": "matchParent",
      "height": 16,
      "fontSize": 12,
      "fontWeight": 400,
      "fontColor": $theme('supportContentColor'),
      "maxLines": 1,
      "textOverflow": "ellipsis",
      "constraintSize": { "minWidth": 0, "minHeight": 0 }
    }
  ),
  Text(
    Expr(data.connected? '已连接' : '未连接'),
    {
      "width": "matchParent",
      "height": 32,
      "fontSize": 20,
      "fontWeight": 700,
      "fontColor": $theme('primaryColor'),
      "maxLines": 1,
      "textOverflow": "ellipsis",
      "constraintSize": { "minWidth": 0, "minHeight": 0 }
    }
  ),
  Row(
    {
      "width": 100,
      "height": 16,
      "itemMargin": 0,
      "justifyContent": "spaceBetween",
      "alignItems": "center",
    },
    Row(
      {
        "width": 50,
        "height": 16,
        "itemMargin": 2,
        "justifyContent": "start",
        "alignItems": "center",
      },
      #if props.leftEarIcon
        Image(
          props.leftEarIcon,
          { "width": 12, "height": 12, "fillColor": $theme('supportContentColor') }
        )
      #else
        Text(
          "左",
          { "fontColor": $theme('supportContentColor'), "fontSize": 12, "fontWeight": 500 }
        )
      #endif
      Text(
        Expr('' + data.left + '%'),
        { "fontColor": $theme('supportContentColor'), "fontSize": 12, "fontWeight": 500 }
      )
    ),
    Row(
      {
        "width": 50,
        "height": 16,
        "itemMargin": 2,
        "justifyContent": "start",
        "alignItems": "center",
      },
      #if props.rightEarIcon
        Image(
          props.rightEarIcon,
          { "width": 12, "height": 12, "fillColor": $theme('supportContentColor') }
        )
      #else
        Text(
          "右",
          { "fontColor": $theme('supportContentColor'), "fontSize": 12, "fontWeight": 500 }
        )
      #endif
      Text(
        Expr('' + data.right + '%'),
        { "fontColor": $theme('supportContentColor'), "fontSize": 12, "fontWeight": 500 }
      )
    )
  )
)
#End

#Template BluetoothDeviceOverviewEarbudsPhoneWideFull@1(props: { sourceIcon?: asset, leftEarIcon?: asset, rightEarIcon?: asset })
data = {
    connected: $path("/isConnected"),
    name: $path("/earphoneName"),
    battery: $optionalPath("/batteryLevel"),
    left: $optionalPath("/leftBatteryLevel"),
    right: $optionalPath("/rightBatteryLevel")
}

Column(
  {"_advancedComponent": "BluetoothDeviceOverview",
    "width": "matchParent",
    "height": "matchParent",
    "padding": {"left": 8,
    "top": 6,
    "right": 8,
    "bottom": 6},
    "borderRadius": 8,
    "backgroundColor": "#1A64BB5C",
    "itemMargin": 4,
    "justifyContent": "start",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {"minWidth": 0,
    "minHeight": 0}},
  #if data.battery
    Text(
          Expr(data.connected ? data.name + ' · 已连接 · 充电盒 ' + data.battery + '%' : data.name + ' · 未连接 · 充电盒 ' + data.battery + '%'),
          {"width": "matchParent", "fontSize": 11, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textAlign": "start", "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
        )
  #else
    Text(
          Expr(data.connected ? data.name + ' · 已连接' : data.name + ' · 未连接'),
          {"width": "matchParent", "fontSize": 11, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textAlign": "start", "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
        )
  #endif
  Row(
      {"width": "matchParent", "height": 56, "itemMargin": 8, "justifyContent": "center", "alignItems": "center", "constraintSize": {"minWidth": 0, "minHeight": 0}},
      #if data.left
        Column(
                {"width":"matchParent","layoutWeight": 1, "itemMargin": 1, "justifyContent": "center", "alignItems": "center", "constraintSize": {"minWidth": 0, "minHeight": 0}},
                Stack(
                          {"width": 40, "height": 40, "alignContent": "center", "flexShrink": 0},
                          Progress(
                                      {"value": data.left,
                                        "total": 100,
                                        "type": "ring",
                                        "color": $theme('supportContentColor'),
                                        "backgroundColor": "#1A000000",
                                        "width": 40,
                                        "height": 40,
                                        "strokeWidth": 6}
                                    ),
                          #if props.leftEarIcon
                            Image(
                                          props.leftEarIcon,
                                          {"width": 18, "height": 18, "objectFit": "contain", "_preserveOriginalColor": true}
                                        )
                          #endif
                        ),
                Text(
                          Expr('' + data.left + '%'),
                          {"width": "matchParent", "fontSize": 12, "fontWeight": 500, "fontColor": $theme('primaryColor'), "maxLines": 1, "textAlign": "center", "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
                        )
              )
      #endif
      #if data.right
        Column(
                {"width":"matchParent","layoutWeight": 1, "itemMargin": 1, "justifyContent": "center", "alignItems": "center", "constraintSize": {"minWidth": 0, "minHeight": 0}},
                Stack(
                          {"width": 40, "height": 40, "alignContent": "center", "flexShrink": 0},
                          Progress(
                                      {"value": data.right,
                                        "total": 100,
                                        "type": "ring",
                                        "color": $theme('supportContentColor'),
                                        "backgroundColor": "#1A000000",
                                        "width": 40,
                                        "height": 40,
                                        "strokeWidth": 6}
                                    ),
                          #if props.rightEarIcon
                            Image(
                                          props.rightEarIcon,
                                          {"width": 18, "height": 18, "objectFit": "contain", "_preserveOriginalColor": true}
                                        )
                          #endif
                        ),
                Text(
                          Expr('' + data.right + '%'),
                          {"width": "matchParent", "fontSize": 12, "fontWeight": 500, "fontColor": $theme('primaryColor'), "maxLines": 1, "textAlign": "center", "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
                        )
              )
      #endif
      #if data.left
      #else
        #if data.right
        #else
          #if data.battery
            Column(
                        {"width":"matchParent","layoutWeight": 1, "itemMargin": 1, "justifyContent": "center", "alignItems": "center", "constraintSize": {"minWidth": 0, "minHeight": 0}},
                        Stack(
                                      {"width": 40, "height": 40, "alignContent": "center", "flexShrink": 0},
                                      Progress(
                                                      {"value": data.battery,
                                                        "total": 100,
                                                        "type": "ring",
                                                        "color": $theme('supportContentColor'),
                                                        "backgroundColor": "#1A000000",
                                                        "width": 40,
                                                        "height": 40,
                                                        "strokeWidth": 6}
                                                    ),
                                      #if props.sourceIcon
                                        Image(
                                                          props.sourceIcon,
                                                          {"width": 18, "height": 18, "objectFit": "contain", "_preserveOriginalColor": true}
                                                        )
                                      #endif
                                    ),
                        Text(
                                      Expr('' + data.battery + '%'),
                                      {"width": "matchParent", "fontSize": 12, "fontWeight": 500, "fontColor": $theme('primaryColor'), "maxLines": 1, "textAlign": "center", "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
                                    )
                      )
          #endif
        #endif
      #endif
    )
)
#End

