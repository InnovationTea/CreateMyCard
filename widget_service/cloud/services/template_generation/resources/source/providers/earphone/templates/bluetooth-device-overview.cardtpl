#Template BluetoothDeviceOverviewDisconnected@1(props: { sourceIcon?: asset })
data = {
    connected: $path("/isConnected"),
    name: $path("/earphoneName")
}

Column(
  "compact",
  {"_advancedComponent": "BluetoothDeviceOverview", "_layoutActionBackgroundOpacity": 0.1, "width": "matchParent", "height": "matchParent", "itemMargin": 4, "justifyContent": "spaceBetween", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
  Row(
      "between",
      {"width": "matchParent", "height": 20, "itemMargin": 4, "justifyContent": "spaceBetween", "alignItems": "top", "constraintSize": {"minWidth": 0, "minHeight": 0}},
      Text(
            data.name,
            "subtitle",
            {"width": "matchParent", "fontSize": 12, "fontWeight": 400, "fontColor": "#99000000", "maxLines": 1, "textAlign": "start", "textOverflow": "ellipsis", "layoutWeight": 1, "constraintSize": {"minWidth": 0, "minHeight": 0}}
          ),
      IfPresent(
            props.sourceIcon,
            Image(
                    props.sourceIcon,
                    "icon",
                    {"width": 20, "height": 20, "borderRadius": 4, "objectFit": "contain", "fillColor": "#99000000", "flexShrink": 0}
                  )
          )
    ),
  Text(
      Expr(`${data.connected} ? '已连接' : '未连接'`),
      "compact-title",
      {"width": "matchParent", "fontSize": 14, "fontWeight": 500, "fontColor": "#E6000000", "maxLines": 1, "textAlign": "start", "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    )
)
#End

