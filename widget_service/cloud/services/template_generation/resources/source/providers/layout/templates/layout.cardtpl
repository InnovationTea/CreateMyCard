#Template SingleFocusLayout@1(props: {}, ...children)
data = {
}

Stack({
  "width": "matchParent",
  "height": "matchParent",
  "alignContent": "topStart"
}, children)
#End

#Template HeroActionLayout@1(props: {}, ...children)
data = {
}

Column({
  "width": "matchParent",
  "height": "matchParent",
  "itemMargin": 8,
  "justifyContent": "start",
  "alignItems": "center",
},
  Column({
    "width": "matchParent",
    "layoutWeight": 1
  }, children[0]),
  Column({
    "width": "matchParent",
    "height": 36
  }, children[1])
)
#End

#Template FullIconActionLayout@1(props: {}, ...children)
data = {
}

Stack({
  "width": "matchParent",
  "height": "matchParent",
  "alignContent": "bottomEnd"
},
  children[0],
  children[1]
)
#End


#Template CompactTwoActionLayout@1(props: {}, ...children)
data = {
}

Column({
  "width": "matchParent",
  "height": "matchParent",
  "justifyContent": "spaceBetween",
  "alignItems": "center",
},
  Column({
    "width": "matchParent",
    "layoutWeight": 1
  }, children[0]),
  Column({
    "width": "matchParent",
    "itemMargin": 8,
    "height": 80,
  },
    Column({
      "width": "matchParent",
      "height": 36
    }, children[1]),
    Column({
      "width": "matchParent",
      "height": 36
    }, children[2])
  )
)
#End

#Template TwoSupportLayout@1(props: {}, ...children)
data = {
}

Column({
  "width": "matchParent",
  "height": "matchParent",
  "itemMargin": 8
},
  Row({
    "width": "matchParent",
    "layoutWeight": 1,
    "justifyContent": "start",
    "alignItems": "center",
    "backgroundColor": $theme("supportContentStyle.backgroundColor"),
    "borderRadius": $theme("supportContentStyle.borderRadius"),
  }, children[0]),
  Row({
    "width": "matchParent",
    "layoutWeight": 1,
    "justifyContent": "start",
    "alignItems": "center",
    "backgroundColor": $theme("supportContentStyle.backgroundColor"),
    "borderRadius": $theme("supportContentStyle.borderRadius"),
  }, children[1])
)
#End

#Template HeroTitleContentActionLayout@1(props: {}, ...children)
data = {
}

Column({
