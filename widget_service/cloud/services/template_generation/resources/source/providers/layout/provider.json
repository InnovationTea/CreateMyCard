{
  "bundleFormat": "card-provider-bundle/1",
  "providerId": "com.huawei.layout.cli",
  "providerVersion": "1.0.0-poc",
  "templates": [
    {
      "templateId": "SingleFocusLayout@1",
      "description": "单一焦点纵向骨架，承载一个主要业务区域。",
      "entry": "templates/layout.cardtpl"
    },
    {
      "templateId": "HeroActionLayout@1",
      "description": "主内容与底部动作组合骨架。",
      "entry": "templates/layout.cardtpl"
    },
    {
      "templateId": "HeroSupportLayout@1",
      "description": "主内容与辅助内容双区域骨架。",
      "entry": "templates/layout.cardtpl"
    },
    {
      "templateId": "HeroSupportActionLayout@1",
      "description": "主内容、辅助内容和底部动作组合骨架。",
      "entry": "templates/layout.cardtpl"
    },
    {
      "templateId": "PeerPairLayout@1",
      "description": "两个同级业务区域并列骨架。",
      "entry": "templates/layout.cardtpl"
    },
    {
      "templateId": "SequentialSummaryLayout@1",
      "description": "多个摘要区域顺序排列骨架。",
      "entry": "templates/layout.cardtpl"
    },
    {
      "templateId": "EqualItemsLayout@1",
      "description": "多个同等权重业务区域排列骨架。",
      "entry": "templates/layout.cardtpl"
    },
    {
      "templateId": "ListActionLayout@1",
      "description": "列表内容与动作组合骨架。",
      "entry": "templates/layout.cardtpl"
    },
    {
      "templateId": "ActionMatrixLayout@1",
      "description": "内容与多个动作矩阵组合骨架。",
      "entry": "templates/layout.cardtpl"
    },
    {
      "templateId": "WeatherNowForecastLayout@1",
      "description": "当前天气与预报组合骨架。",
      "entry": "templates/layout.cardtpl"
    }
  ],
  "compatibility": {
    "templateLanguage": "cardtpl/1",
    "catalogId": "ohos.a2ui.extended.catalog.form",
    "a2uiWireVersion": "v0.9"
  },
  "layoutComponents": [
    {
      "name": "SingleFocusLayout",
      "description": "单一主内容布局；Full 可在最后一个 child 承载一个 IconAction，业务区不得侵入动作热区。",
      "supportedCardSizes": [
        "2x2",
        "2x4"
      ],
      "minChildren": 1,
      "maxChildrenBySize": {
        "2x2": 1,
        "2x4": 1
      },
      "actionPolicy": "optional",
      "minActionChildrenBySize": {
        "2x2": 0,
        "2x4": 0
      },
      "maxActionChildrenBySize": {
        "2x2": 1,
        "2x4": 1
      },
      "parametersSchema": {
        "type": "object",
        "properties": {
          "contentAlign": {
            "type": "string",
            "enum": [
              "topStart",
              "centerStart",
              "bottomStart"
            ]
          }
        },
        "additionalProperties": false
      },
      "loweringBySize": {
        "2x2": "column",
        "2x4": "column"
      }
    },
    {
      "name": "HeroActionLayout",
      "description": "主业务区加一个必需的布局 Action；Action 必须是最后一个 child。2x2 主业务区使用剩余高度，PillAction 固定底部，短数值与单位横排。",
      "supportedCardSizes": [
        "2x2",
        "2x4"
      ],
      "minChildren": 1,
      "maxChildrenBySize": {
        "2x2": 1,
        "2x4": 1
      },
      "actionPolicy": "required",
      "minActionChildrenBySize": {
        "2x2": 1,
        "2x4": 1
      },
      "maxActionChildrenBySize": {
        "2x2": 1,
        "2x4": 1
      },
      "parametersSchema": {
        "type": "object",
        "properties": {
          "actionPlacement": {
            "type": "string",
            "enum": [
              "bottom",
              "end"
            ]
          }
        },
        "additionalProperties": false
      },
      "loweringBySize": {
        "2x2": "column",
        "2x4": "column"
      }
    },
    {
      "name": "HeroSupportLayout",
      "description": "主业务区和辅助业务区布局；2x2 固定纵向并省略重复组件标题行，2x4 默认横向。",
      "supportedCardSizes": [
        "2x2",
        "2x4"
      ],
      "minChildren": 2,
      "maxChildrenBySize": {
        "2x2": 2,
        "2x4": 2
      },
      "actionPolicy": "none",
      "minActionChildrenBySize": {
        "2x2": 0,
        "2x4": 0
      },
      "maxActionChildrenBySize": {
        "2x2": 0,
        "2x4": 0
      },
      "parametersSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "loweringBySize": {
        "2x2": "column",
        "2x4": "row"
      }
    },
    {
      "name": "HeroSupportActionLayout",
      "description": "主业务区、辅助业务区和一个必需的布局 Action。2x2 的 Support 仅限1到2行紧凑文本，空间不足时不得压缩或遮挡底部 Action。",
      "supportedCardSizes": [
        "2x2",
        "2x4"
      ],
      "minChildren": 2,
      "maxChildrenBySize": {
        "2x2": 2,
        "2x4": 2
      },
      "actionPolicy": "required",
      "minActionChildrenBySize": {
        "2x2": 1,
        "2x4": 1
      },
      "maxActionChildrenBySize": {
        "2x2": 1,
        "2x4": 1
      },
      "parametersSchema": {
        "type": "object",
        "properties": {
          "heroRatio": {
            "type": "string",
            "enum": [
              "wide",
              "balanced"
            ]
          }
        },
        "additionalProperties": false
      },
      "loweringBySize": {
        "2x2": "column",
        "2x4": "row"
      }
    },
    {
      "name": "PeerPairLayout",
      "description": "两个同权业务区布局。",
      "supportedCardSizes": [
        "2x2",
        "2x4"
      ],
      "minChildren": 2,
      "maxChildrenBySize": {
        "2x2": 2,
        "2x4": 2
      },
