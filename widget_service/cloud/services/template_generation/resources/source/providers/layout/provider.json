{
  "bundleFormat": "card-provider-bundle/1",
  "providerId": "com.huawei.layout.cli",
  "providerVersion": "1.0.0-poc",
  "templates": [
    {
      "templateId": "SingleFocusLayout@1",
      "description": "2x2 单一焦点布局，仅承载一个无 Action 的 Full 业务模板。",
      "entry": "templates/layout.cardtpl"
    },
    {
      "templateId": "HeroActionLayout@1",
      "description": "2x2 主内容与底部动作布局，承载一个 Hero 业务模板和一个 PillAction。",
      "entry": "templates/layout.cardtpl"
    },
    {
      "templateId": "FullIconActionLayout@1",
      "description": "2x2 完整内容与右下角图标动作布局，承载一个 Full 业务模板和一个 IconAction。",
      "entry": "templates/layout.cardtpl"
    },
    {
      "templateId": "CompactTwoActionLayout@1",
      "description": "2x2 紧凑内容与双动作布局，承载一个 Compact 业务模板和两个 PillAction。",
      "entry": "templates/layout.cardtpl"
    },
    {
      "templateId": "HeroTitleContentActionLayout@1",
      "description": "2x2 双业务与底部动作布局；第一个 child 必须是 HeroTitle，第二个 child 必须是 HeroContent，最后一个 child 必须是 PillAction。",
      "entry": "templates/layout.cardtpl"
    },
    {
      "templateId": "TwoSupportLayout@1",
      "description": "仅供兼容 LLM 路径与原子预览使用的 2x2 双业务支撑布局，纵向承载两个可在内部绑定事件的 Support 业务模板；当前 Search 不可达。",
      "entry": "templates/layout.cardtpl"
    },
    {
      "templateId": "WideSingleFocusLayout@1",
      "description": "2x4 单一焦点布局，承载一个 WideFull，或一个 WideHero 与一个 PillAction。",
      "entry": "templates/layout.cardtpl"
    }
  ],
  "compatibility": {
