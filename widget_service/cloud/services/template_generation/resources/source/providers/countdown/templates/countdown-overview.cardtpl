#Template CountdownOverviewFull@1(props: { title?: string })
data = {
    days: $path("/countdownDays")
}

Column(
  { "_advancedComponent": "CountdownOverview", "itemMargin": 4, "width": "matchParent", "height": "matchParent", "justifyContent": "center", "alignItems": "center", "constraintSize": { "minWidth": 0, "minHeight": 0 } },
  #if props.title
    Text(
      props.title,
      { "width": "matchParent", "fontSize": 16, "minFontSize": 12, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textAlign": "center", "textOverflow": "ellipsis", "constraintSize": { "minWidth": 0, "minHeight": 0 } }
    )
  #else
    Text(
      "倒计时",
      { "width": "matchParent", "fontSize": 16, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textAlign": "center", "textOverflow": "ellipsis", "constraintSize": { "minWidth": 0, "minHeight": 0 } }
    )
  #endif
  Row(
    { "width": "matchParent", "margin": { "top": 4 }, "itemMargin": 0, "justifyContent": "center", "alignItems": "bottom", "constraintSize": { "minWidth": 0, "minHeight": 0 } },
    Text(
      data.days,
      { "fontSize": 40, "fontWeight": 800, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": { "minWidth": 0, "minHeight": 0 } }
    ),
    Text(
      "天",
      { "fontSize": 8, "fontWeight": 500, "fontColor": "#00000000", "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": { "minWidth": 0, "minHeight": 0 } }
    )
  ),
  Text(
    "天",
    { "fontSize": 16, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": { "minWidth": 0, "minHeight": 0 } }
  )
)
#End

#Template CountdownOverviewTargetDetailFull@1(props: { title?: string, targetDate?: string })
data = {
    days: $path("/countdownDays")
}

Column(
  {
    "_advancedComponent": "CountdownOverview",
    "width": "matchParent",
    "height": "matchParent",
    "justifyContent": "spaceBetween",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
  Column(
    {
      "width": "matchParent",
      "itemMargin": 6,
      "justifyContent": "start",
      "alignItems": "start",
      "constraintSize": {"minWidth": 0, "minHeight": 0}
    },
    Text(
      "距离目标日还剩",
      {
        "width": "matchParent",
        "height": 16,
        "fontSize": 12,
        "fontWeight": 400,
        "fontColor": $theme('supportContentColor'),
        "maxLines": 1,
        "textOverflow": "ellipsis",
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      }
    ),
    Row(
      {
        "width": "matchParent",
        "height": 40,
        "itemMargin": 2,
        "justifyContent": "start",
        "alignItems": "bottom",
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      },
      Text(
        data.days,
        {
          "height": 40,
          "fontSize": 38,
          "fontWeight": 700,
          "fontColor": $theme('primaryColor'),
          "maxLines": 1,
          "textOverflow": "ellipsis",
          "constraintSize": {"minWidth": 0, "minHeight": 0}
        }
      ),
      Text(
        "天",
        {
          "height": 16,
          "fontSize": 12,
          "fontWeight": 500,
          "fontColor": $theme('supportContentColor'),
          "maxLines": 1,
          "flexShrink": 0
        }
      )
    )
  ),
  #if props.title
    Column(
      {
        "width": "matchParent",
        "itemMargin": 2,
        "justifyContent": "start",
        "alignItems": "start",
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      },
      Text(
        props.title,
        {
          "width": "matchParent",
          "height": 14,
          "fontSize": 10,
          "fontWeight": 400,
          "fontColor": $theme('supportContentColor'),
          "maxLines": 1,
          "textOverflow": "ellipsis",
          "constraintSize": {"minWidth": 0, "minHeight": 0}
        }
      ),
      #if props.targetDate
        Text(
          props.targetDate,
          {
            "width": "matchParent",
            "height": 14,
            "fontSize": 10,
            "fontWeight": 400,
            "fontColor": $theme('supportContentColor'),
            "maxLines": 1,
            "textOverflow": "ellipsis",
            "constraintSize": {"minWidth": 0, "minHeight": 0}
          }
        )
      #endif
    )
  #elseif props.targetDate
    Text(
      props.targetDate,
      {
        "width": "matchParent",
        "height": 14,
        "fontSize": 10,
        "fontWeight": 400,
        "fontColor": $theme('supportContentColor'),
        "maxLines": 1,
        "textOverflow": "ellipsis",
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      }
    )
  #endif
)
#End

#Template CountdownOverviewSupport@1(props: { title?: string, timerIcon?: asset, actionId?: string })
data = {
    days: $path("/countdownDays")
}

Row(
  {
    "_advancedComponent": "CountdownOverview",
    "width": "matchParent",
    "padding": { "left": 8, "right": 8 },
    "justifyContent": "spaceBetween",
    "alignItems": "center",
    "clip": true,
    "constraintSize": { "minWidth": 0, "minHeight": 0 },
    "onClick": EventAction(props?.actionId)
  },
  Column(
    {
      "itemMargin": 4,
      "justifyContent": "start",
      "alignItems": "start",
      "clip": true,
      "constraintSize": { "minWidth": 0, "minHeight": 0 }
    },
    Row(
      { "justifyContent": "start", "alignItems": "center", "constraintSize": { "minWidth": 0, "minHeight": 0 } },
      Text(
        Expr("剩余" + data.days + "天"),
        {
          "fontSize": 14,
          "fontWeight": 700,
          "fontColor": $theme('primaryColor'),
          "maxLines": 1,
          "textOverflow": "ellipsis",
          "constraintSize": { "minWidth": 0, "minHeight": 0 }
        }
      )
    ),
    #if props.title
      Text(
        props.title,
        {
          "fontSize": 10,
          "fontWeight": 400,
          "fontColor": $theme('supportContentColor'),
          "maxLines": 1,
          "textOverflow": "ellipsis",
          "constraintSize": { "minWidth": 0, "minHeight": 0 }
        }
      ),
    #else
      Text(
        "倒计时",
        {
          "fontSize": 10,
          "fontWeight": 400,
          "fontColor": $theme('supportContentColor'),
          "maxLines": 1,
          "textOverflow": "ellipsis",
          "constraintSize": { "minWidth": 0, "minHeight": 0 }
        }
      ),
    #endif
  ),
  #if props.timerIcon
    Image(
      props.timerIcon,
      {
        "width": 24,
        "height": 24,
        "objectFit": "contain",
        "flexShrink": 0,
        "fillColor": $theme('supportContentColor')
      }
    )
  #endif
)
#End

