#Template("WorkoutOverview@1", {
  capability: "GetHealthAndSportSummary",
  description: "运动健康数据提供方交付的最近运动概览",
  domainTags: ["workout", "exercise", "training"],
  compatibleThemeProfileIds: ["race-sunrise-action", "race-night-violet"],
  allowedParentComponents: ["Column", "Row", "List", "Stack"],
  bindings: {
    type: { path: "/exerciseTypeName", type: "string" },
    duration: { path: "/exerciseDurationText", type: "string" },
    calories: { path: "/exerciseCalorieText", type: "string" }
  },
  params: {
    sourceIcon: { type: "string", kind: "asset", semanticTags: ["sport"] },
    caloriesIcon: { type: "string", kind: "asset", semanticTags: ["calories"] }
  },
  limits: { maxNodes: 12, maxDepth: 4 }
})

#Variant("latest", { sizes: ["2x2", "2x4"], roles: ["hero"], requires: ["type", "duration", "calories"] })
Column("compact", {
  _advancedComponent: "WorkoutOverview", width: "matchParent", height: "matchParent",
  itemMargin: 4, justifyContent: "spaceBetween", alignItems: "start",
  constraintSize: { minWidth: 0, minHeight: 0 }
},
  Row("between", { width: "matchParent", itemMargin: 4, justifyContent: "start", alignItems: "top", constraintSize: { minWidth: 0, minHeight: 0 } },
    IfParam("sourceIcon",
      Image(Asset("sourceIcon"), "icon", { width: 20, height: 20, objectFit: "contain", flexShrink: 0 })
    ),
    Text("最近锻炼", "subtitle", { width: "matchParent", fontSize: 12, fontWeight: 500, fontColor: "#E6000000", maxLines: 1, textOverflow: "ellipsis", constraintSize: { minWidth: 0, minHeight: 0 } })
  ),
  Text(Bind("type"), "compact-title", {
    width: "matchParent", fontSize: 20, fontWeight: 700, fontColor: "#E6000000",
    maxLines: 1, textOverflow: "ellipsis", constraintSize: { minWidth: 0, minHeight: 0 }
  }),
  Row("between", { width: "matchParent", itemMargin: 4, justifyContent: "start", alignItems: "bottom", constraintSize: { minWidth: 0, minHeight: 0 } },
    Text(Bind("duration"), "title", { fontSize: 38, fontWeight: 800, fontColor: "#FFFF7A45", maxLines: 1, textOverflow: "ellipsis", constraintSize: { minWidth: 0, minHeight: 0 } })
  ),
  Row("between", { width: "matchParent", itemMargin: 4, justifyContent: "start", alignItems: "top", constraintSize: { minWidth: 0, minHeight: 0 } },
    IfParam("caloriesIcon",
      Image(Asset("caloriesIcon"), "icon", { width: 16, height: 16, objectFit: "contain", flexShrink: 0 })
    ),
    Text(Bind("calories"), "body", { width: "matchParent", fontSize: 12, fontWeight: 500, fontColor: "#E6000000", maxLines: 1, textOverflow: "ellipsis", constraintSize: { minWidth: 0, minHeight: 0 } })
  )
)
#EndVariant
#EndTemplate
