#Template BatteryOverviewChargingTemperatureFull@1(props: { title?: string })

data = {
  charging: $path("/chargingStatusDesc"),
  temperature: $path("/batteryTemperatureText"),
  percentText: $path("/batterySOCText")
}
Column(
  {"_advancedComponent": "BatteryOverview", "width": "matchParent", "height": "matchParent",
   "padding": {"left": 0, "top": 0, "right": 0, "bottom": 0}, "itemMargin": 4,
   "justifyContent": "start", "alignItems": "start", "clip": true,
   "constraintSize": {"minWidth": 0, "minHeight": 0}},
  Text(#Expr(props.title ? props.title : "手机电池"),
    {"width": "matchParent", "height": 16, "fontSize": 12, "minFontSize": 10,
     "fontWeight": 400, "fontColor": $theme('primaryColor'), "textAlign": "start",
     "maxLines": 1, "textOverflow": "ellipsis", "flexShrink": 0,
     "constraintSize": {"minWidth": 0, "minHeight": 0}}),
  Text(data.charging,
    {"width": "matchParent", "height": 24, "fontSize": 18, "minFontSize": 16,
     "fontWeight": 800, "fontColor": $theme('primaryColor'), "textAlign": "start",
     "maxLines": 1, "textOverflow": "ellipsis", "flexShrink": 0,
     "constraintSize": {"minWidth": 0, "minHeight": 0}}),
  Text(data.temperature,
    {"width": "matchParent", "height": 18, "fontSize": 14, "minFontSize": 12,
     "fontWeight": 500, "fontColor": $theme('supportContentColor'), "textAlign": "start",
     "maxLines": 1, "textOverflow": "ellipsis", "flexShrink": 0,
     "constraintSize": {"minWidth": 0, "minHeight": 0}}),
  Column(
    {"width": "matchParent", "layoutWeight": 1, "justifyContent": "end", "alignItems": "start",
     "constraintSize": {"minWidth": 0, "minHeight": 0}},
    Text(`电量: ${data.percentText}`,
      {"width": "matchParent", "height": 16, "fontSize": 12, "minFontSize": 10,
       "fontWeight": 400, "fontColor": $theme('supportContentColor'), "textAlign": "start",
       "maxLines": 1, "textOverflow": "ellipsis", "flexShrink": 0,
       "constraintSize": {"minWidth": 0, "minHeight": 0}})
  )
)
#End
