#Template BatteryOverviewPercentTextFull@1(props: {})
data = {
    percentText: $path("/batterySOCText"),
    charging: $optionalPath("/chargingStatusDesc")
}

Column(
  {"_advancedComponent": "BatteryOverview", "width": "matchParent", "height": "matchParent",
   "padding": {"top": 4}, "itemMargin": 8, "justifyContent": "start", "alignItems": "center",
   "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
  Text(
    "手机电量",
    {"width": 112, "height": 24, "fontSize": 16, "fontWeight": 400,
     "fontColor": $theme('supportContentColor'), "textAlign": "center", "maxLines": 1, "flexShrink": 0}
  ),
  Text(
    data.percentText,
    {"width": 102, "height": 60, "fontSize": 38, "fontWeight": 700,
     "fontColor": $theme('primaryColor'), "textAlign": "center", "maxLines": 1, "flexShrink": 0}
  ),
  Text(
    #Expr(data.charging ? data.charging : "电量状态"),
    {"width": 106, "height": 16, "fontSize": 12, "fontWeight": 400,
     "fontColor": $theme('supportContentColor'), "textAlign": "center", "maxLines": 1, "flexShrink": 0}
  )
)
#End
