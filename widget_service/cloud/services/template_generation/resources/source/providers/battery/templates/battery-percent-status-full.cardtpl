#Template BatteryOverviewPercentStatusFull@1(props: { title?: string })
data = {
  percentText: $path("/batterySOCText"),
  charging: $optionalPath("/chargingStatusDesc"),
  health: $optionalPath("/healthStatusDesc"),
  level: $optionalPath("/batteryCapacityLevelDesc"),
  temperature: $optionalPath("/batteryTemperatureText"),
  updatedAt: $optionalPath("/updatedAt")
}
Column(
  {"_advancedComponent": "BatteryOverview", "width": "matchParent", "height": "matchParent",
   "itemMargin": 4, "justifyContent": "start", "alignItems": "start", "clip": true,
   "constraintSize": {"minWidth": 0, "minHeight": 0}},
  #if data.updatedAt || data.level || data.temperature || data.charging
  Text(#Expr(data.health ? data.health : (props.title ? props.title : "手机电量")),
    {"width": "matchParent", "height": 16, "fontSize": 12, "minFontSize": 10, "fontWeight": 400,
     "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis",
     "flexShrink": 0, "constraintSize": {"minWidth": 0}}),
  Text(data.percentText, {"width": "matchParent", "height": 40, "fontSize": 30,
    "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1,
    "textOverflow": "ellipsis", "flexShrink": 0, "constraintSize": {"minWidth": 0}}),
  Column(
    {"width": "matchParent", "layoutWeight": 1, "itemMargin": 4, "justifyContent": "end",
     "alignItems": "start", "constraintSize": {"minWidth": 0, "minHeight": 0}},
    #if data.updatedAt
    Text(data.updatedAt, {"width": "matchParent", "height": 16, "fontSize": 10,
      "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis",
      "textAlign": "start", "flexShrink": 0, "constraintSize": {"minWidth": 0}}),
    #endif
    #if data.level
    #if data.temperature
    Text(`${data.level} · ${data.temperature}`,
      {"width": "matchParent", "height": 16, "fontSize": 12, "minFontSize": 10,
       "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1,
       "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0}}),
    #else
    Text(data.level,
      {"width": "matchParent", "height": 16, "fontSize": 12, "minFontSize": 10,
       "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1,
       "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0}}),
    #endif
    #elseif data.temperature
    Text(data.temperature, {"width": "matchParent", "height": 16, "fontSize": 12,
      "minFontSize": 10, "fontWeight": 400, "fontColor": $theme('supportContentColor'),
      "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0}}),
    #endif
    #if data.charging
    Text(`状态：${data.charging}`, {"width": "matchParent", "height": 16, "fontSize": 12,
      "fontWeight": 400, "fontColor": $theme('supportContentColor'), "textAlign": "start",
      "maxLines": 1, "textOverflow": "ellipsis", "flexShrink": 0,
      "constraintSize": {"minWidth": 0}})
    #endif
  )
  #else
  Text(#Expr(data.health ? data.health : (props.title ? props.title : "手机电量")),
    {"width": "matchParent", "height": 24, "margin": {"top": 4}, "fontSize": 16,
     "minFontSize": 10, "fontWeight": 400, "textAlign": "center",
     "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis",
     "flexShrink": 0, "constraintSize": {"minWidth": 0}}),
  Column(
    {"width": "matchParent", "layoutWeight": 1, "justifyContent": "center", "alignItems": "center",
     "constraintSize": {"minWidth": 0, "minHeight": 0}},
    Text(data.percentText, {"width": "matchParent", "height": 48, "fontSize": 30,
      "fontWeight": 700, "fontColor": $theme('primaryColor'), "textAlign": "center", "maxLines": 1,
      "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0}})
  ),
  Text("电池状态", {"width": "matchParent", "height": 16, "fontSize": 12, "fontWeight": 400,
    "fontColor": $theme('supportContentColor'), "textAlign": "center", "maxLines": 1,
    "flexShrink": 0, "constraintSize": {"minWidth": 0}})
  #endif
)
#End
