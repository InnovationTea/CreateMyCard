#Template BatteryOverviewTemperatureStatusFull@1(props: { title?: string })
data = {
  temperature: $path("/batteryTemperatureText"),
  percentText: $optionalPath("/batterySOCText"),
  charging: $optionalPath("/chargingStatusDesc"),
  pluggedType: $optionalPath("/pluggedTypeDesc")
}
Column(
  {"_advancedComponent": "BatteryOverview", "width": "matchParent", "height": "matchParent",
   "padding": {"top": 4}, "itemMargin": 4, "justifyContent": "start", "alignItems": "center",
   "clip": true,
   "constraintSize": {"minWidth": 0, "minHeight": 0}},
  Text(#Expr(props.title ? props.title : "手机电池"),
    {"width": "matchParent", "height": 24, "fontSize": 16, "fontWeight": 400,
    "fontColor": $theme('supportContentColor'), "textAlign": "center", "maxLines": 1, "flexShrink": 0,
    "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0}}),
  Column(
    {"width": "matchParent", "layoutWeight": 1, "justifyContent": "center", "alignItems": "center",
     "constraintSize": {"minWidth": 0, "minHeight": 0}},
    Text(data.temperature, {"width": "matchParent", "height": 48, "fontSize": 30,
      "fontWeight": 700, "fontColor": $theme('primaryColor'), "textAlign": "center", "maxLines": 1,
      "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0}})
  ),
  #if data.percentText || data.charging || data.pluggedType
  Row(
    {"width": "matchParent", "height": 16, "itemMargin": 4, "justifyContent": "spaceBetween",
     "alignItems": "center", "flexShrink": 0, "constraintSize": {"minWidth": 0}},
    #if data.charging
    #if data.pluggedType
    Text(`${data.charging} · ${data.pluggedType}`,
      {"layoutWeight": 1, "height": 16, "fontSize": 12, "fontWeight": 400,
       "fontColor": $theme('supportContentColor'), "textAlign": "start", "maxLines": 1,
       "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0}}),
    #else
    Text(data.charging,
      {"layoutWeight": 1, "height": 16, "fontSize": 12, "fontWeight": 400,
       "fontColor": $theme('supportContentColor'), "textAlign": "start", "maxLines": 1,
       "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0}}),
    #endif
    #elseif data.pluggedType
    Text(`充电器 ${data.pluggedType}`,
      {"layoutWeight": 1, "height": 16, "fontSize": 12, "fontWeight": 400,
       "fontColor": $theme('supportContentColor'), "textAlign": "start", "maxLines": 1,
       "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0}}),
    #endif
    #if data.percentText
    Text(`电量: ${data.percentText}`,
      {"layoutWeight": 1, "height": 16, "fontSize": 12, "fontWeight": 400,
       "fontColor": $theme('supportContentColor'),
       "textAlign": #Expr(data.charging ? "end" : (data.pluggedType ? "end" : "center")),
       "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0}})
    #endif
  )
  #endif
)
#End
