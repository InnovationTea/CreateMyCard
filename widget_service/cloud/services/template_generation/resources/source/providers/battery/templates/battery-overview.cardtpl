#Template("BatteryOverview@1", {
  capability: "GetPhoneBatteryInfo",
  description: "手机电量数据提供方交付的电量概览",
  domainTags: ["battery", "power", "charging"],
  compatibleThemeProfileIds: [
    "system-low-power-blue", "device-clean-blue-teal", "audio-product-neutral-violet",
    "family-weather-care-blue", "rainy-commute-gray-blue"
  ],
  allowedParentComponents: ["Column", "Row", "List", "Stack"],
  bindings: {
    percent: { path: "/batterySOC", type: "integer" },
    percentText: { path: "/batterySOCText", type: "string" },
    charging: { path: "/chargingStatusDesc", type: "string" },
    level: { path: "/batteryCapacityLevelDesc", type: "string" }
  },
  params: {
    batteryIcon: { type: "string", kind: "asset", semanticTags: ["battery"] }
  },
  limits: { maxNodes: 20, maxDepth: 6 }
})

#Variant("normal", { sizes: ["2x2"], roles: ["hero", "support"], requires: ["percent", "percentText", "charging", "level"] })
Column("compact", {
  _advancedComponent: "BatteryOverview", width: "matchParent", height: "matchParent",
  itemMargin: 4, justifyContent: "spaceBetween", alignItems: "start", clip: true,
  constraintSize: { minWidth: 0, minHeight: 0 }
},
  Text("设备电量", "subtitle", {
    width: "matchParent", fontSize: 12, fontWeight: 500, fontColor: "#E6000000",
    maxLines: 1, textOverflow: "ellipsis", constraintSize: { minWidth: 0, minHeight: 0 }
  }),
  Text(`电量 ${percentText}，${level}，${charging}`, "body", {
    width: "matchParent", fontSize: 12, fontWeight: 400, fontColor: "#99000000",
    maxLines: 2, textOverflow: "ellipsis", constraintSize: { minWidth: 0, minHeight: 0 }
  }),
  Stack("overlay", {
    width: "matchParent", height: "matchParent", layoutWeight: 1,
    alignContent: "bottomStart", constraintSize: { minWidth: 0, minHeight: 0 }
  },
    Stack("overlay", { width: 52, height: 52, alignContent: "center", flexShrink: 0 },
      Progress({
        value: Bind("percent"), total: 100, type: "ring", color: "#FFF9A01E",
        backgroundColor: "#1A000000", width: 52, height: 52, strokeWidth: 6
      }),
      IfParam("batteryIcon",
        Image(Asset("batteryIcon"), "icon", { width: 24, height: 24, objectFit: "contain", fillColor: "#99000000" })
      )
    )
  )
)
#EndVariant
#Variant("charging", { extends: "normal" })
#EndVariant
#Variant("low", { extends: "normal" })
#EndVariant

#Variant("normalWide", { sizes: ["2x4"], roles: ["hero"], requires: ["percent", "percentText", "charging", "level"] })
Column("compact", {
  _advancedComponent: "BatteryOverview", width: "matchParent", height: "matchParent",
  itemMargin: 4, justifyContent: "start", alignItems: "start", clip: true,
  constraintSize: { minWidth: 0, minHeight: 0 }
},
  Text("设备电量", "subtitle", {
    width: "matchParent", fontSize: 12, fontWeight: 500, fontColor: "#E6000000",
    maxLines: 1, textOverflow: "ellipsis", constraintSize: { minWidth: 0, minHeight: 0 }
  }),
  Row("between", {
    width: "matchParent", layoutWeight: 1, itemMargin: 8, justifyContent: "start",
    alignItems: "center", clip: true, constraintSize: { minWidth: 0, minHeight: 0 }
  },
    Stack("overlay", { width: 52, height: 52, alignContent: "center", flexShrink: 0 },
      Progress({
        value: Bind("percent"), total: 100, type: "ring", color: "#FFF9A01E",
        backgroundColor: "#1A000000", width: 52, height: 52, strokeWidth: 6
      }),
      IfParam("batteryIcon",
        Image(Asset("batteryIcon"), "icon", { width: 24, height: 24, objectFit: "contain", fillColor: "#99000000" })
      )
    ),
    Column("compact", {
      layoutWeight: 1, itemMargin: 4, justifyContent: "center", alignItems: "start",
      constraintSize: { minWidth: 0, minHeight: 0 }
    },
      Text(Bind("percentText"), "compact-title", {
        width: "matchParent", fontSize: 14, fontWeight: 700, fontColor: "#E6000000",
        maxLines: 1, textOverflow: "ellipsis", constraintSize: { minWidth: 0, minHeight: 0 }
      }),
      Text(Bind("level"), "body", {
        width: "matchParent", fontSize: 14, fontWeight: 400, fontColor: "#E6000000",
        maxLines: 1, textOverflow: "ellipsis", constraintSize: { minWidth: 0, minHeight: 0 }
      }),
      Text(Bind("charging"), "subtitle", {
        width: "matchParent", fontSize: 10, fontWeight: 400, fontColor: "#99000000",
        maxLines: 1, textOverflow: "ellipsis", constraintSize: { minWidth: 0, minHeight: 0 }
      })
    )
  )
)
#EndVariant
#Variant("chargingWide", { extends: "normalWide" })
#EndVariant
#Variant("lowWide", { extends: "normalWide" })
#EndVariant

#Variant("normalPeer", { sizes: ["2x2", "2x4"], roles: ["peer"], requires: ["percent", "percentText", "charging", "level"] })
Column("compact", {
  _advancedComponent: "BatteryOverview", width: "matchParent", height: "matchParent",
  itemMargin: 2, justifyContent: "end", alignItems: "center", clip: true,
  constraintSize: { minWidth: 0, minHeight: 0 }
},
  Stack("overlay", { width: 52, height: 52, alignContent: "center", flexShrink: 0 },
    Progress({
      value: Bind("percent"), total: 100, type: "ring", color: "#FFF9A01E",
      backgroundColor: "#1A000000", width: 52, height: 52, strokeWidth: 6
    }),
    IfParam("batteryIcon",
      Image(Asset("batteryIcon"), "icon", { width: 20, height: 20, objectFit: "contain", fillColor: "#99000000" })
    )
  ),
  Text(Bind("percentText"), "compact-title", {
    width: "matchParent", fontSize: 14, fontWeight: 700, fontColor: "#E6000000",
    maxLines: 1, textAlign: "center", textOverflow: "ellipsis",
    constraintSize: { minWidth: 0, minHeight: 0 }
  }),
  Text(Bind("level"), "subtitle", {
    width: "matchParent", fontSize: 10, fontWeight: 400, fontColor: "#99000000",
    maxLines: 1, textAlign: "center", textOverflow: "ellipsis",
    constraintSize: { minWidth: 0, minHeight: 0 }
  }),
  Text(Bind("charging"), "subtitle", {
    width: "matchParent", fontSize: 10, fontWeight: 400, fontColor: "#99000000",
    maxLines: 1, textAlign: "center", textOverflow: "ellipsis",
    constraintSize: { minWidth: 0, minHeight: 0 }
  })
)
#EndVariant
#Variant("chargingPeer", { extends: "normalPeer" })
#EndVariant
#Variant("lowPeer", { extends: "normalPeer" })
#EndVariant

#Variant("normalPhone", { sizes: ["2x2", "2x4"], roles: ["hero"], requires: ["percent", "percentText"] })
Column("compact", {
  _advancedComponent: "BatteryOverview", width: "matchParent", height: "matchParent",
  itemMargin: 2, justifyContent: "center", alignItems: "center", clip: true,
  constraintSize: { minWidth: 0, minHeight: 0 }
},
  Stack("overlay", { width: 56, height: 56, alignContent: "center", flexShrink: 0 },
    Progress({
      value: Bind("percent"), total: 100, type: "ring", color: "#FFF9A01E",
      backgroundColor: "#1A000000", width: 56, height: 56, strokeWidth: 6
    }),
    IfParam("batteryIcon",
      Image(Asset("batteryIcon"), "icon", { width: 24, height: 24, objectFit: "contain", fillColor: "#99000000" })
    )
  ),
  Text(Bind("percentText"), "compact-title", {
    width: "matchParent", fontSize: 16, fontWeight: 700, fontColor: "#E6000000",
    maxLines: 1, textOverflow: "ellipsis", constraintSize: { minWidth: 0, minHeight: 0 }
  }),
  Text("手机", "subtitle", {
    width: "matchParent", fontSize: 10, fontWeight: 400, fontColor: "#99000000",
    maxLines: 1, textOverflow: "ellipsis", constraintSize: { minWidth: 0, minHeight: 0 }
  })
)
#EndVariant
#Variant("chargingPhone", { extends: "normalPhone" })
#EndVariant
#Variant("lowPhone", { extends: "normalPhone" })
#EndVariant

#Variant("normalWeather", { sizes: ["2x2"], roles: ["support"], requires: ["percentText", "charging", "level"] })
Column("compact", {
  _advancedComponent: "BatteryOverview", width: "matchParent", height: "matchParent",
  itemMargin: 2, justifyContent: "center", alignItems: "start", clip: true,
  constraintSize: { minWidth: 0, minHeight: 0 }
},
  Row("between", {
    width: "matchParent", itemMargin: 4, justifyContent: "start", alignItems: "center",
    clip: true, constraintSize: { minWidth: 0, minHeight: 0 }
  },
    IfParam("batteryIcon",
      Image(Asset("batteryIcon"), "icon", { width: 14, height: 14, objectFit: "contain", flexShrink: 0 })
    ),
    Text(Bind("percentText"), "compact-title", {
      fontSize: 14, fontWeight: 700, fontColor: "#E6000000", maxLines: 1,
      textOverflow: "ellipsis", constraintSize: { minWidth: 0, minHeight: 0 }
    }),
    Text(Bind("level"), "subtitle", {
      fontSize: 10, fontWeight: 400, fontColor: "#99000000", maxLines: 1,
      textOverflow: "ellipsis", constraintSize: { minWidth: 0, minHeight: 0 }
    })
  ),
  Text(Bind("charging"), "subtitle", {
    fontSize: 10, fontWeight: 400, fontColor: "#99000000", maxLines: 1,
    textOverflow: "ellipsis", constraintSize: { minWidth: 0, minHeight: 0 }
  })
)
#EndVariant
#Variant("chargingWeather", { extends: "normalWeather" })
#EndVariant
#Variant("lowWeather", { extends: "normalWeather" })
#EndVariant
#EndTemplate
