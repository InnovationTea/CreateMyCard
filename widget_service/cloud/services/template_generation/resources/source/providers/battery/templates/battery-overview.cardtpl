      )
    )
  ),
  Text(
    data.chargingStatus,
    {
      "width": "matchParent",
      "height": 28,
      "fontSize": 14,
      "minFontSize": 12,
      "fontWeight": 500,
      "fontColor": $theme('primaryColor'),
      "maxLines": 1,
      "textAlign": "center",
      "textOverflow": "ellipsis",
      "constraintSize": {"minWidth": 0, "minHeight": 0}
    }
  )
)
#End

#Template BatteryOverviewTemperatureFull@1(props: { temperatureIcon: asset })
data = {
    temperature: $path("/batteryTemperatureText"),
    pluggedType: $path("/pluggedTypeDesc"),
    updatedAt: $path("/updatedAt")
}

Column(
  {
    "_advancedComponent": "BatteryOverview",
    "width": "matchParent",
    "height": "matchParent",
    "itemMargin": 4,
    "justifyContent": "spaceBetween",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
  Column(
    {
      "width": "matchParent",
      "itemMargin": 8,
      "justifyContent": "start",
      "alignItems": "start",
      "clip": true,
      "constraintSize": {"minWidth": 0, "minHeight": 0}
    },
    Row(
      {
        "width": "matchParent",
        "height": 20,
        "itemMargin": 4,
        "justifyContent": "spaceBetween",
        "alignItems": "top",
        "clip": true,
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      },
      Text(
        "电池温度",
        {
          "fontSize": 12,
          "fontWeight": 500,
          "fontColor": $theme('supportContentColor'),
          "maxLines": 1,
          "textOverflow": "ellipsis",
          "constraintSize": {"minWidth": 0, "minHeight": 0}
        }
      ),
      Image(
        props.temperatureIcon,
        {"width": 20, "height": 20, "objectFit": "contain", "flexShrink": 0}
      )
    ),
    Column(
      {
        "width": "matchParent",
        "itemMargin": 4,
        "justifyContent": "start",
        "alignItems": "start",
        "clip": true,
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      },
      Text(
        data.temperature,
        {
          "width": "matchParent",
          "fontSize": 20,
          "fontWeight": 700,
          "fontColor": $theme('primaryColor'),
          "maxLines": 1,
          "textOverflow": "ellipsis",
          "constraintSize": {"minWidth": 0, "minHeight": 0}
        }
      ),
      Text(
        data.pluggedType,
        {
          "width": "matchParent",
          "fontSize": 12,
          "fontWeight": 400,
          "fontColor": $theme('supportContentColor'),
          "maxLines": 1,
          "textOverflow": "ellipsis",
          "constraintSize": {"minWidth": 0, "minHeight": 0}
        }
      )
    )
  ),
  Column(
    {
      "width": "matchParent",
      "itemMargin": 0,
      "justifyContent": "start",
      "alignItems": "start",
      "clip": true,
      "constraintSize": {"minWidth": 0, "minHeight": 0}
    },
    Text(
      "更新时间：",
      {
        "width": "matchParent",
        "fontSize": 10,
        "fontWeight": 400,
        "fontColor": $theme('supportContentColor'),
        "maxLines": 1,
        "textOverflow": "ellipsis",
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      }
    ),
    Text(
      data.updatedAt,
      {
        "width": "matchParent",
        "fontSize": 10,
        "fontWeight": 400,
        "fontColor": $theme('supportContentColor'),
        "maxLines": 1,
        "textOverflow": "ellipsis",
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      }
    )
  )
)
#End
