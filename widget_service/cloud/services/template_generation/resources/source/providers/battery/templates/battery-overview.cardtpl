#Template BatteryOverviewCompact@1(props: { batteryIcon: asset })
data = {
    percent: $path("/batterySOC"),
    charging: $path("/chargingStatusDesc")
}

Column(
  {
    "_advancedComponent": "BatteryOverview",
    "width": "matchParent",
    "height": "matchParent",
    "itemMargin": 0,
    "justifyContent": "start",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
  Row(
    {
      "width": "matchParent",
      "height": 44,
      "itemMargin": 8,
      "justifyContent": "start",
      "alignItems": "center",
      "constraintSize": {"minWidth": 0, "minHeight": 0}
    },
    Stack(
      {"width": 44, "height": 44, "alignContent": "center", "flexShrink": 0},
      Progress(
        {
          "value": data.percent,
          "total": 100,
          "type": "ring",
          "color": $theme('progressColor'),
          "backgroundColor": $theme('progressBackgroundColor'),
          "width": 44,
          "height": 44,
          "strokeWidth": 6
        }
      ),
      Image(
        props.batteryIcon,
        {
          "width": 16,
          "height": 16,
          "objectFit": "contain",
          "fillColor": $theme('supportContentColor')
        }
      )
    ),
    Column(
      {
        "width": 84,
        "height": 44,
        "itemMargin": 4,
        "justifyContent": "start",
        "alignItems": "start",
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      },
      Row(
        {
          "width": 84,
          "height": 24,
          "itemMargin": 0,
          "justifyContent": "start",
          "alignItems": "center",
          "constraintSize": {"minWidth": 0, "minHeight": 0}
        },
        Text(
          data.percent,
          {
            "fontSize": 18,
            "minFontSize": 18,
            "fontWeight": 700,
            "fontColor": $theme('primaryColor'),
            "maxLines": 1,
            "textOverflow": "ellipsis",
            "constraintSize": {"minWidth": 0, "minHeight": 0}
          }
        ),
        Text(
          "%",
          {
            "fontSize": 18,
            "minFontSize": 18,
            "fontWeight": 700,
            "fontColor": $theme('primaryColor'),
            "maxLines": 1,
            "textOverflow": "ellipsis",
            "constraintSize": {"minWidth": 0, "minHeight": 0}
          }
        )
      ),
      Text(
        data.charging,
        {
          "width": 84,
          "height": 16,
          "fontSize": 12,
          "minFontSize": 10,
          "fontWeight": 400,
          "fontColor": $theme('supportContentColor'),
          "maxLines": 1,
          "textOverflow": "ellipsis",
          "constraintSize": {"minWidth": 0, "minHeight": 0}
        }
      )
    )
  )
)
#End

