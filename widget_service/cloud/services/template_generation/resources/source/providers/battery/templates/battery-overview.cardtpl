#Template BatteryOverviewChargingProgressHero@1(props: {})
data = {
    percentText: $path("/batterySOCText"),
    charging: $optionalPath("/chargingStatusDesc"),
    health: $optionalPath("/healthStatusDesc"),
}

Column(
  {
    "_advancedComponent": "BatteryOverview",
    "_layoutActionBackgroundOpacity": 0.2,
    "width": "matchParent",
    "height": "matchParent",
    "padding": {"left": 0, "top": 0, "right": 0, "bottom": 0},
    "itemMargin": 4,
    "justifyContent": "start",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
  Text(
      "手机电量",
      {"width": "matchParent", "height": 16, "fontSize": 12, "minFontSize": 10, "fontWeight": 400, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    ),
  Row(
      {
        "width": "matchParent",
        "height": 44,
        "itemMargin": 2,
        "margin": { "top": 6 },
        "justifyContent": "start",
        "alignItems": "bottom",
        "clip": true,
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      },
      Text(
          data.percentText,
          { "fontSize": 38, "minFontSize": 16, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
        )
    ),
  #if data.charging && data.health
  Text(
      `${data.charging} · ${data.health}`,
      {"width": "matchParent", "height": 14, "fontSize": 12, "minFontSize": 10, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    )
  #elseif data.charging
    Text(
      `${data.charging}`,
      {"width": "matchParent", "height": 14, "fontSize": 12, "minFontSize": 10, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    )
  #elseif data.health
    Text(
      `${data.health}`,
      {"width": "matchParent", "height": 14, "fontSize": 12, "minFontSize": 10, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    )
  #endif
)
#End

#Template BatteryOverviewChargingProgressFull@1(props: { batteryIcon: asset })
data = {
    percent: $path("/batterySOC"),
    charging: $path("/chargingStatusDesc"),
    health: $path("/healthStatusDesc"),
    plugged: $path("/pluggedTypeDesc")
}

Column(
  {
    "_advancedComponent": "BatteryOverview",
    "width": "matchParent",
    "height": "matchParent",
    "itemMargin": 0,
    "justifyContent": "start",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
  Text(
    "手机电量",
    {"width": "matchParent", "height": 16, "fontSize": 12, "minFontSize": 10, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
  ),
  Divider(
    {"width": 0, "height": 14, "strokeWidth": 0, "color": "#00FFFFFF", "flexShrink": 0}
  ),
  Row(
    {
      "width": "matchParent",
      "height": 44,
      "itemMargin": 8,
      "justifyContent": "start",
      "alignItems": "center",
      "constraintSize": {"minWidth": 0, "minHeight": 0}
    },
    Stack(
      {"width": 44, "height": 44, "alignContent": "center", "flexShrink": 0},
      Progress(
        {"value": data.percent, "total": 100, "type": "ring", "color": $theme('progressColor'), "backgroundColor": $theme('progressBackgroundColor'), "width": 44, "height": 44, "strokeWidth": 6}
      ),
      Image(
        props.batteryIcon,
        {"width": 16, "height": 16, "objectFit": "contain", "fillColor": $theme('supportContentColor')}
      )
    ),
    Column(
      {"width": 84, "height": 44, "itemMargin": 4, "justifyContent": "start", "alignItems": "start", "constraintSize": {"minWidth": 0, "minHeight": 0}},
      Row(
        {"width": 84, "height": 24, "itemMargin": 0, "justifyContent": "start", "alignItems": "center", "constraintSize": {"minWidth": 0, "minHeight": 0}},
        Text(data.percent, {"fontSize": 18, "minFontSize": 18, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}),
        Text("%", {"fontSize": 18, "minFontSize": 18, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}})
      ),
      Text(data.charging, {"width": 84, "height": 16, "fontSize": 12, "minFontSize": 10, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}})
    )
  ),
  Divider(
    {"width": 0, "height": 22, "strokeWidth": 0, "color": "#00FFFFFF", "flexShrink": 0}
  ),
  Row(
    {"width": "matchParent", "height": 20, "itemMargin": 4, "justifyContent": "start", "alignItems": "center", "constraintSize": {"minWidth": 0, "minHeight": 0}},
    Text(
      "电池健康",
      {"width": 48, "fontSize": 12, "minFontSize": 10, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    ),
    Text(
      data.health,
      {"width": 84, "fontSize": 12, "minFontSize": 10, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    )
  ),
  Row(
    {"width": "matchParent", "height": 20, "itemMargin": 4, "justifyContent": "start", "alignItems": "center", "constraintSize": {"minWidth": 0, "minHeight": 0}},
    Text(
      "充电类型",
      {"width": 48, "fontSize": 12, "minFontSize": 10, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    ),
    Text(
      data.plugged,
      {"width": 84, "fontSize": 12, "minFontSize": 10, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    )
  )
)
#End

