#Template BatteryOverviewFull@1(props: { batteryIcon?: asset })
data = {
    percent: $path("/batterySOC"),
    percentText: $path("/batterySOCText"),
    charging: $path("/chargingStatusDesc"),
    level: $path("/batteryCapacityLevelDesc")
}

Column(
  {"_advancedComponent": "BatteryOverview", "width": "matchParent", "height": "matchParent", "itemMargin": 4, "justifyContent": "spaceBetween", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
  Text(
      "设备电量",
      {"width": "matchParent", "fontSize": 16, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    ),
  Text(
      `电量 ${data.percentText}，${data.level}，${data.charging}`,
      {"width": "matchParent", "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 3, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    ),
  Stack(
      {"width": "matchParent", "layoutWeight": 1, "alignContent": "bottomStart", "constraintSize": {"minWidth": 0, "minHeight": 0}},
      Stack(
            {"width": 52, "height": 52, "alignContent": "center", "flexShrink": 0},
            Progress(
                    {"value": data.percent,
                      "total": 100,
                      "type": "ring",
                      "color": $theme('progressColor'),
                      "backgroundColor": $theme('progressBackgroundColor'),
                      "width": 52,
                      "height": 52,
                      "strokeWidth": 6}
                  ),
            IfPresent(
                    props.batteryIcon,
                    Image(
                              props.batteryIcon,
                              {"width": 24,
                                "height": 24,
                                "objectFit": "contain",
                                "fillColor": $theme('supportContentColor')}
                            )
                  )
          )
    )
)
#End

#Template BatteryOverviewHero@1(props: { batteryIcon?: asset })
data = {
    percent: $path("/batterySOC"),
    level: $path("/batteryCapacityLevelDesc")
}

Column(
  {
    "_advancedComponent": "BatteryOverview",
    "width": "matchParent",
    "height": "matchParent",
    "itemMargin": 4,
    "justifyContent": "start",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
  Column(
    {"width":"matchParent","itemMargin":4,
        "height": "matchParent",
        "layoutWeight": 1,
        "justifyContent": "center",
        "alignItems": "center",
        "constraintSize": {"minWidth": 0, "minHeight": 0}
    },
      Stack(
            {"width": 52, "height": 52, "alignContent": "center", "flexShrink": 0},
            Progress(
                    {
                      "value": data.percent,
                      "total": 100,
                      "type": "ring",
                      "color": $theme('progressColor'),
                      "backgroundColor": $theme('progressBackgroundColor'),
                      "width": 52,
                      "height": 52,
                      "strokeWidth": 6
                    }
                  ),
            IfPresent(
                    props.batteryIcon,
                    Image(
                              props.batteryIcon,
                              {"width": 24,
                                "height": 24,
                                "objectFit": "contain",
                                "fillColor": $theme('supportContentColor')}
                            )
                  )
          ),
      Column(
            {"itemMargin":4,
                "width": "matchParent",
                "margin": {"left": 0, "top": 4, "right": 0, "bottom": 0},
                "justifyContent": "center",
                "alignItems": "center",
                "constraintSize": {"minWidth": 0, "minHeight": 0}
            },
            Text(
                data.level,
                {
                    "fontSize": 14,
                    "fontWeight": 400,
                    "fontColor": $theme('primaryColor'),
                    "maxLines": 1,
                    "textOverflow": "ellipsis",
                    "textAlign": "center",
                    "constraintSize": {"minWidth": 0, "minHeight": 0}
                }
            )
        )
    )
)
#End

#Template BatteryOverviewWideFull@1(props: { batteryIcon?: asset })
data = {
    percent: $path("/batterySOC"),
    percentText: $path("/batterySOCText"),
    charging: $path("/chargingStatusDesc"),
    level: $path("/batteryCapacityLevelDesc")
}

Column(
  {"_advancedComponent": "BatteryOverview", "width": "matchParent", "height": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
  Text(
      "设备电量",
      {"width": "matchParent", "fontSize": 16, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    ),
  Row(
      {"width": "matchParent", "layoutWeight": 1, "itemMargin": 8, "justifyContent": "start", "alignItems": "center", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
      Stack(
            {"width": 52, "height": 52, "alignContent": "center", "flexShrink": 0},
            Progress(
                    {"value": data.percent,
                      "total": 100,
                      "type": "ring",
                      "color": $theme('progressColor'),
                      "backgroundColor": $theme('progressBackgroundColor'),
                      "width": 52,
                      "height": 52,
                      "strokeWidth": 6}
                  ),
            IfPresent(
                    props.batteryIcon,
                    Image(
                              props.batteryIcon,
                              {"width": 24,
                                "height": 24,
                                "objectFit": "contain",
                                "fillColor": $theme('supportContentColor')}
                            )
                  )
          ),
      Column(
            {"width":"matchParent","layoutWeight": 1, "itemMargin": 4, "justifyContent": "center", "alignItems": "start", "constraintSize": {"minWidth": 0, "minHeight": 0}},
            Text(
                    data.percentText,
                    {"width": "matchParent", "fontSize": 14, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
                  ),
            Text(
                    data.level,
                    {"width": "matchParent", "fontSize": 14, "fontWeight": 400, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
                  ),
            Text(
                    data.charging,
                    {"width": "matchParent", "fontSize": 10, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
                  )
          )
    )
)
#End

#Template BatteryOverviewCompact@1(props: { })
data = {
    percentText: $path("/batterySOCText"),
    level: $optionalPath("/batteryCapacityLevelDesc"),
    charging: $optionalPath("/chargingStatusDesc"),
}

Column(
  { "_advancedComponent": "BatteryOverview", "width": "matchParent", "height": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "start", "clip": true, "constraintSize": { "minWidth": 0, "minHeight": 0 } },
  Text(
    data.percentText,
    { "width": "matchParent", "fontSize": 16, "fontWeight": 700, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": { "minWidth": 0, "minHeight": 0 } }
  ),
  Row(
    {
      "itemMargin": 4,
      "justifyContent": "start", "alignItems": "start",
    },
    IfPresent(
      data.level,
      Text(
        data.level,
        { "width": "matchParent", "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 3, "textOverflow": "ellipsis", "constraintSize": { "minWidth": 0, "minHeight": 0 } }
      )
    ),
    IfAbsent(
      data.level,
      IfPresent(
        data.charging,
        Text(
          data.charging,
          { "width": "matchParent", "fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 3, "textOverflow": "ellipsis", "constraintSize": { "minWidth": 0, "minHeight": 0 } }
        )
      )
    )
  )
)
#End

#Template BatteryOverviewHealthLevelHero@1(props: {})
data = {
    health: $path("/healthStatusDesc"),
    level: $path("/batteryCapacityLevelDesc")
}

Column(
  {
    "_advancedComponent": "BatteryOverview",
    "_layoutActionBackgroundOpacity": 0.2,
    "width": "matchParent",
    "height": "matchParent",
    "padding": {"left": 0, "top": 0, "right": 0, "bottom": 0},
    "itemMargin": 4,
    "justifyContent": "start",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
  Text(
      "电池体检",
      {"width": "matchParent", "height": 16, "fontSize": 12, "minFontSize": 10, "fontWeight": 400, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    ),
  Text(
      data.health,
      {"width": "matchParent", "height": 26, "fontSize": 20, "minFontSize": 16, "fontWeight": 800, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    ),
  Text(
      data.level,
      {"width": "matchParent", "height": 18, "fontSize": 14, "minFontSize": 12, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    )
)
#End

#Template BatteryOverviewChargingProgressHero@1(props: {})
data = {
    percent: $path("/batterySOC"),
    charging: $path("/chargingStatusDesc"),
    health: $path("/healthStatusDesc"),
    plugged: $path("/pluggedTypeDesc")
}

Column(
  {
    "_advancedComponent": "BatteryOverview",
    "_layoutActionBackgroundOpacity": 0.2,
    "width": "matchParent",
    "height": "matchParent",
    "padding": {"left": 0, "top": 0, "right": 0, "bottom": 0},
    "itemMargin": 4,
    "justifyContent": "start",
    "alignItems": "start",
    "clip": true,
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
  Text(
      "手机电量",
      {"width": "matchParent", "height": 16, "fontSize": 12, "minFontSize": 10, "fontWeight": 400, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    ),
  Row(
      {
        "width": "matchParent",
        "height": 24,
        "itemMargin": 2,
        "justifyContent": "start",
        "alignItems": "bottom",
        "clip": true,
        "constraintSize": {"minWidth": 0, "minHeight": 0}
      },
      Text(
          data.percent,
          {"width": 34, "fontSize": 20, "minFontSize": 16, "fontWeight": 800, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
        ),
      Text(
          "%",
          {"width": 16, "fontSize": 12, "fontWeight": 600, "fontColor": $theme('primaryColor'), "maxLines": 1, "textAlign": "left", "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
        )
    ),
  Progress(
      {"value": data.percent, "total": 100, "strokeWidth": 8, "color": $theme('progressColor'), "backgroundColor": $theme('actionStyle.backgroundColor'), "height": 8, "width": "matchParent"}
    ),
  Text(
      `${data.charging} · ${data.health}`,
      {"width": "matchParent", "height": 14, "fontSize": 12, "minFontSize": 10, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    ),
  Text(
      data.plugged,
      {"width": "matchParent", "height": 14, "fontSize": 12, "minFontSize": 10, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    )
)
#End

#Template BatteryOverviewPercentRingHero@1(props: { batteryIcon: asset })
data = {
    percent: $path("/batterySOC"),
    percentText: $path("/batterySOCText")
}

Column(
  {
    "_advancedComponent": "BatteryOverview",
    "_layoutActionBackgroundOpacity": 0.2,
    "width": "matchParent",
    "height": "matchParent",
    "padding": {"left": 0, "top": 8, "right": 0, "bottom": 0},
    "itemMargin": 4,
    "justifyContent": "start",
    "alignItems": "center",
    "clip": true,
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
  Stack(
      {"width": 52, "height": 52, "alignContent": "center", "flexShrink": 0},
      Progress(
            {"value": data.percent,
              "total": 100,
              "type": "ring",
              "color": $theme('progressColor'),
              "backgroundColor": $theme('progressBackgroundColor'),
              "width": 52,
              "height": 52,
              "strokeWidth": 6}
          ),
      Image(
            props.batteryIcon,
            {"width": 20,
              "height": 20,
              "objectFit": "contain",
              "fillColor": $theme('supportContentColor')}
          )
    ),
  Text(
      `手机电量剩余${data.percentText}`,
      {"width": "matchParent", "height": 28, "fontSize": 14, "minFontSize": 12, "fontWeight": 500, "fontColor": $theme('primaryColor'), "maxLines": 1, "textAlign": "center", "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
    )
)
#End
