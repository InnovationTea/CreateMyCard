["root","Layout",{"layout":"W-split-panels"},["left","right"]]
["left_title","SingleLineTitle",{"title":"日程","fontSize":12}]
["left_body","EventCard",{"items":[{"title":{"path":"/data/calendar/events/0/title"},"time":"{{ ${/data/calendar/events/0/startDate} + ' ' + ${/data/calendar/events/0/dtStart} }}"}]}]
["left_action","PillButton",{"label":"查看日程","icon":"resources/base/media/ic_calender.svg","onClick":[{"call":"clickToIntent","args":{"intentName":"ViewCalendarEvent","params":{"entityId":"{{ ${/data/calendar/events/i/entityId} }}"}}}]}]
["left","Region",{"variant":"title-content-action"},["left_title","left_body","left_action"]]
["right_title","SingleLineTitle",{"title":"天气","fontSize":12}]
["right_body","EmphasisText",{"mainText":{"path":"/data/weather/current/temperatureText"},"secondaryText":{"path":"/data/weather/current/condition"},"fontSize":18}]
["right_action","PillButton",{"label":"查看天气","icon":"resources/base/media/ic_weather_color.svg","onClick":[{"call":"clickToDeeplink","args":{"intentName":"Weather_CityCode","bundleName":"","abilityName":"","uri":"{{ 'hww://www.huawei.com/totemweather?enterType=share&cityCode=' + ${/data/weather/location/cityCode} }}"}}]}]
["right","Region",{"variant":"title-content-action"},["right_title","right_body","right_action"]]
["/data/calendar/events/0/title","项目例会"]
["/data/calendar/events/0/startDate","08-06"]
["/data/calendar/events/0/dtStart","14:00"]
["/data/calendar/events/0/entityId","example-event-001"]
["/data/weather/current/temperatureText","21℃"]
["/data/weather/current/condition","多云"]
["/data/weather/location/cityCode","60814"]
