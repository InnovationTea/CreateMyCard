["earphoneValue","Text",{"content":"耳机","width":70,"fontSize":14,"fontWeight":700,"fontColor":"#FF1F4799","maxLines":1}]
["earphoneStatus","Text",{"content":"未连接","width":70,"fontSize":12,"fontWeight":400,"fontColor":"#FF1F4799","maxLines":1}]
