{
  "name": "getDataCapabilitySchemas",
  "transport": "websocket",
  "path": "/genui-agent-service/api/v1/ws/tools/getDataCapabilitySchemas",
  "description": "按数据能力 ID 加载完整 inputSchema、outputSchema、依赖和 DataModel 骨架。content 对应业务入参。",
  "messageEnvelope": {
    "type": "object",
    "required": ["content", "deviceInfo", "session"],
    "properties": {
      "content": {
        "type": "object",
        "required": true,
        "description": "业务入参，对应旧协议 arguments。",
        "requiredProperties": ["dataCapabilityIds"],
        "properties": {
          "bundleName": {
            "type": "string",
            "required": false,
            "description": "宿主业务包名。"
          },
          "dataCapabilityIds": {
            "type": "string[]",
            "required": true,
            "minItems": 1,
            "description": "需要加载完整 schema 的数据能力 ID 列表。"
          },
          "capabilityRegistryVersion": {
            "type": "string|null",
            "required": false,
            "description": "可选能力清单版本；不传时由 deviceInfo.prdVer + ROM 版本推导。"
          },
          "protocolProfileId": {
            "type": "string|null",
            "required": false,
            "description": "可选 A2UI 协议 profile ID。"
          }
        }
      },
      "deviceInfo": {
        "$ref": "#/nestedTypes/DeviceInfo",
        "required": true,
        "description": "端侧设备信息；缺少 ROM 字段时服务使用 settings.default_device_rom_version。版本目录由 prdVer + ROM 版本组成。"
      },
      "session": {
        "$ref": "#/nestedTypes/Session",
        "required": true,
        "description": "会话信息；服务端 requestId = sessionId + '&' + interactionId。"
      },
      "pagination": {
        "$ref": "#/nestedTypes/Pagination",
        "required": false,
        "description": "分页信息，当前接口暂不消费。"
      },
      "userAuth": {
        "$ref": "#/nestedTypes/UserAuth",
        "required": false,
        "description": "用户鉴权信息；服务从 user.userId 提取 uid。"
      },
      "utterance": {
        "$ref": "#/nestedTypes/Utterance",
        "required": false,
        "description": "用户原始表达。"
      },
      "version": {
        "type": "string",
        "required": false,
        "description": "外部包络协议版本。"
      },
      "bundleName": {
        "type": "string",
        "required": false,
        "description": "外层宿主业务包名。"
      }
    }
  },
  "output": {
    "type": "object",
    "required": [
      "type",
      "tool",
      "operation",
      "requestId",
      "data",
      "status",
      "errorCode",
      "error"
    ],
    "properties": {
      "type": {
        "type": "string",
        "required": true,
        "description": "消息类型；正常响应为 result，异常响应为 error。"
      },
      "tool": {
        "type": "string",
        "required": true,
        "description": "当前工具名；本接口为 getDataCapabilitySchemas。"
      },
      "operation": {
        "type": "string",
        "required": true,
        "description": "当前 WebSocket path 对应的接口名。"
      },
      "requestId": {
        "type": "string|null",
        "required": true,
        "description": "服务端根据 sessionId + '&' + interactionId 生成的请求 ID。"
      },
      "data": {
        "type": "object",
        "required": true,
        "description": "业务响应数据。",
        "requiredProperties": [
          "apiVersion",
          "capabilityRegistryVersion",
          "dataCapabilities",
          "missingCapabilityIds"
        ],
        "properties": {
          "apiVersion": {
            "type": "string",
            "required": true,
            "description": "接口版本。"
          },
          "capabilityRegistryVersion": {
            "type": "string",
            "required": true,
            "description": "本次实际使用的能力清单版本目录名。"
          },
          "dataCapabilities": {
            "type": "DataCapability[]",
            "required": true,
            "description": "已找到的数据能力完整定义。"
          },
          "missingCapabilityIds": {
            "type": "string[]",
            "required": true,
            "description": "未在当前能力清单版本中找到的数据能力 ID。"
          }
        }
      },
      "status": {
        "type": "string",
        "required": true,
        "description": "本次调用状态；成功时为 success。"
      },
      "errorCode": {
        "type": "string",
        "required": true,
        "description": "错误码；成功时为空字符串。"
      },
      "error": {
        "type": "object",
        "required": true,
        "description": "错误详情；成功时为空对象。"
      }
    }
  },
  "nestedTypes": {
    "DeviceInfo": {
      "required": ["locale", "phoneType", "sysVer"],
      "properties": {
        "countryCode": "string，可选，国家码。",
        "deviceFormation": "string，可选，设备形态。",
        "deviceType": "integer|string，可选，设备类型编码。",
        "locale": "string，推荐，语言区域。",
        "phoneType": "string，推荐，设备型号。",
        "prdVer": "string，可选，端侧传入的业务 API 版本；字段名保持端侧协议原名。",
        "sysVer": "string，推荐，系统版本。",
        "time": "string，可选，端侧请求时间。",
        "romVersion|romVer|rom|rom_version|ohosApiVersion|ohos_api_version": "string|integer，可选，ROM 版本；缺失时使用配置默认 ROM。",
        "ohosApiVersion|ohos_api_version": "integer，可选；当前也可作为 ROM 版本兜底来源。"
      }
    },
    "Session": {
      "required": ["sessionId", "interactionId"],
      "properties": {
        "sessionId": "string，会话 ID。",
        "interactionId": "string，交互 ID。",
        "isNew": "boolean，可选，是否新会话。"
      }
    },
    "UserAuth": {
      "required": false,
      "properties": {
        "user.userId": "string，可选，用户 ID。"
      }
    },
    "Pagination": {
      "required": false,
      "properties": {
        "limit": "integer，可选，分页大小。",
        "start": "string，可选，分页游标。"
      }
    },
    "Utterance": {
      "required": false,
      "properties": {
        "original": "string，可选，用户原始表达。",
        "type": "string，可选，输入类型。"
      }
    }
  }
}
