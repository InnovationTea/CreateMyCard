{
  "name": "generateWidgetCard",
  "transport": "websocket",
  "path": "/genui-agent-service/api/v1/ws/tools/generateWidgetCard",
  "description": "提交用户需求、候选数据绑定、候选事件和素材，生成可下载的 HarmonyOS A2UI Form 卡片 artifact。content 对应业务入参。",
  "messageEnvelope": {
    "type": "object",
    "required": ["content", "deviceInfo", "session"],
    "properties": {
      "content": {
        "type": "object",
        "required": true,
        "description": "业务入参，对应旧协议 arguments。",
        "requiredProperties": ["userQuery"],
        "properties": {
          "bundleName": {
            "type": "string",
            "required": false,
            "description": "宿主业务包名。"
          },
          "userQuery": {
            "type": "string",
            "required": true,
            "description": "用户原始卡片需求；缺失时服务会尝试使用 utterance.original 兜底。"
          },
          "size": {
            "type": "string",
            "enum": ["2x2", "2x4"],
            "required": false,
            "default": "2x4",
            "description": "主 Agent 建议尺寸。"
          },
          "candidateDataBindings": {
            "type": "CandidateDataBinding[]",
            "required": false,
            "description": "候选数据能力调用列表；微服务会按注册表和 IDS 状态裁决最终可用项。"
          },
          "candidateEventCandidates": {
            "type": "CandidateEventCandidate[]",
            "required": false,
            "description": "候选点击事件列表；action 只能来自能力概述返回的事件能力说明。"
          },
          "candidateAssetIds": {
            "type": "string[]",
            "required": false,
            "description": "候选素材 ID 列表。"
          },
          "options": {
            "type": "GenerationOptions",
            "required": false,
            "description": "生成选项；本地调试可用 returnArtifactInline 控制是否内联 artifact。"
          },
          "capabilityRegistryVersion": {
            "type": "string|null",
            "required": false,
            "description": "可选能力清单版本；不传时由 deviceInfo 推导。"
          },
          "protocolProfileId": {
            "type": "string|null",
            "required": false,
            "description": "可选 A2UI 协议 profile ID；不传时使用默认 profile。"
          }
        }
      },
      "deviceInfo": {
        "$ref": "#/nestedTypes/DeviceInfo",
        "required": true,
        "description": "端侧设备信息；缺少 ROM 字段时服务使用 settings.default_device_rom_version。"
      },
      "session": {
        "$ref": "#/nestedTypes/Session",
        "required": true,
        "description": "会话信息；服务端 requestId = sessionId + '&' + interactionId。"
      },
      "pagination": {
        "$ref": "#/nestedTypes/Pagination",
        "required": false,
        "description": "分页信息，当前接口暂不消费。"
      },
      "userAuth": {
        "$ref": "#/nestedTypes/UserAuth",
        "required": false,
        "description": "用户鉴权信息；服务从 user.userId 提取 uid。"
      },
      "utterance": {
        "$ref": "#/nestedTypes/Utterance",
        "required": false,
        "description": "用户原始表达；content.userQuery 缺失时可作为兜底。"
      },
      "version": {
        "type": "string",
        "required": false,
        "description": "外部包络协议版本。"
      },
      "bundleName": {
        "type": "string",
        "required": false,
        "description": "外层宿主业务包名。"
      }
    }
  },
  "output": {
    "type": "object",
    "required": ["apiVersion", "status", "suggestSize", "message"],
    "properties": {
      "apiVersion": {
        "type": "string",
        "required": true,
        "description": "接口版本。"
      },
      "status": {
        "type": "string",
        "enum": ["success", "degraded", "unsupported", "failed"],
        "required": true,
        "description": "生成状态。"
      },
      "artifactUrl": {
        "type": "string",
        "required": false,
        "description": "artifact 下载地址；成功或降级成功时返回。"
      },
      "artifactDigest": {
        "type": "string",
        "required": false,
        "description": "artifact 内容摘要。"
      },
      "suggestSize": {
        "type": "string",
        "enum": ["2x2", "2x4"],
        "required": true,
        "description": "最终生成卡片尺寸。"
      },
      "message": {
        "type": "string",
        "required": true,
        "description": "可展示给主 Agent 或用户的生成结果说明。"
      },
      "removedCapabilities": {
        "type": "RemovedCapability[]",
        "required": false,
        "description": "被微服务裁决移除的能力及原因。"
      },
      "errorCode": {
        "type": "string",
        "required": false,
        "description": "失败或不支持时返回的错误码。"
      },
      "artifact": {
        "type": "object|null",
        "required": false,
        "description": "调试时可选内联 artifact；生产默认不返回。"
      },
      "effectiveCapabilities": {
        "type": "object",
        "required": false,
        "description": "最终进入 artifact 的有效 data、event、asset 能力集合。"
      }
    }
  },
  "nestedTypes": {
    "CandidateDataBinding": {
      "required": ["capabilityId", "arguments", "writeResultTo"],
      "properties": {
        "capabilityId": "string，数据能力 ID。",
        "arguments": "object，能力入参，只能使用该能力 inputSchema 声明的字段。",
        "writeResultTo": "string，写入 DataModel 的 JSON Pointer，必须位于 /data/ 下。",
        "updateModel": "object，可选输出字段投影结构，内部层级会原样写入 DataModel。"
      }
    },
    "CandidateEventCandidate": {
      "required": ["capabilityId", "action"],
      "properties": {
        "capabilityId": "string，事件能力 ID。",
        "action.call": "string，事件调用名，例如 clickToDeeplink、clickToIntent、clickToApi。",
        "action.args": "object，事件参数对象。"
      }
    },
    "GenerationOptions": {
      "required": false,
      "properties": {
        "allowDegradation": "boolean，可选，是否允许降级，默认 true。",
        "returnArtifactInline": "boolean，可选，是否在响应中内联 artifact，默认 false。"
      }
    },
    "DeviceInfo": {
      "required": ["locale", "phoneType", "sysVer"],
      "properties": {
        "countryCode": "string，可选，国家码。",
        "deviceFormation": "string，可选，设备形态。",
        "deviceType": "integer|string，可选，设备类型编码。",
        "locale": "string，推荐，语言区域。",
        "phoneType": "string，推荐，设备型号。",
        "prdVer": "string，可选，宿主应用版本。",
        "sysVer": "string，推荐，系统版本。",
        "time": "string，可选，端侧请求时间。",
        "romVersion|romVer|rom|rom_version": "string，可选，ROM 版本；缺失时使用配置默认 ROM。",
        "ohosApiVersion|apiVersion|ohos_api_version": "integer，可选，OHOS API 版本；缺失时使用配置默认值。"
      }
    },
    "Session": {
      "required": ["sessionId", "interactionId"],
      "properties": {
        "sessionId": "string，会话 ID。",
        "interactionId": "string，交互 ID。",
        "isNew": "boolean，可选，是否新会话。"
      }
    },
    "UserAuth": {
      "required": false,
      "properties": {
        "user.userId": "string，可选，用户 ID。"
      }
    },
    "Pagination": {
      "required": false,
      "properties": {
        "limit": "integer，可选，分页大小。",
        "start": "string，可选，分页游标。"
      }
    },
    "Utterance": {
      "required": false,
      "properties": {
        "original": "string，可选，用户原始表达。",
        "type": "string，可选，输入类型。"
      }
    }
  }
}
