{
  "name": "getWidgetCapabilityOverview",
  "transport": "websocket",
  "path": "/genui-agent-service/api/v1/ws/tools/getWidgetCapabilityOverview",
  "description": "获取当前设备版本可用的能力概述。content 对应业务入参，deviceInfo 由工具层注入并转换成内部 DeviceContext。",
  "messageEnvelope": {
    "type": "object",
    "required": ["content", "deviceInfo", "session"],
    "properties": {
      "content": {
        "type": "object",
        "required": false,
        "description": "业务入参，对应旧协议 arguments；本接口可只传 bundleName。",
        "properties": {
          "bundleName": {
            "type": "string",
            "required": false,
            "description": "宿主业务包名。"
          },
          "capabilityRegistryVersion": {
            "type": "string|null",
            "required": false,
            "description": "可选能力清单版本；不传时由 deviceInfo 推导。"
          },
          "protocolProfileId": {
            "type": "string|null",
            "required": false,
            "description": "可选 A2UI 协议 profile ID。"
          }
        }
      },
      "deviceInfo": {
        "$ref": "#/nestedTypes/DeviceInfo",
        "required": true,
        "description": "端侧设备信息；缺少 ROM 字段时服务使用 settings.default_device_rom_version。"
      },
      "session": {
        "$ref": "#/nestedTypes/Session",
        "required": true,
        "description": "会话信息；服务端 requestId = sessionId + '&' + interactionId。"
      },
      "pagination": {
        "$ref": "#/nestedTypes/Pagination",
        "required": false,
        "description": "分页信息，当前接口暂不消费。"
      },
      "userAuth": {
        "$ref": "#/nestedTypes/UserAuth",
        "required": false,
        "description": "用户鉴权信息；服务从 user.userId 提取 uid。"
      },
      "utterance": {
        "$ref": "#/nestedTypes/Utterance",
        "required": false,
        "description": "用户原始表达。"
      },
      "version": {
        "type": "string",
        "required": false,
        "description": "外部包络协议版本。"
      },
      "bundleName": {
        "type": "string",
        "required": false,
        "description": "外层宿主业务包名。"
      }
    }
  },
  "output": {
    "type": "object",
    "required": [
      "apiVersion",
      "capabilityRegistryVersion",
      "dataCapabilities",
      "eventCapabilities",
      "assetCandidates"
    ],
    "properties": {
      "apiVersion": {
        "type": "string",
        "required": true,
        "description": "接口版本。"
      },
      "capabilityRegistryVersion": {
        "type": "string",
        "required": true,
        "description": "本次实际使用的能力清单版本目录名。"
      },
      "dataCapabilities": {
        "type": "DataCapabilityOverview[]",
        "required": true,
        "description": "数据能力概述列表，只包含 id 和 description。"
      },
      "eventCapabilities": {
        "type": "EventCapability[]",
        "required": true,
        "description": "事件能力完整列表。"
      },
      "assetCandidates": {
        "type": "AssetCapability[]",
        "required": true,
        "description": "素材能力完整列表。"
      }
    }
  },
  "nestedTypes": {
    "DeviceInfo": {
      "required": ["locale", "phoneType", "sysVer"],
      "properties": {
        "countryCode": "string，可选，国家码。",
        "deviceFormation": "string，可选，设备形态。",
        "deviceType": "integer|string，可选，设备类型编码。",
        "locale": "string，推荐，语言区域。",
        "phoneType": "string，推荐，设备型号，会映射到内部 deviceType/marketingName。",
        "apiVersion": "string，可选，端侧传入的业务 API 版本。",
        "sysVer": "string，推荐，系统版本，会映射到内部 sysVersion。",
        "time": "string，可选，端侧请求时间。",
        "romVersion|romVer|rom|rom_version": "string，可选，ROM 版本；缺失时使用配置默认 ROM。",
        "ohosApiVersion|ohos_api_version": "integer，可选，OHOS API 版本；缺失时使用配置默认值。"
      }
    },
    "Session": {
      "required": ["sessionId", "interactionId"],
      "properties": {
        "sessionId": "string，会话 ID。",
        "interactionId": "string，交互 ID。",
        "isNew": "boolean，可选，是否新会话。"
      }
    },
    "UserAuth": {
      "required": false,
      "properties": {
        "user.userId": "string，可选，用户 ID。"
      }
    },
    "Pagination": {
      "required": false,
      "properties": {
        "limit": "integer，可选，分页大小。",
        "start": "string，可选，分页游标。"
      }
    },
    "Utterance": {
      "required": false,
      "properties": {
        "original": "string，可选，用户原始表达。",
        "type": "string，可选，输入类型。"
      }
    }
  }
}
