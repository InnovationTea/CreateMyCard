{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": false,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "baseUrl": "../../../..",
    "paths": {
      "@genui-sdk/parser": ["debug_tools/card_renderer/runtime/parser/src/index.ts"],
      "@genui-sdk/graph": ["debug_tools/card_renderer/runtime/graph/src/index.ts"],
      "@genui-sdk/components": ["debug_tools/card_renderer/runtime/components/src/index.ts"],
      "@genui-sdk/interactions": ["debug_tools/card_renderer/runtime/interactions/src/index.ts"],
      "@genui-sdk/renderer": ["debug_tools/card_renderer/runtime/renderer/src/index.ts"],
      "react": ["debug_tools/node_modules/react/index.js"],
      "react/jsx-runtime": ["debug_tools/node_modules/react/jsx-runtime.js"],
      "react-dom/server": ["debug_tools/node_modules/react-dom/server.node.js"]
    }
  }
}
