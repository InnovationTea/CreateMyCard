{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": false,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "baseUrl": "../../../..",
    "paths": {
      "@genui-sdk/parser": ["render/genui-sdk/parser/src/index.ts"],
      "@genui-sdk/graph": ["render/genui-sdk/graph/src/index.ts"],
      "@genui-sdk/components": ["render/genui-sdk/components/src/index.ts"],
      "@genui-sdk/interactions": ["render/genui-sdk/interactions/src/index.ts"],
      "@genui-sdk/renderer": ["render/genui-sdk/renderer/src/index.ts"],
      "react": ["debug_tools/node_modules/react/index.js"],
      "react/jsx-runtime": ["debug_tools/node_modules/react/jsx-runtime.js"],
      "react-dom/server": ["debug_tools/node_modules/react-dom/server.node.js"]
    }
  }
}
