{
  "apiVersion": "batch-postprocess-v2",
  "version": "3.0.0",
  "entrypoint": "builtin",
  "dependence": [
    "browser-capture",
    "data-analysis"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false
  },
  "id": "browser-gallery",
  "name": "浏览器渲染画廊",
  "description": "复用截图与数据分析结果生成可筛选的离线 HTML 画廊。",
  "outputs": [
    {
      "key": "browser-capture",
      "scope": "sample",
      "title": "渲染截图",
      "dataType": "image",
      "required": false,
      "renderer": "gallery"
    },
    {
      "key": "browser-gallery",
      "scope": "dataset",
      "title": "浏览器渲染画廊",
      "dataType": "link",
      "required": true,
      "renderer": "link"
    }
  ],
  "presentation": {
    "defaultView": "gallery",
    "sampleFields": [
      {
        "key": "captureStatus",
        "label": "截图状态",
        "type": "string",
        "filterable": true,
        "sortable": true
      }
    ]
  }
}
