{
  "apiVersion": "batch-postprocess-v2",
  "id": "device-capture",
  "name": "真机截图",
  "version": "5.0.0",
  "description": "复用手动添加的 2x2、2x4 卡片批量截图；需先编译安装，并将应用入口和两张卡片放在同一桌面页，不自动翻页。",
  "entrypoint": "builtin",
  "dependence": [],
  "outputs": [
    {
      "key": "device-capture-metadata",
      "scope": "sample",
      "title": "截图元数据",
      "dataType": "json",
      "required": false
    },
    {
      "key": "device-capture",
      "scope": "sample",
      "title": "真机卡片截图",
      "dataType": "image",
      "renderer": "gallery",
      "required": true
    },
    {
      "key": "device-full-capture",
      "scope": "sample",
      "title": "设备全屏原图",
      "dataType": "image",
      "renderer": "gallery",
      "required": false
    },
    {
      "key": "capture-summary",
      "scope": "dataset",
      "title": "真机截图汇总",
      "dataType": "metrics",
      "renderer": "kpi",
      "required": true
    }
  ],
  "presentation": {
    "defaultView": "gallery",
    "sampleFields": [
      {
        "key": "captureStatus",
        "label": "截图状态",
        "type": "string",
        "filterable": true,
        "sortable": true
      },
      {
        "key": "size",
        "label": "尺寸",
        "type": "string",
        "filterable": true,
        "sortable": true
      }
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "targetId"
    ],
    "properties": {
      "captureMode": {
        "type": "string",
        "enum": ["desktop", "preview"],
        "default": "desktop",
        "title": "截图模式"
      },
      "targetId": {
        "type": "string",
        "minLength": 1,
        "title": "在线设备"
      },
      "captureDelaySeconds": {
        "type": "number",
        "minimum": 0,
        "maximum": 30,
        "deprecated": true,
        "title": "历史截图时延配置",
        "description": "仅兼容旧执行记录；实际时延以 debug_tool.yaml 中 capture_delay_seconds 为准。"
      }
    }
  }
}
