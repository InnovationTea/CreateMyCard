  "content": {
    "title": "通勤助手",
    "description": "天气与导航",
    "userQuery": "生成一个通勤助手卡片，监控天气和导航到公司，公司是华为武汉研究所。\n\n本轮卡片静态内容（用作展示的外部事实）：\n今日武汉市洪山区阵雨转中雨，气温17℃~31℃，南风1级，空气质量良，武汉市气象台发布大风黄色预警信号，预计17日早晨至夜间有6到8级阵风，局地9级以上雷暴大风。",
    "size": "2x4",
    "bundleName": "com.huawei.genui",
    "functionName": "generateWidgetCardCompactDsl",
    "romVersion": "CMU-AL10 7.0.0.115",
    "candidateDataBindings": [
      {
        "arguments": {
          "districtName": "洪山区",
          "forecastDays": 1,
          "prefectureName": "武汉市"
        },
        "candidateOutputFields": [
          "/current/temperatureText",
          "/current/condition",
          "/current/alertLevel",
          "/current/windLevel",
          "/current/airQuality"
        ],
        "capabilityId": "ViewWeather",
        "writeResultTo": "/data/weather"
      }
    ],
    "candidateEventCandidates": [
      {
        "action": {
          "args": {
            "intentName": "StartNavigate",
            "params": {
              "dstLocation": {
                "latitude": "",
                "location": "company",
                "longitude": ""
              }
            }
          },
          "call": "clickToIntent"
        },
        "capabilityId": "event.startNavigate"
      },
      {
        "action": {
          "args": {
            "abilityName": "",
            "bundleName": "",
            "intentName": "Weather_CityCode",
            "uri": "{{ 'hww://www.huawei.com/totemweather?enterType=share&cityCode=' + ${/data/weather/location/cityCode} }}"
          },
          "call": "clickToDeeplink"
        },
        "capabilityId": "event.open.weather"
      }
    ],
