    "title": "上海天气",
    "description": "青浦天气速览",
    "userQuery": "帮我生成一张桌面卡片，显示上海天气\n\n本轮卡片静态内容（用作展示的外部事实）：\n今天上海市青浦区白天中雨转大雨，最高气温约22℃，夜间大雨，最低约18℃，北到东北风4-5级，青浦区已发布台风蓝色预警",
    "size": "2x2",
    "bundleName": "com.huawei.genui",
    "functionName": "generateWidgetCardCompactDsl",
    "romVersion": "VNE-AL00 6.1.0.111",
    "candidateDataBindings": [
      {
        "arguments": {
          "districtName": "青浦区",
          "forecastDays": 1,
          "prefectureName": "上海市"
        },
        "candidateOutputFields": [
          "/current/temperatureText",
          "/current/condition",
          "/current/alertLevel",
          "/current/windDirection",
          "/current/windLevel"
        ],
        "capabilityId": "ViewWeather",
        "writeResultTo": "/data/weather"
      }
    ],
    "candidateEventCandidates": [
