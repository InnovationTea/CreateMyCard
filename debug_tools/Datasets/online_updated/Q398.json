{
  "content": {
    "bundleName": "com.huawei.genui",
    "userQuery": "创建一张美观的桌面卡片，结合当前壁纸风格，展示今日天气、当前时间和近期日程，整体设计要好看、协调，参考百变卡片风格，让桌面更美观。",
    "candidateDataBindings": [
      {
        "capabilityId": "ViewWeather",
        "arguments": {
          "districtName": "孝南区",
          "forecastDays": 1,
          "prefectureName": "孝感市"
        },
        "writeResultTo": "/data/weather",
        "candidateOutputFields": [
          "/current/temperatureText",
          "/current/condition",
          "/current/airQuality"
        ]
      },
      {
        "capabilityId": "GetCurrentTime",
        "arguments": {},
        "writeResultTo": "/data/time",
        "candidateOutputFields": [
          "/currentDate",
          "/dayOfWeek",
          "/lunarDate"
        ]
      },
      {
        "capabilityId": "GetCalendarEvents",
        "arguments": {
          "futureDays": 7
        },
        "writeResultTo": "/data/calendar",
        "candidateOutputFields": [
          "/eventCount",
          "/events/0/title",
          "/events/0/startDate",
          "/events/0/countdownDays"
        ]
      }
    ],
