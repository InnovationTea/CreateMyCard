{
  "content": {
    "title": "今明天气",
    "description": "今明两天天气速览",
    "userQuery": "做一张小艺天气卡片，显示今天和明天两天的天气内容。\n\n本轮卡片静态内容（用作展示的外部事实）：\n今天（10月25日）巢湖市小雨转晴，气温14℃~23℃，东北风3级，空气质量优。\n明天（10月26日）巢湖市晴转阴，气温16℃~23℃，东北风1级，空气质量轻度污染。",
    "size": "2x4",
    "bundleName": "com.huawei.genui",
    "functionName": "generateWidgetCardCompactDsl",
    "romVersion": "CMU-AL10 7.0.0.111",
    "candidateDataBindings": [
      {
        "arguments": {
          "districtName": "巢湖市",
          "forecastDays": 2,
          "prefectureName": "合肥市"
        },
        "candidateOutputFields": [
          "/current/temperatureText",
          "/current/condition",
          "/daily/0/date",
          "/daily/0/weekday",
          "/daily/0/condition",
          "/daily/0/temperatureRangeText",
          "/daily/1/date",
          "/daily/1/weekday",
          "/daily/1/condition",
          "/daily/1/temperatureRangeText",
          "/location/prefectureName",
          "/location/districtName"
        ],
        "capabilityId": "ViewWeather",
        "writeResultTo": "/data/weather"
      }
    ],
    "candidateEventCandidates": [
      {
        "action": {
          "args": {
            "abilityName": "",
            "bundleName": "",
            "intentName": "Weather_CityCode",
            "uri": "{{ 'hww://www.huawei.com/totemweather?enterType=share&cityCode=' + ${/data/weather/location/cityCode} }}"
          },
          "call": "clickToDeeplink"
        },
        "capabilityId": "event.open.weather"
      }
    ],
    "candidateAssetIds": []
  },
