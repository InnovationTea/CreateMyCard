{
  "content": {
    "bundleName": "com.huawei.genui",
    "userQuery": "设计一张2x4的Q版可爱风格桌面卡片，包含时间和天气信息。上方显示大号数字时钟（当前时间、日期、星期），下方显示当前天气（天气现象、温度），整体采用圆润可爱的Q版设计风格，色彩柔和温暖，与桌面壁纸自然融合，文字清晰易读。",
    "candidateDataBindings": [
      {
        "capabilityId": "GetCurrentTime",
        "arguments": {},
        "writeResultTo": "/data/time",
        "candidateOutputFields": [
          "/currentDate",
          "/dayOfWeek",
          "/lunarDate"
        ]
      },
      {
        "capabilityId": "ViewWeather",
        "arguments": {
          "forecastDays": 1
        },
        "writeResultTo": "/data/weather",
        "candidateOutputFields": [
          "/current/temperatureText",
          "/current/condition",
          "/location/prefectureName",
          "/location/districtName"
        ]
      }
    ],
    "title": "Q版时钟天气",
    "size": "2x4",
    "candidateEventCandidates": [
      {
        "capabilityId": "event.open.weather",
        "action": {
          "call": "clickToDeeplink",
          "args": {
            "abilityName": "",
            "bundleName": "",
            "intentName": "Weather_CityCode",
            "uri": "{{ 'hww://www.huawei.com/totemweather?enterType=share&cityCode=' + ${/data/weather/location/cityCode} }}"
          }
        }
      }
    ],
    "description": "Q版时间天气卡片",
    "candidateAssetIds": [
      "asset.emoji_time",
      "asset.ic_weather_monochrome",
      "asset.emoji_default_weather_blue"
    ]
  },
