{
  "name": "widget-debug-tools",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "platform",
    "end_to_end_debug/frontend",
    "interface_debug/frontend",
    "card_renderer/frontend",
    "card_renderer/runtime/*"
  ],
  "scripts": {
    "dev": "npm --workspace @widget-debug/platform run dev",
    "sync:renderer-runtime": "node card_renderer/runtime/scripts/sync-runtime.mjs --sync",
    "check:renderer-runtime": "node card_renderer/runtime/scripts/sync-runtime.mjs --check",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm --workspace @widget-debug/platform run build",
    "pretest": "npm run check:renderer-runtime",
    "test": "npm run test --workspaces --if-present"
  },
  "dependencies": {
    "playwright-core": "^1.55.0"
  }
}
