{
  "bundleName": "com.omega_w_0823.hmservice",
  "pluginType": "Cloud",
  "toolType": "XiaoYiPlugin",
  "toolName": "generateWidgetCardCompactDsl",
  "description": "Generate a HarmonyOS A2UI Form artifact from the user request and candidate capabilities using Compact DSL.",
  "arguments": {
    "properties": {
      "candidateDataBindings": {
        "type": "Array",
        "description": "Candidate data capability calls approved by the capability overview.",
        "required": [],
        "properties": {
          "ArrayItem": {
            "type": "Object",
            "description": "Candidate data capability.",
            "required": [
              "capabilityId",
              "writeResultTo"
            ],
            "properties": {
              "writeResultTo": {
                "type": "String",
                "description": "Result target path."
              },
              "capabilityId": {
                "type": "String",
                "description": "Capability identifier."
              },
              "arguments": {
                "type": "Object",
                "description": "Optional capability arguments; omission is equivalent to an empty object."
              },
              "candidateOutputFields": {
                "type": "Array<String>",
                "description": "Optional JSON Pointer paths for candidate display fields.",
                "required": [],
                "properties": {
                  "ArrayItem": {
                    "type": "String",
                    "description": "Candidate display field JSON Pointer."
                  }
                }
              }
            }
          }
        }
      },
      "title": {
        "type": "String",
        "description": "Suggested static card title; required and non-empty for create, optional for edit."
      },
      "size": {
        "type": "String",
        "description": "Suggested card size."
      },
      "description": {
        "type": "String",
        "description": "Suggested static card description; required and non-empty for create, optional for edit."
      },
      "userQuery": {
        "type": "String",
        "description": "Original user card request."
      },
      "sourceArtifactUrl": {
        "type": "String",
        "description": "Previous complete artifact URL; required and non-empty for edit, omit for create."
      },
      "candidateAssetIds": {
        "type": "Array<String>",
        "description": "Candidate asset identifiers.",
        "required": [],
        "properties": {
          "ArrayItem": {
            "type": "String",
            "description": "Candidate asset identifier."
          }
        }
      },
      "candidateEventCandidates": {
        "type": "Array",
        "description": "Candidate click events from the capability overview.",
        "required": [],
        "properties": {
          "ArrayItem": {
            "type": "Object",
            "description": "Candidate event capability.",
            "required": [
              "capabilityId",
              "action"
            ],
            "properties": {
              "capabilityId": {
                "type": "String",
                "description": "Capability identifier."
              },
              "action": {
                "type": "Object",
                "description": "Complete action copied from the capability action template.",
                "required": [
                  "call",
                  "args"
                ],
                "properties": {
                  "id": {
                    "type": "String",
                    "description": "Optional action identifier."
                  },
                  "call": {
                    "type": "String",
                    "description": "Event call name."
                  },
                  "args": {
                    "type": "Object",
                    "description": "Event arguments."
                  }
                }
              }
            }
          }
        }
      }
    },
    "required": [
      "userQuery"
    ],
    "type": "object"
  },
  "outputSchema": {
    "properties": {
      "status": {
        "type": "String",
        "description": "业务状态：success、degraded、unsupported 或 failed。"
      },
      "artifactUrl": {
        "type": "String",
        "description": "成功生成的新 artifact 地址；无有效产物时为空或缺失。"
      },
      "artifactDigest": {
        "type": "String",
        "description": "服务端排障使用的 artifact 摘要。"
      },
      "suggestSize": {
        "type": "String",
        "description": "微服务最终裁决的卡片尺寸。"
      },
      "message": {
        "type": "String",
        "description": "完整成功时可使用的用户可读说明。"
      },
      "removedCapabilities": {
        "type": "Array",
        "description": "本轮被移除的能力及原因。",
        "properties": {
          "ArrayItem": {
            "type": "Object",
            "description": "被移除能力的结构化说明。"
          }
        }
      },
      "errorCode": {
        "type": "String",
        "description": "服务端业务错误码；不得向用户展示。"
      },
      "effectiveCapabilities": {
        "type": "Object",
        "description": "本轮最终生效的数据、事件和素材能力。"
      }
    },
    "required": [
      "status",
      "suggestSize",
      "message"
    ],
    "type": "object"
  },
  "protocol": "WebSocket",
  "deviceCommand": null,
  "schemaVersion": "1.0"
}
